#!/bin/bash
set -e
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 022

SRC="${1:-}"
DST="${2:-}"

if [ -z "$SRC" ] || [ -z "$DST" ]; then
    echo "usage: $0 <source-dir> <install-dir> [--owned-signal-v1 <pid> <started-at-utc-ticks> <executable-path>]" >&2
    exit 2
fi

if [ "$#" -ne 2 ] && { [ "$#" -ne 6 ] || [ "$3" != "--owned-signal-v1" ]; }; then
    echo "Invalid owned-process signal arguments" >&2
    exit 2
fi

case "$DST" in
    /opt/vpnrouter|/opt/vpnrouter/|/usr/local/vpnrouter|/usr/local/vpnrouter/) ;;
    *)
        echo "Refusing to write outside /opt/vpnrouter or /usr/local/vpnrouter: $DST" >&2
        exit 3
        ;;
esac
DST="${DST%/}"
SRC="${SRC%/}"

root_owned_and_protected() {
    local metadata
    metadata=$(stat -c '%u:%a' -- "$1") || return 1
    [[ "${metadata%%:*}" = 0 ]] && (( (0${metadata#*:} & 022) == 0 ))
}

trusted_directory() {
    [[ ! -L "$1" && -d "$1" ]] && root_owned_and_protected "$1"
}

trusted_file() {
    [[ ! -L "$1" && -f "$1" ]] && root_owned_and_protected "$1"
}

tree_is_valid() {
    local path="$1"
    shift
    find -P "$path" \( ! -type f ! -type d -o -perm /6000 "$@" \) -exec /bin/false {} + -quit
}

directory="$DST"
if [[ ! -e "$DST" && ! -L "$DST" && "$#" -eq 2 ]]; then
    directory="${DST%/*}"
fi
while true; do
    if ! trusted_directory "$directory"; then
        echo "Refusing to update through an untrusted directory: $directory" >&2
        exit 3
    fi
    [[ "$directory" != / ]] || break
    directory="${directory%/*}"
    directory="${directory:-/}"
done

if [[ "$SRC" != /* || "$SRC" == */ || ! -d "$SRC" || -L "$SRC" ]]; then
    echo "Source is not a directory: $SRC" >&2
    exit 4
fi

if ! tree_is_valid "$SRC"; then
    echo "Source contains unsupported entries or could not be verified" >&2
    exit 5
fi
if [[ -d "$DST" ]] && ! tree_is_valid "$DST" -o ! -uid 0 -o -perm /022; then
    echo "Refusing to update an untrusted installation tree" >&2
    exit 3
fi

if [ ! -f "$SRC/VPNRouter.App" ] && [ ! -f "$SRC/VPNRouter.App.dll" ]; then
    echo "Source does not contain a VPNRouter.App binary: $SRC" >&2
    exit 5
fi

for filename in VPNRouter.App VPNRouter.App.dll sing-box; do
    if [[ -e "$SRC/$filename" || -L "$SRC/$filename" ]] &&
        [[ -L "$SRC/$filename" || ! -f "$SRC/$filename" ]]; then
        echo "Source does not contain a regular $filename file" >&2
        exit 5
    fi
    if [[ -e "$DST/$filename" || -L "$DST/$filename" ]] && ! trusted_file "$DST/$filename"; then
        echo "Refusing to replace an untrusted file: $DST/$filename" >&2
        exit 3
    fi
done

stage=$(mktemp -d "${DST%/*}/.vpnrouter-update.XXXXXXXX")
trap 'rm -rf -- "$stage"' EXIT
cp -rT -- "$SRC" "$stage/payload"
if ! tree_is_valid "$stage/payload" -o ! -uid 0 -o -perm /022; then
    echo "Staged payload contains unsupported entries or could not be verified" >&2
    exit 5
fi

if [ "$#" -eq 6 ]; then
    CURRENT_HOST="$DST/VPNRouter.App"
    if ! trusted_file "$CURRENT_HOST" || [ ! -x "$CURRENT_HOST" ]; then
        echo "Current VPNRouter helper executable is unavailable: $CURRENT_HOST" >&2
        exit 6
    fi
    if ! "$CURRENT_HOST" --vpnrouter-internal-signal-owned-v1 "$4" "$5" "$6" 9; then
        echo "Exact owned sing-box stop failed" >&2
        exit 6
    fi
fi

cp -rfT --remove-destination -- "$stage/payload" "$DST"

if ! trusted_directory "$DST"; then
    echo "Updated directory does not match the protected installation layout: $DST" >&2
    exit 3
fi
for filename in VPNRouter.App sing-box; do
    target="$DST/$filename"
    if [[ ! -e "$target" && ! -L "$target" ]]; then
        continue
    fi
    if ! trusted_file "$target"; then
        echo "Refusing to chmod an untrusted file: $target" >&2
        exit 3
    fi
    chmod +x -- "$target"
done

CAPABILITIES=cap_net_admin,cap_net_bind_service=+eip
if trusted_file "$DST/sing-box"; then
    if ! setcap "$CAPABILITIES" "$DST/sing-box" || ! setcap -q -v "$CAPABILITIES" "$DST/sing-box"; then
        printf '%s\n' 'VPNRouter: could not verify sing-box capabilities. Connecting may require polkit authentication.' >&2
    fi
fi

exit 0

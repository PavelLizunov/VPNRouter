#!/bin/bash
set -e

SRC="${1:-}"
DST="${2:-}"

if [ -z "$SRC" ] || [ -z "$DST" ]; then
    echo "usage: $0 <source-dir> <install-dir> [--owned-signal-v1 <pid> <started-at-utc-ticks> <executable-path>]" >&2
    exit 2
fi

if [ "$#" -ne 2 ] && { [ "$#" -ne 6 ] || [ "$3" != "--owned-signal-v1" ]; }; then
    echo "Invalid owned-process signal arguments" >&2
    exit 2
fi

case "$DST" in
    /opt/vpnrouter|/opt/vpnrouter/|/usr/local/vpnrouter|/usr/local/vpnrouter/) ;;
    *)
        echo "Refusing to write outside /opt/vpnrouter or /usr/local/vpnrouter: $DST" >&2
        exit 3
        ;;
esac

if [ ! -d "$SRC" ]; then
    echo "Source is not a directory: $SRC" >&2
    exit 4
fi

if [ ! -f "$SRC/VPNRouter.App" ] && [ ! -f "$SRC/VPNRouter.App.dll" ]; then
    echo "Source does not contain a VPNRouter.App binary: $SRC" >&2
    exit 5
fi

if [ "$#" -eq 6 ]; then
    CURRENT_HOST="$DST/VPNRouter.App"
    if [ ! -x "$CURRENT_HOST" ]; then
        echo "Current VPNRouter helper executable is unavailable: $CURRENT_HOST" >&2
        exit 6
    fi
    if ! "$CURRENT_HOST" --vpnrouter-internal-signal-owned-v1 "$4" "$5" "$6" 9; then
        echo "Exact owned sing-box stop failed" >&2
        exit 6
    fi
fi

cp -rfT "$SRC" "$DST"

[ -f "$DST/VPNRouter.App" ] && chmod +x "$DST/VPNRouter.App"
[ -f "$DST/sing-box" ]       && chmod +x "$DST/sing-box"

if [ -f "$DST/sing-box" ] && command -v setcap >/dev/null 2>&1; then
    setcap cap_net_admin,cap_net_bind_service=+eip "$DST/sing-box" 2>/dev/null || true
fi

exit 0

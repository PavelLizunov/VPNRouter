[Unit]
Description=VPNRouter independent session service
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
ExecStart=/usr/lib/vpnrouter-headless/VPNRouter.Headless --service
UMask=0077
RuntimeDirectory=vpnrouter-headless
RuntimeDirectoryMode=0700
KillMode=control-group
TimeoutStopSec=45s
Restart=on-failure
RestartSec=2s

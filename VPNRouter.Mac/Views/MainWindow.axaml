<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VPNRouter.Mac.ViewModels"
        xmlns:conv="using:VPNRouter.Mac"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="680"
        x:Class="VPNRouter.Mac.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Virtual Penguin Network"
        Width="540" Height="680"
        MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:BoolToStatusColorConverter x:Key="StatusColorConverter"/>
        <conv:BoolToLangConverter x:Key="LangConverter"/>
        <conv:BoolToFontWeightConverter x:Key="ActiveFontConverter"/>
    </Window.Resources>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- ═══ Header: Logo + Brand + Controls ═══ -->
        <Border DockPanel.Dock="Top" Padding="16,12" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                Background="{DynamicResource SystemAltHighColor}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Logo -->
                <Image Grid.Column="0" Source="/Assets/penguin_logo.png"
                       Width="48" Height="48" Margin="0,0,12,0"/>
                <!-- Title + Subtitle -->
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Virtual Penguin Network" FontSize="18" FontWeight="Bold"
                               Foreground="#2563EB"/>
                    <TextBlock Text="{Binding VersionText}" FontSize="11" Opacity="0.5"/>
                </StackPanel>
                <!-- Theme / Lang / Tools -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button Content="{Binding ShowLogsLabel}"
                            Command="{Binding OpenLogsCommand}"
                            Padding="8,4" FontSize="11"
                            Background="Transparent" BorderThickness="0"
                            ToolTip.Tip="Open logs folder"/>
                    <Button Content="{Binding CheckLeaksLabel}"
                            Command="{Binding OpenLeakTestCommand}"
                            Padding="8,4" FontSize="11"
                            Background="Transparent" BorderThickness="0"
                            ToolTip.Tip="ipleak.net"/>
                    <Button Content="{Binding ThemeToggleText}"
                            Command="{Binding ToggleThemeCommand}"
                            Padding="8,4" FontSize="11"
                            Background="Transparent" BorderThickness="0"/>
                    <Button Content="{Binding IsRussian, Converter={StaticResource LangConverter}}"
                            Command="{Binding ToggleLanguageCommand}"
                            Padding="8,4" FontSize="11"
                            Background="Transparent" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Bottom: Action Panel (Connect + Status) ═══ -->
        <Border DockPanel.Dock="Bottom" Padding="16,10" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
            <StackPanel Spacing="8">
                <!-- Connect Button — full width, primary color -->
                <Button Content="{Binding ConnectButtonText}"
                        Command="{Binding ToggleConnectionCommand}"
                        IsEnabled="{Binding !IsConnecting}"
                        FontSize="14" FontWeight="Bold"
                        Padding="0,12"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#2563EB" Foreground="White"
                        CornerRadius="6"/>
                <!-- Status row -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="10" Height="10"
                             Fill="{Binding IsConnected, Converter={StaticResource StatusColorConverter}}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Opacity="0.7" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ Tabs ═══ -->
        <TabControl Margin="0" Padding="8">

            <!-- ─── Servers Tab ─── -->
            <TabItem Header="{Binding LblTabServers}">
                <ScrollViewer Padding="12">
                    <StackPanel Spacing="12">

                        <!-- Config Mode Toggle -->
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton Content="{Binding LblVlessServers}"
                                         IsChecked="{Binding IsVlessMode}"
                                         GroupName="ConfigMode" FontWeight="SemiBold"/>
                            <RadioButton Content="{Binding LblCustomConfigJson}"
                                         GroupName="ConfigMode" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- ── VLESS Panel ── -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsVlessMode}">
                            <!-- Buttons -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{Binding LblAddServers}"
                                        Command="{Binding AddServerCommand}"
                                        Background="#2563EB" Foreground="White"
                                        Padding="16,6" CornerRadius="4" FontWeight="SemiBold"/>
                                <Button Content="{Binding LblRemove}"
                                        Command="{Binding RemoveServerCommand}"
                                        Padding="16,6" CornerRadius="4"/>
                            </StackPanel>

                            <!-- VLESS URI input -->
                            <TextBox Text="{Binding VlessUri}"
                                     Watermark="vless://uuid@server:443?security=reality&amp;sni=...#name"
                                     AcceptsReturn="True" MinHeight="50"/>

                            <!-- Server List -->
                            <ListBox ItemsSource="{Binding Servers}"
                                     SelectedItem="{Binding SelectedServer}"
                                     MinHeight="100" MaxHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ServerViewModel">
                                        <Grid ColumnDefinitions="*,*,50,70" Margin="4,2">
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Server}" Opacity="0.7"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Port}" Opacity="0.5" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Security}" Opacity="0.4" TextAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{Binding LblDoubleClickEditServer}"
                                       FontSize="11" Opacity="0.5"/>

                            <!-- Selected Server Details -->
                            <Border IsVisible="{Binding SelectedServer, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12">
                                <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                      DataContext="{Binding SelectedServer}"
                                      x:DataType="vm:ServerViewModel">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Server:" VerticalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Server}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Port:" VerticalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Port}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="UUID:" VerticalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Uuid}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Public Key:" VerticalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PublicKey}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Short ID:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ShortId}"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ── Custom Config Panel ── -->
                        <StackPanel Spacing="8" IsVisible="{Binding !IsVlessMode}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{Binding LblAddConfig}"
                                        Command="{Binding AddCustomConfigCommand}"
                                        Background="#2563EB" Foreground="White"
                                        Padding="16,6" CornerRadius="4" FontWeight="SemiBold"/>
                                <Button Content="{Binding LblRemove}"
                                        Command="{Binding RemoveCustomConfigCommand}"
                                        Padding="16,6" CornerRadius="4"/>
                            </StackPanel>

                            <ListBox ItemsSource="{Binding CustomConfigs}"
                                     SelectedItem="{Binding SelectedCustomConfig}"
                                     MinHeight="100" MaxHeight="200"
                                     DoubleTapped="CustomConfigList_DoubleTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CustomConfigViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="4,2">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       FontWeight="{Binding IsActive, Converter={StaticResource ActiveFontConverter}}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Protocols}"
                                                       Opacity="0.6" Margin="8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Server}"
                                                       Opacity="0.4" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding LblDoubleClickActiveConfig}"
                                       FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─── Apps Tab ─── -->
            <TabItem Header="{Binding LblTabApps}">
                <ScrollViewer Padding="12">
                    <StackPanel Spacing="12">
                        <!-- Routing Mode -->
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton Content="{Binding LblSplitTunnel}"
                                         IsChecked="{Binding IsSplitTunnel}"
                                         GroupName="RoutingMode" FontWeight="SemiBold"/>
                            <RadioButton Content="{Binding LblFullTunnel}"
                                         GroupName="RoutingMode" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Russian Geo Bypass -->
                        <Border Padding="12,10" CornerRadius="6"
                                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="4">
                                <CheckBox IsChecked="{Binding BypassRussianTraffic}"
                                          Content="{Binding BypassRuLabel}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding BypassRuHint}"
                                           FontSize="11" Opacity="0.6" Margin="22,0,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Strict Mode + Advanced -->
                        <Border Padding="12,10" CornerRadius="6"
                                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="6">
                                <CheckBox IsChecked="{Binding StrictMode}"
                                          Content="{Binding StrictModeLabel}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding StrictModeHint}"
                                           FontSize="11" Opacity="0.6" Margin="22,0,0,4"
                                           TextWrapping="Wrap"/>
                                <CheckBox IsChecked="{Binding ForceIpv4Only}"
                                          Content="{Binding ForceIpv4Label}" FontSize="12"/>
                                <CheckBox IsChecked="{Binding FlushDnsOnStart}"
                                          Content="{Binding FlushDnsLabel}" FontSize="12"/>
                                <CheckBox IsChecked="{Binding StrictDns}"
                                          Content="{Binding StrictDnsLabel}" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding LblAppsHint}"
                                   FontSize="12" Opacity="0.7"
                                   IsVisible="{Binding IsSplitTunnel}"/>

                        <!-- App Groups -->
                        <ItemsControl ItemsSource="{Binding AppGroups}"
                                      IsVisible="{Binding IsSplitTunnel}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AppGroupViewModel">
                                    <Border Margin="0,2" Padding="8,6"
                                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                            BorderThickness="1" CornerRadius="4">
                                        <Expander>
                                            <Expander.Header>
                                                <CheckBox IsChecked="{Binding IsChecked}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Description}" Opacity="0.5"
                                                                   FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Apps}" Margin="24,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:AppItemViewModel">
                                                        <CheckBox IsChecked="{Binding IsChecked}" Margin="0,1">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{Binding ProcessName}"/>
                                                                <TextBlock Text="(custom)" Opacity="0.4"
                                                                           IsVisible="{Binding IsCustom}"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add Custom App -->
                        <StackPanel Spacing="4" IsVisible="{Binding IsSplitTunnel}">
                            <TextBlock Text="{Binding LblAddCustomAppHint}"
                                       FontSize="12" Opacity="0.7"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{Binding LblRemove}"
                                        Command="{Binding RemoveCustomAppsCommand}"
                                        Margin="8,0,0,0" Padding="12,6" CornerRadius="4"/>
                                <Button DockPanel.Dock="Right" Content="{Binding LblBtnAdd}"
                                        Command="{Binding AddCustomAppCommand}"
                                        CommandParameter="{Binding #customAppInput.Text}"
                                        Margin="8,0,0,0" Padding="12,6" CornerRadius="4"
                                        Background="#2563EB" Foreground="White"/>
                                <TextBox x:Name="customAppInput"
                                         Watermark="e.g. Discord, Chrome, Telegram"/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

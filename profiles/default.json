{
  "profiles": [
    {
      "name": "Discord_Privacy",
      "description": "Полная приватность для Discord",
      "processes": [
        {
          "name": "Discord.exe",
          "include_children": true,
          "scan_patterns": [
            "Discord*.exe",
            "DiscordUpdate.exe",
            "DiscordPTB.exe",
            "DiscordCanary.exe"
          ]
        }
      ],
      "dns_mode": "vpn_only",
      "block_on_vpn_fail": true
    },
    {
      "name": "Gaming_Full",
      "description": "Все игровые приложения",
      "processes": [
        {
          "name": "Games.exe",
          "include_children": true,
          "scan_patterns": ["Games*.exe"]
        },
        {
          "name": "Endfield.exe",
          "include_children": true,
          "scan_patterns": ["Endfield*.exe", "EndField*.exe"]
        }
      ],
      "dns_mode": "vpn_only",
      "block_on_vpn_fail": false
    },
    {
      "name": "Work_Suite",
      "description": "Рабочие приложения",
      "processes": [
        {
          "name": "ChatGPT.exe",
          "include_children": true,
          "scan_patterns": ["ChatGPT*.exe"]
        },
        {
          "name": "claude.exe",
          "include_children": true,
          "scan_patterns": ["claude*.exe", "Claude*.exe"]
        },
        {
          "name": "Telegram.exe",
          "include_children": true,
          "scan_patterns": ["Telegram*.exe"]
        }
      ],
      "dns_mode": "vpn_only",
      "block_on_vpn_fail": true
    },
    {
      "name": "Browsers",
      "description": "Все браузеры",
      "processes": [
        {
          "name": "chrome.exe",
          "include_children": true,
          "scan_patterns": ["chrome.exe"]
        },
        {
          "name": "brave.exe",
          "include_children": true,
          "scan_patterns": ["brave.exe"]
        }
      ],
      "dns_mode": "smart",
      "block_on_vpn_fail": false
    },
    {
      "name": "Terminal",
      "description": "Windows Terminal и консольные приложения",
      "processes": [
        {
          "name": "WindowsTerminal.exe",
          "include_children": false,
          "scan_patterns": ["WindowsTerminal*.exe", "wt.exe"]
        }
      ],
      "dns_mode": "direct",
      "block_on_vpn_fail": false
    }
  ]
}

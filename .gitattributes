# Force LF line endings for Linux scripts and POSIX config files so they
# work inside the .deb and when extracted from the repo on Linux hosts.
# Without this, files edited on Windows end up as CRLF in the package
# and shell scripts fail with "bad interpreter" or polkit refuses to
# parse the policy XML.
*.sh                                               text eol=lf
packaging/linux/vpnrouter-update-helper            text eol=lf
packaging/linux/com.vpnrouter.update.policy        text eol=lf
packaging/linux/VPNRouter.sh                       text eol=lf
packaging/linux/vpnrouter.desktop                  text eol=lf
build-linux.sh                                     text eol=lf
build-mac.sh                                       text eol=lf

# Windows batch / PowerShell — keep CRLF.
*.bat                                              text eol=crlf
*.cmd                                              text eol=crlf
*.ps1                                              text eol=crlf

# C# / yaml / markdown — let git handle per-platform default.
*.cs                                               text
*.axaml                                            text
*.yml                                              text eol=lf
*.yaml                                             text eol=lf
*.md                                               text
*.json                                             text

# Binary — never CRLF conversion
*.png                                              binary
*.ico                                              binary
*.dmg                                              binary
*.zip                                              binary
*.gz                                               binary
*.deb                                              binary
*.AppImage                                         binary

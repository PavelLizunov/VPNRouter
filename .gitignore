# Windows reserved device files
nul

# sing-box source & Go build cache (built via build-singbox.ps1).
# Use tools/* (not tools/) so we can re-include specific developer
# scripts via exceptions below. With a trailing-slash ignore the dir
# itself gets pruned and git never even looks inside for !-patterns.
tools/*
# Re-include: live-test scripts (reusable per-release regression harness).
!tools/live-test-*.ps1
# Re-include: smoke-update.ps1 (v2.29.0-r7 ship-time pre-tag verification).
!tools/smoke-update.ps1
# Re-include: VpnRouterTestMcp (in-tree MCP server — Claude GUI testing).
!tools/VpnRouterTestMcp/
!tools/VpnRouterTestMcp/**
# v2.31.1 follow-up: the recursive re-include above also pulled in this
# project's bin/obj output (the global "bin/"+"obj/" rules at the top
# of this file are overridden by the bang-include). Re-exclude them so
# build artefacts don't show up as untracked / dirty.
tools/VpnRouterTestMcp/bin/
tools/VpnRouterTestMcp/obj/

# Misc
*.jpg

# Release artifacts (narrow patterns — "VPNRouter-v*" used to match
# plan filenames like vpnrouter-v2.16-*.md as well; restrict to archives)
*.dmg
*.zip
VPNRouter-v*.zip
VPNRouter-v*.dmg
VPNRouter-v*.sha256
VPNRouter-install-*.zip
VPNRouter-update-*.zip
VPNRouter-update-v*.sha256
b_icon.png
w_icon.png
publish/

# Draft release-notes files — rendered into `gh release --notes-file`, not
# checked in. The finalised copy is on the GitHub Release itself.
release-notes-*.md

# UI test screenshots (regenerated on every `dotnet test` run; inspection
# artefact, not versioned content). See plans/ui-testing-workflow.md.
# Exception: screenshots/baseline/ holds pinned PNGs for VisualDiffTests
# regression — those ARE versioned and refreshed only when a page change
# is intentional (see VisualDiffTests doc-comment for the workflow).
VPNRouter.Tests/screenshots/*
!VPNRouter.Tests/screenshots/baseline/
!VPNRouter.Tests/screenshots/baseline/**

# Claude session handoff (memory layer for CSM context system).
# Contains current state + persons + infrastructure pointers. May contain
# secrets in future iterations (Forgejo creds, GitHub PATs, etc.) — keep
# private. See /CLAUDE.md "Memory layer" section for workflow.
.claude_handoff.md

# Claude Code per-user permission allowlist (autonomous-mode bypass for
# ship-rolling-candidate workflow). Personal overrides — convention says
# settings.local.json is gitignored. settings.json (committed) is for
# team-wide config; settings.local.json is for "I trust these commands
# on my machine".
.claude/settings.local.json

# v3.0 Android Phase 1.B — libbox.aar built locally (92 MB Go cross-compile)
VPNRouter.Android/Lib/libbox*.aar
test-screenshots/

<?xml version="1.0" encoding="utf-8"?>
<!--
  Wave 32b / r14 (2026-05-20) — NU1102 workaround for the .NET 10 preview
  Android workload.

  Problem: setup-dotnet @ 10.0.x in CI pulls SDK 10.0.300, whose Android
  workload manifest references runtime packs (e.g.
  `Microsoft.NETCore.App.Runtime.Mono.linux-x64 = 10.0.8`) that haven't
  been published to the public nuget.org feed yet. Restore fails with
  `NU1102: Unable to find package … Found 142 version(s) in nuget.org
  [ Nearest version: 9.0.0-preview.7.24405.7 ]`.

  Fix: layer the public `dotnet10` Azure DevOps feed above nuget.org so
  the missing preview packs resolve from there while everything else
  still comes from nuget.org. The feed is the same one Microsoft's
  dotnet/installer pipelines use for preview SDK testing.

  Scope: this NuGet.config sits inside `VPNRouter.Android/` so only
  Android restores see the extra feed; macOS / Linux / Windows / CLI /
  Service / Core / Tests all keep restoring from nuget.org alone.

  Future: remove when SDK 10.0.x ships GA and the matching runtime packs
  land on nuget.org. Tracked in `MEMORY.md` "Wave 32b NU1102".
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="dotnet10" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet10/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

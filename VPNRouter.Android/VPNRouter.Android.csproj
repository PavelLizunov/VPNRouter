<Project Sdk="Microsoft.NET.Sdk">

  <!-- Android port. Build when Android SDK is available:
           dotnet build VPNRouter.Android/VPNRouter.Android.csproj \
                  /p:AndroidSdkDirectory=<path>
       Or set $ANDROID_HOME / $ANDROID_SDK_ROOT env var.

       Reference plan: plans/vpnrouter-android-research.md
       Reference issue tracker: TBD on first user-visible Android build.
  -->

  <PropertyGroup>
    <!-- Wave 23 (Phase 5, 2026-05-18) — bumped to .NET 10 + Android 36 to
         move off the Avalonia 11.3.12 pin. Avalonia.Android 12.0.3 requires
         net10.0-android36.0; the desktop App is already on Avalonia 12.0.3
         from Phase 3A. -->
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <!-- libbox.aar requires API 23+ (Android 6.0 Marshmallow). Practically
         universal at this point; KYOCERA A101BM Phase 1.A test runs Android
         12 (API 31). We bumped from 21 → 23 to satisfy libbox's minSdk. -->
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.ninitux.vpnrouter</ApplicationId>
    <!-- Android version derives from a single $(VpnRouterVersion) so the
         versionCode increases monotonically EVERY release. Android (and
         F-Droid) refuse to install an APK whose versionCode is <= the
         installed one, so the old hardcoded "1" silently blocked ALL in-app
         updates. build-android.ps1 passes -p:VpnRouterVersion=X.Y.Z; the
         default tracks the current desktop AppVersion so manual builds stay
         installable. versionCode = Major*1000000 + Minor*1000 + Patch
         (e.g. 2.38.2 -> 2038002); versionName = the full version string. -->
    <!-- Default now genuinely tracks AppVersion.cs (single source of truth): was a
         hardcoded "2.38.2" that silently mislabelled every manual `dotnet build`
         (versionName + versionCode) while the comment claimed it tracked AppVersion.
         build-android.ps1 / the release still override via -p:VpnRouterVersion. -->
    <VpnRouterVersion Condition="'$(VpnRouterVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../VPNRouter.Core/AppVersion.cs')), '(?&lt;=readonly string Version = ")[^"]+').Value)</VpnRouterVersion>
    <_VpnVerCore>$([System.Text.RegularExpressions.Regex]::Replace($(VpnRouterVersion), '-.*$', ''))</_VpnVerCore>
    <ApplicationDisplayVersion>$(VpnRouterVersion)</ApplicationDisplayVersion>
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($([System.Version]::Parse($(_VpnVerCore)).Major), 1000000)), $([MSBuild]::Multiply($([System.Version]::Parse($(_VpnVerCore)).Minor), 1000)))), $([System.Version]::Parse($(_VpnVerCore)).Build)))</ApplicationVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Android-only define so VPNRouter.Core's Android branches compile. -->
    <DefineConstants>$(DefineConstants);PLATFORM_ANDROID</DefineConstants>

    <!-- Android-specific build flags. -->
    <RuntimeIdentifiers>android-arm64;android-arm;android-x64;android-x86</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidSigningKeyStore Condition="'$(Configuration)' == 'Release'">vpnrouter.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias Condition="'$(Configuration)' == 'Release'">vpnrouter</AndroidSigningKeyAlias>
  </PropertyGroup>

  <ItemGroup>
    <!-- v3.0 Phase 2 (2026-05-04): link the desktop design tokens so
         the Android UI shares the same Arctic palette + radii + spacing.
         Avalonia 11 supports cross-project resource linking via
         <AvaloniaResource> with a Link metadata; the file path inside
         the APK becomes /Styles/Tokens.axaml regardless of where it
         lives on disk. Loaded from AndroidApp.axaml via:
           <ResourceInclude Source="avares://VPNRouter.Android/Styles/Tokens.axaml"/>
    -->
    <AvaloniaResource Include="..\VPNRouter.App\Styles\Tokens.axaml"
                      Link="Styles\Tokens.axaml" />
    <!-- v3.0 Phase 5 (2026-05-04) — link the mascot PNG from desktop
         assets directly so palette+art changes propagate. Pre-5 we used
         🐧 emoji which doesn't match desktop's branded penguin. -->
    <AvaloniaResource Include="..\VPNRouter.App\Assets\penguin_mascot.png"
                      Link="Assets\penguin_mascot.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- v3.0 Phase 1.E (2026-05-04): link VPNRouter.Core sources
         directly into this project rather than using a ProjectReference
         to a multi-target Core build.
         Why: ProjectReference + multi-target + RID-aware Android consumer
         hit a deadlock — Core's restore for net8.0-android needs RIDs
         to satisfy Android.csproj's restore graph, but adding RIDs to
         Core.csproj makes its build expect per-RID DLL outputs in obj/
         which never get written for a class library. The cleanest
         workaround for now is to compile Core sources straight into
         the Android assembly. PLATFORM_ANDROID is already defined for
         this project (see <DefineConstants> above), so Core's
         #if PLATFORM_ANDROID branches activate; Windows-only files
         (EtwProcessMonitor, FirewallManager, WindowsDnsHardening,
         Zapret*, TgProxy*, etc.) are gated behind #if PLATFORM_WINDOWS
         and compile out cleanly.

         When Core grows enough Android-specific code that source
         linking becomes painful (or when .NET 9's improved ProjectReference
         multi-target story lands), revisit and switch to a proper
         ProjectReference. -->
    <Compile Include="..\VPNRouter.Core\**\*.cs"
             Exclude="..\VPNRouter.Core\bin\**;..\VPNRouter.Core\obj\**"
             LinkBase="Core" />
  </ItemGroup>

  <!-- Cross-platform packages that VPNRouter.Core depends on. Mirror
       what's declared in VPNRouter.Core.csproj because we're consuming
       Core's source files directly above (no ProjectReference to pull
       its package graph).
       Phase 4 (2026-05-18): Newtonsoft.Json dropped — AndroidUpdater
       migrated to STJ; Core no longer references Newtonsoft. -->
  <ItemGroup>
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <!-- Phase 6 Wave 31a (commit b446f3d) added Vecc.YamlDotNet.Analyzers.StaticGenerator
         to Core.csproj for the StaticDeserializerBuilder swap in
         VPNRouter.Core/Services/SettingsLoader.cs. Android source-links
         Core's .cs files via <Compile Include="..\VPNRouter.Core\**\*.cs">
         above (no ProjectReference, see csproj comment line 60-79), which
         pulls in SettingsLoader.cs source but does NOT inherit Core's
         analyzer PackageReferences. Without this duplicate reference here,
         the Android compile pass produces 0 of the generator's partial
         halves → YamlStaticContext lacks the `: StaticContext` base, so
         the StaticDeserializerBuilder ctor call in SettingsLoader fails
         compile with CS1503 "cannot convert from 'YamlStaticContext' to
         'StaticContext'". Mirroring the analyzer-style PackageReference
         from Core.csproj fixes it. Both YamlDotNet and this generator pin
         must match VPNRouter.Core.csproj (currently 18.1.0). -->
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" Version="18.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Wave 23 (Phase 5, 2026-05-18) — Avalonia 12.0.3 bump on the
         net10.0-android36.0 TFM. The Wave 12 11.3.12 pin block is removed
         now that .NET 10 + Android 36 toolchain is available locally. -->
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Android" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- v2.32.0 (2026-05-07) — FileProvider for auto-update APK
         hand-off (Android 7+ requires content:// URIs in cross-app
         intents). Avalonia.Android already pulls in much of AndroidX
         transitively, but Core.Content.FileProvider isn't in the
         transitive set, so we add it explicitly. ~50 KB on top of
         the existing AndroidX surface. -->
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.17.0.2" />
  </ItemGroup>

  <!-- libbox.aar — sing-box gomobile binding. Built locally via:
         cd tools/sing-box-upstream && export ANDROID_NDK_HOME=...
         go run ./cmd/internal/build_libbox -target android
       (Requires SagerNet's gomobile fork at $GOPATH/bin — installed via
       `go install github.com/sagernet/gomobile/cmd/{gomobile,gobind}@latest`.)

       Drop the resulting libbox.aar into VPNRouter.Android/Lib/ and
       uncomment the AndroidLibrary item below. We use Bind="false" to
       skip the ~20 MB Java→C# binding overhead — VpnRouterService.cs
       calls into libbox via raw JNI through the [Register] attributed
       handle in VPNRouter.Core/Platform/Android/AndroidSingBoxRuntime.cs. -->
  <ItemGroup>
    <!-- Bind="false" — skip C# binding generation for libbox.aar's Java
         types. The Mono.Android binding generator triggers a GC-bridge
         abort on libbox's ~80 gomobile-generated proxy classes ("asked
         if a class System.Object is a bridge before we inited
         java.lang.Object"); we work around it by keeping all libbox-
         touching code in Java (VpnRouterService.java) where the
         libbox.aar classpath is consumed natively without any C#
         translation layer. -->
    <AndroidLibrary Include="Lib\libbox.aar" Bind="false" />

    <!-- Bug-AND-023 v2 (2026-05-17) — zxing-android-embedded for live-
         preview QR scanning (replacing the v1 ACTION_IMAGE_CAPTURE photo
         flow which felt off — user had to frame + press shutter + wait
         for ZXing.Net to decode the JPEG, instead of just pointing the
         camera and getting an instant detect like every other Android
         QR-capable app).

         Bind="false" — same rationale as libbox above. We expose the
         scanner through a thin Java bridge (QrScanLauncher.java) which
         is compiled in-tree via <AndroidJavaSource> below. The aar's
         own AndroidManifest declares CaptureActivity so the manifest
         merger picks it up automatically. Core ZXing decoder ships as
         a plain .jar (com.google.zxing:core) that the embedded aar
         depends on at runtime. -->
    <!-- The Android SDK already includes every aar/jar. Update those items;
         Include would add duplicates whose default Bind=true still generates
         the unused managed wrappers. Pack remains true by default. -->
    <AndroidLibrary Update="Lib\zxing-android-embedded-4.3.0.aar" Bind="false" />
    <AndroidLibrary Update="Lib\zxing-core-3.5.3.jar" Bind="false" />
  </ItemGroup>

  <!-- Java service implementation. .NET Android compiles AndroidJavaSource
       items via javac and merges the resulting .class files into the
       APK; the [Service]-attributed C# Java callable wrapper pattern
       isn't needed because this Java class registers itself in
       AndroidManifest.xml directly. -->
  <ItemGroup>
    <AndroidJavaSource Include="VpnRouterService.java" />
    <!-- Bug #1 (2026-05-11) — libbox-backed Deep Verify for the Free
         Configs page. Self-contained Java helper (no VpnRouterService
         dependency) that spins a transient sing-box.Service per config
         to upgrade single-✓ entries to ✓✓ via a real HTTP probe. C#
         side calls verifyConfigSync(...) through reflection from
         AndroidFreeConfigDeepVerifier.cs. -->
    <AndroidJavaSource Include="AndroidDeepVerifyBox.java" />
    <!-- Bug-AND-023 v2 (2026-05-17) — Java bridge over IntentIntegrator
         from zxing-android-embedded. C# side (MainActivity.cs) reaches
         into it via reflection because the aar import uses Bind="false". -->
    <AndroidJavaSource Include="QrScanLauncher.java" />
    <!-- DNS-tunnel (slipstream) JNI binding. Loads libslipstream_jni.so (built
         from Mygod/slipstream-rust + our slipstream-android crate). Gated by a
         runtime dlopen probe (SlipstreamNative.isAvailable) so a build/ABI
         without the .so refuses the dns-tunnel scheme rather than crashing. -->
    <AndroidJavaSource Include="SlipstreamNative.java" />
  </ItemGroup>

  <!-- DNS-tunnel sidecar native lib, per ABI. Bundled in the APK (like libbox,
       NOT pulled — needed precisely when the network is hostile). Built locally
       on the Mac host (cargo-ndk), cached under tools/slipstream-android-cache/
       (gitignored, local-only, same constraint as libbox.aar). Exists-guarded
       so a build without it still produces an APK (dns-tunnel just unavailable). -->
  <ItemGroup>
    <AndroidNativeLibrary
        Condition="Exists('$(MSBuildThisFileDirectory)..\tools\slipstream-android-cache\arm64-v8a\libslipstream_jni.so')"
        Include="$(MSBuildThisFileDirectory)..\tools\slipstream-android-cache\arm64-v8a\libslipstream_jni.so">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>
    <!-- armeabi-v7a + x86_64 libslipstream_jni.so are built + cached under
         tools/slipstream-android-cache/{armeabi-v7a,x86_64}/ but intentionally
         NOT bundled: libbox.aar (sing-box) ships arm64-v8a only, so an APK that
         advertised those ABIs would install on 32-bit/x86 devices and then
         crash on connect (no libbox there). Wire these in only once libbox.aar
         is rebuilt multi-ABI. -->
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- v3.0 Android port — Phase 0 scaffold.
       Cannot build standalone yet (Android SDK not installed on this
       host). Build when SDK is available:
           dotnet build VPNRouter.Android/VPNRouter.Android.csproj \
                  /p:AndroidSdkDirectory=<path>
       Or set $ANDROID_HOME / $ANDROID_SDK_ROOT env var.

       Reference plan: plans/vpnrouter-android-research.md
       Reference issue tracker: TBD on first user-visible Android build.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <!-- libbox.aar requires API 23+ (Android 6.0 Marshmallow). Practically
         universal at this point; KYOCERA A101BM Phase 1.A test runs Android
         12 (API 31). We bumped from 21 → 23 to satisfy libbox's minSdk. -->
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <TargetPlatformVersion>34</TargetPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.ninitux.vpnrouter</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>3.0.0-android-alpha</ApplicationDisplayVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Android-only define so VPNRouter.Core's Android branches compile. -->
    <DefineConstants>$(DefineConstants);PLATFORM_ANDROID</DefineConstants>

    <!-- Android-specific build flags. -->
    <RuntimeIdentifiers>android-arm64;android-arm;android-x64;android-x86</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidSigningKeyStore Condition="'$(Configuration)' == 'Release'">vpnrouter.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias Condition="'$(Configuration)' == 'Release'">vpnrouter</AndroidSigningKeyAlias>
  </PropertyGroup>

  <ItemGroup>
    <!-- VPNRouter.Core needs to be built with Android target enabled. -->
    <ProjectReference Include="..\VPNRouter.Core\VPNRouter.Core.csproj">
      <Properties>EnableAndroidTarget=true</Properties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia for Android. Same version as desktop App. Note:
         Avalonia.Android pulls in System.Net.WebSockets, System.IO.Pipelines,
         and the Mono Android runtime by transitive dependency. -->
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Android" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <!-- libbox.aar — sing-box gomobile binding. Built locally via:
         cd tools/sing-box-upstream && export ANDROID_NDK_HOME=...
         go run ./cmd/internal/build_libbox -target android
       (Requires SagerNet's gomobile fork at $GOPATH/bin — installed via
       `go install github.com/sagernet/gomobile/cmd/{gomobile,gobind}@latest`.)

       Drop the resulting libbox.aar into VPNRouter.Android/Lib/ and
       uncomment the AndroidLibrary item below. We use Bind="false" to
       skip the ~20 MB Java→C# binding overhead — VpnRouterService.cs
       calls into libbox via raw JNI through the [Register] attributed
       handle in VPNRouter.Core/Platform/Android/AndroidSingBoxRuntime.cs. -->
  <ItemGroup>
    <!-- Bind="false" — skip C# binding generation for libbox.aar's Java
         types. Phase 1.B foundation was happy with this; switching to
         Bind="true" mid-Phase-1.C surfaced a Mono GC-bridge abort during
         app init ("asked if a class System.Object is a bridge before we
         inited java.lang.Object"). Phase 1.D will revisit either by
         resolving that crash or by switching to raw JNI calls into
         libbox via Java.Interop.JniEnvironment. -->
    <AndroidLibrary Include="Lib\libbox.aar" Bind="false" />
  </ItemGroup>

  <!-- VpnRouterService.cs lives in this project (compiled directly). The
       legacy VpnRouterService.kt sibling is kept for documentation only —
       it remains outside the build (no <AndroidJavaSource> entry) until
       we add a Kotlin compile step (currently not part of .NET Android
       toolchain). -->
  <ItemGroup>
    <None Include="VpnRouterService.kt" />
  </ItemGroup>

</Project>

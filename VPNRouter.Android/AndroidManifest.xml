<?xml version="1.0" encoding="utf-8"?>
<!--
  VPNRouter Android manifest.

  MainActivity is auto-registered from `[Activity]`; Java services and
  providers live here because they are not generated from C# attributes.

  Reference: plans/vpnrouter-android-research.md §"Required Android
  manifest bits".
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- v3.0 Phase 6.2 — required by ConnectivityManager.requestNetwork
         used in fallback NetworkCallback path on API 28-30. On API 31+
         we use registerBestMatchingNetworkCallback which doesn't need
         this, but keeping for forward/back-compat. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A11 justification (2026-06-15): the per-app split-tunnel picker must
         enumerate ALL installed apps so the user can choose which ones route
         through the VPN. A <queries> element only permits querying a KNOWN, fixed
         set of packages and cannot list arbitrary installed apps, so it is not a
         substitute for a VPN app picker. Distribution is sideload-only (no Play
         policy gate today); if Play distribution is ever pursued this needs a Play
         Console declaration or a <queries>-based narrower fallback that degrades
         the picker. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
                     tools:ignore="QueryAllPackagesPermission" />
    <!-- v2.32.0 (2026-05-07) — auto-update sideload. Lets the app hand
         a downloaded APK to the system PackageInstaller via
         Intent.ActionView. On API 26+ the user must grant this in
         Settings → Apps → VPNRouter → Install unknown apps; we deep-
         link them there from the in-app banner if not yet granted. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- v2.32.0 AND-NETRES (2026-05-07) — partial wake-lock acquired by
         VpnRouterService.acquireConnectWakeLock during the connect-init
         window so a screen-off / Doze device finishes the first dial.
         60-second hard timeout; released when tunnel-up fires or
         start path errors. WAKE_LOCK is a normal-protection-level
         permission (granted at install, no runtime prompt). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- v2.32.0 AND-NETRES (2026-05-07) — needed for the deep-link from
         Settings > Reliability > "Disable battery optimization" button.
         Without this permission the
         Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS intent fails
         silently on Android 6+ (the system's package-installer-style
         dialog won't accept the request). The user still has to confirm
         the prompt manually — we never grant ourselves the exclusion. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- lucid-pike (2026-05-09) — Simple-page QR scan. The user taps the
         "Scan QR" button, we launch MediaStore.ActionImageCapture, and
         decode the resulting JPEG via ZXing.Net so the VLESS / subscription
         text drops into the VPN config TextBox. Camera is android.permission-
         protected on Android 6+, so we ask at runtime via
         ActivityCompat.RequestPermissions before dispatching the intent.
         android:required="false" on the feature flag keeps non-camera
         devices (some emulators, Android TV boxes) able to install — we
         soft-toast on intent failure rather than blocking install. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera"
                  android:required="false" />

    <application android:label="VPNRouter"
                 android:icon="@mipmap/ic_launcher"
                 android:roundIcon="@mipmap/ic_launcher_round"
                 android:allowBackup="false"
                 android:supportsRtl="true">
        <!-- Avalonia MainActivity auto-generated from C# [Activity] attribute. -->
        <!-- Launcher icon (added 2026-05-10) — penguin_logo.png from
             VPNRouter.App/Assets resized to 5 mipmap densities so
             different launchers + screen DPIs pick the right size.
             roundIcon mirrors the same image — Pixel-style adaptive
             round icons can be added later as a separate enhancement. -->

        <!-- VpnRouterService is a Java class (VpnRouterService.java)
             compiled into the APK via <AndroidJavaSource>. Because it's
             not generated from a C# [Service] attribute, we register it
             in this manifest directly. -->
        <service android:name=".VpnRouterService"
                 android:permission="android.permission.BIND_VPN_SERVICE"
                 android:foregroundServiceType="systemExempted"
                 android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- v2.32.0 (2026-05-07) — FileProvider for the auto-update
             sideload. Android 7.0+ rejects file:// URIs in cross-app
             intents (StrictMode FileUriExposedException), so the
             downloaded APK gets handed to the system PackageInstaller
             via a content:// URI minted by androidx.core.content.FileProvider.
             The grantUriPermissions=true + ActivityFlags.GrantReadUriPermission
             at intent-launch time gives the installer transient read
             access without permanently opening the cache directory.

             Authority is "${applicationId}.fileprovider" so the URI
             is namespaced under our package — different VPNRouter
             builds (debug / release / forks) won't clash. Paths are
             defined in res/xml/file_paths.xml. -->
        <provider android:name="androidx.core.content.FileProvider"
                  android:authorities="${applicationId}.fileprovider"
                  android:exported="false"
                  android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                       android:resource="@xml/file_paths" />
        </provider>

        <!-- Bug-AND-023 v3 (2026-05-17) — zxing-android-embedded ships its
             CaptureActivity declared with android:screenOrientation=
             "sensorLandscape" in its bundled AndroidManifest. That hard-
             code forces the QR scanner to launch in landscape regardless
             of the launching activity's orientation, which is exactly the
             "had to flip the phone" UX the tester reported. The Android
             manifest merger lets us override that attribute by re-declaring
             the same activity name with tools:replace; the .class file
             stays in the aar (we don't subclass anything), only the
             manifest entry gets rewritten at merge time.
             "fullSensor" keeps the auto-rotate behaviour of v2 (so users
             holding the phone in any of the 4 orientations get a correctly
             rotated preview) while letting setOrientationLocked(true) at
             runtime pin to whichever orientation the user actually has —
             no more forced landscape kick. -->
        <activity android:name="com.journeyapps.barcodescanner.CaptureActivity"
                  android:screenOrientation="fullSensor"
                  tools:replace="android:screenOrientation" />
    </application>

</manifest>

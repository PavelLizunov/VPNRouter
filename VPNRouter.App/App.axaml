<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VPNRouter.App.App"
             xmlns:local="using:VPNRouter.App"
             xmlns:icons="using:VPNRouter.App.Controls"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://VPNRouter.App/Styles/Tokens.axaml"/>
                <ResourceInclude Source="avares://VPNRouter.App/Styles/ButtonRoles.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="EmojiFlagFont">avares://VPNRouter.App/Assets/Fonts/Twemoji.Mozilla.ttf#Twemoji Mozilla</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#FF0EA5E9"/>
                <ColorPaletteResources x:Key="Dark" Accent="#FF38BDF8"/>
            </FluentTheme.Palettes>
        </FluentTheme>

        <!-- Tab strips (the main tabs and the inner tabs of a page): secondary text when idle, an accent tint on hover
             and the accent role when selected, in both themes through the tokens. -->
        <Style Selector="ListBoxItem.main-tab, ListBoxItem.sub-tab, ListBox.sub-tabs ListBoxItem">
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="ListBoxItem.sub-tab">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="ListBoxItem.main-tab /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem.sub-tab /template/ ContentPresenter#PART_ContentPresenter, ListBox.sub-tabs ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
        </Style>
        <Style Selector="ListBoxItem.main-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem.sub-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.sub-tabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="ListBoxItem.main-tab:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem.sub-tab:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.sub-tabs ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBgMutedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="ListBoxItem.main-tab:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem.sub-tab:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem.main-tab:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem.sub-tab:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem.main-tab:selected:focus /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem.sub-tab:selected:focus /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem.main-tab:selected:focus:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem.sub-tab:selected:focus:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem.main-tab:selected:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem.sub-tab:selected:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.sub-tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.sub-tabs ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.sub-tabs ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter, ListBox.sub-tabs ListBoxItem:selected:focus:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.sub-tabs ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBgMutedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
        </Style>

        <!-- A destructive action that is not the main one: danger text on a danger tint, a stronger tint on hover. -->
        <Style Selector="Button.danger-soft">
            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}"/>
        </Style>
        <Style Selector="Button.danger-soft:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.danger-soft:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}"/>
        </Style>

        <Style Selector="Button.solid:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[Button].Background}"/>
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}"/>
            <Setter Property="Opacity" Value="0.88"/>
        </Style>
        <Style Selector="Button.solid:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[Button].Background}"/>
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}"/>
            <Setter Property="Opacity" Value="0.76"/>
        </Style>

        <Style Selector="Border.disclosure-pill">
            <Setter Property="Padding" Value="10,4,8,4"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.disclosure-pill TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="icons|Pictogram.disclosure">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="icons|Pictogram.disclosure.open">
            <Setter Property="RenderTransform" Value="rotate(180deg)"/>
        </Style>

        <Style Selector="ToggleButton.TabStripPill">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="ToggleButton.TabStripPill:checked">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="ToggleButton.TabStripPill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="ToggleButton.TabStripPill:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="ToggleButton.TabStripPill:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="ToggleButton.TabStripPill:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Application.Styles>
</Application>

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VPNRouter.App.App"
             xmlns:local="using:VPNRouter.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- v2.16.0 Arctic design tokens (Light + Dark via ThemeDictionaries) -->
                <ResourceInclude Source="avares://VPNRouter.App/Styles/Tokens.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- v2.28.6-r7: Twemoji-Mozilla COLR/CPAL emoji font.
                 Windows Segoe UI Emoji renders Regional Indicator pairs
                 (🇩🇪 = U+1F1E9 + U+1F1EA) as letter boxes ("DE") instead
                 of country flags. Mac and Linux do render proper colored
                 flags via Apple Color Emoji / Noto Color Emoji. Embedding
                 Twemoji-Mozilla (~1.4 MB COLR-format) gives Avalonia /
                 Skia a font with proper colored flag glyphs that works
                 identically across all three OSes.
                 License: MIT (Mozilla / Twitter Twemoji).
                 Source: https://github.com/mozilla/twemoji-colr -->
            <FontFamily x:Key="EmojiFlagFont">avares://VPNRouter.App/Assets/Fonts/Twemoji.Mozilla.ttf#Twemoji Mozilla</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- v2.37.0-r31: ToggleButton styled as underline tab. Used by
             DpiBypassPage + TelegramPage sub-tab strips. No radio glyph
             (RadioButton in r29 looked like settings options per user
             feedback). Inactive: muted text. Active: accent underline +
             bolder text. Matches the main app's top tabs visual. -->
        <Style Selector="ToggleButton.TabStripPill">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="ToggleButton.TabStripPill:checked">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="ToggleButton.TabStripPill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="ToggleButton.TabStripPill:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Application.Styles>
</Application>

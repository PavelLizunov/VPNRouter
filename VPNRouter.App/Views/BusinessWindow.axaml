<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VPNRouter.App.ViewModels"
        xmlns:business="using:VPNRouter.App.ViewModels.Internals"
        xmlns:loc="using:VPNRouter.Core.Localization"
        xmlns:icons="using:VPNRouter.App.Controls"
        x:Class="VPNRouter.App.Views.BusinessWindow"
        x:Name="BusinessWindowRoot"
        x:DataType="vm:MainWindowViewModel"
        Title="VPNRouter Business" Width="420" Height="500" MinWidth="340" MinHeight="480"
        Background="{DynamicResource SurfaceAppBrush}"
        Icon="avares://VPNRouter.App/Assets/penguin_mascot.ico">
    <Window.Styles>
        <Style Selector="Button.menu-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.menu-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
        </Style>
        <Style Selector="Border.menu-divider">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="Margin" Value="4,4"/>
        </Style>
        <Style Selector="FlyoutPresenter.naked">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Ellipse.business-health-dot">
            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
        </Style>
        <Style Selector="Ellipse.business-health-dot.good">
            <Setter Property="Fill" Value="{DynamicResource SuccessSolidBrush}"/>
        </Style>
        <Style Selector="Ellipse.business-health-dot.warning">
            <Setter Property="Fill" Value="{DynamicResource WarningSolidBrush}"/>
        </Style>
        <Style Selector="Ellipse.business-health-dot.bad">
            <Setter Property="Fill" Value="{DynamicResource DangerSolidBrush}"/>
        </Style>
        <Style Selector="Border.business-activity-bar">
            <Setter Property="Background" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <Style Selector="Border.business-activity-bar.low">
            <Setter Property="Background" Value="{DynamicResource SuccessSolidBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Border.business-activity-bar.medium">
            <Setter Property="Background" Value="{DynamicResource WarningSolidBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Border.business-activity-bar.high">
            <Setter Property="Background" Value="{DynamicResource DangerSolidBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </Window.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Spacing="12" MaxWidth="400" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Image Source="{Binding LogoSource}" Width="36" Height="36" Stretch="Uniform"
                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                <TextBlock Grid.Column="1" Text="VPNRouter Business" FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="2" x:Name="BusinessMenuButton" Width="28" Height="28" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="{StaticResource RadiusSm}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        VerticalAlignment="Center" HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip.Tip="{Binding #BusinessWindowRoot.Texts.Menu}"
                        AutomationProperties.AutomationId="BusinessMenuButton"
                        AutomationProperties.Name="{Binding #BusinessWindowRoot.Texts.Menu}">
                    <icons:Pictogram Id="more-horizontal" Width="18" Height="18">
                        <icons:Pictogram.RenderTransform>
                            <RotateTransform Angle="90"/>
                        </icons:Pictogram.RenderTransform>
                    </icons:Pictogram>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight"
                                ShowMode="TransientWithDismissOnPointerMoveAway"
                                FlyoutPresenterClasses="naked">
                            <Border Width="280" DataContext="{Binding #BusinessWindowRoot.DataContext}"
                                    Background="{DynamicResource SurfaceBaseBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}" Padding="6">
                                <ScrollViewer x:Name="BusinessMenuScroll" MaxHeight="360"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="1">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="8,6">
                                            <TextBlock Text="{Binding #BusinessWindowRoot.Texts.Language}" FontSize="11"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" x:Name="BusinessLanguageSelector" MinWidth="110"
                                                      SelectionChanged="OnBusinessLanguageChanged"
                                                      ToolTip.Tip="{Binding #BusinessWindowRoot.Texts.Language}"
                                                      AutomationProperties.AutomationId="BusinessLanguageSelector"
                                                      AutomationProperties.Name="{Binding #BusinessWindowRoot.Texts.Language}">
                                                <ComboBoxItem Tag="ru" Content="{x:Static loc:Strings.BusinessRussian}"/>
                                                <ComboBoxItem Tag="en" Content="{x:Static loc:Strings.BusinessEnglish}"/>
                                            </ComboBox>
                                        </Grid>
                                        <Border Classes="menu-divider"/>
                                        <Border x:Name="BusinessActions" x:DataType="business:BusinessServicesViewModel">
                                            <StackPanel Spacing="1">
                                                <Button Classes="menu-item" Content="{Binding #BusinessWindowRoot.Texts.DiagnosticsSend}"
                                                        Command="{Binding SendCommand}" AutomationProperties.AutomationId="BusinessDiagnosticsSend"
                                                        ToolTip.Tip="{Binding #BusinessWindowRoot.Texts.DiagnosticsHint}"/>
                                                <Button Classes="menu-item" Content="{Binding #BusinessWindowRoot.Texts.DiagnosticsCollect}"
                                                        Command="{Binding CollectCommand}" AutomationProperties.AutomationId="BusinessDiagnosticsCollect"/>
                                                <TextBlock Text="{Binding DiagnosticStatus}" IsVisible="{Binding IsDiagnosticStatusVisible}"
                                                           TextWrapping="Wrap" FontSize="12" Margin="10,4"
                                                           AutomationProperties.AutomationId="BusinessDiagnosticsStatus"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <ProgressBar IsIndeterminate="True" Height="3" Margin="10,4"
                                                             IsVisible="{Binding IsDiagnosticBusy}"/>
                                                <Button Classes="menu-item" Content="{Binding #BusinessWindowRoot.Texts.DiagnosticsCancel}"
                                                        Command="{Binding CancelDiagnosticCommand}" IsVisible="{Binding IsDiagnosticBusy}"
                                                        AutomationProperties.AutomationId="BusinessDiagnosticsCancel"/>
                                                <Button Classes="menu-item" Content="{Binding #BusinessWindowRoot.Texts.DiagnosticsOpen}"
                                                        Command="{Binding OpenReportCommand}" IsVisible="{Binding HasReport}"
                                                        AutomationProperties.AutomationId="BusinessDiagnosticsOpen"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="menu-divider"/>
                                        <Border>
                                            <Button Classes="menu-item" Content="{Binding UpdateVm.CheckLinkText}"
                                                    Command="{Binding UpdateVm.CheckManuallyCommand}" IsEnabled="{Binding UpdateVm.CanCheckUpdates}"
                                                    AutomationProperties.AutomationId="BusinessUpdateCheck"/>
                                        </Border>
                                        <Border Classes="menu-divider"/>
                                        <Button x:Name="BusinessServerRefresh" Classes="menu-item"
                                                Content="{Binding #BusinessWindowRoot.Texts.ServerRefresh}"
                                                Click="OnBusinessServerRefresh"
                                                IsEnabled="{Binding !IsConnecting}"
                                                AutomationProperties.AutomationId="BusinessServerRefresh"/>
                                        <StackPanel x:Name="BusinessSubscriptionActions" x:DataType="business:BusinessServicesViewModel" Spacing="1">
                                            <Button Classes="menu-item" Content="{Binding #BusinessWindowRoot.Texts.UpdateServers}"
                                                    Command="{Binding RefreshListCommand}" AutomationProperties.AutomationId="BusinessSubscriptionRefresh"/>
                                            <TextBlock Text="{Binding RefreshStatus}" IsVisible="{Binding IsRefreshStatusVisible}"
                                                       TextWrapping="Wrap" FontSize="12" Margin="10,4"
                                                       AutomationProperties.AutomationId="BusinessSubscriptionStatus"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <Border IsVisible="{Binding UpdateVm.IsVisible}" Padding="10"
                    Background="{DynamicResource SurfaceBaseBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    AutomationProperties.AutomationId="BusinessUpdateNotice">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding UpdateVm.Message}" TextWrapping="Wrap" FontSize="12"/>
                    <ProgressBar Height="3" Value="{Binding UpdateVm.DownloadProgress}" IsVisible="{Binding UpdateVm.IsDownloading}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !UpdateVm.IsDownloading}">
                        <Button Content="{Binding #BusinessWindowRoot.Texts.InstallUpdate}" Command="{Binding UpdateVm.DownloadAndApplyCommand}"
                                AutomationProperties.AutomationId="BusinessUpdateInstall"/>
                        <Button Content="{Binding #BusinessWindowRoot.Texts.LaterUpdate}" Command="{Binding UpdateVm.DismissCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding #BusinessWindowRoot.Texts.ConnectionStatus}" TextWrapping="Wrap" TextAlignment="Center"
                       MinHeight="24" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Border IsEnabled="{Binding !UpdateVm.IsDownloading}">
            <Button Command="{Binding ToggleConnectionCommand}" IsEnabled="{Binding !IsConnecting}"
                    Classes="solid" MinHeight="48" CornerRadius="{StaticResource RadiusPill}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentOnSolidBrush}"
                    AutomationProperties.Name="{Binding #BusinessWindowRoot.Texts.ConnectButton}">
                <TextBlock Text="{Binding #BusinessWindowRoot.Texts.ConnectButton}" FontSize="18" VerticalAlignment="Center"/>
            </Button>
            </Border>
            <StackPanel Spacing="8" IsEnabled="{Binding !IsConnected}">
                <TextBlock Text="{Binding #BusinessWindowRoot.Texts.Server}"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox x:Name="BusinessServerSelector" SelectionChanged="OnBusinessServerSelectionChanged"
                          IsEnabled="{Binding !IsConnecting}" MinHeight="56"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          AutomationProperties.AutomationId="BusinessServerSelector"
                          AutomationProperties.Name="{Binding #BusinessWindowRoot.Texts.Server}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="business:BusinessServerChoiceViewModel">
                            <Grid ColumnDefinitions="12,24,*,Auto" ColumnSpacing="6" ToolTip.Tip="{Binding StatusText}">
                                <Ellipse Classes="business-health-dot" Width="8" Height="8"
                                         Classes.good="{Binding IsGood}" Classes.warning="{Binding IsWarning}"
                                         Classes.bad="{Binding IsBad}" VerticalAlignment="Center"/>
                                <Image Grid.Column="1" Source="{Binding CountryFlag}" Width="24" Height="16"
                                       IsVisible="{Binding HasCountry}" VerticalAlignment="Center" ToolTip.Tip="{Binding CountryName}"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}"/>
                                    <TextBlock Text="{Binding CountryName}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" IsVisible="{Binding HasMetadata}"
                                          ToolTip.Tip="{Binding MetricsHint}">
                                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Height="10">
                                            <Border Classes="business-activity-bar" Width="3" Height="4" VerticalAlignment="Bottom"
                                                    Classes.low="{Binding IsActivityLow}" Classes.medium="{Binding IsActivityMedium}"
                                                    Classes.high="{Binding IsActivityHigh}"/>
                                            <Border Classes="business-activity-bar" Width="3" Height="7" VerticalAlignment="Bottom"
                                                    Classes.medium="{Binding IsActivityMedium}" Classes.high="{Binding IsActivityHigh}"/>
                                            <Border Classes="business-activity-bar" Width="3" Height="10" VerticalAlignment="Bottom"
                                                    Classes.high="{Binding IsActivityHigh}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding MetricsText}" FontSize="10"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding PingText}" FontSize="12"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <Border Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusXl}" Padding="12">
                <StackPanel Spacing="12" IsEnabled="{Binding !IsConnected}">
                    <RadioButton GroupName="BusinessMode" IsChecked="{Binding IsSplitTunnel}" IsEnabled="{Binding !IsConnecting}">
                        <TextBlock Text="{Binding #BusinessWindowRoot.Texts.Split}" TextWrapping="Wrap"/>
                    </RadioButton>
                    <RadioButton GroupName="BusinessMode" IsChecked="{Binding !IsSplitTunnel, Mode=OneWay}" IsEnabled="{Binding !IsConnecting}">
                        <TextBlock Text="{Binding #BusinessWindowRoot.Texts.FullCompact}" TextWrapping="Wrap"/>
                    </RadioButton>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>

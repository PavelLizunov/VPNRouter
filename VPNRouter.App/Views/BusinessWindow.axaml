<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VPNRouter.App.ViewModels"
        xmlns:business="using:VPNRouter.App.ViewModels.Internals"
        xmlns:loc="using:VPNRouter.Core.Localization"
        xmlns:icons="using:VPNRouter.App.Controls"
        x:Class="VPNRouter.App.Views.BusinessWindow"
        x:Name="BusinessWindowRoot" KeyDown="OnBusinessKeyDown"
        x:DataType="vm:MainWindowViewModel"
        Title="VPNRouter Business" Width="420" Height="500" MinWidth="340" MinHeight="480"
        Background="{DynamicResource SurfaceAppBrush}"
        Icon="avares://VPNRouter.App/Assets/penguin_mascot.ico">
    <Window.Styles>
        <Style Selector="Button.menu-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.menu-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
        </Style>
        <Style Selector="Button.home-setting">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
        </Style>
        <Style Selector="Button.home-setting:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
        </Style>
        <Style Selector="icons|Pictogram.setting-chevron">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="icons|Pictogram.setting-chevron.expanded">
            <Setter Property="RenderTransform" Value="rotate(180deg)"/>
        </Style>
        <Style Selector="Border.menu-divider">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="Margin" Value="4,4"/>
        </Style>
        <Style Selector="FlyoutPresenter.naked">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Ellipse.business-health-dot">
            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
        </Style>
        <Style Selector="Ellipse.business-health-dot.good">
            <Setter Property="Fill" Value="{DynamicResource SuccessSolidBrush}"/>
        </Style>
        <Style Selector="Ellipse.business-health-dot.warning">
            <Setter Property="Fill" Value="{DynamicResource WarningSolidBrush}"/>
        </Style>
        <Style Selector="Ellipse.business-health-dot.bad">
            <Setter Property="Fill" Value="{DynamicResource DangerSolidBrush}"/>
        </Style>
        <Style Selector="TextBlock.setting-summary">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.setting-summary.active-tag">
            <Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.setting-summary.warn-tag">
            <Setter Property="Foreground" Value="{DynamicResource WarningFgBrush}"/>
        </Style>
        <Style Selector="Border.load-seg">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
            <Setter Property="Background" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Border.load-seg.low">
            <Setter Property="Background" Value="{DynamicResource SuccessSolidBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Border.load-seg.medium">
            <Setter Property="Background" Value="{DynamicResource WarningSolidBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Border.load-seg.high">
            <Setter Property="Background" Value="{DynamicResource DangerSolidBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.solid">
            <Setter Property="Background" Value="{DynamicResource AccentSolidBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentOnSolidBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.business-ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.business-ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.business-outline">
            <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.business-outline:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
        </Style>
        <Style Selector="Button.business-cta.business-outline:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}"/>
        </Style>
        <Style Selector="Button.business-tonal">
            <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.business-tonal:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBgMutedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
        </Style>
        <Style Selector="Button.business-warning-action">
            <Setter Property="Background" Value="{DynamicResource WarningActionSolidBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WarningActionOnSolidBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.business-warning-action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WarningActionSolidHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WarningActionOnSolidBrush}"/>
        </Style>
        <Style Selector="Border.business-status">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        </Style>
        <Style Selector="Border.business-status.connected">
            <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}"/>
        </Style>
        <Style Selector="Border.business-status.busy">
            <Setter Property="Background" Value="{DynamicResource InfoBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InfoBorderBrush}"/>
        </Style>
        <Style Selector="Border.business-status.error">
            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
        </Style>
        <Style Selector="Ellipse.business-status-dot">
            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
        </Style>
        <Style Selector="Border.business-status.connected Ellipse.business-status-dot">
            <Setter Property="Fill" Value="{DynamicResource SuccessSolidBrush}"/>
        </Style>
        <Style Selector="Border.business-status.busy Ellipse.business-status-dot">
            <Setter Property="Fill" Value="{DynamicResource InfoSolidBrush}"/>
        </Style>
        <Style Selector="Border.business-status.error Ellipse.business-status-dot">
            <Setter Property="Fill" Value="{DynamicResource DangerSolidBrush}"/>
        </Style>
        <Style Selector="Border.business-status.error TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}"/>
        </Style>
        <Style Selector="Border.business-status.connected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/>
        </Style>
        <Style Selector="Border.business-status.busy TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InfoFgBrush}"/>
        </Style>
        <Style Selector="Border.business-policy">
            <Setter Property="Background" Value="{DynamicResource WarningBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}"/>
        </Style>
        <Style Selector="Border.business-policy TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningFgBrush}"/>
        </Style>
        <Style Selector="Border.business-policy.applying">
            <Setter Property="Background" Value="{DynamicResource InfoBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InfoBorderBrush}"/>
        </Style>
        <Style Selector="Border.business-policy.applying TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InfoFgBrush}"/>
        </Style>
        <Style Selector="Border.business-policy.danger">
            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
        </Style>
        <Style Selector="Border.business-policy.danger TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}"/>
        </Style>
        <Style Selector="Border.business-repair">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        </Style>
        <Style Selector="Border.business-repair.error">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
        </Style>
        <Style Selector="Border.business-repair.receipt">
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}"/>
        </Style>
        <Style Selector="Border.business-repair.error TextBlock.repair-heading">
            <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}"/>
        </Style>
        <Style Selector="Border.repair-advice">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="Border.business-repair.receipt TextBlock.repair-heading">
            <Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/>
        </Style>
    </Window.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,18,20,20" Spacing="12" MaxWidth="400" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="32,*,32" ColumnSpacing="10">
                <Image x:Name="BusinessHeaderLogo" Source="{Binding LogoSource}"
                       Width="32" Height="32" Stretch="Uniform"
                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                <TextBlock Grid.Column="1" Text="{Binding AppVersionShortText, StringFormat='VPNRouter Business {0}'}"
                           AutomationProperties.AutomationId="BusinessProductVersion" FontSize="15" FontWeight="SemiBold"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="2" x:Name="BusinessMenuButton" Classes="business-ghost" Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="{StaticResource RadiusSm}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        VerticalAlignment="Center" HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip.Tip="{Binding #BusinessWindowRoot.Texts.Menu}"
                        AutomationProperties.AutomationId="BusinessMenuButton"
                        AutomationProperties.Name="{Binding #BusinessWindowRoot.Texts.Menu}">
                    <icons:Pictogram Id="more-horizontal" Width="18" Height="18">
                        <icons:Pictogram.RenderTransform>
                            <RotateTransform Angle="90"/>
                        </icons:Pictogram.RenderTransform>
                    </icons:Pictogram>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight"
                                ShowMode="Standard"
                                FlyoutPresenterClasses="naked">
                            <Border Width="284" DataContext="{Binding #BusinessWindowRoot.DataContext}"
                                    Background="{DynamicResource SurfaceBaseBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}" Padding="6">
                                <ScrollViewer x:Name="BusinessMenuScroll" MaxHeight="420"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="1">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="8,6">
                                            <TextBlock Text="{Binding #BusinessWindowRoot.Texts.Language}" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" x:Name="BusinessLanguageSelector" MinWidth="110"
                                                      SelectionChanged="OnBusinessLanguageChanged"
                                                      ToolTip.Tip="{Binding #BusinessWindowRoot.Texts.Language}"
                                                      AutomationProperties.AutomationId="BusinessLanguageSelector"
                                                      AutomationProperties.Name="{Binding #BusinessWindowRoot.Texts.Language}">
                                                <ComboBoxItem Tag="ru" Content="{x:Static loc:Strings.BusinessRussian}"/>
                                                <ComboBoxItem Tag="en" Content="{x:Static loc:Strings.BusinessEnglish}"/>
                                            </ComboBox>
                                        </Grid>
                                        <Border Classes="menu-divider"/>
                                        <StackPanel x:Name="BusinessSubscriptionActions" x:DataType="business:BusinessServicesViewModel" Spacing="1">
                                            <Button Classes="menu-item" Content="{Binding #BusinessWindowRoot.Texts.UpdateServers}"
                                                    Command="{Binding RefreshListCommand}" AutomationProperties.AutomationId="BusinessSubscriptionRefresh"/>
                                            <TextBlock Text="{Binding RefreshStatus}" IsVisible="{Binding IsRefreshStatusVisible}"
                                                       TextWrapping="Wrap" FontSize="12" Margin="10,4"
                                                       AutomationProperties.AutomationId="BusinessSubscriptionStatus"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Border Classes="menu-divider"/>
                                        <Border x:Name="BusinessActions" x:DataType="business:BusinessServicesViewModel">
                                            <StackPanel Spacing="1">
                                                <Button Classes="menu-item" Content="{Binding #BusinessWindowRoot.Texts.DiagnosticsSend}"
                                                        Command="{Binding SendCommand}" Click="OnBusinessDiagnosticMenuClick"
                                                        AutomationProperties.AutomationId="BusinessDiagnosticsSend"
                                                        ToolTip.Tip="{Binding #BusinessWindowRoot.Texts.DiagnosticsHint}"/>
                                                <Button Classes="menu-item" Content="{Binding #BusinessWindowRoot.Texts.DiagnosticsCollect}"
                                                        Command="{Binding CollectCommand}" AutomationProperties.AutomationId="BusinessDiagnosticsCollect"/>
                                                <TextBlock Text="{Binding DiagnosticStatus}" IsVisible="{Binding IsDiagnosticStatusVisible}"
                                                           TextWrapping="Wrap" FontSize="12" Margin="10,4"
                                                           AutomationProperties.AutomationId="BusinessDiagnosticsStatus"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <ProgressBar IsIndeterminate="True" Height="3" MinHeight="3" Margin="10,4"
                                                             Foreground="{DynamicResource AccentSolidBrush}"
                                                             IsVisible="{Binding IsDiagnosticBusy}"/>
                                                <Button Classes="menu-item" Content="{Binding #BusinessWindowRoot.Texts.DiagnosticsCancel}"
                                                        Command="{Binding CancelDiagnosticCommand}" IsVisible="{Binding IsDiagnosticBusy}"
                                                        AutomationProperties.AutomationId="BusinessDiagnosticsCancel"/>
                                                <Button Classes="menu-item" Content="{Binding #BusinessWindowRoot.Texts.DiagnosticsOpen}"
                                                        Command="{Binding OpenReportCommand}" IsVisible="{Binding HasReport}"
                                                        AutomationProperties.AutomationId="BusinessDiagnosticsOpen"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="menu-divider"/>
                                        <StackPanel Spacing="4" IsEnabled="{Binding !UpdateVm.IsDownloading}">
                                            <Button Classes="menu-item" Content="{Binding UpdateVm.CheckLinkText}"
                                                    Command="{Binding UpdateVm.CheckManuallyCommand}" IsEnabled="{Binding UpdateVm.CanCheckUpdates}"
                                                    AutomationProperties.AutomationId="BusinessUpdateCheck"/>
                                            <Button Classes="menu-item" Content="{Binding UpdateVm.VersionHistoryButtonText}"
                                                    Command="{Binding UpdateVm.ToggleVersionHistoryCommand}" IsEnabled="{Binding UpdateVm.CanCheckUpdates}"
                                                    AutomationProperties.AutomationId="BusinessVersionHistory"/>
                                            <Border x:Name="BusinessVersionHistoryPanel" IsVisible="{Binding UpdateVm.IsVersionHistoryVisible}" Padding="8"
                                                    Background="{DynamicResource SurfaceSunkenBrush}"
                                                    CornerRadius="{StaticResource RadiusSm}"
                                                    AutomationProperties.AutomationId="BusinessVersionHistoryPanel">
                                                <StackPanel Spacing="7">
                                                    <TextBlock Text="{Binding UpdateVm.VersionHistoryMessage}" TextWrapping="Wrap" FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <ItemsControl ItemsSource="{Binding UpdateVm.StableVersions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:RollbackReleaseItemViewModel">
                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                                                                    <TextBlock Text="{Binding DisplayVersion}" VerticalAlignment="Center" FontSize="12"/>
                                                                    <Button Grid.Column="1" Command="{Binding SelectCommand}" IsEnabled="{Binding !IsInstalled}"
                                                                            Padding="8,4" MinHeight="0" FontSize="11"
                                                                            AutomationProperties.AutomationId="BusinessRollbackSelect">
                                                                        <TextBlock Text="{Binding StateText}" TextWrapping="Wrap"/>
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border x:Name="BusinessRollbackConfirmPanel" IsVisible="{Binding UpdateVm.IsRollbackConfirmationVisible}" Padding="8"
                                                            Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningBorderBrush}"
                                                            BorderThickness="1" CornerRadius="{StaticResource RadiusSm}">
                                                        <StackPanel Spacing="7">
                                                            <TextBlock Text="{Binding UpdateVm.RollbackConfirmationText}" TextWrapping="Wrap" FontSize="11"
                                                                       Foreground="{DynamicResource WarningFgBrush}"/>
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                <Button Classes="business-warning-action" Command="{Binding UpdateVm.ConfirmRollbackCommand}"
                                                                        MinHeight="0" Padding="8,5" HorizontalAlignment="Stretch"
                                                                        AutomationProperties.AutomationId="BusinessRollbackConfirm">
                                                                    <TextBlock Text="{Binding UpdateVm.ConfirmRollbackText}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"/>
                                                                </Button>
                                                                <Button Grid.Column="1" Classes="business-ghost" Command="{Binding UpdateVm.CancelRollbackCommand}"
                                                                        MinHeight="0" Padding="8,5" AutomationProperties.AutomationId="BusinessRollbackCancel">
                                                                    <TextBlock Text="{Binding UpdateVm.CancelRollbackText}" FontSize="12"/>
                                                                </Button>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <Border IsVisible="{Binding UpdateVm.IsVisible}" Padding="10"
                    Background="{DynamicResource SurfaceBaseBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    AutomationProperties.AutomationId="BusinessUpdateNotice">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding UpdateVm.Message}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{Binding #BusinessWindowRoot.Texts.UpdateStopNote}" TextWrapping="Wrap"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding !UpdateVm.IsDownloading}"/>
                    <ProgressBar Height="3" MinHeight="3" Value="{Binding UpdateVm.DownloadProgress}"
                                 IsIndeterminate="{Binding UpdateVm.IsDownloadProgressIndeterminate}"
                                 Foreground="{DynamicResource AccentSolidBrush}"
                                 IsVisible="{Binding UpdateVm.IsDownloading}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !UpdateVm.IsDownloading}">
                        <Button Classes="solid" Content="{Binding #BusinessWindowRoot.Texts.InstallUpdate}" Command="{Binding UpdateVm.DownloadAndApplyCommand}"
                                AutomationProperties.AutomationId="BusinessUpdateInstall"/>
                        <Button Classes="business-ghost" Content="{Binding #BusinessWindowRoot.Texts.LaterUpdate}" Command="{Binding UpdateVm.DismissCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel Spacing="8">
                <Border x:Name="BusinessStatusPill" Classes="business-status" Classes.connected="{Binding IsConnected}"
                        Classes.busy="{Binding #BusinessWindowRoot.Texts.IsConnectionBusy}"
                        Classes.error="{Binding #BusinessWindowRoot.Texts.IsConnectionFailure}"
                        Padding="10,5" BorderThickness="1" HorizontalAlignment="Center"
                        CornerRadius="{StaticResource RadiusPill}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                        <Ellipse Classes="business-status-dot" Width="8" Height="8" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" AutomationProperties.AutomationId="BusinessConnectionStatus"
                                   Text="{Binding #BusinessWindowRoot.Texts.ConnectionStatus}"
                                   TextWrapping="Wrap" TextAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </Grid>
                </Border>
                <Border IsVisible="{Binding #BusinessWindowRoot.Texts.HasPolicyStatus}"
                        Classes="business-policy" Classes.danger="{Binding #BusinessWindowRoot.Texts.IsPolicyDanger}"
                        Classes.applying="{Binding #BusinessWindowRoot.Texts.IsPolicyApplying}"
                        Padding="10,7" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}">
                    <TextBlock Text="{Binding #BusinessWindowRoot.Texts.PolicyStatus}" TextWrapping="Wrap" FontSize="12"
                               AutomationProperties.AutomationId="BusinessPolicyStatus" AutomationProperties.LiveSetting="Polite"/>
                </Border>
            </StackPanel>
            <Border IsEnabled="{Binding !UpdateVm.IsDownloading}">
                <Button x:Name="BusinessConnectButton" Classes="business-cta" Command="{Binding ToggleConnectionCommand}"
                        IsEnabled="{Binding #BusinessWindowRoot.Texts.CanToggleConnection}"
                        Classes.solid="{Binding !IsConnected}" Classes.business-outline="{Binding IsConnected}"
                        MinHeight="48" CornerRadius="{StaticResource RadiusPill}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        AutomationProperties.Name="{Binding #BusinessWindowRoot.Texts.ConnectButton}">
                    <TextBlock Text="{Binding #BusinessWindowRoot.Texts.ConnectButton}" FontSize="16"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Button>
            </Border>
            <StackPanel x:Name="BusinessRepairActions" x:DataType="business:BusinessServicesViewModel" Spacing="6">
                <Button x:Name="BusinessRepairButton" Command="{Binding OpenRepairCommand}"
                        Classes.business-ghost="{Binding #BusinessWindowRoot.Texts.IsConnectionHealthy}"
                        Classes.business-outline="{Binding #BusinessWindowRoot.Texts.IsConnectionFailure}"
                        Click="OnBusinessRepairClick" Content="{Binding #BusinessWindowRoot.Texts.RepairTitle}"
                        IsVisible="{Binding !IsRepairOpen}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        AutomationProperties.AutomationId="BusinessRepairOpen"/>
                <Border Classes="business-repair" Classes.error="{Binding IsRepairError}"
                        Classes.receipt="{Binding IsRepairReceipt}"
                        IsVisible="{Binding IsRepairOpen}" BorderThickness="1"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        CornerRadius="{StaticResource RadiusMd}" Padding="12,9">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <Panel VerticalAlignment="Center">
                                    <icons:Pictogram Id="warning" Width="16" Height="16" IsVisible="{Binding IsRepairError}"
                                                     Foreground="{DynamicResource DangerFgBrush}"/>
                                    <icons:Pictogram Id="check" Width="16" Height="16" IsVisible="{Binding IsRepairReceipt}"
                                                     Foreground="{DynamicResource SuccessFgBrush}"/>
                                </Panel>
                                <TextBlock Grid.Column="1" Classes="repair-heading" Text="{Binding RepairHeading}"
                                           FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                                           AutomationProperties.LiveSetting="Polite"/>
                            </Grid>
                            <Button Grid.Column="1" x:Name="BusinessRepairCloseButton" Classes="business-ghost" Width="32" Height="32" Padding="0"
                                    IsVisible="{Binding ShowRepairHeaderClose}"
                                    Command="{Binding CloseRepairCommand}" ToolTip.Tip="{Binding RepairDismissText}"
                                    AutomationProperties.Name="{Binding RepairDismissText}"
                                    AutomationProperties.AutomationId="BusinessRepairClose">
                                <icons:Pictogram Id="close" Width="15" Height="15"/>
                            </Button>
                        </Grid>
                        <ProgressBar Height="3" MinHeight="3" IsIndeterminate="True"
                                     Foreground="{DynamicResource AccentSolidBrush}"
                                     IsVisible="{Binding IsRepairBusy}"/>
                        <Border Classes.repair-advice="{Binding HasRepairAdvice}">
                            <TextBlock Text="{Binding RepairBody}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.AutomationId="BusinessRepairAnalysis"/>
                        </Border>
                        <TextBlock Text="{Binding RepairResendNote}" IsVisible="{Binding HasRepairResendNote}"
                                   TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource WarningFgBrush}"/>
                        <TextBlock Text="{Binding RepairAdviceFooter}" IsVisible="{Binding HasRepairAdvice}"
                                   TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <WrapPanel ItemSpacing="4" LineSpacing="4">
                            <Button Classes="business-tonal" Command="{Binding RepairPrimaryCommand}" Click="OnBusinessRepairActionClick"
                                    IsVisible="{Binding HasRepairPrimaryAction}"
                                    AutomationProperties.AutomationId="BusinessRepairAnalyze">
                                <TextBlock Text="{Binding RepairActionText}" TextWrapping="Wrap"/>
                            </Button>
                            <Button Classes="business-ghost" Command="{Binding RetryRepairSearchCommand}"
                                    Click="OnBusinessRepairActionClick" IsVisible="{Binding HasRepairRetrySearchAction}"
                                    AutomationProperties.AutomationId="BusinessRepairRetrySearch">
                                <TextBlock Text="{Binding RepairRetrySearchText}" TextWrapping="Wrap"/>
                            </Button>
                            <Button x:Name="BusinessRepairDismiss" Classes="business-ghost" Content="{Binding RepairDismissText}"
                                    IsVisible="{Binding ShowRepairBottomDismiss}"
                                    AutomationProperties.AutomationId="BusinessRepairDismiss"
                                    Command="{Binding CloseRepairCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Button Classes="business-ghost" Command="{Binding ReopenDeliveredReceiptCommand}"
                        IsVisible="{Binding HasDeliveredReceiptBadge}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        FontSize="11" Padding="8,4"
                        AutomationProperties.AutomationId="BusinessRepairReceiptBadge">
                    <TextBlock Text="{Binding DeliveredReceiptBadgeText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource SuccessFgBrush}"/>
                </Button>
            </StackPanel>
            <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                    Background="{DynamicResource SurfaceBaseBrush}" CornerRadius="{StaticResource RadiusMd}">
                <StackPanel>
                    <Button x:Name="BusinessServerMenuButton" Classes="home-setting"
                            Click="OnBusinessServerMenuToggle"
                            AutomationProperties.AutomationId="BusinessServerMenu"
                            AutomationProperties.Name="{Binding #BusinessWindowRoot.Texts.ServerMenu}"
                            AutomationProperties.ItemStatus="{Binding #BusinessWindowRoot.Texts.ServerSummary}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock VerticalAlignment="Center" Text="{Binding #BusinessWindowRoot.Texts.ServerMenu}"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right"
                                       Classes="setting-summary"
                                       Classes.active-tag="{Binding #BusinessWindowRoot.Texts.IsServerSummaryActive}"
                                       Classes.warn-tag="{Binding #BusinessWindowRoot.Texts.IsServerSummaryWarning}"
                                       TextTrimming="CharacterEllipsis" FontSize="12"
                                       Text="{Binding #BusinessWindowRoot.Texts.ServerSummary}"
                                       ToolTip.Tip="{Binding #BusinessWindowRoot.Texts.ServerSummary}"
                                       AutomationProperties.AutomationId="BusinessServerSummary"/>
                            <icons:Pictogram Grid.Column="2" Id="chevron-down" Classes="setting-chevron"
                                             Classes.expanded="{Binding #BusinessServerPanel.IsVisible}"/>
                        </Grid>
                    </Button>
                    <Border x:Name="BusinessServerPanel" IsVisible="False" Padding="10,8"
                            Background="{DynamicResource SurfaceSunkenBrush}">
                        <StackPanel Spacing="7">
                            <TextBlock IsVisible="{Binding IsConnected}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding #BusinessWindowRoot.Texts.ServerLocked}"/>
                            <StackPanel Spacing="7" IsEnabled="{Binding #BusinessWindowRoot.Texts.CanToggleConnection}">
                                <StackPanel Spacing="7" IsEnabled="{Binding !IsConnected}">
                                    <CheckBox IsChecked="{Binding #BusinessWindowRoot.Texts.AutoSelectEnabled, Mode=TwoWay}"
                                              MinHeight="0" Padding="4,0" ToolTip.Tip="{Binding #BusinessWindowRoot.Texts.AutoSelectHint}"
                                              AutomationProperties.AutomationId="BusinessAutoSelect"
                                              AutomationProperties.Name="{Binding #BusinessWindowRoot.Texts.AutoSelect}">
                                        <TextBlock Text="{Binding #BusinessWindowRoot.Texts.AutoSelect}" TextWrapping="Wrap" FontSize="12"/>
                                    </CheckBox>
                                    <TextBlock Text="{Binding #BusinessWindowRoot.Texts.AutoSelectStatus}"
                                               IsVisible="{Binding #BusinessWindowRoot.Texts.HasAutoSelectStatus}" TextWrapping="Wrap"
                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                               AutomationProperties.AutomationId="BusinessAutoSelectStatus"/>
                                    <TextBlock Text="{Binding #BusinessWindowRoot.Texts.ServerPickerCaption}" TextWrapping="Wrap"
                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding #BusinessWindowRoot.Texts.ServerFallbackLabel}"
                                               IsVisible="{Binding #BusinessWindowRoot.Texts.HasServerFallbackLabel}"
                                               TextWrapping="Wrap" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               AutomationProperties.AutomationId="BusinessServerFallbackLabel"/>
                                    <ComboBox x:Name="BusinessServerSelector" SelectionChanged="OnBusinessServerSelectionChanged"
                                              PlaceholderText="{Binding #BusinessWindowRoot.Texts.ServerPickerPlaceholder}"
                                              MinHeight="48" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                              AutomationProperties.AutomationId="BusinessServerSelector"
                                              AutomationProperties.Name="{Binding #BusinessWindowRoot.Texts.Server}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="business:BusinessServerChoiceViewModel">
                                                <Grid ColumnDefinitions="8,Auto,*,Auto" ColumnSpacing="6" ToolTip.Tip="{Binding StatusText}">
                                                    <Ellipse Classes="business-health-dot" Width="8" Height="8"
                                                             Classes.good="{Binding IsGood}" Classes.warning="{Binding IsWarning}"
                                                             Classes.bad="{Binding IsBad}" VerticalAlignment="Center"/>
                                                    <Image Grid.Column="1" Source="{Binding CountryFlag}" Width="21" Height="14"
                                                           IsVisible="{Binding HasCountry}" VerticalAlignment="Center" ToolTip.Tip="{Binding CountryName}"/>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}"/>
                                                        <TextBlock Text="{Binding CountryName}" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasCountry}"
                                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <StackPanel Orientation="Horizontal" Spacing="2"
                                                                        IsVisible="{Binding HasKnownActivity}" VerticalAlignment="Center">
                                                                <Border Classes="load-seg" Classes.low="{Binding Seg1Low}" Classes.medium="{Binding Seg1Medium}" Classes.high="{Binding Seg1High}"/>
                                                                <Border Classes="load-seg" Classes.medium="{Binding Seg2Medium}" Classes.high="{Binding Seg2High}"/>
                                                                <Border Classes="load-seg" Classes.high="{Binding Seg3High}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding MetricsText}" IsVisible="{Binding HasMetadata}"
                                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MetricsHint}"
                                                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" MaxWidth="94">
                                                        <TextBlock Text="{Binding PingText}" FontSize="11" TextWrapping="Wrap" TextAlignment="Right"/>
                                                        <TextBlock Text="{Binding SlowBadgeText}" IsVisible="{Binding IsSlow}" FontSize="11"
                                                                   Foreground="{DynamicResource WarningFgBrush}" TextAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button x:Name="BusinessServerRefresh" Classes="business-outline" HorizontalAlignment="Left"
                                            Content="{Binding #BusinessWindowRoot.Texts.ServerRefresh}" Click="OnBusinessServerRefresh"
                                            IsEnabled="{Binding #BusinessWindowRoot.Texts.CanTestServers}"
                                            AutomationProperties.AutomationId="BusinessServerRefresh"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Height="1" Margin="10,0" Background="{DynamicResource BorderSubtleBrush}"/>
                    <Button x:Name="BusinessModeMenuButton" Classes="home-setting"
                            Click="OnBusinessModeMenuToggle"
                            AutomationProperties.AutomationId="BusinessModeMenu"
                            AutomationProperties.Name="{Binding #BusinessWindowRoot.Texts.ModeMenu}"
                            AutomationProperties.ItemStatus="{Binding #BusinessWindowRoot.Texts.ModeSummary}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock VerticalAlignment="Center" Text="{Binding #BusinessWindowRoot.Texts.ModeMenu}"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding #BusinessWindowRoot.Texts.ModeSummary}"/>
                            <icons:Pictogram Grid.Column="2" Id="chevron-down" Classes="setting-chevron"
                                             Classes.expanded="{Binding #BusinessModePanel.IsVisible}"/>
                        </Grid>
                    </Button>
                    <Border x:Name="BusinessModePanel" IsVisible="False" Padding="10,8"
                            Background="{DynamicResource SurfaceSunkenBrush}">
                        <StackPanel Spacing="7">
                            <TextBlock IsVisible="{Binding IsConnected}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding #BusinessWindowRoot.Texts.ModeLocked}"/>
                            <StackPanel Spacing="8" IsEnabled="{Binding #BusinessWindowRoot.Texts.CanToggleConnection}"
                                        IsVisible="{Binding !IsConnected}">
                                <RadioButton GroupName="BusinessMode" IsChecked="{Binding IsSplitTunnel}" IsEnabled="{Binding !IsConnected}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding #BusinessWindowRoot.Texts.Split}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding #BusinessWindowRoot.Texts.SplitDescription}" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="BusinessMode" IsChecked="{Binding !IsSplitTunnel, Mode=OneWay}" IsEnabled="{Binding !IsConnected}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding #BusinessWindowRoot.Texts.FullCompact}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding #BusinessWindowRoot.Texts.FullDescription}" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VPNRouter.App.ViewModels"
        xmlns:conv="using:VPNRouter.App"
        xmlns:ctrl="using:VPNRouter.App.Controls"
        xmlns:icons="using:VPNRouter.App.Controls"
        xmlns:loc="using:VPNRouter.App.Localization"
        xmlns:pages="using:VPNRouter.App.Views.Pages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="680"
        x:Class="VPNRouter.App.Views.MainWindow"
        x:CompileBindings="True"
        x:DataType="vm:MainWindowViewModel"
        Title="VPNRouter"
        Width="520" Height="760"
        MinWidth="380" MinHeight="520"
        FontSize="10"
        Background="{DynamicResource SurfaceAppBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:BoolToStatusColorConverter x:Key="StatusColorConverter"/>
        <conv:BoolToLangConverter x:Key="LangConverter"/>
    </Window.Resources>

    <Window.Styles>

        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="8,6,8,4"/>
        </Style>

        <Style Selector="Border.segment-container">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="6,0,6,4"/>
        </Style>

        <Style Selector="Button.segment">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.segment:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
        </Style>
        <Style Selector="Button.segment.active">
            <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.segment.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
            <Setter Property="BoxShadow" Value="{DynamicResource ShadowXs}"/>
        </Style>

        <Style Selector="Button.menu-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.menu-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
        </Style>
        <Style Selector="Button.menu-item.armed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="TextBlock.version-hint">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontFamily" Value="Consolas, 'SF Mono', 'Cascadia Code', 'Ubuntu Mono', monospace"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <Style Selector="ListBoxItem.main-tab">
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="ListBoxItem.main-tab StackPanel">
            <Setter Property="Spacing" Value="6"/>
        </Style>
        <Style Selector="icons|Pictogram.tab-icon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- The three header chips are buttons (they open the VPN, Zapret and Telegram pages): a thin outline, a hand cursor and a hover/focus change say so. -->
        <Style Selector="Button.status-chip">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.status-chip:pointerover">
            <Setter Property="Opacity" Value="0.82"/>
        </Style>
        <Style Selector="Button.status-chip:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.status-chip TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.primary-cta">
            <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primary-cta:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBgMutedBrush}"/>
        </Style>

        <Style Selector="Border.menu-divider">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="Margin" Value="4,4"/>
        </Style>

        <Style Selector="FlyoutPresenter.naked">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>


        <!-- Narrow window: only the selected main tab keeps its label, the others show their icon (the label is the tooltip), so all six stay reachable. -->
        <Style Selector="ListBox.compact ListBoxItem.main-tab:not(:selected) TextBlock">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ListBox.compact ListBoxItem.main-tab:not(:selected) StackPanel">
            <Setter Property="Spacing" Value="0"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Vertical">
            <Border IsVisible="{Binding HasSettingsRecoveryNotice}"
                    Background="{DynamicResource WarningBgBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0"
                               icons:PictogramText.Icons="warning" icons:PictogramText.Text="⚠"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource WarningFgBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding SettingsRecoveryNoticeText}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource WarningFgBrush}"/>
                    <Button Grid.Column="2"
                            icons:PictogramText.Icons="close" icons:PictogramText.Content="✕"
                            Command="{Binding DismissSettingsRecoveryNoticeCommand}"
                            Padding="8,2" MinHeight="0" FontSize="11"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource WarningFgBrush}"
                            ToolTip.Tip="{Binding L_TipDismiss}" AutomationProperties.Name="{Binding L_TipDismiss}"/>
                </Grid>
            </Border>

            <Border IsVisible="{Binding HasPlaceholderPruneNotice}"
                    Background="{DynamicResource WarningBgBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0"
                               icons:PictogramText.Icons="shield" icons:PictogramText.Text="🛡"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource WarningFgBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding PlaceholderPruneNoticeText}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource WarningFgBrush}"/>
                    <Button Grid.Column="2"
                            icons:PictogramText.Icons="close" icons:PictogramText.Content="✕"
                            Command="{Binding DismissPlaceholderPruneNoticeCommand}"
                            Padding="8,2" MinHeight="0" FontSize="11"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource WarningFgBrush}"
                            ToolTip.Tip="{Binding L_TipDismiss}" AutomationProperties.Name="{Binding L_TipDismiss}"/>
                </Grid>
            </Border>

            <Border IsVisible="{Binding HasUpdateWarning}"
                    Background="{DynamicResource WarningBgBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0"
                               icons:PictogramText.Icons="warning" icons:PictogramText.Text="⚠"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource WarningFgBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding UpdateWarningText}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource WarningFgBrush}"/>
                    <Button Grid.Column="2"
                            icons:PictogramText.Icons="close" icons:PictogramText.Content="✕"
                            Command="{Binding DismissUpdateWarningCommand}"
                            Padding="8,2" MinHeight="0" FontSize="11"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource WarningFgBrush}"
                            ToolTip.Tip="{Binding L_TipDismiss}" AutomationProperties.Name="{Binding L_TipDismiss}"/>
                </Grid>
            </Border>

            <Border IsVisible="{Binding HasConflictingVpnWarning}"
                    Background="{DynamicResource DangerBgBrush}"
                    BorderBrush="{DynamicResource DangerBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0"
                                   icons:PictogramText.Icons="blocked" icons:PictogramText.Text="⛔"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DangerFgBrush}"/>
                        <StackPanel Grid.Column="1" Spacing="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding L_ConflictOtherVpnDetectedTitle}"
                                       FontSize="11" FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource DangerFgBrush}"/>
                            <TextBlock Text="{Binding ConflictingVpnWarningText}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource DangerFgBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                icons:PictogramText.Icons="close" icons:PictogramText.Content="✕"
                                Command="{Binding DismissConflictingVpnWarningCommand}"
                                Padding="8,2" MinHeight="0" FontSize="11"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource DangerFgBrush}"
                                ToolTip.Tip="{Binding L_TipDismiss}" AutomationProperties.Name="{Binding L_TipDismiss}"/>
                    </Grid>
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="22,0,0,0">
                        <Button Classes="solid" Content="{Binding L_ConflictKillButton}"
                                Command="{Binding KillConflictingVpnCommand}"
                                ToolTip.Tip="{Binding L_ConflictKillTooltip}"
                                Padding="10,3" Margin="0,0,6,4" MinHeight="0" FontSize="11"
                                FontWeight="SemiBold"
                                CornerRadius="{StaticResource RadiusSm}"
                                Background="{DynamicResource DangerSolidBrush}"
                                Foreground="White"
                                BorderThickness="0"/>
                        <Button Content="{Binding L_ConflictIgnoreButton}"
                                Command="{Binding IgnoreVpnConflictAndConnectCommand}"
                                ToolTip.Tip="{Binding L_ConflictIgnoreTooltip}"
                                Padding="10,3" Margin="0,0,6,4" MinHeight="0" FontSize="11"
                                CornerRadius="{StaticResource RadiusSm}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource DangerBorderBrush}"
                                BorderThickness="1"
                                Foreground="{DynamicResource DangerFgBrush}"/>
                        <Button Content="{Binding L_ConflictRefreshButton}"
                                Command="{Binding RefreshConflictingVpnCommand}"
                                Padding="8,2" Margin="0,0,6,4" MinHeight="0" FontSize="11"
                                Background="Transparent"
                                BorderBrush="{DynamicResource DangerBorderBrush}"
                                BorderThickness="1"
                                Foreground="{DynamicResource DangerFgBrush}"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Padding="14,10,10,10" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                Background="{DynamicResource SurfaceBaseBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <!-- The brand tile: the mascot art placed on its light tile by tools/icons/make-icons.py (art unchanged); it reads in both themes. -->
                <Border Grid.Column="0" Width="40" Height="40"
                        CornerRadius="{StaticResource RadiusLg}"
                        DoubleTapped="OnBrandTileDoubleTapped"
                        ToolTip.Tip="{Binding L_SmpMenuResetWindowSize}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        VerticalAlignment="Center">
                    <Image Source="avares://VPNRouter.App/Assets/penguin_logo.png"
                           Width="40" Height="40" Stretch="UniformToFill"
                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                </Border>

                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Virtual Penguin Network"
                               ToolTip.Tip="Virtual Penguin Network"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Button Command="{Binding NavigateToVpnCommand}"
                                ToolTip.Tip="{Binding VpnBadgeTooltip}"
                                Classes="status-chip"
                                Background="{DynamicResource SuccessBgBrush}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource RadiusPill}"
                                Cursor="Hand"
                                IsVisible="{Binding SimpleStatusIsOn}">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <icons:Pictogram Id="status" Width="8" Height="8" VerticalAlignment="Center"
                                         Foreground="{DynamicResource SuccessSolidBrush}"/>
                                <TextBlock Text="VPN"
                                           Foreground="{DynamicResource SuccessFgBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateToVpnCommand}"
                                ToolTip.Tip="{Binding VpnBadgeTooltip}"
                                Classes="status-chip"
                                Background="{DynamicResource WarningBgBrush}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource RadiusPill}"
                                Cursor="Hand"
                                IsVisible="{Binding SimpleStatusIsWarn}">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <icons:Pictogram Id="status" Classes="pulse"
                                         Width="8" Height="8" VerticalAlignment="Center"
                                         Foreground="{DynamicResource WarningSolidBrush}"/>
                                <TextBlock Text="VPN"
                                           Foreground="{DynamicResource WarningFgBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateToVpnCommand}"
                                ToolTip.Tip="{Binding VpnBadgeTooltip}"
                                Classes="status-chip"
                                Background="{DynamicResource SurfaceSunkenBrush}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource RadiusPill}"
                                Cursor="Hand"
                                IsVisible="{Binding SimpleStatusIsOff}">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <icons:Pictogram Id="status" Width="8" Height="8" VerticalAlignment="Center"
                                         Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="VPN"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToZapretCommand}"
                                ToolTip.Tip="{Binding ZapretBadgeTooltip}"
                                IsVisible="{Binding IsZapretAvailable}"
                                Classes="status-chip"
                                Background="{Binding ZapretBadgeBrush}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource RadiusPill}"
                                Cursor="Hand">
                            <TextBlock Text="Zapret"
                                       Foreground="White"/>
                        </Button>

                        <Button Command="{Binding NavigateToTgProxyCommand}"
                                ToolTip.Tip="{Binding TgProxyBadgeTooltip}"
                                IsVisible="{Binding IsTgProxyAvailable}"
                                Classes="status-chip"
                                Background="{Binding TgProxyBadgeBrush}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource RadiusPill}"
                                Cursor="Hand">
                            <TextBlock Text="TG"
                                       Foreground="White"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2"
                        Command="{Binding ToggleUiModeCommand}"
                        icons:PictogramText.Icons="chevron-left,chevron-right" icons:PictogramText.Content="{Binding UiModeToggleText}"
                        ToolTip.Tip="{Binding UiModeToggleTooltip}"
                        IsVisible="{Binding !IsSimpleMode}"
                        Padding="14,7" MinHeight="32"
                        FontSize="12" FontWeight="Bold"
                        Background="{DynamicResource AccentBgSubtleBrush}"
                        BorderBrush="{DynamicResource AccentBorderBrush}"
                        BorderThickness="1"
                        Foreground="{DynamicResource AccentFgBrush}"
                        CornerRadius="{StaticResource RadiusPill}"
                        VerticalAlignment="Center"
                        Cursor="Hand">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource AccentBgMutedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
                        </Style>
                    </Button.Styles>
                </Button>

                <Button Grid.Column="3" Width="28" Height="28" Padding="0"
                        FontSize="15" FontWeight="Bold"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="{StaticResource RadiusSm}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                    <Button.Content><icons:Pictogram Id="more-horizontal" Width="18" Height="18"/></Button.Content>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight"
                                ShowMode="TransientWithDismissOnPointerMoveAway"
                                FlyoutPresenterClasses="naked">
                            <Border Width="232"
                                    Background="{DynamicResource SurfaceBaseBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}"
                                    Padding="6">
                                <StackPanel Spacing="1">

                                    <TextBlock Classes="section-label"
                                               Text="{Binding L_SmpMenuViewSection}"/>

                                    <Border Classes="segment-container">
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="2">
                                            <Button Grid.Column="0"
                                                    Classes="segment"
                                                    Classes.active="{Binding IsSystemThemePref}"
                                                    Command="{Binding SetThemeSystemCommand}"
                                                    Content="{Binding L_SmpSegSystem}"/>
                                            <Button Grid.Column="1"
                                                    Classes="segment"
                                                    Classes.active="{Binding IsLightThemePref}"
                                                    Command="{Binding SetThemeLightCommand}"
                                                    Content="{Binding L_SmpSegLight}"/>
                                            <Button Grid.Column="2"
                                                    Classes="segment"
                                                    Classes.active="{Binding IsDarkThemePref}"
                                                    Command="{Binding SetThemeDarkCommand}"
                                                    Content="{Binding L_SmpSegDark}"/>
                                        </Grid>
                                    </Border>

                                    <Border Classes="segment-container">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
                                            <Button Grid.Column="0"
                                                    Classes="segment"
                                                    Classes.active="{Binding IsRussian}"
                                                    Command="{Binding SetLanguageRussianCommand}"
                                                    Content="{Binding L_SmpSegRu}"/>
                                            <Button Grid.Column="1"
                                                    Classes="segment"
                                                    Classes.active="{Binding !IsRussian}"
                                                    Command="{Binding SetLanguageEnglishCommand}"
                                                    Content="{Binding L_SmpSegEn}"/>
                                        </Grid>
                                    </Border>

                                    <Border Classes="menu-divider"/>

                                    <TextBlock Classes="section-label"
                                               Text="{Binding L_SmpMenuDiagnosticsSection}"/>

                                    <Button Classes="menu-item"
                                            Command="{Binding OpenLogsCommand}"
                                            Content="{Binding L_SmpMenuOpenLogs}"
                                            ToolTip.Tip="{Binding L_TipOpenLogs}"/>
                                    <Button Classes="menu-item"
                                            Command="{Binding ExportDiagnosticsCommand}"
                                            IsEnabled="{Binding !IsExportingDiagnostics}"
                                            Content="{Binding L_DiagExportButton}"
                                            ToolTip.Tip="{Binding L_DiagExportHint}"/>
                                    <Button Classes="menu-item"
                                            Command="{Binding OpenLeakTestCommand}"
                                            Content="{Binding L_SmpMenuCheckLeaks}"
                                            ToolTip.Tip="{Binding L_TipIpLeak}"/>
                                    <Button Classes="menu-item"
                                            Command="{Binding UpdateVm.CheckManuallyCommand}"
                                            Content="{Binding UpdateVm.CheckLinkText}"/>

                                    <Border Classes="menu-divider"/>

                                    <TextBlock Classes="section-label"
                                               Text="{Binding L_SmpMenuTroubleshootingSection}"/>

                                    <Button Classes="menu-item"
                                            Command="{Binding OpenSetupWizardCommand}"
                                            ToolTip.Tip="{Binding L_TipSmpMenuSetupWizard}">
                                        <TextBlock Text="{Binding L_SmpMenuSetupWizard}"
                                                   TextWrapping="Wrap"/>
                                    </Button>
                                    <Button Classes="menu-item"
                                            Click="OnResetWindowSizeClick"
                                            Content="{Binding L_SmpMenuResetWindowSize}"
                                            ToolTip.Tip="{Binding L_TipSmpMenuResetWindowSize}"/>
                                    <Button Classes="menu-item"
                                            Command="{Binding RunHealthCheckCommand}"
                                            Content="{Binding L_SmpMenuHealthCheck}"
                                            ToolTip.Tip="{Binding L_TipSmpMenuHealthCheck}"/>
                                    <Button Classes="menu-item"
                                            Command="{Binding RestartInSafeModeCommand}"
                                            Content="{Binding L_SmpMenuSafeMode}"
                                            ToolTip.Tip="{Binding L_TipSmpMenuSafeMode}"/>
                                    <Button Classes="menu-item"
                                            Classes.armed="{Binding ResetConfigArmed}"
                                            Command="{Binding ResetConfigCommand}"
                                            Content="{Binding ResetConfigMenuHeader}"
                                            ToolTip.Tip="{Binding L_TipSmpMenuResetConfig}"
                                            Foreground="{DynamicResource DangerSolidBrush}"/>

                                    <Border Classes="menu-divider"/>

                                    <Button Classes="menu-item"
                                            Command="{Binding OpenAboutCommand}"
                                            ToolTip.Tip="{Binding L_TipSmpMenuAbout}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding L_SmpMenuAbout}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Classes="version-hint"
                                                       Text="{Binding AppVersionShortText}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>

                                    <Button Classes="primary-cta"
                                            Command="{Binding ToggleUiModeCommand}"
                                            icons:PictogramText.Icons="chevron-left,chevron-right" icons:PictogramText.Content="{Binding UiModeToggleText}"/>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                IsVisible="{Binding UpdateVm.IsVisible}"
                Background="{DynamicResource WarningBgBrush}"
                BorderBrush="{DynamicResource WarningBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel>
                <Button Classes="solid" DockPanel.Dock="Right"
                        Content="{Binding L_UpdateButton}"
                        Command="{Binding UpdateVm.DownloadAndApplyCommand}"
                        IsVisible="{Binding !UpdateVm.IsDownloading}"
                        Background="{DynamicResource WarningSolidBrush}" Foreground="White"
                        FontWeight="Bold" Padding="14,6" CornerRadius="{StaticResource RadiusSm}"/>
                <ProgressBar DockPanel.Dock="Right"
                             Value="{Binding UpdateVm.DownloadProgress}"
                             Maximum="100"
                             Width="180" Height="20"
                             Margin="8,0,0,0"
                             IsVisible="{Binding UpdateVm.IsDownloading}"/>
                <TextBlock Text="{Binding UpdateVm.Message}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningFgBrush}"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" RowDefinitions="Auto,*"
              IsVisible="{Binding !IsSimpleMode}">
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBaseBrush}"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderDefaultBrush}">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Stretch">
                <ListBox x:Name="MainTabs"
                         SelectedIndex="{Binding SelectedTabIndex}"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalAlignment="Left"
                         Padding="8,6">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem Classes="main-tab" AutomationProperties.Name="{Binding LblTabManual}" ToolTip.Tip="{Binding LblTabManual}">
                        <StackPanel Orientation="Horizontal">
                            <icons:Pictogram Classes="tab-icon" Id="tab-servers"/>
                            <TextBlock Text="{Binding LblTabManual}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Classes="main-tab" AutomationProperties.Name="{Binding LblTabSubscribe}" ToolTip.Tip="{Binding LblTabSubscribe}">
                        <StackPanel Orientation="Horizontal">
                            <icons:Pictogram Classes="tab-icon" Id="tab-subscribe"/>
                            <TextBlock Text="{Binding LblTabSubscribe}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Classes="main-tab" AutomationProperties.Name="{Binding LblTabNetwork}" ToolTip.Tip="{Binding LblTabNetwork}">
                        <StackPanel Orientation="Horizontal">
                            <icons:Pictogram Classes="tab-icon" Id="tab-settings"/>
                            <TextBlock Text="{Binding LblTabNetwork}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Classes="main-tab" AutomationProperties.Name="{Binding LblTabApps}" ToolTip.Tip="{Binding LblTabApps}">
                        <StackPanel Orientation="Horizontal">
                            <icons:Pictogram Classes="tab-icon" Id="tab-apps"/>
                            <TextBlock Text="{Binding LblTabApps}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Classes="main-tab" AutomationProperties.Name="{Binding LblTabTools}" ToolTip.Tip="{Binding LblTabTools}"
                                 IsVisible="{Binding IsToolsAvailable}">
                        <StackPanel Orientation="Horizontal">
                            <icons:Pictogram Classes="tab-icon" Id="tab-tools"/>
                            <TextBlock Text="{Binding LblTabTools}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Classes="main-tab" AutomationProperties.Name="{Binding LblTabFreeConfigs}" ToolTip.Tip="{Binding LblTabFreeConfigs}">
                        <StackPanel Orientation="Horizontal">
                            <icons:Pictogram Classes="tab-icon" Id="tab-public"/>
                            <TextBlock Text="{Binding LblTabFreeConfigs}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </ScrollViewer>
            </Border>

            <Grid Grid.Row="1">
                <ctrl:DeferredPage IsActive="{Binding IsServersTabSelected}" PageType="{x:Type pages:ServersPage}"/>
                <ctrl:DeferredPage IsActive="{Binding IsSubscribeTabSelected}" PageType="{x:Type pages:SubscribePage}"/>
                <ctrl:DeferredPage IsActive="{Binding IsNetworkTabSelected}" PageType="{x:Type pages:NetworkPage}"/>
                <ctrl:DeferredPage IsActive="{Binding IsAppsTabSelected}" PageType="{x:Type pages:ApplicationsPage}"/>
                <ctrl:DeferredPage IsActive="{Binding IsToolsTabSelected}" PageType="{x:Type pages:ToolsPage}"/>
                <ctrl:DeferredPage IsActive="{Binding IsFreeConfigsTabSelected}" PageType="{x:Type pages:FreeConfigsPage}"/>
            </Grid>
        </Grid>

        <ctrl:DeferredPage Grid.Row="3" IsActive="{Binding IsSimpleMode}" PageType="{x:Type pages:SimplePage}"/>

        <Border Grid.Row="4" Padding="12,7" BorderThickness="0,1,0,0"
                IsVisible="{Binding !IsSimpleMode}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                Background="{DynamicResource SurfaceRaisedBrush}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Grid Grid.Column="0"
                      ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="7"
                      VerticalAlignment="Center"
                      MinWidth="0">
                    <icons:Pictogram Id="status" Width="16" Height="16"
                             Foreground="{Binding IsConnected, Converter={StaticResource StatusColorConverter}}"
                             VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" ToolTip.Tip="{Binding StatusText}"
                               icons:PictogramText.Icons="warning,arrow-right" icons:PictogramText.PrefixOnly="True" icons:PictogramText.Text="{Binding StatusText}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="2"
                            IsVisible="{Binding IsTrueSplitActive}"
                            Background="{DynamicResource SuccessBgBrush}"
                            BorderBrush="{DynamicResource SuccessBorderBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusPill}"
                            Padding="7,1" VerticalAlignment="Center"
                            ToolTip.Tip="{Binding L_TrueSplitTooltip}">
                        <TextBlock Text="{Binding L_TrueSplitBadge}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessFgBrush}"/>
                    </Border>
                </Grid>

                <Button Classes="solid" Grid.Column="1"
                        icons:PictogramText.Icons="play,stop" icons:PictogramText.Content="{Binding ConnectButtonText}"
                        Command="{Binding ToggleConnectionCommand}"
                        IsEnabled="{Binding CanToggleConnection}"
                        FontSize="11" FontWeight="Bold"
                        Padding="14,5" MinHeight="0"
                        HorizontalContentAlignment="Center"
                        Background="{DynamicResource AccentSolidBrush}"
                        Foreground="{DynamicResource AccentOnSolidBrush}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource RadiusSm}"/>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="5"
                IsVisible="{Binding RulesToastText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Padding="10,6"
                Margin="0,0,16,72"
                CornerRadius="{StaticResource RadiusSm}"
                Background="{DynamicResource SuccessBgBrush}"
                BorderBrush="{DynamicResource SuccessBorderBrush}"
                BorderThickness="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                ZIndex="100">
            <TextBlock icons:PictogramText.Icons="check,warning,error" icons:PictogramText.PrefixOnly="True" icons:PictogramText.Text="{Binding RulesToastText}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SuccessFgBrush}"/>
        </Border>
    </Grid>
</Window>

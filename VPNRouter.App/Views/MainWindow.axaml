<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VPNRouter.App.ViewModels"
        xmlns:conv="using:VPNRouter.App"
        xmlns:loc="using:VPNRouter.App.Localization"
        xmlns:pages="using:VPNRouter.App.Views.Pages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="680"
        x:Class="VPNRouter.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title=""
        Width="520" Height="640"
        MinWidth="360" MinHeight="360"
        FontSize="10"
        Background="{DynamicResource SurfaceAppBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:BoolToStatusColorConverter x:Key="StatusColorConverter"/>
        <conv:BoolToLangConverter x:Key="LangConverter"/>
    </Window.Resources>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- ═══ Compact header (v2.25.0 redesign) ═══
             One-row header, tight grid:
                 [28 px logo] [brand name + status badges] [◂ Simple] [⋯]

             Before v2.25.0 the header carried a 3-line block — brand name,
             "by NiniTux · v2.x.y · sing-box 1.13.x", and the badge row. The
             by-line + version moved into a dedicated About dialog (⋯ menu →
             О приложении) so the header stays a single row even when the
             window is narrow. VPN/Zapret/TG badges continue to act both as
             status indicators and as navigation shortcuts — identical
             command bindings to v2.24.4. Changes:
               • logo container 40 → 28 px (matches design handoff)
               • VersionText subtitle removed from header
               • brand name drops a font weight (13 bold → 12 bold) so the
                 badge row reads as the primary visual anchor
               • "О приложении" menu item added, opens AboutWindow dialog
             -->
        <Border Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                Background="{DynamicResource SurfaceBaseBrush}">
            <Grid ColumnDefinitions="28,*,Auto,Auto" ColumnSpacing="10">
                <Border Grid.Column="0" Width="28" Height="28"
                        CornerRadius="{StaticResource RadiusSm}"
                        Background="{DynamicResource AccentBgSubtleBrush}"
                        ClipToBounds="True"
                        VerticalAlignment="Center">
                    <Image Source="{Binding LogoSource}"
                           Width="26" Height="26" Stretch="Uniform"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Virtual Penguin Network"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!-- VPN pill-chip — 3 states via IsVisible.
                             Same Simple v2.18.3 style; NavigateToVpnCommand
                             already no-ops in Simple mode and switches to
                             Manual/Subscribe tab in Advanced. -->
                        <Button Command="{Binding NavigateToVpnCommand}"
                                ToolTip.Tip="{Binding VpnBadgeTooltip}"
                                Padding="5,1" MinHeight="0"
                                Background="{DynamicResource SuccessBgBrush}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource RadiusPill}"
                                Cursor="Hand"
                                IsVisible="{Binding SimpleStatusIsOn}">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <Ellipse Width="4" Height="4" VerticalAlignment="Center"
                                         Fill="{DynamicResource SuccessSolidBrush}"/>
                                <TextBlock Text="VPN" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessFgBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateToVpnCommand}"
                                ToolTip.Tip="{Binding VpnBadgeTooltip}"
                                Padding="5,1" MinHeight="0"
                                Background="{DynamicResource WarningBgBrush}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource RadiusPill}"
                                Cursor="Hand"
                                IsVisible="{Binding SimpleStatusIsWarn}">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <Ellipse Width="4" Height="4" VerticalAlignment="Center"
                                         Fill="{DynamicResource WarningSolidBrush}"/>
                                <TextBlock Text="VPN" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningFgBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateToVpnCommand}"
                                ToolTip.Tip="{Binding VpnBadgeTooltip}"
                                Padding="5,1" MinHeight="0"
                                Background="{DynamicResource SurfaceSunkenBrush}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource RadiusPill}"
                                Cursor="Hand"
                                IsVisible="{Binding SimpleStatusIsOff}">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <Ellipse Width="4" Height="4" VerticalAlignment="Center"
                                         Fill="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="VPN" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- v2.21.0: Zapret + TG chips hidden on Linux —
                             both features are Windows-only (winws.exe via
                             Cygwin, Python embeddable we ship only for Win). -->
                        <Button Command="{Binding NavigateToZapretCommand}"
                                ToolTip.Tip="{Binding ZapretBadgeTooltip}"
                                IsVisible="{Binding IsZapretAvailable}"
                                Padding="5,1" MinHeight="0"
                                Background="{Binding ZapretBadgeBrush}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource RadiusPill}"
                                Cursor="Hand">
                            <TextBlock Text="Zapret" FontSize="9" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Button>

                        <Button Command="{Binding NavigateToTgProxyCommand}"
                                ToolTip.Tip="{Binding TgProxyBadgeTooltip}"
                                IsVisible="{Binding IsTgProxyAvailable}"
                                Padding="5,1" MinHeight="0"
                                Background="{Binding TgProxyBadgeBrush}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource RadiusPill}"
                                Cursor="Hand">
                            <TextBlock Text="TG" FontSize="9" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- v2.20.0: "◂ Simple" ghost-button, shown only in Advanced.
                     Previous accent-subtle + border version (v2.19.1) looked
                     like a status chip and visually competed with VPN/Zapret/TG.
                     Mode-switch is navigation, not status — render as a
                     subtle accent-fg text control with transparent background
                     so it sits quietly in the top-right corner until hovered.
                     In Simple mode the big Advanced card on the page handles
                     the opposite direction, so this slot stays hidden. -->
                <Button Grid.Column="2"
                        Command="{Binding ToggleUiModeCommand}"
                        Content="{Binding UiModeToggleText}"
                        ToolTip.Tip="{Binding UiModeToggleTooltip}"
                        IsVisible="{Binding !IsSimpleMode}"
                        Padding="8,4" MinHeight="0"
                        FontSize="11" FontWeight="SemiBold"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource AccentFgBrush}"
                        CornerRadius="{StaticResource RadiusSm}"
                        VerticalAlignment="Center"
                        Cursor="Hand">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
                        </Style>
                    </Button.Styles>
                </Button>

                <!-- ⋯ flyout — theme · lang · logs · leaks · updates · mode toggle.
                     Absorbs all the ex-header buttons. UiModeToggleText auto-flips
                     "Advanced ▸" / "◂ Simple" based on the current mode. -->
                <Button Grid.Column="3" Width="28" Height="28" Padding="0"
                        FontSize="15" FontWeight="Bold"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="{StaticResource RadiusSm}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                    <Button.Content>⋯</Button.Content>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="{Binding ThemeToggleText}"
                                      Command="{Binding ToggleThemeCommand}"/>
                            <MenuItem Header="{Binding IsRussian, Converter={StaticResource LangConverter}}"
                                      Command="{Binding ToggleLanguageCommand}"/>
                            <Separator/>
                            <MenuItem Header="{x:Static loc:Strings.SmpMenuOpenLogs}"
                                      Command="{Binding OpenLogsCommand}"/>
                            <MenuItem Header="{x:Static loc:Strings.SmpMenuCheckLeaks}"
                                      Command="{Binding OpenLeakTestCommand}"/>
                            <Separator/>
                            <MenuItem Header="{x:Static loc:Strings.SmpMenuCheckUpdates}"
                                      Command="{Binding UpdateVm.CheckManuallyCommand}"/>
                            <Separator/>
                            <!-- v2.23.1 troubleshooting actions (command-backed twin of CLI flags). -->
                            <MenuItem Header="{x:Static loc:Strings.SmpMenuHealthCheck}"
                                      Command="{Binding RunHealthCheckCommand}"
                                      ToolTip.Tip="{x:Static loc:Strings.TipSmpMenuHealthCheck}"/>
                            <MenuItem Header="{x:Static loc:Strings.SmpMenuSafeMode}"
                                      Command="{Binding RestartInSafeModeCommand}"
                                      ToolTip.Tip="{x:Static loc:Strings.TipSmpMenuSafeMode}"/>
                            <MenuItem Header="{Binding ResetConfigMenuHeader}"
                                      Command="{Binding ResetConfigCommand}"
                                      ToolTip.Tip="{x:Static loc:Strings.TipSmpMenuResetConfig}"/>
                            <Separator/>
                            <!-- v2.25.0 — "About" absorbs the meta block that
                                 used to render in the header subtitle. -->
                            <MenuItem Header="{x:Static loc:Strings.SmpMenuAbout}"
                                      Command="{Binding OpenAboutCommand}"
                                      ToolTip.Tip="{x:Static loc:Strings.TipSmpMenuAbout}"/>
                            <MenuItem Header="{Binding UiModeToggleText}"
                                      Command="{Binding ToggleUiModeCommand}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ Update Notification ═══ -->
        <Border Grid.Row="1"
                IsVisible="{Binding UpdateVm.IsVisible}"
                Background="{DynamicResource WarningBgBrush}"
                BorderBrush="{DynamicResource WarningBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="↓ Update"
                        Command="{Binding UpdateVm.DownloadAndApplyCommand}"
                        IsVisible="{Binding !UpdateVm.IsDownloading}"
                        Background="{DynamicResource WarningSolidBrush}" Foreground="White"
                        FontWeight="Bold" Padding="14,6" CornerRadius="{StaticResource RadiusSm}"/>
                <ProgressBar DockPanel.Dock="Right"
                             Value="{Binding UpdateVm.DownloadProgress}"
                             Maximum="100"
                             Width="180" Height="20"
                             Margin="8,0,0,0"
                             IsVisible="{Binding UpdateVm.IsDownloading}"/>
                <TextBlock Text="{Binding UpdateVm.Message}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningFgBrush}"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ═══ ADVANCED: Tab strip + page area (no TabControl — direct Grid layout) ═══ -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*"
              IsVisible="{Binding !IsSimpleMode}">
            <!-- v2.25.0 — tabbar wrapped in a horizontal ScrollViewer.
                 At 520 px window width the six tabs fit comfortably, but
                 longer localised labels (e.g. EN "Applications" vs RU
                 "Приложения" vs "Free Configs") have historically clipped
                 the rightmost "Free" on narrower viewports. Hidden
                 scrollbar + horizontal overflow means the UI degrades by
                 letting the user flick instead of losing discoverability.
                 HorizontalAlignment="Left" keeps the tabs left-aligned
                 even when the ScrollViewer's content is narrower than the
                 viewport (prevents the tabs from centring which would
                 leave empty space to the left). -->
            <ScrollViewer Grid.Row="0"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Stretch"
                          BorderThickness="0,0,0,1"
                          BorderBrush="{DynamicResource BorderDefaultBrush}">
                <ListBox SelectedIndex="{Binding SelectedTabIndex}"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalAlignment="Left"
                         Padding="6,2">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem Content="{Binding LblTabManual}"      Padding="12,6" FontSize="12" FontWeight="SemiBold"/>
                    <ListBoxItem Content="{Binding LblTabSubscribe}"   Padding="12,6" FontSize="12" FontWeight="SemiBold"/>
                    <ListBoxItem Content="{Binding LblTabNetwork}"     Padding="12,6" FontSize="12" FontWeight="SemiBold"/>
                    <ListBoxItem Content="{Binding LblTabApps}"        Padding="12,6" FontSize="12" FontWeight="SemiBold"/>
                    <!-- v2.21.0: Tools tab hidden on Linux — its only sub-pages
                         are Zapret and TgProxy, both Windows-only. The tab
                         visibility uses IsZapretAvailable (same signal). -->
                    <ListBoxItem Content="{Binding LblTabTools}"       Padding="12,6" FontSize="12" FontWeight="SemiBold"
                                 IsVisible="{Binding IsZapretAvailable}"/>
                    <ListBoxItem Content="{Binding LblTabFreeConfigs}" Padding="12,6" FontSize="12" FontWeight="SemiBold"/>
                </ListBox>
            </ScrollViewer>

            <!-- Pages: all six live in same Grid cell, only selected one visible. -->
            <Grid Grid.Row="1">
                <pages:ServersPage      IsVisible="{Binding IsServersTabSelected}"/>
                <pages:SubscribePage    IsVisible="{Binding IsSubscribeTabSelected}"/>
                <pages:NetworkPage      IsVisible="{Binding IsNetworkTabSelected}"/>
                <pages:ApplicationsPage IsVisible="{Binding IsAppsTabSelected}"/>
                <pages:ToolsPage        IsVisible="{Binding IsToolsTabSelected}"/>
                <pages:FreeConfigsPage  IsVisible="{Binding IsFreeConfigsTabSelected}"/>
            </Grid>
        </Grid>

        <!-- ═══ SIMPLE: one-page onboarding (v2.17+) ═══ -->
        <pages:SimplePage Grid.Row="2" IsVisible="{Binding IsSimpleMode}"/>

        <!-- ═══ Footer (v2.25.0 unified) ═══
             Single-row status bar + inline compact connect button. Replaces
             the triple-stacked footer (service row · big full-width Start/Stop
             · separate status line) that existed through v2.24.x.

             Layout: `[● status-dot] [mode / server / ip …]      [▶ Start | ■ Stop]`

             Rationale for the consolidation:
               • `Autostart with Windows` checkbox lived twice in the UI
                 (footer + Settings → Autostart). Settings is the canonical
                 home; footer copy is gone.
               • ServiceVm Restart / Reinstall buttons are admin-tier and
                 rarely needed. They'll migrate into Settings → Autostart in
                 v2.25.4. For v2.25.0 they're not reachable from the footer.
               • Full-width Start/Stop button was visually overwhelming; the
                 compact version matches the Arctic design language and
                 leaves more vertical room for page content. -->
        <Border Grid.Row="3" Padding="12,7" BorderThickness="0,1,0,0"
                IsVisible="{Binding !IsSimpleMode}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                Background="{DynamicResource SurfaceRaisedBrush}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <!-- Left: status dot + text; whole block is `min-width:0`
                     (Grid * with TextTrimming) so long status lines ellide
                     instead of pushing the Stop button off-screen. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7"
                            VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             Fill="{Binding IsConnected, Converter={StaticResource StatusColorConverter}}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: inline Start/Stop. Text toggles via ConnectButtonText
                     (Start / Stop / Starting / Stopping). Same command as the
                     big button v2.24.4 exposed; only styling is reduced. -->
                <Button Grid.Column="1"
                        Content="{Binding ConnectButtonText}"
                        Command="{Binding ToggleConnectionCommand}"
                        IsEnabled="{Binding !IsConnecting}"
                        FontSize="11" FontWeight="Bold"
                        Padding="14,5" MinHeight="0"
                        HorizontalContentAlignment="Center"
                        Background="{DynamicResource AccentSolidBrush}"
                        Foreground="{DynamicResource AccentOnSolidBrush}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource RadiusSm}"/>
            </Grid>
        </Border>
    </Grid>
</Window>

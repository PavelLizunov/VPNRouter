<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VPNRouter.App.ViewModels"
        xmlns:conv="using:VPNRouter.App"
        xmlns:loc="using:VPNRouter.App.Localization"
        xmlns:pages="using:VPNRouter.App.Views.Pages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="680"
        x:Class="VPNRouter.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="VPNRouter"
        Width="520" Height="640"
        MinWidth="360" MinHeight="360"
        FontSize="10"
        Background="{DynamicResource SurfaceAppBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:BoolToStatusColorConverter x:Key="StatusColorConverter"/>
        <conv:BoolToLangConverter x:Key="LangConverter"/>
    </Window.Resources>

    <!-- v2.25.2 — styling primitives for the redesigned ⋯ popover menu.
         These are MainWindow-local so they don't leak into page content
         that happens to use the same class names. Kept inline (rather
         than promoted to Tokens.axaml or a dedicated Styles/Menu.axaml)
         because they only render inside the popover Flyout and revealing
         them to other pages would invite accidental reuse with the
         wrong visual context. -->
    <Window.Styles>

        <!-- Section label — small caps-style header above each group -->
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="8,6,8,4"/>
        </Style>

        <!-- Segment container — the rounded grey track -->
        <Style Selector="Border.segment-container">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="6,0,6,4"/>
        </Style>

        <!-- Base segment button — inactive state. Uses a transparent
             background; active state (below) applies SurfaceBase + shadow.
             v2.25.9 fix: Avalonia Button has large default MinWidth +
             MinHeight which left random-looking gaps between segments
             and inside each pill. Zero both so the Padding + Grid *|*
             column measurements are the only thing sizing the button. -->
        <Style Selector="Button.segment">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.segment:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
        </Style>
        <!-- Active segment: SurfaceBase background to contrast against the
             SurfaceSunken track. BoxShadow sits on the ContentPresenter (not
             the Button itself — Button doesn't carry the BoxShadow property
             directly in Avalonia). -->
        <Style Selector="Button.segment.active">
            <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.segment.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
            <Setter Property="BoxShadow" Value="{DynamicResource ShadowXs}"/>
        </Style>

        <!-- Regular menu item -->
        <Style Selector="Button.menu-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.menu-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
        </Style>
        <!-- v2.31.0-r4 (F-27): armed state for the destructive Reset
             menu item. When the user has clicked once, the label flips to
             "Нажмите ещё раз для сброса" via ResetConfigMenuHeader; this
             style adds a danger-tinted backdrop + 1px danger border so the
             visual rises out of the regular menu strip. Inactive state
             stays transparent (matches every other menu-item). -->
        <Style Selector="Button.menu-item.armed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Mono version pill on the right side of the About row -->
        <Style Selector="TextBlock.version-hint">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontFamily" Value="Consolas, 'SF Mono', 'Cascadia Code', 'Ubuntu Mono', monospace"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <!-- Primary CTA — Advanced / Simple toggle at the bottom of the
             popover. Arctic accent, full-width, slightly taller padding. -->
        <Style Selector="Button.primary-cta">
            <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primary-cta:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBgMutedBrush}"/>
        </Style>

        <!-- 1-px separator between menu sections -->
        <Style Selector="Border.menu-divider">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="Margin" Value="4,4"/>
        </Style>

        <!-- v2.25.10 fix: strip the default FlyoutPresenter chrome that
             Avalonia wraps around any Flyout content. Without this the
             popover shows: our custom Border with SurfaceBase + rounded
             corners inside a SurfaceSunken rectangle from FlyoutPresenter's
             default theme — reads as an ugly grey frame around the menu.
             FlyoutPresenterClasses="naked" targets this selector so only
             the ⋯ menu popover is affected (Flyouts from other controls
             elsewhere in the app still use the default chrome). -->
        <Style Selector="FlyoutPresenter.naked">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <!-- v2.25.8 Phase 8 polish: pulse for the warn-state VPN badge
             dot. Matches the Claude-Design handoff CSS (pulse 1.2s ease-
             out infinite, opacity 1 → 0.55 → 1). Applied via Ellipse.pulse
             class on the small indicator inside the warn pill — gives the
             user a clear "something needs attention" signal without
             shouting. Not attached to the success or off states because
             those are stable, not transient. -->
        <Style Selector="Ellipse.pulse">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.55"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- Row 0 stacks recoverable / update banners. Both default
             collapsed (IsVisible=false); StackPanel keeps the
             surrounding row layout stable when one flips on. -->
        <StackPanel Grid.Row="0" Orientation="Vertical">
            <!-- ═══ v2.32.0: settings-validator recovery banner ═══
                 Shown once after SettingsValidator rejected a
                 structurally-valid but semantically-broken config.yaml
                 (typoed config_mode, port out of range, malformed URL,
                 etc.) and the loader rewrote defaults. Dismissible —
                 the underlying SettingsLoader.LastRecoveryNotice was
                 already consumed at VM-ctor time so this only fires
                 once per session. -->
            <Border IsVisible="{Binding HasSettingsRecoveryNotice}"
                    Background="{DynamicResource WarningBgBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0"
                               Text="⚠"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource WarningFgBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding SettingsRecoveryNoticeText}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource WarningFgBrush}"/>
                    <Button Grid.Column="2"
                            Content="✕"
                            Command="{Binding DismissSettingsRecoveryNoticeCommand}"
                            Padding="8,2" MinHeight="0" FontSize="11"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource WarningFgBrush}"
                            ToolTip.Tip="Dismiss"/>
                </Grid>
            </Border>

            <!-- ═══ v2.29.0-r7+ Layer 7: update receipt warning banner ═══
                 Surfaces "Last update attempt did not take effect" warning
                 that pre-r7 was log-only (and missed by users). Visible only
                 when MainWindowViewModel.HasUpdateWarning. Dismissible
                 without persisting — re-checks on every app start because
                 a stale receipt means the update genuinely didn't land. -->
            <Border IsVisible="{Binding HasUpdateWarning}"
                    Background="{DynamicResource WarningBgBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0"
                               Text="⚠"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource WarningFgBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding UpdateWarningText}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource WarningFgBrush}"/>
                    <Button Grid.Column="2"
                            Content="✕"
                            Command="{Binding DismissUpdateWarningCommand}"
                            Padding="8,2" MinHeight="0" FontSize="11"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource WarningFgBrush}"
                            ToolTip.Tip="Dismiss"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ═══ Compact header (v2.25.0 redesign) ═══
             One-row header, tight grid:
                 [28 px logo] [brand name + status badges] [◂ Simple] [⋯]

             Before v2.25.0 the header carried a 3-line block — brand name,
             "by NiniTux · v2.x.y · sing-box 1.13.x", and the badge row. The
             by-line + version moved into a dedicated About dialog (⋯ menu →
             О приложении) so the header stays a single row even when the
             window is narrow. VPN/Zapret/TG badges continue to act both as
             status indicators and as navigation shortcuts — identical
             command bindings to v2.24.4. Changes:
               • logo container 40 → 28 px (matches design handoff)
               • VersionText subtitle removed from header
               • brand name drops a font weight (13 bold → 12 bold) so the
                 badge row reads as the primary visual anchor
               • "О приложении" menu item added, opens AboutWindow dialog
             -->
        <Border Grid.Row="1" Padding="12,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                Background="{DynamicResource SurfaceBaseBrush}">
            <Grid ColumnDefinitions="28,*,Auto,Auto" ColumnSpacing="10">
                <!-- v2.32.0 parity audit F-02 row 1: SimplePage now owns its
                     own mini-header (mascot + brand + chips) so that
                     PageScreenshotTests captures show the brand identity
                     even when the page is rendered standalone (no
                     MainWindow chrome). At runtime in Simple mode we hide
                     these two columns to avoid duplicating the brand row;
                     the kebab/mode-toggle in columns 2-3 stays visible. -->
                <Border Grid.Column="0" Width="28" Height="28"
                        CornerRadius="{StaticResource RadiusSm}"
                        Background="{DynamicResource AccentBgSubtleBrush}"
                        ClipToBounds="True"
                        VerticalAlignment="Center"
                        IsVisible="{Binding !IsSimpleMode}">
                    <Image Source="{Binding LogoSource}"
                           Width="26" Height="26" Stretch="Uniform"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"
                            IsVisible="{Binding !IsSimpleMode}">
                    <TextBlock Text="Virtual Penguin Network"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!-- VPN pill-chip — 3 states via IsVisible.
                             Same Simple v2.18.3 style; NavigateToVpnCommand
                             already no-ops in Simple mode and switches to
                             Manual/Subscribe tab in Advanced. -->
                        <Button Command="{Binding NavigateToVpnCommand}"
                                ToolTip.Tip="{Binding VpnBadgeTooltip}"
                                Padding="5,1" MinHeight="0"
                                Background="{DynamicResource SuccessBgBrush}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource RadiusPill}"
                                Cursor="Hand"
                                IsVisible="{Binding SimpleStatusIsOn}">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <Ellipse Width="4" Height="4" VerticalAlignment="Center"
                                         Fill="{DynamicResource SuccessSolidBrush}"/>
                                <TextBlock Text="VPN" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessFgBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateToVpnCommand}"
                                ToolTip.Tip="{Binding VpnBadgeTooltip}"
                                Padding="5,1" MinHeight="0"
                                Background="{DynamicResource WarningBgBrush}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource RadiusPill}"
                                Cursor="Hand"
                                IsVisible="{Binding SimpleStatusIsWarn}">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <!-- v2.25.8: Ellipse.pulse animates opacity 1→0.55→1
                                     over 1.2s continuously while the VPN is in the
                                     "warn" state. See Window.Styles for the animation
                                     definition. -->
                                <Ellipse Classes="pulse"
                                         Width="4" Height="4" VerticalAlignment="Center"
                                         Fill="{DynamicResource WarningSolidBrush}"/>
                                <TextBlock Text="VPN" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningFgBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateToVpnCommand}"
                                ToolTip.Tip="{Binding VpnBadgeTooltip}"
                                Padding="5,1" MinHeight="0"
                                Background="{DynamicResource SurfaceSunkenBrush}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource RadiusPill}"
                                Cursor="Hand"
                                IsVisible="{Binding SimpleStatusIsOff}">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <Ellipse Width="4" Height="4" VerticalAlignment="Center"
                                         Fill="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="VPN" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- v2.21.0: Zapret + TG chips hidden on Linux —
                             both features are Windows-only (winws.exe via
                             Cygwin, Python embeddable we ship only for Win). -->
                        <Button Command="{Binding NavigateToZapretCommand}"
                                ToolTip.Tip="{Binding ZapretBadgeTooltip}"
                                IsVisible="{Binding IsZapretAvailable}"
                                Padding="5,1" MinHeight="0"
                                Background="{Binding ZapretBadgeBrush}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource RadiusPill}"
                                Cursor="Hand">
                            <TextBlock Text="Zapret" FontSize="9" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Button>

                        <Button Command="{Binding NavigateToTgProxyCommand}"
                                ToolTip.Tip="{Binding TgProxyBadgeTooltip}"
                                IsVisible="{Binding IsTgProxyAvailable}"
                                Padding="5,1" MinHeight="0"
                                Background="{Binding TgProxyBadgeBrush}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource RadiusPill}"
                                Cursor="Hand">
                            <TextBlock Text="TG" FontSize="9" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- v2.20.0: "◂ Simple" ghost-button, shown only in Advanced.
                     Previous accent-subtle + border version (v2.19.1) looked
                     like a status chip and visually competed with VPN/Zapret/TG.
                     Mode-switch is navigation, not status — render as a
                     subtle accent-fg text control with transparent background
                     so it sits quietly in the top-right corner until hovered.
                     In Simple mode the big Advanced card on the page handles
                     the opposite direction, so this slot stays hidden. -->
                <Button Grid.Column="2"
                        Command="{Binding ToggleUiModeCommand}"
                        Content="{Binding UiModeToggleText}"
                        ToolTip.Tip="{Binding UiModeToggleTooltip}"
                        IsVisible="{Binding !IsSimpleMode}"
                        Padding="8,4" MinHeight="0"
                        FontSize="11" FontWeight="SemiBold"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource AccentFgBrush}"
                        CornerRadius="{StaticResource RadiusSm}"
                        VerticalAlignment="Center"
                        Cursor="Hand">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
                        </Style>
                    </Button.Styles>
                </Button>

                <!-- ⋯ flyout — redesigned in v2.25.2 per Claude Design handoff
                     (AdvancedMode.html section 1). Layout top-down:
                       • "Вид" label
                       • Light | Dark   segmented control
                       • RU | EN         segmented control
                       • Divider
                       • "Диагностика"  label
                       • Открыть логи / Проверить утечку IP / Проверить обновления
                       • Divider
                       • "Устранение неполадок" label
                       • Run Health Check / Safe Mode / Reset config
                       • Divider
                       • О приложении (with version pill)
                       • Advanced / Simple toggle (primary arctic CTA)

                     Implementation notes:
                       • Swapped MenuFlyout → regular Flyout, because MenuFlyout
                         doesn't support non-MenuItem children (section labels
                         or segmented controls). The content is a fully
                         custom StackPanel styled with inline Classes.
                       • Segment buttons bind to SetTheme{Light,Dark} /
                         SetLanguage{Russian,English} (new in v2.25.2)
                         rather than toggle commands — clicking the already-
                         active segment is a no-op.
                       • Classes.active="{Binding !IsDarkTheme}" is the
                         idiomatic way to attach a style class conditionally.
                       • Flyout Placement defaults to Bottom; we anchor to
                         the right edge so the popover doesn't overflow off
                         the left side of the narrow (520 px) window. -->
                <Button Grid.Column="3" Width="28" Height="28" Padding="0"
                        FontSize="15" FontWeight="Bold"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="{StaticResource RadiusSm}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                    <Button.Content>⋯</Button.Content>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight"
                                ShowMode="TransientWithDismissOnPointerMoveAway"
                                FlyoutPresenterClasses="naked">
                            <Border Width="232"
                                    Background="{DynamicResource SurfaceBaseBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}"
                                    Padding="6">
                                <StackPanel Spacing="1">

                                    <!-- Section: Вид -->
                                    <TextBlock Classes="section-label"
                                               Text="{Binding L_SmpMenuViewSection}"/>

                                    <!-- Theme segmented: Light | Dark -->
                                    <Border Classes="segment-container">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
                                            <Button Grid.Column="0"
                                                    Classes="segment"
                                                    Classes.active="{Binding !IsDarkTheme}"
                                                    Command="{Binding SetThemeLightCommand}"
                                                    Content="{Binding L_SmpSegLight}"/>
                                            <Button Grid.Column="1"
                                                    Classes="segment"
                                                    Classes.active="{Binding IsDarkTheme}"
                                                    Command="{Binding SetThemeDarkCommand}"
                                                    Content="{Binding L_SmpSegDark}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Language segmented: RU | EN -->
                                    <Border Classes="segment-container">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
                                            <Button Grid.Column="0"
                                                    Classes="segment"
                                                    Classes.active="{Binding IsRussian}"
                                                    Command="{Binding SetLanguageRussianCommand}"
                                                    Content="{Binding L_SmpSegRu}"/>
                                            <Button Grid.Column="1"
                                                    Classes="segment"
                                                    Classes.active="{Binding !IsRussian}"
                                                    Command="{Binding SetLanguageEnglishCommand}"
                                                    Content="{Binding L_SmpSegEn}"/>
                                        </Grid>
                                    </Border>

                                    <Border Classes="menu-divider"/>

                                    <!-- Section: Диагностика -->
                                    <TextBlock Classes="section-label"
                                               Text="{Binding L_SmpMenuDiagnosticsSection}"/>

                                    <Button Classes="menu-item"
                                            Command="{Binding OpenLogsCommand}"
                                            Content="{Binding L_SmpMenuOpenLogs}"
                                            ToolTip.Tip="{Binding L_TipOpenLogs}"/>
                                    <Button Classes="menu-item"
                                            Command="{Binding OpenLeakTestCommand}"
                                            Content="{Binding L_SmpMenuCheckLeaks}"
                                            ToolTip.Tip="{Binding L_TipIpLeak}"/>
                                    <!-- v2.30.7-r2 (AU-11 fix): Content was bound to the
                                         static L_SmpMenuCheckUpdates so users got NO feedback
                                         after clicking — CheckLinkText observable on UpdateVm
                                         already cycles "Checking…" → "Up to date" / "Update
                                         available" / "Check failed" → reset to "Check for
                                         updates" after 3s. Now: bind to that observable so the
                                         click reflects in the menu label. -->
                                    <Button Classes="menu-item"
                                            Command="{Binding UpdateVm.CheckManuallyCommand}"
                                            Content="{Binding UpdateVm.CheckLinkText}"/>

                                    <Border Classes="menu-divider"/>

                                    <!-- Section: Устранение неполадок -->
                                    <TextBlock Classes="section-label"
                                               Text="{Binding L_SmpMenuTroubleshootingSection}"/>

                                    <Button Classes="menu-item"
                                            Command="{Binding RunHealthCheckCommand}"
                                            Content="{Binding L_SmpMenuHealthCheck}"
                                            ToolTip.Tip="{Binding L_TipSmpMenuHealthCheck}"/>
                                    <Button Classes="menu-item"
                                            Command="{Binding RestartInSafeModeCommand}"
                                            Content="{Binding L_SmpMenuSafeMode}"
                                            ToolTip.Tip="{Binding L_TipSmpMenuSafeMode}"/>
                                    <!-- v2.30.3-r1 (UX-69 fix): destructive
                                         "Reset config" item gets Danger
                                         foreground tint so accidental clicks
                                         are less likely. -->
                                    <Button Classes="menu-item"
                                            Classes.armed="{Binding ResetConfigArmed}"
                                            Command="{Binding ResetConfigCommand}"
                                            Content="{Binding ResetConfigMenuHeader}"
                                            ToolTip.Tip="{Binding L_TipSmpMenuResetConfig}"
                                            Foreground="{DynamicResource DangerSolidBrush}"/>

                                    <Border Classes="menu-divider"/>

                                    <!-- About (with version pill on the right).
                                         v2.25.9 fix: ColumnSpacing="16" so the
                                         version tag has breathing room from the
                                         "О приложении" text. Before there was no
                                         spacing and on narrow popups the two were
                                         almost touching. -->
                                    <Button Classes="menu-item"
                                            Command="{Binding OpenAboutCommand}"
                                            ToolTip.Tip="{Binding L_TipSmpMenuAbout}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding L_SmpMenuAbout}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Classes="version-hint"
                                                       Text="{Binding AppVersionShortText}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>

                                    <!-- Advanced / Simple toggle — arctic primary CTA -->
                                    <Button Classes="primary-cta"
                                            Command="{Binding ToggleUiModeCommand}"
                                            Content="{Binding UiModeToggleText}"/>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ Update Notification ═══ -->
        <Border Grid.Row="2"
                IsVisible="{Binding UpdateVm.IsVisible}"
                Background="{DynamicResource WarningBgBrush}"
                BorderBrush="{DynamicResource WarningBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="↓ Update"
                        Command="{Binding UpdateVm.DownloadAndApplyCommand}"
                        IsVisible="{Binding !UpdateVm.IsDownloading}"
                        Background="{DynamicResource WarningSolidBrush}" Foreground="White"
                        FontWeight="Bold" Padding="14,6" CornerRadius="{StaticResource RadiusSm}"/>
                <ProgressBar DockPanel.Dock="Right"
                             Value="{Binding UpdateVm.DownloadProgress}"
                             Maximum="100"
                             Width="180" Height="20"
                             Margin="8,0,0,0"
                             IsVisible="{Binding UpdateVm.IsDownloading}"/>
                <TextBlock Text="{Binding UpdateVm.Message}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningFgBrush}"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ═══ ADVANCED: Tab strip + page area (no TabControl — direct Grid layout) ═══ -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*"
              IsVisible="{Binding !IsSimpleMode}">
            <!-- v2.25.0 — tabbar wrapped in a horizontal ScrollViewer.
                 At 520 px window width the six tabs fit comfortably, but
                 longer localised labels (e.g. EN "Applications" vs RU
                 "Приложения" vs "Free Configs") have historically clipped
                 the rightmost "Free" on narrower viewports. Hidden
                 scrollbar + horizontal overflow means the UI degrades by
                 letting the user flick instead of losing discoverability.
                 HorizontalAlignment="Left" keeps the tabs left-aligned
                 even when the ScrollViewer's content is narrower than the
                 viewport (prevents the tabs from centring which would
                 leave empty space to the left). -->
            <ScrollViewer Grid.Row="0"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalAlignment="Stretch"
                          BorderThickness="0,0,0,1"
                          BorderBrush="{DynamicResource BorderDefaultBrush}">
                <ListBox SelectedIndex="{Binding SelectedTabIndex}"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalAlignment="Left"
                         Padding="6,2">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem Content="{Binding LblTabManual}"      Padding="8,5" FontSize="12" FontWeight="SemiBold"/>
                    <ListBoxItem Content="{Binding LblTabSubscribe}"   Padding="8,5" FontSize="12" FontWeight="SemiBold"/>
                    <ListBoxItem Content="{Binding LblTabNetwork}"     Padding="8,5" FontSize="12" FontWeight="SemiBold"/>
                    <ListBoxItem Content="{Binding LblTabApps}"        Padding="8,5" FontSize="12" FontWeight="SemiBold"/>
                    <!-- v2.21.0: Tools tab hidden on Linux — its only sub-pages
                         are Zapret and TgProxy, both Windows-only. The tab
                         visibility uses IsZapretAvailable (same signal). -->
                    <ListBoxItem Content="{Binding LblTabTools}"       Padding="8,5" FontSize="12" FontWeight="SemiBold"
                                 IsVisible="{Binding IsZapretAvailable}"/>
                    <ListBoxItem Content="{Binding LblTabFreeConfigs}" Padding="8,5" FontSize="12" FontWeight="SemiBold"/>
                </ListBox>
            </ScrollViewer>

            <!-- Pages: all six live in same Grid cell, only selected one visible. -->
            <Grid Grid.Row="1">
                <pages:ServersPage      IsVisible="{Binding IsServersTabSelected}"/>
                <pages:SubscribePage    IsVisible="{Binding IsSubscribeTabSelected}"/>
                <pages:NetworkPage      IsVisible="{Binding IsNetworkTabSelected}"/>
                <pages:ApplicationsPage IsVisible="{Binding IsAppsTabSelected}"/>
                <pages:ToolsPage        IsVisible="{Binding IsToolsTabSelected}"/>
                <pages:FreeConfigsPage  IsVisible="{Binding IsFreeConfigsTabSelected}"/>
            </Grid>
        </Grid>

        <!-- ═══ SIMPLE: one-page onboarding (v2.17+) ═══ -->
        <pages:SimplePage Grid.Row="3" IsVisible="{Binding IsSimpleMode}"/>

        <!-- ═══ Footer (v2.25.0 unified) ═══
             Single-row status bar + inline compact connect button. Replaces
             the triple-stacked footer (service row · big full-width Start/Stop
             · separate status line) that existed through v2.24.x.

             Layout: `[● status-dot] [mode / server / ip …]      [▶ Start | ■ Stop]`

             Rationale for the consolidation:
               • `Autostart with Windows` checkbox lived twice in the UI
                 (footer + Settings → Autostart). Settings is the canonical
                 home; footer copy is gone.
               • ServiceVm Restart / Reinstall buttons are admin-tier and
                 rarely needed. They'll migrate into Settings → Autostart in
                 v2.25.4. For v2.25.0 they're not reachable from the footer.
               • Full-width Start/Stop button was visually overwhelming; the
                 compact version matches the Arctic design language and
                 leaves more vertical room for page content. -->
        <Border Grid.Row="4" Padding="12,7" BorderThickness="0,1,0,0"
                IsVisible="{Binding !IsSimpleMode}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                Background="{DynamicResource SurfaceRaisedBrush}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <!-- Left: status dot + text; whole block is `min-width:0`
                     (Grid * with TextTrimming) so long status lines ellide
                     instead of pushing the Stop button off-screen. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7"
                            VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             Fill="{Binding IsConnected, Converter={StaticResource StatusColorConverter}}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: inline Start/Stop. Text toggles via ConnectButtonText
                     (Start / Stop / Starting / Stopping). Same command as the
                     big button v2.24.4 exposed; only styling is reduced. -->
                <Button Grid.Column="1"
                        Content="{Binding ConnectButtonText}"
                        Command="{Binding ToggleConnectionCommand}"
                        IsEnabled="{Binding !IsConnecting}"
                        FontSize="11" FontWeight="Bold"
                        Padding="14,5" MinHeight="0"
                        HorizontalContentAlignment="Center"
                        Background="{DynamicResource AccentSolidBrush}"
                        Foreground="{DynamicResource AccentOnSolidBrush}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource RadiusSm}"/>
            </Grid>
        </Border>

        <!-- v2.31.0-r5 (F-26 follow-up): global toast overlay.
             Pre-fix the toast Border lived on NetworkPage's Rules
             sub-section, so HealthCheck/etc feedback was invisible
             unless the user happened to be on Settings → Правила.
             Moved here as the last child of the root Grid (highest
             z-order) with RowSpan=5 + Right/Bottom alignment so it
             floats above whatever page is shown. Same RulesToastText
             binding — the rules-bulk-action feedback that used to
             render here also benefits from the global scope. -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                IsVisible="{Binding RulesToastText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Padding="10,6"
                Margin="0,0,16,72"
                CornerRadius="{StaticResource RadiusSm}"
                Background="{DynamicResource SuccessBgBrush}"
                BorderBrush="{DynamicResource SuccessBorderBrush}"
                BorderThickness="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                ZIndex="100">
            <TextBlock Text="{Binding RulesToastText}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SuccessFgBrush}"/>
        </Border>
    </Grid>
</Window>

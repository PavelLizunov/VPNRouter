<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:conv="using:VPNRouter.App"
             xmlns:icons="using:VPNRouter.App.Controls"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="640"
             x:Class="VPNRouter.App.Views.Pages.SubscribePage"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">

  <UserControl.Resources>
    <conv:BoolToFontWeightConverter x:Key="ActiveFontConverter"/>
  </UserControl.Resources>


  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <Border Padding="10,8,10,10" MinHeight="{Binding $parent[ScrollViewer].Viewport.Height}">
  <Grid RowDefinitions="*,Auto,Auto,Auto" RowSpacing="8">

    <Border Grid.Row="0" Classes="list-card" MinHeight="170">
      <DockPanel>
        <Border DockPanel.Dock="Top" Classes="list-head" IsVisible="{Binding SubscriptionServers.Count}">
          <Grid ColumnDefinitions="22,*,Auto,30" ColumnSpacing="10" Margin="0,0,10,0">
            <TextBlock Grid.Column="1" Text="{Binding L_ColServer}"/>
            <TextBlock Grid.Column="2" Text="{Binding L_ColPing}"
                       ToolTip.Tip="{Binding L_ColPingTooltip}"
                       MinWidth="58" TextAlignment="Center"/>
          </Grid>
        </Border>
        <Panel>
          <ListBox x:Name="SubList"
                   Classes="server-list"
                   ItemsSource="{Binding SubscriptionServers}"
                   SelectedItem="{Binding SelectedSubscriptionServer}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ServerViewModel">
                <Border Classes="server-row" Classes.active="{Binding IsActive}">
                  <Grid ColumnDefinitions="22,*,Auto,Auto" ColumnSpacing="10" Margin="0,0,10,0">
                    <Panel Grid.Column="0" VerticalAlignment="Center">
                      <icons:Pictogram Id="radio-on" Width="18" Height="18" IsVisible="{Binding IsActive}" Foreground="{DynamicResource AccentSolidBrush}"/>
                      <icons:Pictogram Id="radio-off" Width="18" Height="18" IsVisible="{Binding !IsActive}" Foreground="{DynamicResource BorderStrongBrush}"/>
                    </Panel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                      <TextBlock Classes="server-name" Text="{Binding DisplayName}" ToolTip.Tip="{Binding DisplayName}"/>
                      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="5">
                        <Border Grid.Column="0" Classes="chip"
                                IsVisible="{Binding HostSubtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                          <TextBlock Text="{Binding HostSubtitle}"/>
                        </Border>
                        <Border Grid.Column="1" Classes="chip" ToolTip.Tip="{Binding ProtocolUseCaseTooltip}">
                          <TextBlock Text="{Binding ProtocolUseCase}"/>
                        </Border>
                        <TextBlock Grid.Column="2" Classes="server-endpoint" Text="{Binding Endpoint}" Margin="2,0,0,0"/>
                      </Grid>
                      <TextBlock Classes="server-endpoint" Text="{Binding HealthVerdictText}"
                                 IsVisible="{Binding HasHealthVerdict}"
                                 TextWrapping="Wrap"
                                 ToolTip.Tip="{Binding HealthTooltip}"/>
                    </StackPanel>

                    <Border Grid.Column="2" Classes="ping-pill"
                            Classes.good="{Binding IsPingGood}"
                            Classes.slow="{Binding IsPingSlow}"
                            Classes.bad="{Binding IsPingBad}"
                            ToolTip.Tip="{Binding HealthTooltip}">
                      <TextBlock Text="{Binding PingDisplay}"/>
                    </Border>

                    <Button Grid.Column="3" Classes="row-icon"
                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).TestServerCommand}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding !IsTesting}"
                            ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipTestTcpTls}" AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipTestTcpTls}">
                      <icons:Pictogram Id="retest"/>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Classes="empty-state" IsVisible="{Binding !SubscriptionServers.Count}">
            <Border Classes="empty-icon">
              <icons:Pictogram Id="tab-subscribe"/>
            </Border>
            <TextBlock Classes="empty-title" Text="{Binding L_SubsEmptyTitle}" IsVisible="{Binding !Subscriptions.Count}"/>
            <TextBlock Classes="empty-text" Text="{Binding L_SubsEmptyBody}" IsVisible="{Binding !Subscriptions.Count}"/>
            <TextBlock Classes="empty-title" Text="{Binding L_LblNoServers}" IsVisible="{Binding !!Subscriptions.Count}"/>
            <TextBlock Classes="empty-text" Text="{Binding L_TipRefreshSubscription}" IsVisible="{Binding !!Subscriptions.Count}"/>
          </StackPanel>
        </Panel>
      </DockPanel>
    </Border>

    <StackPanel Grid.Row="1" Spacing="6">
      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6">
        <Button Grid.Column="0" Classes="solid" Content="{Binding ServerTestButtonText}"
                Command="{Binding TestAllSubscriptionServersCommand}"
                IsEnabled="{Binding !!SubscriptionServers.Count}"
                Padding="12,5" CornerRadius="{StaticResource RadiusSm}"
                FontSize="11" FontWeight="SemiBold"
                Background="{DynamicResource SuccessSolidBrush}" Foreground="{DynamicResource SuccessOnSolidBrush}"
                ToolTip.Tip="{Binding L_TipTestAllServers}"
                AutomationProperties.Name="{Binding L_TipTestAllServers}"/>
        <Button Grid.Column="1" Content="{Binding ServerDeepButtonText}"
                Command="{Binding DeepVerifyAllSubscriptionServersCommand}"
                IsEnabled="{Binding !!SubscriptionServers.Count}"
                Padding="12,5" CornerRadius="{StaticResource RadiusSm}"
                FontSize="11" FontWeight="SemiBold"
                ToolTip.Tip="{Binding L_TipDeepVerifyServers}"
                AutomationProperties.Name="{Binding L_TipDeepVerifyServers}"/>
        <TextBlock Grid.Column="2" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding SubscriptionTestProgressText}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   FontSize="10"/>
      </Grid>
      <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="{Binding SubscriptionDeepProgressText}"
                 FontSize="10"
                 IsVisible="{Binding SubscriptionDeepProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <Border IsVisible="{Binding SubscriptionTestImplausibleWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              Padding="8,5" CornerRadius="{StaticResource RadiusSm}"
              Background="{DynamicResource WarningBgBrush}"
              BorderBrush="{DynamicResource WarningBorderBrush}"
              BorderThickness="1">
          <TextBlock icons:PictogramText.Icons="warning" icons:PictogramText.PrefixOnly="True" icons:PictogramText.Text="{Binding SubscriptionTestImplausibleWarning}"
                     FontSize="10" TextWrapping="Wrap"
                     Foreground="{DynamicResource WarningFgBrush}"/>
      </Border>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <CheckBox Grid.Column="0" IsChecked="{Binding AutoSelectBestServer}"
                  MinHeight="0" Padding="4,0"
                  ToolTip.Tip="{Binding L_AutoSelectBestTip}">
          <TextBlock Text="{Binding L_AutoSelectBest}" TextWrapping="Wrap" FontSize="11"/>
        </CheckBox>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="{Binding ConnectionIntentStatusText}"
                     FontSize="10"
                     Foreground="{DynamicResource TextMutedBrush}"
                     VerticalAlignment="Center"/>
          <ComboBox ItemsSource="{Binding ConnectionIntentChoices}"
                    SelectedIndex="{Binding ConnectionIntentIndex}"
                    FontSize="11"
                    Padding="8,5"/>
        </StackPanel>
      </Grid>
    </StackPanel>

    <StackPanel Grid.Row="2" Spacing="6" IsVisible="{Binding Subscriptions.Count}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="{Binding L_SubscriptionsSection}"
                   FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <Button Grid.Column="1"
                Command="{Binding RefreshAllSubscriptionsCommand}"
                IsEnabled="{Binding !!Subscriptions.Count}"
                FontSize="11" Padding="10,4" CornerRadius="{StaticResource RadiusSm}"
                AutomationProperties.Name="{Binding L_RefreshAll}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <icons:Pictogram Id="refresh" Width="13" Height="13" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding L_RefreshAll}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
      <ScrollViewer MaxHeight="150"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Subscriptions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SubscriptionViewModel">
              <Border Classes="form-card" Padding="10,8" Margin="0,0,0,6">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                  <CheckBox Grid.Column="0"
                            IsChecked="{Binding Enabled}"
                            AutomationProperties.Name="{Binding Name}"
                            MinHeight="0" MinWidth="0" Padding="0"
                            VerticalAlignment="Center"/>

                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                      <TextBlock Classes="server-name" Text="{Binding Name}"/>
                      <Border Grid.Column="1" Classes="chip">
                        <TextBlock Text="{Binding ServerCountText}"/>
                      </Border>
                    </Grid>
                    <TextBlock Classes="server-endpoint" Text="{Binding Url}"
                               ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipSubscriptionMetadata}"/>
                    <TextBlock Classes="server-endpoint" Text="{Binding LastRefreshedDisplay}" IsVisible="{Binding HasLastRefreshed}"/>
                    <TextBlock Text="{Binding StatusBadge}"
                               IsVisible="{Binding LastRefreshFailed}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningFgBrush}"/>
                    <TextBlock Text="{Binding UserInfoDisplay}"
                               IsVisible="{Binding HasUserInfo}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentFgBrush}"/>
                  </StackPanel>

                  <ProgressBar Grid.Column="2" IsVisible="{Binding IsRefreshing}"
                               IsIndeterminate="True"
                               Height="3" Width="40" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentSolidBrush}"/>

                  <Button Grid.Column="3" Classes="row-icon"
                          Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RefreshSubscriptionCommand}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding !IsRefreshing}"
                          ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipRefreshSubscription}" AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipRefreshSubscription}">
                    <icons:Pictogram Id="refresh"/>
                  </Button>

                  <Button Grid.Column="4" Classes="row-icon danger"
                          Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RemoveSubscriptionCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipRemoveSubscription}" AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipRemoveSubscription}">
                    <icons:Pictogram Id="delete"/>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>

    <Border Grid.Row="3" Classes="form-card" Padding="10">
      <StackPanel Spacing="8">
        <TextBlock Classes="form-title" Text="{Binding L_AddSubscriptionTitle}"/>
        <TextBox Text="{Binding NewSubName}"
                 PlaceholderText="{Binding L_SubscriptionNameHint}"
                 FontSize="11" Padding="8,6" MinHeight="32" VerticalContentAlignment="Center"
                 AutomationProperties.Name="{Binding L_SubscriptionNameHint}"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0"
                   Text="{Binding NewSubUrl}"
                   PlaceholderText="{Binding LblSubscriptionUrlHint}"
                   FontFamily="Consolas, 'SF Mono', 'Cascadia Code', 'Ubuntu Mono', monospace"
                   FontSize="11" Padding="8,6" MinHeight="32" VerticalContentAlignment="Center"
                   AutomationProperties.Name="{Binding LblSubscriptionUrlHint}"/>
          <Button Classes="solid" Grid.Column="1"
                  icons:PictogramText.Icons="add" icons:PictogramText.Content="{Binding L_AddSubscription}"
                  Command="{Binding AddSubscriptionCommand}"
                  Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentOnSolidBrush}"
                  FontSize="11" FontWeight="SemiBold"
                  Padding="16,0" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                  CornerRadius="{StaticResource RadiusSm}"
                  AutomationProperties.Name="{Binding L_AddSubscription}"/>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
  </Border>
  </ScrollViewer>
</UserControl>

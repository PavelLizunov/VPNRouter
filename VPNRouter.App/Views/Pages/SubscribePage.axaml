<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:conv="using:VPNRouter.App"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="640"
             x:Class="VPNRouter.App.Views.Pages.SubscribePage"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <conv:BoolToFontWeightConverter x:Key="ActiveFontConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto,Auto,Auto">

        <!-- Aggregated server pool (from all enabled subscriptions) -->
        <ListBox Grid.Row="0"
                 x:Name="SubList"
                 ItemsSource="{Binding SubscriptionServers}"
                 SelectedItem="{Binding SelectedSubscriptionServer}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="10,8,10,6"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ServerViewModel">
                    <Grid ColumnDefinitions="Auto,Auto,*,*,55,55,40,Auto">
                        <TextBlock Grid.Column="0" Text="●" Foreground="{DynamicResource SuccessSolidBrush}"
                                   IsVisible="{Binding IsActive}" FontSize="9"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusDot}"
                                   Foreground="{Binding StatusDotBrush}"
                                   FontSize="11" VerticalAlignment="Center"
                                   Margin="0,0,4,0"
                                   ToolTip.Tip="{Binding TestError}"/>
                        <TextBlock Grid.Column="2" Text="{Binding DisplayName}"
                                   FontWeight="{Binding IsActive, Converter={StaticResource ActiveFontConverter}}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding Server}" Opacity="0.7"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="4" Text="{Binding PingDisplay}"
                                   Opacity="0.8" FontSize="10" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                   ToolTip.Tip="{x:Static loc:Strings.TipTcpTlsPing}"/>
                        <TextBlock Grid.Column="5" Text="{Binding DeepDisplay}"
                                   Opacity="0.9" FontSize="10" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                   ToolTip.Tip="{Binding DeepError}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="6" Text="{Binding Port}" Opacity="0.5"
                                   TextAlignment="Center" FontSize="10" VerticalAlignment="Center"/>
                        <Button Grid.Column="7"
                                Content="⟳"
                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).TestServerCommand}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding !IsTesting}"
                                FontSize="10" Padding="6,1" MinHeight="0"
                                Background="Transparent" BorderThickness="0"
                                ToolTip.Tip="{x:Static loc:Strings.TipTestTcpTls}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty state -->
        <StackPanel Grid.Row="0"
                    IsVisible="{Binding !SubscriptionServers.Count}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="6">
            <TextBlock Text="{x:Static loc:Strings.LblNoServers}"
                       FontSize="13" FontWeight="SemiBold" Opacity="0.6"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Static loc:Strings.LblAddSubscriptionHint}"
                       FontSize="11" Opacity="0.4"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Subscriptions section header -->
        <Border Grid.Row="1" Padding="10,6,10,4"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderDefaultBrush}">
            <StackPanel Spacing="4">
                <!-- Test all + Deep verify + progress row -->
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="{Binding ServerTestButtonText}"
                                Command="{Binding TestAllSubscriptionServersCommand}"
                                Padding="10,4" CornerRadius="{StaticResource RadiusSm}"
                                FontSize="10"
                                Background="{DynamicResource SuccessSolidBrush}" Foreground="White"
                                ToolTip.Tip="{x:Static loc:Strings.TipTestAllServers}"/>
                        <Button Content="{Binding ServerDeepButtonText}"
                                Command="{Binding DeepVerifyAllSubscriptionServersCommand}"
                                Padding="10,4" CornerRadius="{StaticResource RadiusSm}"
                                FontSize="10"
                                Background="#7C3AED" Foreground="White"
                                ToolTip.Tip="{x:Static loc:Strings.TipDeepVerifyServers}"/>
                        <TextBlock Text="{Binding ServerTestProgressText}"
                                   VerticalAlignment="Center"
                                   FontSize="10" Opacity="0.7"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ServerDeepProgressText}"
                               FontSize="10" Opacity="0.7"
                               IsVisible="{Binding ServerDeepProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
                <!-- Subscriptions label + Refresh all -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{x:Static loc:Strings.SubscriptionsSection}"
                               FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="{x:Static loc:Strings.RefreshAll}"
                            Command="{Binding RefreshAllSubscriptionsCommand}"
                            FontSize="10" Padding="8,3" CornerRadius="{StaticResource RadiusSm}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Subscriptions list: compact 1-line cards, scrolls when >5 -->
        <ScrollViewer Grid.Row="2"
                      MaxHeight="130"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="10,0,10,2">
        <ItemsControl ItemsSource="{Binding Subscriptions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SubscriptionViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="0,1"
                          VerticalAlignment="Center">
                        <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}"
                                  MinHeight="0" Padding="2,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                   FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="4,0,6,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" FontSize="9" Opacity="0.5"
                                   VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}s · {1}">
                                    <Binding Path="LastServerCount"/>
                                    <Binding Path="LastRefreshedDisplay"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <ProgressBar Grid.Column="3" IsVisible="{Binding IsRefreshing}"
                                     IsIndeterminate="True"
                                     Height="3" Width="40" VerticalAlignment="Center"
                                     Margin="2,0,4,0" Foreground="{DynamicResource AccentSolidBrush}"/>
                        <Button Grid.Column="4" Content="🔄"
                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RefreshSubscriptionCommand}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding !IsRefreshing}"
                                FontSize="10" Padding="4,1" MinHeight="0" CornerRadius="{StaticResource RadiusXs}"
                                Background="Transparent" BorderThickness="0"
                                ToolTip.Tip="{x:Static loc:Strings.TipRefreshSubscription}"/>
                        <Button Grid.Column="5" Content="✕"
                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RemoveSubscriptionCommand}"
                                CommandParameter="{Binding}"
                                FontSize="10" Padding="4,1" MinHeight="0" CornerRadius="{StaticResource RadiusXs}"
                                Background="Transparent" BorderThickness="0"
                                Opacity="0.55"
                                ToolTip.Tip="{x:Static loc:Strings.TipRemoveSubscription}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>

        <!-- Add new subscription -->
        <Border Grid.Row="3" Padding="10,6"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderDefaultBrush}">
            <Grid ColumnDefinitions="100,*,Auto" ColumnSpacing="4">
                <TextBox Grid.Column="0"
                         Text="{Binding NewSubName}"
                         Watermark="{x:Static loc:Strings.SubscriptionNameHint}"
                         FontSize="10" Padding="6,4"/>
                <TextBox Grid.Column="1"
                         Text="{Binding NewSubUrl}"
                         Watermark="{Binding LblSubscriptionUrlHint}"
                         FontSize="10" Padding="6,4"/>
                <Button Grid.Column="2"
                        Content="{x:Static loc:Strings.AddSubscription}"
                        Command="{Binding AddSubscriptionCommand}"
                        Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentOnSolidBrush}"
                        FontSize="11" FontWeight="SemiBold"
                        Padding="12,5" CornerRadius="{StaticResource RadiusSm}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

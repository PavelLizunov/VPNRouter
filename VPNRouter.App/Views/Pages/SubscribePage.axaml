<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:conv="using:VPNRouter.App"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="640"
             x:Class="VPNRouter.App.Views.Pages.SubscribePage"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">

  <UserControl.Resources>
    <conv:BoolToFontWeightConverter x:Key="ActiveFontConverter"/>
  </UserControl.Resources>

  <!-- v2.25.3 — SubscribePage redesign per Claude Design handoff section 3.
       Shares the row-template, column-header, radio-indicator, and arctic
       active-highlight primitives with ServersPage. Diffs from ServersPage:
         • No sub-tab strip (pure subscription pool view).
         • Empty-state overlay when SubscriptionServers is empty.
         • Test all / Deep verify buttons bind to subscription-specific
           commands, not the VLESS list ones.
         • Subscriptions card-list (bottom) also re-laid-out as row-style
           cards with URL subtitle + last-refresh timestamp, matching the
           srv-row shape. -->
  <UserControl.Styles>

    <!-- Radio indicator (shared identical to ServersPage). -->
    <Style Selector="Border.rbx">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Height" Value="12"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.rbx.active">
      <Setter Property="BorderBrush" Value="{DynamicResource SuccessSolidBrush}"/>
      <Setter Property="Background" Value="{DynamicResource SuccessSolidBrush}"/>
    </Style>

    <!-- Row wrapper — arctic tint when active -->
    <Style Selector="Border.srv-row">
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.srv-row.active">
      <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
    </Style>

    <Style Selector="TextBlock.srv-name">
      <Setter Property="FontFamily" Value="Consolas, 'SF Mono', 'Cascadia Code', 'Ubuntu Mono', monospace"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Border.srv-row.active TextBlock.srv-name">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
    </Style>

    <Style Selector="TextBlock.srv-host">
      <Setter Property="FontFamily" Value="Consolas, 'SF Mono', 'Cascadia Code', 'Ubuntu Mono', monospace"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style Selector="TextBlock.srv-cell">
      <Setter Property="FontFamily" Value="Consolas, 'SF Mono', 'Cascadia Code', 'Ubuntu Mono', monospace"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.srv-col-label">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.srv-refresh">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="2"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.srv-refresh:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
    </Style>

    <Style Selector="ListBox.srv-list ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">

    <!-- Column headers — same grid definition as the row template below. -->
    <Grid Grid.Row="0" ColumnDefinitions="14,*,100,42,40,24" ColumnSpacing="8"
          Margin="18,6,18,4">
      <TextBlock Grid.Column="1" Classes="srv-col-label"
                 Text="{Binding L_ColServer}"/>
      <TextBlock Grid.Column="2" Classes="srv-col-label"
                 Text="{Binding L_ColIp}"/>
      <!-- v2.30.6-r1 (UX-32 fix): tooltip explains the "—" placeholder. -->
      <TextBlock Grid.Column="3" Classes="srv-col-label"
                 Text="{Binding L_ColPing}"
                 ToolTip.Tip="{Binding L_ColPingTooltip}"
                 HorizontalAlignment="Center"/>
      <TextBlock Grid.Column="4" Classes="srv-col-label"
                 Text="{Binding L_ColPort}"
                 HorizontalAlignment="Center"/>
    </Grid>

    <!-- Aggregated server pool -->
    <ListBox Grid.Row="1"
             x:Name="SubList"
             Classes="srv-list"
             ItemsSource="{Binding SubscriptionServers}"
             SelectedItem="{Binding SelectedSubscriptionServer}"
             BorderBrush="{DynamicResource BorderSubtleBrush}"
             BorderThickness="1"
             CornerRadius="{StaticResource RadiusSm}"
             Background="{DynamicResource SurfaceBaseBrush}"
             Margin="10,0,10,0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ServerViewModel">
          <Border Classes="srv-row" Classes.active="{Binding IsActive}">
            <Grid ColumnDefinitions="14,*,100,42,40,24" ColumnSpacing="8">

              <Border Grid.Column="0" Classes="rbx" Classes.active="{Binding IsActive}">
                <Ellipse Width="4" Height="4" Fill="White"
                         IsVisible="{Binding IsActive}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>

              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock Classes="srv-name" Text="{Binding DisplayName}"/>
                <TextBlock Classes="srv-host" Text="{Binding HostSubtitle}"
                           IsVisible="{Binding HostSubtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>

              <TextBlock Grid.Column="2" Classes="srv-cell"
                         Text="{Binding Server}"
                         TextTrimming="CharacterEllipsis"/>

              <TextBlock Grid.Column="3" Classes="srv-cell"
                         Text="{Binding PingDisplay}"
                         Foreground="{Binding StatusDotBrush}"
                         HorizontalAlignment="Center"
                         ToolTip.Tip="{Binding TestError}"/>

              <TextBlock Grid.Column="4" Classes="srv-cell"
                         Text="{Binding Port}"
                         HorizontalAlignment="Center"/>

              <Button Grid.Column="5" Classes="srv-refresh"
                      Content="⟳"
                      Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).TestServerCommand}"
                      CommandParameter="{Binding}"
                      IsEnabled="{Binding !IsTesting}"
                      ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipTestTcpTls}"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Empty state overlay (kept as-is — simple centred prompt) -->
    <StackPanel Grid.Row="1"
                IsVisible="{Binding !SubscriptionServers.Count}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Spacing="6">
      <TextBlock Text="{Binding L_LblNoServers}"
                 FontSize="13" FontWeight="SemiBold" Opacity="0.6"
                 HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding L_LblAddSubscriptionHint}"
                 FontSize="11" Opacity="0.4"
                 HorizontalAlignment="Center"/>
    </StackPanel>

    <!-- Section: action bar (Проверить все / Deep verify / прогресс)
         v2.31.6-r13 A11y: AutomationProperties.Name on each action
         button so screen readers announce the canonical label even
         when the visible Content has been replaced with a progress
         string ("Testing 3/7…"). Same pattern as ServersPage r9. -->
    <Border Grid.Row="2" Padding="10,6,10,4"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource BorderDefaultBrush}">
      <StackPanel Spacing="4">
        <StackPanel Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="{Binding ServerTestButtonText}"
                    Command="{Binding TestAllSubscriptionServersCommand}"
                    Padding="10,4" CornerRadius="{StaticResource RadiusSm}"
                    FontSize="10"
                    Background="{DynamicResource SuccessSolidBrush}" Foreground="White"
                    ToolTip.Tip="{Binding L_TipTestAllServers}"
                    AutomationProperties.Name="{Binding L_TipTestAllServers}"/>
            <!-- v2.25.3: arctic primary, was #7C3AED violet — same rationale
                 as in ServersPage. -->
            <Button Content="{Binding ServerDeepButtonText}"
                    Command="{Binding DeepVerifyAllSubscriptionServersCommand}"
                    Padding="10,4" CornerRadius="{StaticResource RadiusSm}"
                    FontSize="10"
                    Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentOnSolidBrush}"
                    ToolTip.Tip="{Binding L_TipDeepVerifyServers}"
                    AutomationProperties.Name="{Binding L_TipDeepVerifyServers}"/>
            <!-- v2.31.6-r15 (iter#6): Subscribe progress text now reads
                 from SubscriptionTestProgressText (separate from the
                 ServerTestProgressText used by Servers tab). Pre-r15
                 they shared one field, so a Test all on Servers left
                 stale "Pinged X/Y" text on this tab even when Subscribe
                 servers had never been tested. -->
            <TextBlock Text="{Binding SubscriptionTestProgressText}"
                       VerticalAlignment="Center"
                       FontSize="10" Opacity="0.7"/>
          </StackPanel>
          <TextBlock Text="{Binding SubscriptionDeepProgressText}"
                     FontSize="10" Opacity="0.7"
                     IsVisible="{Binding SubscriptionDeepProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <!-- v2.31.6-r15: active-VPN-intercept warning banner. Same
               pattern as ServersPage. -->
          <Border IsVisible="{Binding SubscriptionTestImplausibleWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  Padding="8,5" CornerRadius="{StaticResource RadiusSm}"
                  Background="{DynamicResource WarningBgBrush}"
                  BorderBrush="{DynamicResource WarningBorderBrush}"
                  BorderThickness="1">
              <TextBlock Text="{Binding SubscriptionTestImplausibleWarning}"
                         FontSize="10" TextWrapping="Wrap"
                         Foreground="{DynamicResource WarningFgBrush}"/>
          </Border>
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="{Binding L_SubscriptionsSection}"
                     FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
          <Button Grid.Column="1"
                  Content="{Binding L_RefreshAll}"
                  Command="{Binding RefreshAllSubscriptionsCommand}"
                  FontSize="10" Padding="8,3" CornerRadius="{StaticResource RadiusSm}"
                  AutomationProperties.Name="{Binding L_RefreshAll}"/>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Subscriptions card list — v2.25.3 re-laid-out as srv-row style.
         Each subscription is a 1-line card:
             [filled-arctic radio] [name + URL subtitle]  [timestamp]  [↻] [✕]
         Same Grid.ColumnDefinitions shape as the server rows so things
         line up vertically. -->
    <ScrollViewer Grid.Row="3"
                  MaxHeight="130"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Padding="10,2,10,2">
      <ItemsControl ItemsSource="{Binding Subscriptions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SubscriptionViewModel">
            <Border Classes="srv-row">
              <Grid ColumnDefinitions="24,*,Auto,Auto,Auto" ColumnSpacing="8"
                    VerticalAlignment="Center">

                <!-- v2.25.10 fix: column widened 14 → 24 px, CheckBox got
                     MinWidth=0/MinHeight=0/Padding=0 so Avalonia's default
                     control sizing doesn't clip the check indicator (same
                     root cause as the Settings → Routing radios). -->
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding Enabled}"
                          AutomationProperties.Name="{Binding Name}"
                          MinHeight="0" MinWidth="0" Padding="0"
                          VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                  <TextBlock Classes="srv-name" Text="{Binding Name}"/>
                  <!-- v2.31.1-r1 (F-6 / UX-33): tooltip explaining the
                       cryptic `URL · Ns · time` format. Pre-fix users
                       read "7s" as seconds and the "—" placeholder as
                       opaque. -->
                  <TextBlock Classes="srv-host"
                             ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipSubscriptionMetadata}">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0} · {1}s · {2}">
                        <Binding Path="Url"/>
                        <Binding Path="LastServerCount"/>
                        <Binding Path="LastRefreshedDisplay"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>

                <ProgressBar Grid.Column="2" IsVisible="{Binding IsRefreshing}"
                             IsIndeterminate="True"
                             Height="3" Width="40" VerticalAlignment="Center"
                             Margin="0,0,4,0" Foreground="{DynamicResource AccentSolidBrush}"/>

                <Button Grid.Column="3" Classes="srv-refresh"
                        Content="↻"
                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RefreshSubscriptionCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding !IsRefreshing}"
                        ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipRefreshSubscription}"/>

                <Button Grid.Column="4" Classes="srv-refresh"
                        Content="✕"
                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RemoveSubscriptionCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipRemoveSubscription}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Add new subscription
         v2.31.6-r13 A11y: AutomationProperties.Name on the form
         inputs and the primary blue Add button. Watermarks disappear
         after the user starts typing, so screen readers fall back to
         the explicit Name binding. -->
    <Border Grid.Row="4" Padding="10,6"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource BorderDefaultBrush}">
      <Grid ColumnDefinitions="100,*,Auto" ColumnSpacing="4">
        <TextBox Grid.Column="0"
                 Text="{Binding NewSubName}"
                 Watermark="{Binding L_SubscriptionNameHint}"
                 FontSize="10" Padding="6,4"
                 AutomationProperties.Name="{Binding L_SubscriptionNameHint}"/>
        <TextBox Grid.Column="1"
                 Text="{Binding NewSubUrl}"
                 Watermark="{Binding LblSubscriptionUrlHint}"
                 FontFamily="Consolas, 'SF Mono', 'Cascadia Code', 'Ubuntu Mono', monospace"
                 FontSize="10" Padding="6,4"
                 AutomationProperties.Name="{Binding LblSubscriptionUrlHint}"/>
        <Button Grid.Column="2"
                Content="{Binding L_AddSubscription}"
                Command="{Binding AddSubscriptionCommand}"
                Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentOnSolidBrush}"
                FontSize="11" FontWeight="SemiBold"
                Padding="12,5" CornerRadius="{StaticResource RadiusSm}"
                AutomationProperties.Name="{Binding L_AddSubscription}"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>

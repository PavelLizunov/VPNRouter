<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:conv="using:VPNRouter.App"
             xmlns:icons="using:VPNRouter.App.Controls"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="640"
             x:Class="VPNRouter.App.Views.Pages.SubscribePage"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">

  <UserControl.Resources>
    <conv:BoolToFontWeightConverter x:Key="ActiveFontConverter"/>
  </UserControl.Resources>

  <UserControl.Styles>

    <Style Selector="Border.srv-row">
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.srv-row.active">
      <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
    </Style>

    <Style Selector="TextBlock.srv-name">
      <Setter Property="FontFamily" Value="Consolas, 'SF Mono', 'Cascadia Code', 'Ubuntu Mono', monospace"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Border.srv-row.active TextBlock.srv-name">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
    </Style>

    <Style Selector="TextBlock.srv-host">
      <Setter Property="FontFamily" Value="Consolas, 'SF Mono', 'Cascadia Code', 'Ubuntu Mono', monospace"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Border.srv-use">
      <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}"/>
      <Setter Property="Padding" Value="4,0"/>
    </Style>
    <Style Selector="TextBlock.srv-use-text">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.srv-cell">
      <Setter Property="FontFamily" Value="Consolas, 'SF Mono', 'Cascadia Code', 'Ubuntu Mono', monospace"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.srv-col-label">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.srv-refresh">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="2"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.srv-refresh:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
    </Style>

    <Style Selector="ListBox.srv-list ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">

    <Grid Grid.Row="0" ColumnDefinitions="14,*,100,42,40,24" ColumnSpacing="8"
          Margin="18,6,18,4">
      <TextBlock Grid.Column="1" Classes="srv-col-label"
                 Text="{Binding L_ColServer}"/>
      <TextBlock Grid.Column="2" Classes="srv-col-label"
                 Text="{Binding L_ColIp}"/>
      <TextBlock Grid.Column="3" Classes="srv-col-label"
                 Text="{Binding L_ColPing}"
                 ToolTip.Tip="{Binding L_ColPingTooltip}"
                 HorizontalAlignment="Center"/>
      <TextBlock Grid.Column="4" Classes="srv-col-label"
                 Text="{Binding L_ColPort}"
                 HorizontalAlignment="Center"/>
    </Grid>

    <ListBox Grid.Row="1"
             x:Name="SubList"
             Classes="srv-list"
             ItemsSource="{Binding SubscriptionServers}"
             SelectedItem="{Binding SelectedSubscriptionServer}"
             BorderBrush="{DynamicResource BorderSubtleBrush}"
             BorderThickness="1"
             CornerRadius="{StaticResource RadiusSm}"
             Background="{DynamicResource SurfaceBaseBrush}"
             Margin="10,0,10,0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ServerViewModel">
          <Border Classes="srv-row" Classes.active="{Binding IsActive}">
            <Grid ColumnDefinitions="14,*,100,42,40,24" ColumnSpacing="8">

              <Panel Grid.Column="0" VerticalAlignment="Center">
                <icons:Pictogram Id="radio-on" Width="16" Height="16" IsVisible="{Binding IsActive}" Foreground="{DynamicResource SuccessSolidBrush}"/>
                <icons:Pictogram Id="radio-off" Width="16" Height="16" IsVisible="{Binding !IsActive}" Foreground="{DynamicResource BorderStrongBrush}"/>
              </Panel>

              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock Classes="srv-name" Text="{Binding DisplayName}"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                  <TextBlock Grid.Column="0" Classes="srv-host" Text="{Binding HostSubtitle}"
                             IsVisible="{Binding HostSubtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  <Border Grid.Column="1" Classes="srv-use"
                          ToolTip.Tip="{Binding ProtocolUseCaseTooltip}">
                    <TextBlock Classes="srv-use-text" Text="{Binding ProtocolUseCase}"/>
                  </Border>
                </Grid>
                <TextBlock Classes="srv-host" Text="{Binding HealthVerdictText}"
                           IsVisible="{Binding HasHealthVerdict}"
                           ToolTip.Tip="{Binding HealthTooltip}"/>
              </StackPanel>

              <TextBlock Grid.Column="2" Classes="srv-cell"
                         Text="{Binding Server}"
                         TextTrimming="CharacterEllipsis"/>

              <TextBlock Grid.Column="3" Classes="srv-cell"
                         Text="{Binding PingDisplay}"
                         Foreground="{Binding StatusDotBrush}"
                         HorizontalAlignment="Center"
                         ToolTip.Tip="{Binding HealthTooltip}"/>

              <TextBlock Grid.Column="4" Classes="srv-cell"
                         Text="{Binding Port}"
                         HorizontalAlignment="Center"/>

              <Button Grid.Column="5" Classes="srv-refresh"
                      icons:PictogramText.Icons="retest" icons:PictogramText.Content="⟳"
                      Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).TestServerCommand}"
                      CommandParameter="{Binding}"
                      IsEnabled="{Binding !IsTesting}"
                      ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipTestTcpTls}" AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipTestTcpTls}"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="1"
                IsVisible="{Binding !SubscriptionServers.Count}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Spacing="6">
      <TextBlock Text="{Binding L_LblNoServers}"
                 FontSize="13" FontWeight="SemiBold" Opacity="0.6"
                 HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding L_LblAddSubscriptionHint}"
                 FontSize="11" Opacity="0.4"
                 HorizontalAlignment="Center"/>
    </StackPanel>

    <Border Grid.Row="2" Padding="10,6,10,4"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource BorderDefaultBrush}">
      <StackPanel Spacing="4">
        <StackPanel Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="{Binding ServerTestButtonText}"
                    Command="{Binding TestAllSubscriptionServersCommand}"
                    Padding="10,4" CornerRadius="{StaticResource RadiusSm}"
                    FontSize="10"
                    Background="{DynamicResource SuccessSolidBrush}" Foreground="White"
                    ToolTip.Tip="{Binding L_TipTestAllServers}"
                    AutomationProperties.Name="{Binding L_TipTestAllServers}"/>
            <Button Content="{Binding ServerDeepButtonText}"
                    Command="{Binding DeepVerifyAllSubscriptionServersCommand}"
                    Padding="10,4" CornerRadius="{StaticResource RadiusSm}"
                    FontSize="10"
                    Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentOnSolidBrush}"
                    ToolTip.Tip="{Binding L_TipDeepVerifyServers}"
                    AutomationProperties.Name="{Binding L_TipDeepVerifyServers}"/>
            <TextBlock Text="{Binding SubscriptionTestProgressText}"
                       VerticalAlignment="Center"
                       FontSize="10" Opacity="0.7"/>
          </StackPanel>
          <TextBlock Text="{Binding SubscriptionDeepProgressText}"
                     FontSize="10" Opacity="0.7"
                     IsVisible="{Binding SubscriptionDeepProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <Border IsVisible="{Binding SubscriptionTestImplausibleWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  Padding="8,5" CornerRadius="{StaticResource RadiusSm}"
                  Background="{DynamicResource WarningBgBrush}"
                  BorderBrush="{DynamicResource WarningBorderBrush}"
                  BorderThickness="1">
              <TextBlock icons:PictogramText.Icons="warning" icons:PictogramText.PrefixOnly="True" icons:PictogramText.Text="{Binding SubscriptionTestImplausibleWarning}"
                         FontSize="10" TextWrapping="Wrap"
                         Foreground="{DynamicResource WarningFgBrush}"/>
          </Border>
        </StackPanel>
        <CheckBox IsChecked="{Binding AutoSelectBestServer}"
                  MinHeight="0" Padding="4,0"
                  ToolTip.Tip="{Binding L_AutoSelectBestTip}">
          <TextBlock Text="{Binding L_AutoSelectBest}" TextWrapping="Wrap" FontSize="11"/>
        </CheckBox>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <TextBlock Grid.Column="0"
                     Text="{Binding ConnectionIntentStatusText}"
                     FontSize="10"
                     Foreground="{DynamicResource TextMutedBrush}"
                     VerticalAlignment="Center"/>
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding ConnectionIntentChoices}"
                    SelectedIndex="{Binding ConnectionIntentIndex}"
                    FontSize="10"
                    MinHeight="0"
                    Padding="8,2"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="{Binding L_SubscriptionsSection}"
                     FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
          <Button Grid.Column="1"
                  Content="{Binding L_RefreshAll}"
                  Command="{Binding RefreshAllSubscriptionsCommand}"
                  FontSize="10" Padding="8,3" CornerRadius="{StaticResource RadiusSm}"
                  AutomationProperties.Name="{Binding L_RefreshAll}"/>
        </Grid>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="3"
                  MaxHeight="130"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Padding="10,2,10,2">
      <ItemsControl ItemsSource="{Binding Subscriptions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SubscriptionViewModel">
            <Border Classes="srv-row">
              <Grid ColumnDefinitions="24,*,Auto,Auto,Auto" ColumnSpacing="8"
                    VerticalAlignment="Center">

                <CheckBox Grid.Column="0"
                          IsChecked="{Binding Enabled}"
                          AutomationProperties.Name="{Binding Name}"
                          MinHeight="0" MinWidth="0" Padding="0"
                          VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                  <TextBlock Classes="srv-name" Text="{Binding Name}"/>
                  <TextBlock Classes="srv-host"
                             ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipSubscriptionMetadata}">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0} · {1}s · {2}">
                        <Binding Path="Url"/>
                        <Binding Path="LastServerCount"/>
                        <Binding Path="LastRefreshedDisplay"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Text="{Binding StatusBadge}"
                             IsVisible="{Binding LastRefreshFailed}"
                             FontSize="10"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource WarningFgBrush}"/>
                  <TextBlock Text="{Binding UserInfoDisplay}"
                             IsVisible="{Binding HasUserInfo}"
                             FontSize="10"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentFgBrush}"/>
                </StackPanel>

                <ProgressBar Grid.Column="2" IsVisible="{Binding IsRefreshing}"
                             IsIndeterminate="True"
                             Height="3" Width="40" VerticalAlignment="Center"
                             Margin="0,0,4,0" Foreground="{DynamicResource AccentSolidBrush}"/>

                <Button Grid.Column="3" Classes="srv-refresh"
                        icons:PictogramText.Icons="refresh" icons:PictogramText.Content="↻"
                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RefreshSubscriptionCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding !IsRefreshing}"
                        ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipRefreshSubscription}" AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipRefreshSubscription}"/>

                <Button Grid.Column="4" Classes="srv-refresh"
                        icons:PictogramText.Icons="delete" icons:PictogramText.Content="✕"
                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RemoveSubscriptionCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipRemoveSubscription}" AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipRemoveSubscription}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="4" Padding="10,6"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource BorderDefaultBrush}">
      <Grid ColumnDefinitions="100,*,Auto" ColumnSpacing="4">
        <TextBox Grid.Column="0"
                 Text="{Binding NewSubName}"
                 PlaceholderText="{Binding L_SubscriptionNameHint}"
                 FontSize="10" Padding="6,4"
                 AutomationProperties.Name="{Binding L_SubscriptionNameHint}"/>
        <TextBox Grid.Column="1"
                 Text="{Binding NewSubUrl}"
                 PlaceholderText="{Binding LblSubscriptionUrlHint}"
                 FontFamily="Consolas, 'SF Mono', 'Cascadia Code', 'Ubuntu Mono', monospace"
                 FontSize="10" Padding="6,4"
                 AutomationProperties.Name="{Binding LblSubscriptionUrlHint}"/>
        <Button Grid.Column="2"
                icons:PictogramText.Icons="add" icons:PictogramText.Content="{Binding L_AddSubscription}"
                Command="{Binding AddSubscriptionCommand}"
                Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentOnSolidBrush}"
                FontSize="11" FontWeight="SemiBold"
                Padding="12,5" CornerRadius="{StaticResource RadiusSm}"
                AutomationProperties.Name="{Binding L_AddSubscription}"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>

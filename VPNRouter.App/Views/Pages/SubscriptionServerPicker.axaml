<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:icons="using:VPNRouter.App.Controls"
             xmlns:pages="using:VPNRouter.App.Views.Pages"
             x:Class="VPNRouter.App.Views.Pages.SubscriptionServerPicker"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="SimpleServerRowTemplate" x:DataType="vm:ServerViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <Grid Width="24" Height="18" VerticalAlignment="Center">
                    <Image Source="{Binding CountryFlag}" Stretch="Uniform" ToolTip.Tip="{Binding CountryFlagTooltip}"
                           IsVisible="{Binding HasCountryFlag}" AutomationProperties.Name="{Binding CountryFlagTooltip}"/>
                    <icons:ProtocolDisc Group="{Binding ProtocolGroup}" Width="18" Height="18" GlyphSize="12"
                                        CornerRadius="9" IsVisible="{Binding !HasCountryFlag}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="2">
                        <TextBlock Text="{Binding SimpleDisplayName}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding DisplayName}"/>
                        <Border Classes="chip" IsVisible="{Binding HasTurnRelayHop}"
                                ToolTip.Tip="{Binding TurnRelayTooltip}">
                            <TextBlock Text="{Binding TurnRelayBadgeText}" FontSize="{StaticResource FsSm}"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Classes="hint" Text="{Binding SimpleLocation}" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding CanSelectInSimpleMode}" ToolTip.Tip="{Binding HealthTooltip}"/>
                    <TextBlock Classes="hint advanced-verdict" Text="{Binding HealthVerdictText}"
                               Classes.has-verdict="{Binding HasHealthVerdict}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding HealthTooltip}"/>
                    <TextBlock Classes="hint" Text="{Binding UnavailableReasonText}"
                               IsVisible="{Binding !CanSelectInSimpleMode}" TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningFgBrush}"
                               ToolTip.Tip="{Binding Endpoint}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding PingDisplay}" ToolTip.Tip="{Binding HealthTooltip}"
                               HorizontalAlignment="Right" Classes="hint"/>
                    <TextBlock IsVisible="{Binding IsActive}" Text="{x:Static loc:Strings.SmpCurrentServer}"
                               Foreground="{DynamicResource SuccessFgBrush}" FontSize="{StaticResource FsXs}"/>
                </StackPanel>
                <Button Grid.Column="3" Classes="row-icon picker-retest"
                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).TestServerCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding !IsTesting}"
                        ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipTestTcpTls}"
                        AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipTestTcpTls}">
                    <icons:Pictogram Id="retest"/>
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.category">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAppBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.category.current">
            <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
        </Style>
        <Style Selector="Button.category.disclosure">
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="ListBox.pick">
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.pick ListBoxItem">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
            <Setter Property="FontSize" Value="{StaticResource FsMd}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="ListBox.pick ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="ListBox.pick ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="ListBox.pick ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.pick ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.pick ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.pick ListBoxItem:selected:focus:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.pick ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBgMutedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="{StaticResource FsSm}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="{StaticResource FsSm}"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <Style Selector="Button.change, ToggleButton.change">
            <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6,10,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
            <Setter Property="FontSize" Value="{StaticResource FsSm}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.change:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.change:pressed /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.change:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.change:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBgMutedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
        </Style>

        <Style Selector="Button.picker-retest, TextBlock.advanced-verdict">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="pages|SubscriptionServerPicker.advanced Button.picker-retest,
                         pages|SubscriptionServerPicker.advanced TextBlock.advanced-verdict.has-verdict">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Name="SimpleServerPanel" Spacing="8"
                IsEnabled="{Binding !SimpleCtaIsConnecting}">
        <StackPanel Spacing="4">
            <TextBlock Name="PickerSelection" Classes="label" TextWrapping="Wrap"/>
            <TextBlock Name="PickerRunning" Classes="hint" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <ToggleButton Name="SimpleServerSearchButton" Classes="change" IsVisible="{Binding SmpHasSubscriptionServers}"
                      HorizontalAlignment="Left" Click="ToggleServerSearch">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <icons:Pictogram Id="search-tab" Width="14" Height="14"/>
                <TextBlock Name="SimpleServerSearchButtonLabel"/>
            </StackPanel>
        </ToggleButton>
        <StackPanel Spacing="6" IsVisible="{Binding #SimpleServerSearchButton.IsChecked, FallbackValue=False}">
            <TextBlock Name="SimpleServerSearchLabel" Classes="label"/>
            <TextBox Name="SimpleServerSearch" MinHeight="36" KeyDown="OnSearchKeyDown"/>
            <StackPanel Name="SimpleSearchLinkHint" IsVisible="False" Spacing="4">
                <TextBlock Name="SimpleSearchLinkMessage" Classes="hint" TextWrapping="Wrap"/>
                <Button Name="SimpleTransferLink" Classes="change" Click="TransferSearchLink"/>
            </StackPanel>
        </StackPanel>
        <ItemsControl Name="SimpleServerGroups">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="4"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pages:SimpleServerGroup">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <Button Classes="category" Classes.current="{Binding IsCurrent}"
                                    Click="ChooseServerCategory"
                                    IsEnabled="{Binding CanActivateCategory}"
                                    AutomationProperties.Name="{Binding AutoLabel}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <icons:ProtocolDisc Width="30" Height="30" GlyphSize="16" CornerRadius="15"
                                                        Group="{Binding Category}"/>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Classes="hint" Text="{Binding Protocols}"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Protocols}"/>
                                        <TextBlock Classes="hint" Text="{Binding SelectionHint}"
                                                   IsVisible="{Binding !CanAutoSelect}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding AutoText}" IsVisible="{Binding IsCurrent}"
                                               Foreground="{DynamicResource AccentFgBrush}"
                                               FontSize="{StaticResource FsXs}" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button Grid.Column="1" Classes="category disclosure"
                                    Click="ToggleServerCategory"
                                    AutomationProperties.Name="{Binding DisclosureLabel}"
                                    ToolTip.Tip="{Binding DisclosureLabel}">
                                <icons:Pictogram Id="chevron-down" Classes="disclosure"
                                                 Classes.open="{Binding IsExpanded}"/>
                            </Button>
                        </Grid>
                        <icons:ServerPickerListBox Classes="pick"
                                                   Margin="16,0,0,2"
                                                   IsVisible="{Binding IsExpanded}"
                                                   ItemsSource="{Binding Servers}"
                                                   SelectedItem="{Binding SelectedServer, Mode=OneWay}"
                                                   ItemTemplate="{StaticResource SimpleServerRowTemplate}"
                                                   AutomationProperties.Name="{Binding Name}"
                                                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                   Loaded="WireGroupServerList"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <icons:ServerPickerListBox Name="SimpleServerResults" Classes="pick"
                                   ItemTemplate="{StaticResource SimpleServerRowTemplate}"
                                   AutomationProperties.Name="{Binding L_SmpPickServerLabel}"
                                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        <TextBlock Name="SimplePickerEmptyState" Classes="hint" TextWrapping="Wrap"
                   IsVisible="False" Foreground="{DynamicResource WarningFgBrush}"
                   AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Name="SimpleServerCount" Classes="hint"
                   AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
</UserControl>

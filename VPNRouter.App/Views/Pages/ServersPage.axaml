<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:conv="using:VPNRouter.App"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="500"
             x:Class="VPNRouter.App.Views.Pages.ServersPage"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Resources>
        <conv:BoolToFontWeightConverter x:Key="ActiveFontConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Sub-tab strip: VLESS Servers / Custom Config -->
        <ListBox Grid.Row="0"
                 SelectedIndex="{Binding SelectedServerModeIndex}"
                 Background="Transparent"
                 BorderThickness="0,0,0,1"
                 BorderBrush="{DynamicResource BorderDefaultBrush}"
                 Padding="6,2">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBoxItem Content="{Binding LblServerModeVless}"  Padding="10,4" FontSize="11"/>
            <ListBoxItem Content="{Binding LblServerModeCustom}" Padding="10,4" FontSize="11"/>
        </ListBox>

        <!-- ═══ VLESS Panel ═══ -->
        <Grid Grid.Row="1"
              IsVisible="{Binding IsVlessMode}"
              RowDefinitions="*,Auto,Auto"
              Margin="10,8,10,4">

            <!-- Server list -->
            <ListBox Grid.Row="0"
                     x:Name="ServerList"
                     ItemsSource="{Binding Servers}"
                     SelectedItem="{Binding SelectedServer}"
                     ContextRequested="ServerList_ContextRequested"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ServerViewModel">
                        <Grid ColumnDefinitions="Auto,Auto,*,*,55,55,40,Auto">
                            <TextBlock Grid.Column="0" Text="●" Foreground="{DynamicResource SuccessSolidBrush}"
                                       IsVisible="{Binding IsActive}" FontSize="9"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding StatusDot}"
                                       Foreground="{Binding StatusDotBrush}"
                                       FontSize="11" VerticalAlignment="Center"
                                       Margin="0,0,4,0"
                                       ToolTip.Tip="{Binding TestError}"/>
                            <TextBlock Grid.Column="2" Text="{Binding DisplayName}"
                                       FontWeight="{Binding IsActive, Converter={StaticResource ActiveFontConverter}}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding Server}" Opacity="0.7"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="4" Text="{Binding PingDisplay}"
                                       Opacity="0.8" FontSize="10" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       ToolTip.Tip="{x:Static loc:Strings.TipTcpTlsPing}"/>
                            <TextBlock Grid.Column="5" Text="{Binding DeepDisplay}"
                                       Opacity="0.9" FontSize="10" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       ToolTip.Tip="{Binding DeepError}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="6" Text="{Binding Port}" Opacity="0.5"
                                       TextAlignment="Center" FontSize="10" VerticalAlignment="Center"/>
                            <Button Grid.Column="7"
                                    Content="⟳"
                                    Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).TestServerCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding !IsTesting}"
                                    FontSize="10" Padding="6,1" MinHeight="0"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTip.Tip="{x:Static loc:Strings.TipTestTcpTls}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Hints -->
            <StackPanel Grid.Row="1" Spacing="2" Margin="0,4,0,0">
                <TextBlock Text="{x:Static loc:Strings.ServerListHint}"
                           FontSize="10" Opacity="0.5"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding LblTcpUdpHint}"
                           FontSize="10" Opacity="0.6" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Server detail editor (opened via right-click) -->
            <Border Grid.Row="2"
                    IsVisible="{Binding DetailServer, Converter={x:Static ObjectConverters.IsNotNull}}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="10,8" Margin="0,6,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Content="X"
                            Command="{Binding CloseServerDetailCommand}"
                            Background="Transparent" BorderThickness="0"
                            Padding="6,0" MinHeight="0" FontSize="11" Opacity="0.6"
                            ToolTip.Tip="{x:Static loc:Strings.TipCloseServerDetail}"/>
                <Grid ColumnDefinitions="80,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      DataContext="{Binding DetailServer}"
                      x:DataType="vm:ServerViewModel">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:Strings.LblName}"      VerticalAlignment="Center" FontSize="10" Margin="0,0,0,3"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Name}"      FontSize="10" Padding="4,2" Margin="0,0,0,3"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:Strings.LblServer}"    VerticalAlignment="Center" FontSize="10" Margin="0,0,0,3"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding Server}"    FontSize="10" Padding="4,2" Margin="0,0,0,3"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static loc:Strings.LblPort}"      VerticalAlignment="Center" FontSize="10" Margin="0,0,0,3"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding Port}"      FontSize="10" Padding="4,2" Margin="0,0,0,3"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static loc:Strings.LblUuid}"      VerticalAlignment="Center" FontSize="10" Margin="0,0,0,3"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding Uuid}"      FontSize="10" Padding="4,2" Margin="0,0,0,3"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static loc:Strings.LblPublicKey}" VerticalAlignment="Center" FontSize="10" Margin="0,0,0,3"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding PublicKey}" FontSize="10" Padding="4,2" Margin="0,0,0,3"/>
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{x:Static loc:Strings.LblShortId}"   VerticalAlignment="Center" FontSize="10"/>
                    <TextBox   Grid.Row="5" Grid.Column="1" Text="{Binding ShortId}"   FontSize="10" Padding="4,2"/>
                </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ Custom Config Panel ═══ -->
        <Grid Grid.Row="1"
              IsVisible="{Binding !IsVlessMode}"
              RowDefinitions="*,Auto"
              Margin="10,8,10,4">
            <ListBox Grid.Row="0"
                     ItemsSource="{Binding CustomConfigs}"
                     SelectedItem="{Binding SelectedCustomConfig}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CustomConfigViewModel">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="O" Foreground="{DynamicResource SuccessSolidBrush}"
                                       IsVisible="{Binding IsActive}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" FontSize="9"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                       FontWeight="{Binding IsActive, Converter={StaticResource ActiveFontConverter}}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding Protocols}"
                                       Opacity="0.6" Margin="8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding Server}"
                                       Opacity="0.4" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="1" Text="{Binding LblClickToActivateConfig}"
                       FontSize="10" Opacity="0.5" Margin="0,4,0,0"/>
        </Grid>

        <!-- ═══ Bottom action bar ═══ -->
        <Border Grid.Row="2" Padding="10,6"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderDefaultBrush}">
            <StackPanel Spacing="6">
                <!-- Test all + Deep verify + progress row -->
                <StackPanel Spacing="2" IsVisible="{Binding IsVlessMode}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="{Binding ServerTestButtonText}"
                                Command="{Binding TestAllServersCommand}"
                                Padding="10,4" CornerRadius="{StaticResource RadiusSm}"
                                FontSize="10"
                                Background="{DynamicResource SuccessSolidBrush}" Foreground="White"
                                ToolTip.Tip="{x:Static loc:Strings.TipTestAllServers}"/>
                        <Button Content="{Binding ServerDeepButtonText}"
                                Command="{Binding DeepVerifyAllServersCommand}"
                                Padding="10,4" CornerRadius="{StaticResource RadiusSm}"
                                FontSize="10"
                                Background="#7C3AED" Foreground="White"
                                ToolTip.Tip="{x:Static loc:Strings.TipDeepVerifyServers}"/>
                        <TextBlock Text="{Binding ServerTestProgressText}"
                                   VerticalAlignment="Center"
                                   FontSize="10" Opacity="0.7"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ServerDeepProgressText}"
                               FontSize="10" Opacity="0.7"
                               IsVisible="{Binding ServerDeepProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <!-- VLESS: URI input + Add/Remove -->
                <DockPanel IsVisible="{Binding IsVlessMode}" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="{Binding LblAddServers}"
                            Command="{Binding AddServerCommand}"
                            Margin="6,0,0,0"
                            Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentOnSolidBrush}"
                            Padding="14,5" CornerRadius="{StaticResource RadiusSm}" FontWeight="SemiBold"/>
                    <Button DockPanel.Dock="Right" Content="{Binding LblRemove}"
                            Command="{Binding RemoveServerCommand}"
                            Margin="6,0,0,0"
                            Padding="14,5" CornerRadius="{StaticResource RadiusSm}"/>
                    <TextBox Text="{Binding VlessUri}"
                             Watermark="{x:Static loc:Strings.WmVlessUri}"
                             FontSize="10" Padding="6,4"
                             AcceptsReturn="False"/>
                </DockPanel>
                <!-- Custom Config buttons -->
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding !IsVlessMode}">
                    <Button Content="{Binding LblAddConfig}"
                            Command="{Binding AddCustomConfigCommand}"
                            Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentOnSolidBrush}"
                            Padding="14,5" CornerRadius="{StaticResource RadiusSm}" FontWeight="SemiBold"/>
                    <Button Content="{Binding LblRemove}"
                            Command="{Binding RemoveCustomConfigCommand}"
                            Padding="14,5" CornerRadius="{StaticResource RadiusSm}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

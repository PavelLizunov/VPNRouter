<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:conv="using:VPNRouter.App"
             xmlns:icons="using:VPNRouter.App.Controls"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="500"
             x:Class="VPNRouter.App.Views.Pages.ServersPage"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.Resources>
    <conv:BoolToFontWeightConverter x:Key="ActiveFontConverter"/>
  </UserControl.Resources>


  <Grid RowDefinitions="Auto,*,Auto">

    <ListBox Grid.Row="0" Classes="hk-segs" Margin="10,8,10,6"
             SelectedIndex="{Binding SelectedServerModeIndex}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1"/>
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBoxItem Content="{Binding LblServerModeVless}"/>
      <ListBoxItem Content="{Binding LblServerModeCustom}"/>
    </ListBox>

    <Grid Grid.Row="1"
          IsVisible="{Binding IsVlessMode}"
          RowDefinitions="Auto,*,Auto,Auto"
          Margin="10,8,10,4">

      <Border Grid.Row="0" Grid.RowSpan="2" Classes="list-card" MinHeight="170">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="list-head" IsVisible="{Binding Servers.Count}">
            <Grid ColumnDefinitions="22,*,Auto,70" ColumnSpacing="10">
              <TextBlock Grid.Column="1" Text="{Binding L_ColServer}"/>
              <TextBlock Grid.Column="2" Text="{Binding L_ColPing}"
                         ToolTip.Tip="{Binding L_ColPingTooltip}"
                         MinWidth="58" TextAlignment="Center"/>
            </Grid>
          </Border>
          <Panel>
            <ListBox x:Name="ServerList"
                     Classes="server-list"
                     ItemsSource="{Binding Servers}"
                     SelectedItem="{Binding SelectedServer}"
                     ContextRequested="ServerList_ContextRequested"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ServerViewModel">
                  <Border Classes="server-row" Classes.active="{Binding IsActive}">
                    <Grid ColumnDefinitions="22,*,Auto,Auto,Auto" ColumnSpacing="10">
                      <Panel Grid.Column="0" VerticalAlignment="Center">
                        <icons:Pictogram Id="radio-on" Width="18" Height="18" IsVisible="{Binding IsActive}" Foreground="{DynamicResource AccentSolidBrush}"/>
                        <icons:Pictogram Id="radio-off" Width="18" Height="18" IsVisible="{Binding !IsActive}" Foreground="{DynamicResource BorderStrongBrush}"/>
                      </Panel>

                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                          <TextBlock Classes="server-name" Text="{Binding DisplayName}" ToolTip.Tip="{Binding DisplayName}"/>
                          <Border Grid.Column="1" Classes="chip warn"
                                  IsVisible="{Binding IsOrphanFromSubscription}"
                                  ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_ServersOrphanTooltip}">
                            <TextBlock Text="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_ServersOrphanBadge}"/>
                          </Border>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="5">
                          <Border Grid.Column="0" Classes="chip"
                                  IsVisible="{Binding HostSubtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding HostSubtitle}"/>
                          </Border>
                          <Border Grid.Column="1" Classes="chip" ToolTip.Tip="{Binding ProtocolUseCaseTooltip}">
                            <TextBlock Text="{Binding ProtocolUseCase}"/>
                          </Border>
                          <TextBlock Grid.Column="2" Classes="server-endpoint" Text="{Binding Endpoint}" Margin="2,0,0,0"/>
                        </Grid>
                        <TextBlock Classes="server-endpoint" Text="{Binding HealthVerdictText}"
                                   IsVisible="{Binding HasHealthVerdict}"
                                   TextWrapping="Wrap"
                                   ToolTip.Tip="{Binding HealthTooltip}"/>
                      </StackPanel>

                      <Border Grid.Column="2" Classes="ping-pill"
                              Classes.good="{Binding IsPingGood}"
                              Classes.slow="{Binding IsPingSlow}"
                              Classes.bad="{Binding IsPingBad}"
                              ToolTip.Tip="{Binding HealthTooltip}">
                        <TextBlock Text="{Binding PingDisplay}"/>
                      </Border>

                      <Button Grid.Column="3" Classes="row-icon"
                              Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).TestServerCommand}"
                              CommandParameter="{Binding}"
                              IsEnabled="{Binding !IsTesting}"
                              ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipTestTcpTls}" AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipTestTcpTls}">
                        <icons:Pictogram Id="retest"/>
                      </Button>

                      <Button Grid.Column="4" Classes="row-icon danger"
                              Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RemoveServerByEntryCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipDeleteServer}" AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipDeleteServer}">
                        <icons:Pictogram Id="delete"/>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Classes="empty-state" IsVisible="{Binding !Servers.Count}">
              <Border Classes="empty-icon">
                <icons:Pictogram Id="tab-servers"/>
              </Border>
              <TextBlock Classes="empty-title" Text="{Binding L_SrvEmptyTitle}"/>
              <TextBlock Classes="empty-text" Text="{Binding L_SrvEmptyBody}"/>
            </StackPanel>
          </Panel>
        </DockPanel>
      </Border>

      <TextBlock Foreground="{DynamicResource TextMutedBrush}" Grid.Row="2"
                 Text="{Binding LblTcpUdpHint}"
                 FontSize="10" TextWrapping="Wrap"
                 Margin="4,6,0,0"/>

      <Border Grid.Row="3"
              IsVisible="{Binding DetailServer, Converter={x:Static ObjectConverters.IsNotNull}}"
              BorderBrush="{DynamicResource BorderDefaultBrush}"
              BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="10,8" Margin="0,6,0,0">
        <DockPanel>
          <Button DockPanel.Dock="Top" HorizontalAlignment="Right" icons:PictogramText.Icons="close" icons:PictogramText.Content="X"
                  Command="{Binding CloseServerDetailCommand}"
                  Background="Transparent" BorderThickness="0"
                  Padding="6,0" MinHeight="0" FontSize="11" Opacity="0.6"
                  ToolTip.Tip="{Binding L_TipCloseServerDetail}" AutomationProperties.Name="{Binding L_TipCloseServerDetail}"/>
          <Grid ColumnDefinitions="80,*"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                DataContext="{Binding DetailServer}"
                x:DataType="vm:ServerViewModel">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_LblName}"      VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
            <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Name}"      FontSize="11" Padding="8,5" Margin="0,0,0,6" CornerRadius="{StaticResource RadiusSm}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_LblServer}"    VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding Server}"    FontSize="11" Padding="8,5" Margin="0,0,0,6" CornerRadius="{StaticResource RadiusSm}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_LblPort}"      VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
            <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding Port}"      FontSize="11" Padding="8,5" Margin="0,0,0,6" CornerRadius="{StaticResource RadiusSm}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_LblUuid}"      VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
            <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding Uuid}"      FontSize="11" Padding="8,5" Margin="0,0,0,6" CornerRadius="{StaticResource RadiusSm}"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_LblPublicKey}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
            <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding PublicKey}" FontSize="11" Padding="8,5" Margin="0,0,0,6" CornerRadius="{StaticResource RadiusSm}"/>
            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_LblShortId}"   VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox   Grid.Row="5" Grid.Column="1" Text="{Binding ShortId}"   FontSize="11" Padding="8,5" CornerRadius="{StaticResource RadiusSm}"/>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1"
          IsVisible="{Binding !IsVlessMode}"
          RowDefinitions="*,Auto"
          Margin="10,8,10,4">
      <Grid Grid.Row="0">
        <ListBox ItemsSource="{Binding CustomConfigs}"
                 SelectedItem="{Binding SelectedCustomConfig}"
                 BorderBrush="{DynamicResource BorderSubtleBrush}"
                 BorderThickness="1"
                 CornerRadius="{StaticResource RadiusSm}"
                 Background="{DynamicResource SurfaceBaseBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CustomConfigViewModel">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0" icons:PictogramText.Icons="status" icons:PictogramText.Text="●" Foreground="{DynamicResource SuccessSolidBrush}"
                           IsVisible="{Binding IsActive}"
                           VerticalAlignment="Center" Margin="0,0,6,0" FontSize="9"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}"
                           FontWeight="{Binding IsActive, Converter={StaticResource ActiveFontConverter}}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding Protocols}" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding Server}" FontSize="10"
                           FontFamily="Consolas, 'SF Mono', monospace"
                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    MaxWidth="380"
                    IsVisible="{Binding !CustomConfigs.Count}">
          <TextBlock Text="{Binding L_CustomConfigsEmptyTitle}"
                     FontSize="13" FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Text="{Binding L_CustomConfigsEmptyHint}"
                     FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                     TextWrapping="Wrap"
                     TextAlignment="Center"/>
        </StackPanel>
      </Grid>
      <TextBlock Grid.Row="1" Text="{Binding LblClickToActivateConfig}"
                 FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"
                 IsVisible="{Binding CustomConfigs.Count}"/>
    </Grid>

    <Border Grid.Row="2" Padding="10,6"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource BorderDefaultBrush}">
      <StackPanel Spacing="6">
        <StackPanel Spacing="2" IsVisible="{Binding IsVlessMode}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="solid" Content="{Binding ServerTestButtonText}"
                    Command="{Binding TestAllServersCommand}"
                    IsEnabled="{Binding !!Servers.Count}"
                    Padding="10,4" CornerRadius="{StaticResource RadiusSm}"
                    FontSize="10"
                    Background="{DynamicResource SuccessSolidBrush}" Foreground="{DynamicResource SuccessOnSolidBrush}"
                    ToolTip.Tip="{Binding L_TipTestAllServers}"
                    AutomationProperties.Name="{Binding L_TipTestAllServers}"/>
            <Button Classes="solid" Content="{Binding ServerDeepButtonText}"
                    Command="{Binding DeepVerifyAllServersCommand}"
                    IsEnabled="{Binding !!Servers.Count}"
                    Padding="10,4" CornerRadius="{StaticResource RadiusSm}"
                    FontSize="10"
                    Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentOnSolidBrush}"
                    ToolTip.Tip="{Binding L_TipDeepVerifyServers}"
                    AutomationProperties.Name="{Binding L_TipDeepVerifyServers}"/>
            <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="{Binding ServerTestProgressText}"
                       VerticalAlignment="Center"
                       FontSize="10"/>
          </StackPanel>
          <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="{Binding ServerDeepProgressText}"
                     FontSize="10"
                     IsVisible="{Binding ServerDeepProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <Border IsVisible="{Binding ServerTestImplausibleWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  Padding="8,5" CornerRadius="{StaticResource RadiusSm}"
                  Background="{DynamicResource WarningBgBrush}"
                  BorderBrush="{DynamicResource WarningBorderBrush}"
                  BorderThickness="1">
              <TextBlock icons:PictogramText.Icons="warning" icons:PictogramText.PrefixOnly="True" icons:PictogramText.Text="{Binding ServerTestImplausibleWarning}"
                         FontSize="10" TextWrapping="Wrap"
                         Foreground="{DynamicResource WarningFgBrush}"/>
          </Border>
        </StackPanel>

        <!-- The link box takes the full width on its own row (a link is long and was squeezed between two buttons at 360 px); the buttons sit below it. -->
        <Border Classes="form-card" IsVisible="{Binding IsVlessMode}" Padding="10">
          <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
            <TextBox Grid.Row="0" Text="{Binding VlessUri}"
                     PlaceholderText="{Binding L_WmVlessUri}"
                     FontFamily="Consolas, 'SF Mono', 'Cascadia Code', 'Ubuntu Mono', monospace"
                     FontSize="11" Padding="8,6" MinHeight="32"
                     VerticalContentAlignment="Center"
                     AcceptsReturn="False"
                     AutomationProperties.Name="{Binding L_WmVlessUri}"/>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <Button Grid.Column="0" Content="{Binding LblRemove}"
                      Command="{Binding RemoveServerCommand}"
                      Classes="danger-soft"
                      Padding="14,6" CornerRadius="{StaticResource RadiusSm}"
                      AutomationProperties.Name="{Binding L_TipDeleteServer}"/>
              <Button Grid.Column="2" Classes="solid"
                      Command="{Binding AddServerCommand}"
                      Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentOnSolidBrush}"
                      Padding="16,6" CornerRadius="{StaticResource RadiusSm}" FontWeight="SemiBold"
                      AutomationProperties.Name="{Binding LblAddServers}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <icons:Pictogram Id="add" Width="14" Height="14" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding LblAddServers}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Grid>
          </Grid>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8"
                    IsVisible="{Binding !IsVlessMode}">
          <Button Classes="solid" Content="{Binding LblAddConfig}"
                  Command="{Binding AddCustomConfigCommand}"
                  Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentOnSolidBrush}"
                  Padding="14,5" CornerRadius="{StaticResource RadiusSm}" FontWeight="SemiBold"
                  AutomationProperties.Name="{Binding LblAddConfig}"/>
          <Button Content="{Binding LblRemove}"
                  Command="{Binding RemoveCustomConfigCommand}"
                  Padding="14,5" CornerRadius="{StaticResource RadiusSm}"
                  AutomationProperties.Name="{Binding LblRemove}"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

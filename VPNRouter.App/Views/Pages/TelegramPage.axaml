<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:conv="using:VPNRouter.App"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="500"
             x:Class="VPNRouter.App.Views.Pages.TelegramPage"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <conv:BoolToStatusColorConverter x:Key="StatusColorConverter"/>
    </UserControl.Resources>

    <!--
      v2.31.6-r3 — strict redo per `C:/tmp/vpnrouter-design/.../AdvancedMode.html`
      cell 6 (Инструменты → TgProxy).

      Pre-r3 (v2.31.6-r1/r2 "Variant A"):
        - I proposed and shipped a two-state cascade with onboarding CTA +
          Advanced expander hiding port/secret/version/folder/GitHub.
        - User reverse course: «ты не сверился с дизайном». Rule B4
          violation — design has all controls visible, just better
          organised.

      r3 lays out exactly per the design handoff:
        1. Description paragraph (italic small, text-secondary).
        2. 2-column grid 120 px + 1fr:
             Col 1 — ПОРТ caption (uppercase 9 px tracking-caps muted
                     semibold) + centred Port input.
             Col 2 — SECRET caption + (input | Copy | New) sub-grid.
        3. Info banner: ⓘ + "PID … · v… · running on :…" status line
           + ↻ Update button on the right.
        4. 3-button row — Open in Telegram (primary blue), Open folder,
           GitHub (secondary). Wrap so they reflow on narrow widths.
        5. Note paragraph — bold "Setup in Telegram:" + the manual route
           through Telegram Settings → Advanced → Connection type →
           MTProto Proxy + the "click 'Open in Telegram' once" hint.
        6. Footer toggle — secondary "Start/Stop Telegram Proxy" per
           v2.25.6 design intent ("don't fight global Start/Stop VPN").

      The IsTgProxySetUp + SetupTgProxyAsync VM additions from r1 stay
      wired internally — "Open in Telegram" button now drives the full
      one-click setup chain (download → start → open) on first click,
      and falls through to plain OpenTgProxyInTelegramCommand once the
      proxy is up. Two-state cascade in the visual layout is dropped.
    -->

    <Grid RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      AllowAutoHide="False"
                      Padding="0,10,0,10">
            <Grid Margin="12,0,14,0">
                <StackPanel Spacing="12">

                    <!-- 1. Description (per design `desc` class). -->
                    <TextBlock Text="{Binding LblTgProxyDescription}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               LineHeight="16"
                               Opacity="0.7"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <!-- 2. 2-column grid: Порт (120 px) | Secret (1fr). -->
                    <Grid ColumnDefinitions="120,*" ColumnSpacing="12">

                        <!-- Col 1: Порт -->
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="{Binding L_TgProxyPort}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Opacity="0.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       LetterSpacing="0.5"/>
                            <TextBox Text="{Binding TgProxyPort}"
                                     Watermark="{Binding L_WmTgProxyPort}"
                                     FontSize="11" Padding="6,4"
                                     HorizontalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Col 2: Secret + Copy + New -->
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="{Binding L_TgProxySecret}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Opacity="0.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       LetterSpacing="0.5"/>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                <TextBox Grid.Column="0"
                                         Text="{Binding TgProxySecret}"
                                         Watermark="{Binding L_WmTgProxySecret}"
                                         FontSize="10" Padding="6,4"
                                         FontFamily="Consolas,Courier New,monospace"
                                         IsReadOnly="True"/>
                                <Button Grid.Column="1"
                                        Content="{Binding L_TgProxyCopy}"
                                        Command="{Binding CopyTgProxySecretCommand}"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <Button Grid.Column="2"
                                        Content="{Binding L_TgProxyRegenerate}"
                                        Command="{Binding RegenerateTgProxySecretCommand}"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                            </Grid>
                        </StackPanel>

                    </Grid>

                    <!-- 3. Info banner — status line + Update button.
                         Per design `banner` class: surface-base bg with
                         info icon + status text + ghost button on the
                         right. We wire the ↻ icon button to UpdateTgProxy
                         since the design's stale-version implication
                         maps cleanly to "refresh binary". -->
                    <Border Padding="10,8"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="{DynamicResource SurfaceBaseBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderSubtleBrush}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Ellipse Grid.Column="0"
                                     Width="8" Height="8"
                                     VerticalAlignment="Center"
                                     Fill="{Binding TgProxyBadgeBrush}"/>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding TgProxyStatus}"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="·"
                                           FontSize="11"
                                           Opacity="0.5"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TgProxyVersionText}"
                                           FontSize="11"
                                           Opacity="0.6"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="{Binding LblUpdateTgProxy}"
                                    Command="{Binding UpdateTgProxyCommand}"
                                    FontSize="10" Padding="8,3"
                                    CornerRadius="{StaticResource RadiusSm}"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    IsEnabled="{Binding !IsTgProxyDownloading}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Download progress (shown while UpdateTgProxy is
                         in flight — banner above stays static so the
                         layout doesn't jump). -->
                    <ProgressBar IsVisible="{Binding IsTgProxyDownloading}"
                                 IsIndeterminate="True"
                                 Height="3"
                                 CornerRadius="{StaticResource RadiusXs}"
                                 Foreground="{DynamicResource AccentSolidBrush}"/>

                    <!-- 4. 3-button row.
                         Open in Telegram = primary blue per design (it's
                         the primary user-facing action — sets up the
                         proxy AND opens Telegram client to add it). We
                         route it through SetupTgProxyCommand which does
                         the full chain: download (if needed) → start →
                         open Telegram deep-link. Once the proxy is set
                         up, subsequent clicks fall through to plain
                         deep-link opens.
                         Open folder + GitHub = secondary per design. -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="{Binding L_TgProxyOpenInTelegram}"
                                Command="{Binding SetupTgProxyCommand}"
                                FontSize="11" FontWeight="SemiBold"
                                Padding="12,6"
                                CornerRadius="{StaticResource RadiusSm}"
                                Background="{DynamicResource AccentSolidBrush}"
                                Foreground="{DynamicResource AccentOnSolidBrush}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                IsEnabled="{Binding !IsTgProxyDownloading}"/>
                        <Button Content="{Binding L_OpenFolder}"
                                Command="{Binding OpenTgProxyFolderCommand}"
                                FontSize="10" Padding="10,5"
                                CornerRadius="{StaticResource RadiusSm}"/>
                        <Button Content="{Binding L_OpenGitHub}"
                                Command="{Binding OpenTgProxyGitHubCommand}"
                                FontSize="10" Padding="10,5"
                                CornerRadius="{StaticResource RadiusSm}"
                                Foreground="{DynamicResource AccentSolidBrush}"/>
                    </StackPanel>

                    <!-- 5. Note paragraph (per design `note` class).
                         Bold lead-in + manual setup path + click-once
                         hint. Critical for users whose Telegram client
                         doesn't accept the deep-link auto-add (custom
                         distributions, web Telegram, some RU forks). -->
                    <Border Padding="10,8"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="{DynamicResource SurfaceSunkenBrush}">
                        <StackPanel Spacing="3">
                            <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.7"
                                       Text="{Binding LblTgProxySetupHint}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.5"
                                       FontStyle="Italic"
                                       Text="{Binding L_TgProxySetupOnce}"/>
                        </StackPanel>
                    </Border>

                    <!-- Author credit (low-emphasis, design has it as
                         monospace fragment in 4-row's tail; we surface
                         it as a separate footer line because the 3-button
                         row above is already busier than the design's
                         flex-wrap allows on narrow widths). -->
                    <TextBlock Text="Flowseal/tg-ws-proxy"
                               FontSize="9"
                               Opacity="0.4"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Left"/>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 6. Footer toggle — secondary per design (per v2.25.6 design
             handoff comment: "Кнопка «Остановить Telegram Proxy» —
             secondary (не ещё один огромный синий)"). Stays secondary
             in BOTH start/stop wording — page primary is "Open in
             Telegram" above, this is the runtime toggle for users who
             already finished setup. -->
        <Border Grid.Row="1" Padding="10,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderDefaultBrush}">
            <Button Content="{Binding LblTgProxyToggle}"
                    Command="{Binding ToggleTgProxyCommand}"
                    FontSize="11" FontWeight="SemiBold"
                    Padding="14,7"
                    HorizontalAlignment="Right"
                    HorizontalContentAlignment="Center"
                    Background="{DynamicResource SurfaceBaseBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}"/>
        </Border>
    </Grid>
</UserControl>

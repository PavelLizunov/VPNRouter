<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:conv="using:VPNRouter.App"
             xmlns:icons="using:VPNRouter.App.Controls"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="560"
             x:Class="VPNRouter.App.Views.Pages.TelegramPage"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <conv:BoolToStatusColorConverter x:Key="StatusColorConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto">

        <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto,*" Margin="12,8,14,8">
            <StackPanel Grid.Row="0" Spacing="8">

                    <StackPanel IsVisible="{Binding IsTgProxyDownloading}" Spacing="6">
                        <ProgressBar IsIndeterminate="True"
                                     Height="3"
                                     CornerRadius="{StaticResource RadiusXs}"
                                     Foreground="{DynamicResource AccentSolidBrush}"/>
                        <TextBlock IsVisible="{Binding HasTgProxyDownloadStep}"
                                   Text="{Binding TgProxyDownloadStep}"
                                   TextWrapping="Wrap"
                                   FontSize="10"
                                   Opacity="0.7"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <Border CornerRadius="{StaticResource RadiusLg}"
                            Background="{DynamicResource SurfaceBaseBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="16,10,16,12"
                            ClipToBounds="True">
                        <Grid>
                            <Ellipse Width="140" Height="140"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Opacity="0.5"
                                     IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="50%,50%" Center="50%,50%" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Offset="0.0"  Color="{DynamicResource AccentBgSubtle}"/>
                                        <GradientStop Offset="0.65" Color="Transparent"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <StackPanel Spacing="10" HorizontalAlignment="Stretch" MaxWidth="420">

                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                    <Border Grid.Column="0" Grid.RowSpan="2"
                                            Width="36" Height="36"
                                            CornerRadius="10"
                                            Background="{DynamicResource SurfaceBaseBrush}"
                                            BorderBrush="{DynamicResource AccentBorderBrush}"
                                            BorderThickness="1"
                                            BoxShadow="0 2 6 0 #14000000"
                                            VerticalAlignment="Top"
                                            Margin="0,2,12,0">
                                        <icons:Pictogram Id="telegram" Width="20" Height="20"
                                                         Foreground="{DynamicResource AccentFgBrush}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Grid.Column="1" Grid.Row="0"
                                               Text="{Binding LblTgProxyHeroTitle}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top"/>

                                    <TextBlock Grid.Column="1" Grid.Row="1"
                                               Text="{Binding LblTgProxyHeroLede}"
                                               FontSize="11"
                                               LineHeight="15"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </Grid>

                                <Button Command="{Binding TgProxyMainActionCommand}"
                                        IsEnabled="{Binding !IsTgProxyDownloading}"
                                        Background="{DynamicResource AccentSolidBrush}"
                                        Foreground="{DynamicResource AccentOnSolidBrush}"
                                        BorderThickness="0"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="22,12"
                                        MinWidth="220"
                                        HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        FontWeight="Bold"
                                        FontSize="13"
                                        AutomationProperties.Name="{Binding LblTgProxyMainAction}">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <icons:Pictogram Id="play" Width="14" Height="14"
                                                         Foreground="{DynamicResource AccentOnSolidBrush}"
                                                         VerticalAlignment="Center"
                                                         IsVisible="{Binding !TgProxyEnabled}"/>
                                        <icons:Pictogram Id="stop" Width="14" Height="14"
                                                         Foreground="{DynamicResource AccentOnSolidBrush}"
                                                         VerticalAlignment="Center"
                                                         IsVisible="{Binding TgProxyEnabled}"/>
                                        <TextBlock Text="{Binding LblTgProxyMainAction}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel IsVisible="{Binding TgProxyEnabled}"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border CornerRadius="{StaticResource RadiusPill}"
                                            Background="{DynamicResource SuccessBgBrush}"
                                            BorderBrush="{DynamicResource SuccessBorderBrush}"
                                            BorderThickness="1"
                                            Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <icons:Pictogram Id="status" Width="12" Height="12"
                                                     Foreground="{DynamicResource SuccessSolidBrush}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding LblTgProxyAirPill}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SuccessFgBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock icons:PictogramText.Icons="arrow-down,arrow-up" icons:PictogramText.Text="{Binding TgProxyStats}"
                                                       IsVisible="{Binding HasTgProxyStats}"
                                                       FontSize="10"
                                                       Opacity="0.85"
                                                       Foreground="{DynamicResource SuccessFgBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Command="{Binding CopyTgProxyLinkCommand}"
                                            Content="{Binding L_TgProxyCopyLink}"
                                            FontSize="10"
                                            Padding="10,5"
                                            CornerRadius="{StaticResource RadiusPill}"
                                            Background="{DynamicResource SurfaceBaseBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding L_TgProxyCopyLink}"/>
                                </StackPanel>

                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border IsVisible="{Binding HasTgProxyToast}"
                            Padding="10,6"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="{DynamicResource AccentBgSubtleBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource AccentBorderBrush}">
                        <TextBlock Text="{Binding TgProxyToast}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource AccentFgBrush}"/>
                    </Border>

                    <Border IsVisible="{Binding IsTelegramSchemeWarningVisible}"
                            Padding="10,8"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="{DynamicResource WarningBgBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource WarningBorderBrush}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding L_TgProxySchemeMissingWarning}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource WarningFgBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="{Binding L_TgProxyCopyLink}"
                                        Command="{Binding CopyTgProxyLinkCommand}"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <Button Content="{Binding L_TgProxyDismiss}"
                                        Command="{Binding DismissTelegramSchemeWarningCommand}"
                                        FontSize="10" Padding="8,4"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource WarningBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

            </StackPanel>

            <UniformGrid Grid.Row="1" Rows="1" Columns="3" Margin="0,8,0,0">
                <ToggleButton IsChecked="{Binding IsTgProxyTab0}"
                              Command="{Binding SetTgProxyTabCommand}"
                              CommandParameter="0"
                              Classes="TabStripPill"
                              Content="{Binding L_TgProxyTabSettings}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"/>
                <ToggleButton IsChecked="{Binding IsTgProxyTab1}"
                              Command="{Binding SetTgProxyTabCommand}"
                              CommandParameter="1"
                              Classes="TabStripPill"
                              Content="{Binding L_TgProxyTabVersion}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"/>
                <ToggleButton IsChecked="{Binding IsTgProxyTab2}"
                              Command="{Binding SetTgProxyTabCommand}"
                              CommandParameter="2"
                              Classes="TabStripPill"
                              Content="{Binding L_TgProxyTabHelp}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"/>
            </UniformGrid>

            <Border Grid.Row="2"
                    Height="1"
                    Background="{DynamicResource BorderSubtleBrush}"
                    Margin="0,0,0,6"/>

            <Border Grid.Row="3"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}"
                    Padding="10,6">
                <Panel>

                        <ScrollViewer IsVisible="{Binding IsTgProxyTab0}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">

                            <Grid ColumnDefinitions="120,*" ColumnSpacing="12">

                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="{Binding L_TgProxyPort}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Opacity="0.5"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               LetterSpacing="0.5"/>
                                    <TextBox Text="{Binding TgProxyPort}"
                                             PlaceholderText="{Binding L_WmTgProxyPort}"
                                             FontSize="11" Padding="6,4"
                                             HorizontalContentAlignment="Center"
                                             AutomationProperties.Name="{Binding L_TgProxyPort}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{Binding L_TgProxySecret}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Opacity="0.5"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               LetterSpacing="0.5"/>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding TgProxySecret}"
                                                 PlaceholderText="{Binding L_WmTgProxySecret}"
                                                 FontSize="10" Padding="6,4"
                                                 FontFamily="Consolas,Courier New,monospace"
                                                 IsReadOnly="True"
                                                 AutomationProperties.Name="{Binding L_TgProxySecret}"/>
                                        <Button Grid.Column="1"
                                                Content="{Binding L_TgProxyCopy}"
                                                Command="{Binding CopyTgProxySecretCommand}"
                                                FontSize="10" Padding="8,4"
                                                CornerRadius="{StaticResource RadiusSm}"
                                                AutomationProperties.Name="{Binding L_TgProxyCopySecretA11y}"/>
                                        <Button Grid.Column="2"
                                                Content="{Binding L_TgProxyRegenerate}"
                                                Command="{Binding RegenerateTgProxySecretCommand}"
                                                FontSize="10" Padding="8,4"
                                                CornerRadius="{StaticResource RadiusSm}"
                                                AutomationProperties.Name="{Binding L_TgProxyRegenerateSecretA11y}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer IsVisible="{Binding IsTgProxyTab1}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">

                            <Border Padding="10,8"
                                    CornerRadius="{StaticResource RadiusSm}"
                                    Background="{DynamicResource SurfaceSunkenBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <icons:Pictogram Id="status" Grid.Column="0"
                                             Width="16" Height="16"
                                             VerticalAlignment="Center"
                                             Foreground="{Binding TgProxyBadgeBrush}"/>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TgProxyStatus}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="·"
                                                   FontSize="11"
                                                   Opacity="0.5"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TgProxyVersionText}"
                                                   FontSize="11"
                                                   Opacity="0.6"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="{Binding LblUpdateTgProxy}"
                                            Command="{Binding UpdateTgProxyCommand}"
                                            FontSize="10" Padding="8,3"
                                            CornerRadius="{StaticResource RadiusSm}"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            IsEnabled="{Binding !IsTgProxyDownloading}"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding LblUpdateTgProxy}"/>
                                </Grid>
                            </Border>

                            <Button Content="{Binding L_TgProxyReopenInTelegram}"
                                    Command="{Binding OpenTgProxyInTelegramCommand}"
                                    FontSize="10" Padding="10,5"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    CornerRadius="{StaticResource RadiusSm}"
                                    IsEnabled="{Binding TgProxyEnabled}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer IsVisible="{Binding IsTgProxyTab2}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">

                            <Border Padding="10,8"
                                    CornerRadius="{StaticResource RadiusSm}"
                                    Background="{DynamicResource SurfaceSunkenBrush}">
                                <StackPanel Spacing="3">
                                    <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.7"
                                               icons:PictogramText.Icons="arrow-right" icons:PictogramText.Text="{Binding LblTgProxySetupHint}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.5"
                                               FontStyle="Italic"
                                               Text="{Binding L_TgProxySetupOnce}"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="{Binding L_OpenFolder}"
                                        Command="{Binding OpenTgProxyFolderCommand}"
                                        FontSize="10" Padding="10,5"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <Button Content="{Binding L_OpenGitHub}"
                                        Command="{Binding OpenTgProxyGitHubCommand}"
                                        FontSize="10" Padding="10,5"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Foreground="{DynamicResource AccentSolidBrush}"/>
                            </StackPanel>

                            <TextBlock Text="Flowseal/tg-ws-proxy"
                                       FontSize="9"
                                       Opacity="0.4"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Left"/>

                            </StackPanel>
                        </ScrollViewer>

                </Panel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Padding="14,7,14,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                Background="{DynamicResource SurfaceSunkenBrush}">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" ColumnSpacing="8">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <icons:Pictogram Id="status" Width="16" Height="16"
                             VerticalAlignment="Center"
                             Foreground="{Binding TgProxyBadgeBrush}"/>
                    <TextBlock Text="{Binding TgProxyStatus}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1"
                        IsVisible="False"
                        Content="{Binding LblTgProxyMainAction}"
                        Command="{Binding TgProxyMainActionCommand}"
                        FontSize="10" FontWeight="SemiBold"
                        Padding="10,5"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSm}"
                        IsEnabled="{Binding !IsTgProxyDownloading}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

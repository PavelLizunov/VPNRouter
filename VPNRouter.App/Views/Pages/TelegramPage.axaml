<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:conv="using:VPNRouter.App"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="500"
             x:Class="VPNRouter.App.Views.Pages.TelegramPage"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <conv:BoolToStatusColorConverter x:Key="StatusColorConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="10,8,16,12">
            <StackPanel Spacing="10">

                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                           Text="{Binding LblTgProxyDescription}"/>

                <!-- Version + Download/Update -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding TgProxyVersionText}" FontSize="10" Opacity="0.5"
                               VerticalAlignment="Center"/>
                    <Button Content="{Binding LblUpdateTgProxy}"
                            Command="{Binding UpdateTgProxyCommand}"
                            FontSize="10" Padding="8,4"
                            CornerRadius="4" VerticalAlignment="Center"
                            IsEnabled="{Binding !IsTgProxyDownloading}"/>
                    <ProgressBar IsVisible="{Binding IsTgProxyDownloading}"
                                 IsIndeterminate="True"
                                 Height="4" Width="100" CornerRadius="2"
                                 VerticalAlignment="Center"
                                 Foreground="#0088cc"/>
                </StackPanel>

                <!-- Status -->
                <Border Padding="10,8" CornerRadius="4"
                        Background="{DynamicResource SystemControlBackgroundListLowBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding TgProxyEnabled, Converter={StaticResource StatusColorConverter}}"/>
                        <TextBlock Text="{Binding TgProxyStatus}" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Setup instructions -->
                <Border Padding="10,8" CornerRadius="4"
                        Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding LblTgProxySetupTitle}" FontWeight="SemiBold" FontSize="11" Opacity="0.8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6"
                                   Text="{Binding LblTgProxySetup}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="10,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
            <Button Content="{Binding LblTgProxyToggle}"
                    Command="{Binding ToggleTgProxyCommand}"
                    FontSize="12" FontWeight="Bold"
                    Padding="0,8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Background="#0088cc" Foreground="White"
                    CornerRadius="5"/>
        </Border>
    </Grid>
</UserControl>

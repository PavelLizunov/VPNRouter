<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:conv="using:VPNRouter.App"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="500"
             x:Class="VPNRouter.App.Views.Pages.TelegramPage"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <conv:BoolToStatusColorConverter x:Key="StatusColorConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="10,8,16,12">
            <StackPanel Spacing="10">

                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                           Text="{Binding LblTgProxyDescription}"/>

                <!-- Port -->
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Static loc:Strings.TgProxyPort}" FontWeight="SemiBold" Opacity="0.7"/>
                    <TextBox Text="{Binding TgProxyPort}"
                             Watermark="{x:Static loc:Strings.WmTgProxyPort}"
                             FontSize="11" Padding="6,4"
                             MaxWidth="120" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Secret + Copy + Regenerate -->
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Static loc:Strings.TgProxySecret}" FontWeight="SemiBold" Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox Text="{Binding TgProxySecret}"
                                 Watermark="{x:Static loc:Strings.WmTgProxySecret}"
                                 FontSize="10" Padding="6,4"
                                 FontFamily="Consolas,Courier New,monospace"
                                 MinWidth="260" IsReadOnly="True"/>
                        <Button Content="{x:Static loc:Strings.TgProxyCopy}"
                                Command="{Binding CopyTgProxySecretCommand}"
                                FontSize="10" Padding="8,4" CornerRadius="{StaticResource RadiusSm}"/>
                        <Button Content="{x:Static loc:Strings.TgProxyRegenerate}"
                                Command="{Binding RegenerateTgProxySecretCommand}"
                                FontSize="10" Padding="8,4" CornerRadius="{StaticResource RadiusSm}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Version + Download/Update -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <TextBlock Text="{Binding TgProxyVersionText}" FontSize="10" Opacity="0.5"
                               VerticalAlignment="Center"/>
                    <Button Content="{Binding LblUpdateTgProxy}"
                            Command="{Binding UpdateTgProxyCommand}"
                            FontSize="10" Padding="8,4"
                            CornerRadius="{StaticResource RadiusSm}" VerticalAlignment="Center"
                            IsEnabled="{Binding !IsTgProxyDownloading}"/>
                    <ProgressBar IsVisible="{Binding IsTgProxyDownloading}"
                                 IsIndeterminate="True"
                                 Height="4" Width="100" CornerRadius="{StaticResource RadiusXs}"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource AccentSolidBrush}"/>
                </StackPanel>

                <!-- Status.
                     v2.20.0: dot reads TgProxyBadgeBrush — same polled
                     ComponentRuntimeStatus that drives the header chip — so
                     the page never contradicts the header. Previously the
                     dot flipped to grey instantly on the local
                     TgProxyEnabled flag even when the process failed to die
                     (e.g. KillAll missed it because of the old
                     process-name mismatch). Users saw "Stopped" dot + green
                     header chip + working Telegram traffic. -->
                <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                        Background="{DynamicResource SurfaceSunkenBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding TgProxyBadgeBrush}"/>
                        <TextBlock Text="{Binding TgProxyStatus}" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Open in Telegram button (one-time setup) -->
                <StackPanel Spacing="4">
                    <Button Content="{x:Static loc:Strings.TgProxyOpenInTelegram}"
                            Command="{Binding OpenTgProxyInTelegramCommand}"
                            FontSize="11" Padding="12,6"
                            CornerRadius="{StaticResource RadiusSm}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.5" FontStyle="Italic"
                               Text="{x:Static loc:Strings.TgProxySetupOnce}"/>
                </StackPanel>

                <!-- Open folder + GitHub -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                    <Button Content="{x:Static loc:Strings.OpenFolder}"
                            Command="{Binding OpenTgProxyFolderCommand}"
                            FontSize="10" Padding="8,4" CornerRadius="{StaticResource RadiusSm}"/>
                    <Button Content="{x:Static loc:Strings.OpenGitHub}"
                            Command="{Binding OpenTgProxyGitHubCommand}"
                            FontSize="10" Padding="8,4" CornerRadius="{StaticResource RadiusSm}"
                            Foreground="{DynamicResource AccentSolidBrush}"/>
                    <TextBlock Text="Flowseal/tg-ws-proxy" FontSize="9" Opacity="0.4"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Setup path hint -->
                <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.4"
                           Text="{Binding LblTgProxySetupHint}"/>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="10,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderDefaultBrush}">
            <Button Content="{Binding LblTgProxyToggle}"
                    Command="{Binding ToggleTgProxyCommand}"
                    FontSize="12" FontWeight="Bold"
                    Padding="0,8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentOnSolidBrush}"
                    CornerRadius="{StaticResource RadiusSm}"/>
        </Border>
    </Grid>
</UserControl>

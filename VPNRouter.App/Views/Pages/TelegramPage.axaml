<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:conv="using:VPNRouter.App"
             xmlns:icons="using:VPNRouter.App.Controls"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="560"
             x:Class="VPNRouter.App.Views.Pages.TelegramPage"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <conv:BoolToStatusColorConverter x:Key="StatusColorConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" AllowAutoHide="False">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="16,8,16,16">
            <StackPanel Grid.Row="0" Spacing="8">

                    <StackPanel IsVisible="{Binding IsTgProxyDownloading}" Spacing="6">
                        <ProgressBar IsIndeterminate="True"
                                     Height="3"
                                     CornerRadius="{StaticResource RadiusXs}"
                                     Foreground="{DynamicResource AccentSolidBrush}"/>
                        <TextBlock IsVisible="{Binding HasTgProxyDownloadStep}"
                                   Text="{Binding TgProxyDownloadStep}"
                                   TextWrapping="Wrap"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <!-- Hero in the look of the home screen: the status emblem, the state word and sub-line, one pill button. -->
                    <StackPanel HorizontalAlignment="Stretch" MaxWidth="400" Margin="0,12,0,4">
                        <icons:StatusEmblem HorizontalAlignment="Center" IconId="telegram"
                                            IsOn="{Binding TgProxyEnabled}"
                                            IsBusy="{Binding IsTgProxyDownloading}"/>
                        <TextBlock Classes="hk-state" Classes.on="{Binding TgProxyEnabled}" Margin="0,22,0,0"
                                   Text="{Binding LblTgProxyHeroTitle}"/>
                        <TextBlock Classes="hk-subline" Margin="0,6,0,0" Text="{Binding LblTgProxyHeroLede}"/>
                        <TextBlock icons:PictogramText.Icons="arrow-down,arrow-up" icons:PictogramText.Text="{Binding TgProxyStats}"
                                   IsVisible="{Binding HasTgProxyStats}"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="{StaticResource FsSm}"
                                   FontFamily="Consolas,Menlo,monospace"
                                   Foreground="{DynamicResource TextMutedBrush}"/>

                        <Button Classes="hk-cta" Classes.stop="{Binding TgProxyEnabled}" Margin="0,20,0,0"
                                Command="{Binding TgProxyMainActionCommand}"
                                IsEnabled="{Binding !IsTgProxyDownloading}"
                                AutomationProperties.Name="{Binding LblTgProxyMainAction}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <icons:Pictogram Id="play" IsVisible="{Binding !TgProxyEnabled}"/>
                                <icons:Pictogram Id="stop" IsVisible="{Binding TgProxyEnabled}"/>
                                <TextBlock Text="{Binding LblTgProxyMainAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="hk-soft" Margin="0,10,0,0" HorizontalAlignment="Center"
                                IsVisible="{Binding TgProxyEnabled}"
                                Command="{Binding CopyTgProxyLinkCommand}"
                                Content="{Binding L_TgProxyCopyLink}"
                                AutomationProperties.Name="{Binding L_TgProxyCopyLink}"/>
                    </StackPanel>

                    <Border IsVisible="{Binding HasTgProxyToast}"
                            Padding="10,6"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="{DynamicResource AccentBgSubtleBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource AccentBorderBrush}">
                        <TextBlock Text="{Binding TgProxyToast}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource AccentFgBrush}"/>
                    </Border>

                    <Border IsVisible="{Binding IsTelegramSchemeWarningVisible}"
                            Padding="10,8"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="{DynamicResource WarningBgBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource WarningBorderBrush}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding L_TgProxySchemeMissingWarning}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource WarningFgBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="{Binding L_TgProxyCopyLink}"
                                        Command="{Binding CopyTgProxyLinkCommand}"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <Button Content="{Binding L_TgProxyDismiss}"
                                        Command="{Binding DismissTelegramSchemeWarningCommand}"
                                        FontSize="10" Padding="8,4"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource WarningBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

            </StackPanel>

            <Border Grid.Row="1" Classes="hk-seg-track" Margin="0,8,0,0">
            <UniformGrid Rows="1" Columns="3">
                <RadioButton Classes="hk-seg" GroupName="TgProxyTabs" IsChecked="{Binding IsTgProxyTab0, Mode=OneWay}"
                                 Command="{Binding SetTgProxyTabCommand}" CommandParameter="0"
                                 Content="{Binding L_TgProxyTabSettings}"/>
                <RadioButton Classes="hk-seg" GroupName="TgProxyTabs" IsChecked="{Binding IsTgProxyTab1, Mode=OneWay}"
                                 Command="{Binding SetTgProxyTabCommand}" CommandParameter="1"
                                 Content="{Binding L_TgProxyTabVersion}"/>
                <RadioButton Classes="hk-seg" GroupName="TgProxyTabs" IsChecked="{Binding IsTgProxyTab2, Mode=OneWay}"
                                 Command="{Binding SetTgProxyTabCommand}" CommandParameter="2"
                                 Content="{Binding L_TgProxyTabHelp}"/>
            </UniformGrid>
            </Border>


            <Border Grid.Row="3" Classes="hk-card" Margin="0,12,0,0" Padding="4">
                <Panel>

                        <ScrollViewer IsVisible="{Binding IsTgProxyTab0}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">

                            <Grid ColumnDefinitions="88,*" ColumnSpacing="10">

                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="{Binding L_TgProxyPort}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               LetterSpacing="0.5"/>
                                    <TextBox Text="{Binding TgProxyPort}"
                                             PlaceholderText="{Binding L_WmTgProxyPort}"
                                             FontSize="11" Padding="8,5"
                                             HorizontalContentAlignment="Center"
                                             AutomationProperties.Name="{Binding L_TgProxyPort}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{Binding L_TgProxySecret}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               LetterSpacing="0.5"/>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding TgProxySecret}"
                                                 PlaceholderText="{Binding L_WmTgProxySecret}"
                                                 FontSize="10" Padding="8,5"
                                                 FontFamily="Consolas,Courier New,monospace"
                                                 IsReadOnly="True"
                                                 AutomationProperties.Name="{Binding L_TgProxySecret}"/>
                                        <Button Grid.Column="1"
                                                Content="{Binding L_TgProxyCopy}"
                                                Command="{Binding CopyTgProxySecretCommand}"
                                                FontSize="10" Padding="8,4"
                                                CornerRadius="{StaticResource RadiusSm}"
                                                AutomationProperties.Name="{Binding L_TgProxyCopySecretA11y}"/>
                                        <Button Grid.Column="2"
                                                Content="{Binding L_TgProxyRegenerate}"
                                                Command="{Binding RegenerateTgProxySecretCommand}"
                                                FontSize="10" Padding="8,4"
                                                CornerRadius="{StaticResource RadiusSm}"
                                                AutomationProperties.Name="{Binding L_TgProxyRegenerateSecretA11y}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer IsVisible="{Binding IsTgProxyTab1}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">

                            <Border Padding="10,8"
                                    CornerRadius="{StaticResource RadiusSm}"
                                    Background="{DynamicResource SurfaceSunkenBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <icons:Pictogram Id="status" Grid.Column="0"
                                             Width="16" Height="16"
                                             VerticalAlignment="Center"
                                             Foreground="{Binding TgProxyBadgeBrush}"/>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TgProxyStatus}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="·"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="{Binding TgProxyVersionText}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="{Binding LblUpdateTgProxy}"
                                            Command="{Binding UpdateTgProxyCommand}"
                                            FontSize="10" Padding="8,3"
                                            CornerRadius="{StaticResource RadiusSm}"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            IsEnabled="{Binding !IsTgProxyDownloading}"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding LblUpdateTgProxy}"/>
                                </Grid>
                            </Border>

                            <Button Content="{Binding L_TgProxyReopenInTelegram}"
                                    Command="{Binding OpenTgProxyInTelegramCommand}"
                                    FontSize="10" Padding="10,5"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    CornerRadius="{StaticResource RadiusSm}"
                                    IsEnabled="{Binding TgProxyEnabled}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer IsVisible="{Binding IsTgProxyTab2}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">

                            <Border Padding="10,8"
                                    CornerRadius="{StaticResource RadiusSm}"
                                    Background="{DynamicResource SurfaceSunkenBrush}">
                                <StackPanel Spacing="3">
                                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" FontSize="10"
                                               icons:PictogramText.Icons="arrow-right" icons:PictogramText.Text="{Binding LblTgProxySetupHint}"/>
                                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" FontSize="10"
                                               FontStyle="Italic"
                                               Text="{Binding L_TgProxySetupOnce}"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="{Binding L_OpenFolder}"
                                        Command="{Binding OpenTgProxyFolderCommand}"
                                        FontSize="10" Padding="10,5"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <Button Content="{Binding L_OpenGitHub}"
                                        Command="{Binding OpenTgProxyGitHubCommand}"
                                        FontSize="10" Padding="10,5"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Foreground="{DynamicResource AccentSolidBrush}"/>
                            </StackPanel>

                            <TextBlock Text="Flowseal/tg-ws-proxy"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Left"/>

                            </StackPanel>
                        </ScrollViewer>

                </Panel>
            </Border>
        </Grid>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="14,7,14,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                Background="{DynamicResource SurfaceSunkenBrush}">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" ColumnSpacing="8">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <icons:Pictogram Id="status" Width="16" Height="16"
                             VerticalAlignment="Center"
                             Foreground="{Binding TgProxyBadgeBrush}"/>
                    <TextBlock Text="{Binding TgProxyStatus}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1"
                        IsVisible="False"
                        Content="{Binding LblTgProxyMainAction}"
                        Command="{Binding TgProxyMainActionCommand}"
                        FontSize="10" FontWeight="SemiBold"
                        Padding="10,5"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSm}"
                        IsEnabled="{Binding !IsTgProxyDownloading}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

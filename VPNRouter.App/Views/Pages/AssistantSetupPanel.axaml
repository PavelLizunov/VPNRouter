<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VPNRouter.App.Views.Pages.AssistantSetupPanel"
             IsVisible="False">
    <Border Margin="0,16,0,0" Padding="14,12"
            Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
            BorderThickness="1" CornerRadius="{StaticResource RadiusXl}">
        <StackPanel Spacing="10">
            <TextBlock x:Name="AssistantHeading" FontSize="{StaticResource FsLg}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
            <StackPanel x:Name="AssistantFields" Spacing="8">
                <TextBox x:Name="AssistantGoal" AutomationProperties.AutomationId="Assistant.Goal"
                         AcceptsReturn="False" TextWrapping="Wrap" MaxLength="384" MinHeight="40" MaxHeight="96"
                         KeyDown="AssistantGoal_KeyDown" CornerRadius="{StaticResource RadiusMd}">
                    <TextBox.InnerRightContent>
                        <Button x:Name="RunAssistant" Classes="ghost" Padding="9,5" Margin="0,2,3,2"
                                VerticalAlignment="Center" AutomationProperties.AutomationId="Assistant.Run" Click="RunAssistant_Click"/>
                    </TextBox.InnerRightContent>
                </TextBox>
                <TextBlock x:Name="AssistantNotice" FontSize="{StaticResource FsSm}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <StackPanel x:Name="AssistantFeedbackArea" Spacing="8"
                        IsVisible="{Binding #AssistantStatus.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <ProgressBar x:Name="AssistantProgress" Height="3" IsIndeterminate="True"
                             Foreground="{DynamicResource AccentSolidBrush}" IsVisible="False"/>
                <TextBlock x:Name="AssistantStatus" FontSize="{StaticResource FsSm}" LineHeight="18" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="Assistant.Status" AutomationProperties.LiveSetting="Polite"/>
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                    <Button x:Name="ConfirmAssistant" Classes="solid" IsVisible="False"
                            AutomationProperties.AutomationId="Assistant.Confirm" Click="ConfirmAssistant_Click"/>
                    <Button x:Name="CancelAssistant" Classes="ghost" IsVisible="False"
                            AutomationProperties.AutomationId="Assistant.Cancel" Click="CancelAssistant_Click"/>
                </WrapPanel>
            </StackPanel>
            <Button x:Name="UndoAssistant" HorizontalAlignment="Left" Classes="ghost" IsVisible="False"
                    AutomationProperties.AutomationId="Assistant.Undo" Click="UndoAssistant_Click"/>
            <Expander x:Name="DiagnosticsDetails" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8" Margin="0,6,0,0">
                    <Button x:Name="RepairVpn" Classes="outline" HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="Assistant.Repair" Click="RepairVpn_Click"/>
                    <TextBlock x:Name="AssistantCrashNotice" FontSize="{StaticResource FsSm}"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <Button x:Name="DiagnoseCrash" Classes="ghost" HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="Assistant.DiagnoseCrash" Click="DiagnoseCrash_Click"/>
                    <TextBlock x:Name="SourceDiagnosisNotice" FontSize="{StaticResource FsSm}"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                        <Button x:Name="DiagnoseConnection" Classes="outline" AutomationProperties.AutomationId="Assistant.DiagnoseConnection"
                                Click="DiagnoseSource_Click"/>
                        <Button x:Name="DiagnoseSource" Classes="outline" AutomationProperties.AutomationId="Assistant.DiagnoseSource"
                                Click="DiagnoseSource_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>

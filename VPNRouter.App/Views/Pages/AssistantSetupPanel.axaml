<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VPNRouter.App.Views.Pages.AssistantSetupPanel"
             IsVisible="False">
    <StackPanel Spacing="8" Margin="0,16,0,0">
        <Button x:Name="OpenAssistant" Click="OpenAssistant_Click"
                AutomationProperties.AutomationId="Assistant.Open"
                HorizontalAlignment="Left"/>
        <StackPanel x:Name="AssistantFields" IsVisible="False" Spacing="8">
            <TextBox x:Name="AssistantGoal" AutomationProperties.AutomationId="Assistant.Goal"
                     AcceptsReturn="False" MaxLength="384"/>
            <TextBlock x:Name="AssistantNotice" FontSize="{StaticResource FsSm}"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="AssistantStatus" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="Assistant.Status"
                       AutomationProperties.LiveSetting="Polite"/>
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                <Button x:Name="RunAssistant" AutomationProperties.AutomationId="Assistant.Run"
                        Click="RunAssistant_Click"/>
                <Button x:Name="DiagnoseCrash" AutomationProperties.AutomationId="Assistant.DiagnoseCrash"
                        Click="DiagnoseCrash_Click"/>
                <Button x:Name="RepairVpn" AutomationProperties.AutomationId="Assistant.Repair"
                        Click="RepairVpn_Click"/>
                <Button x:Name="ConfirmAssistant" AutomationProperties.AutomationId="Assistant.Confirm"
                        Click="ConfirmAssistant_Click" IsVisible="False"/>
                <Button x:Name="CancelAssistant" AutomationProperties.AutomationId="Assistant.Cancel"
                        Click="CancelAssistant_Click" IsVisible="False"/>
                <Button x:Name="UndoAssistant" AutomationProperties.AutomationId="Assistant.Undo"
                        Click="UndoAssistant_Click" IsVisible="False"/>
            </WrapPanel>
            <Expander x:Name="SourceDiagnosisDetails" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="SourceDiagnosisNotice" TextWrapping="Wrap"/>
                    <Button x:Name="DiagnoseSource" HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="Assistant.DiagnoseSource" Click="DiagnoseSource_Click"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </StackPanel>
</UserControl>

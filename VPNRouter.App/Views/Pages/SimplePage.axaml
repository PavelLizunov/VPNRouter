<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:loc="using:VPNRouter.App.Localization"
             x:Class="VPNRouter.App.Views.Pages.SimplePage"
             x:DataType="vm:MainWindowViewModel">

    <!--
      v2.17.1 skeleton: final layout + all bindings, but the big Start button
      is still a stub that writes to the log only. v2.17.2 wires it into the
      existing Connect path with input parsing (vless:// vs https://).
    -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Padding="20,20,20,16">
        <Grid MaxWidth="440" HorizontalAlignment="Center">
            <StackPanel Spacing="16">

                <!-- No brand lockup here — the main window header already shows
                     the logo + title + version + status badges. Having it
                     again would produce the 'window inside a window' effect
                     the user reported in v2.17.4 feedback. -->

                <!-- Input — VLESS URI or subscription URL -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Static loc:Strings.SmpInputLabel}"
                               FontSize="11" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding SmpInput}"
                             Watermark="{x:Static loc:Strings.SmpInputWatermark}"
                             FontSize="11" Padding="10,8"
                             AcceptsReturn="False"
                             CornerRadius="{StaticResource RadiusSm}"/>
                    <TextBlock Text="{x:Static loc:Strings.SmpInputHint}"
                               FontSize="9" Opacity="0.55"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SmpErrorText}"
                               FontSize="10"
                               Foreground="{DynamicResource DangerFgBrush}"
                               IsVisible="{Binding SmpErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Tunnel mode -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Static loc:Strings.SmpTunnelModeLabel}"
                               FontSize="11" FontWeight="SemiBold"/>
                    <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                            Background="{DynamicResource SurfaceSunkenBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="6">
                            <RadioButton GroupName="SmpTunnel"
                                         IsChecked="{Binding IsSplitTunnel}"
                                         Content="{x:Static loc:Strings.SmpSplitOption}"
                                         ToolTip.Tip="{x:Static loc:Strings.SmpTipSplit}"
                                         FontSize="11"/>
                            <RadioButton GroupName="SmpTunnel"
                                         IsChecked="{Binding !IsSplitTunnel}"
                                         Content="{x:Static loc:Strings.SmpFullOption}"
                                         ToolTip.Tip="{x:Static loc:Strings.SmpTipFull}"
                                         FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Autostart -->
                <CheckBox IsChecked="{Binding SmpAutostartChecked}"
                          Content="{x:Static loc:Strings.SmpAutostartLabel}"
                          ToolTip.Tip="{x:Static loc:Strings.SmpTipAutostart}"
                          FontSize="11"
                          MinHeight="0" Padding="4,0"/>

                <!-- Big Start/Stop button -->
                <Button Command="{Binding SmpToggleConnectCommand}"
                        Content="{Binding SmpConnectButtonText}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="0,14" FontSize="14" FontWeight="Bold"
                        Background="{Binding SmpConnectButtonBrush}"
                        Foreground="{DynamicResource AccentOnSolidBrush}"
                        CornerRadius="{StaticResource RadiusMd}"/>

                <!-- Status -->
                <Border Background="{DynamicResource SurfaceSunkenBrush}"
                        CornerRadius="{StaticResource RadiusSm}"
                        Padding="12,10">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SmpActiveServerLine}"
                                   FontSize="10" Opacity="0.7"
                                   IsVisible="{Binding IsConnected}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

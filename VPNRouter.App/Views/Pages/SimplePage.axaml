<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:conv="using:VPNRouter.App"
             xmlns:loc="using:VPNRouter.App.Localization"
             x:Class="VPNRouter.App.Views.Pages.SimplePage"
             x:DataType="vm:MainWindowViewModel">

    <!--
      v2.18.0 — Compact Simple mode (Variant A · Calm).
      Layout sourced from "VPNRouter Design System 2/handoff/SimpleMode.html".
      The page owns its own mini-header (logo + brand + status chips + ⋯ menu),
      so the big MainWindow header is hidden in Simple mode. Three states —
      on / warn / off — each shown via IsVisible on mutually-exclusive VM
      flags (SimpleStatusIsOn / IsWarn / IsOff, same for CTA).
      Don't re-introduce a red destructive CTA for "Disconnect" — per design
      it's a benign toggle, accent-solid.
    -->
    <UserControl.Resources>
        <!-- UserControl can't see MainWindow.Resources at parse time, so
             the local converters used below must be declared here (same
             pattern DpiBypassPage and TelegramPage follow). -->
        <conv:BoolToStatusColorConverter x:Key="StatusColorConverter"/>
        <conv:BoolToLangConverter x:Key="LangConverter"/>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Padding="16,12,16,16">
        <Grid MaxWidth="420" HorizontalAlignment="Center">
            <StackPanel Spacing="14">

                <!-- ═══ Mini header (40px logo · brand + 3 mini badges · ⋯ menu).
                     v2.18.3: bumped container 32→40 and image 28→36 — at 32
                     the mascot read as a decorative chip rather than the
                     brand anchor. 40 matches the visual weight of the brand
                     name next to it. ═══ -->
                <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10" Margin="2,4,2,2">
                    <Border Grid.Column="0" Width="40" Height="40"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="{DynamicResource AccentBgSubtleBrush}"
                            ClipToBounds="True">
                        <Image Source="{Binding LogoSource}"
                               Width="36" Height="36" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="Virtual Penguin Network"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <!-- Mini-badges: 3 tiny pill chips. Each shown only in the
                             right component state. SuccessBgBrush / WarningBgBrush
                             token auto-adapts to light + dark. -->
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <!-- VPN chip — 3 states. v2.18.3: wrapped in
                                 Button using NavigateToVpnCommand, same as
                                 the Advanced header badge. The command
                                 no-ops when IsSimpleMode so tapping the
                                 VPN chip in Simple is a quiet "acknowledge"
                                 instead of navigating somewhere unexpected. -->
                            <Button Command="{Binding NavigateToVpnCommand}"
                                    ToolTip.Tip="{Binding VpnBadgeTooltip}"
                                    Padding="5,1" MinHeight="0"
                                    Background="{DynamicResource SuccessBgBrush}"
                                    BorderThickness="0"
                                    CornerRadius="{StaticResource RadiusPill}"
                                    Cursor="Hand"
                                    IsVisible="{Binding SimpleStatusIsOn}">
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <Ellipse Width="4" Height="4" VerticalAlignment="Center"
                                             Fill="{DynamicResource SuccessSolidBrush}"/>
                                    <TextBlock Text="VPN" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessFgBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NavigateToVpnCommand}"
                                    ToolTip.Tip="{Binding VpnBadgeTooltip}"
                                    Padding="5,1" MinHeight="0"
                                    Background="{DynamicResource WarningBgBrush}"
                                    BorderThickness="0"
                                    CornerRadius="{StaticResource RadiusPill}"
                                    Cursor="Hand"
                                    IsVisible="{Binding SimpleStatusIsWarn}">
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <Ellipse Width="4" Height="4" VerticalAlignment="Center"
                                             Fill="{DynamicResource WarningSolidBrush}"/>
                                    <TextBlock Text="VPN" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WarningFgBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NavigateToVpnCommand}"
                                    ToolTip.Tip="{Binding VpnBadgeTooltip}"
                                    Padding="5,1" MinHeight="0"
                                    Background="{DynamicResource SurfaceSunkenBrush}"
                                    BorderThickness="0"
                                    CornerRadius="{StaticResource RadiusPill}"
                                    Cursor="Hand"
                                    IsVisible="{Binding SimpleStatusIsOff}">
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <Ellipse Width="4" Height="4" VerticalAlignment="Center"
                                             Fill="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="VPN" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </Button>

                            <!-- Zapret chip — running/idle. v2.18.3: same
                                 NavigateToZapretCommand as the Advanced
                                 header badge — the command already handles
                                 the Simple→Advanced flip + opens Tools tab
                                 + selects the Zapret sub-section. -->
                            <Button Command="{Binding NavigateToZapretCommand}"
                                    ToolTip.Tip="{Binding ZapretBadgeTooltip}"
                                    Padding="5,1" MinHeight="0"
                                    Background="{Binding ZapretBadgeBrush}"
                                    BorderThickness="0"
                                    CornerRadius="{StaticResource RadiusPill}"
                                    Cursor="Hand">
                                <TextBlock Text="Zapret" FontSize="9" FontWeight="SemiBold"
                                           Foreground="White"/>
                            </Button>

                            <!-- TgProxy chip — same navigation logic. -->
                            <Button Command="{Binding NavigateToTgProxyCommand}"
                                    ToolTip.Tip="{Binding TgProxyBadgeTooltip}"
                                    Padding="5,1" MinHeight="0"
                                    Background="{Binding TgProxyBadgeBrush}"
                                    BorderThickness="0"
                                    CornerRadius="{StaticResource RadiusPill}"
                                    Cursor="Hand">
                                <TextBlock Text="TG" FontSize="9" FontWeight="SemiBold"
                                           Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- ⋯ menu: theme · language · logs · leaks · updates · switch -->
                    <Button Grid.Column="2" Width="28" Height="28" Padding="0"
                            FontSize="15" FontWeight="Bold"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="{StaticResource RadiusSm}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="{x:Static loc:Strings.SmpMenuTheme}">
                        <Button.Content>⋯</Button.Content>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="{Binding ThemeToggleText}"
                                          Command="{Binding ToggleThemeCommand}"/>
                                <MenuItem Header="{Binding IsRussian, Converter={StaticResource LangConverter}}"
                                          Command="{Binding ToggleLanguageCommand}"/>
                                <Separator/>
                                <MenuItem Header="{x:Static loc:Strings.SmpMenuOpenLogs}"
                                          Command="{Binding OpenLogsCommand}"/>
                                <MenuItem Header="{x:Static loc:Strings.SmpMenuCheckLeaks}"
                                          Command="{Binding OpenLeakTestCommand}"/>
                                <Separator/>
                                <MenuItem Header="{x:Static loc:Strings.SmpMenuCheckUpdates}"
                                          Command="{Binding UpdateVm.CheckManuallyCommand}"/>
                                <Separator/>
                                <MenuItem Header="{x:Static loc:Strings.SmpMenuSwitchToAdv}"
                                          Command="{Binding ToggleUiModeCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- ═══ Status card — 3 variants via IsVisible on SimpleStatusIs* ═══ -->
                <Border BorderThickness="1"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="14">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <!-- Status dot — only one visible at a time -->
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{DynamicResource SuccessSolidBrush}"
                                     IsVisible="{Binding SimpleStatusIsOn}"/>
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{DynamicResource WarningSolidBrush}"
                                     IsVisible="{Binding SimpleStatusIsWarn}"/>
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{DynamicResource TextMutedBrush}"
                                     IsVisible="{Binding SimpleStatusIsOff}"/>
                            <TextBlock Text="{Binding SimpleStatusTitle}"
                                       FontSize="15" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SimpleStatusDescription}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="20,0,0,0"
                                   LineHeight="15"/>
                    </StackPanel>
                </Border>

                <!-- ═══ Config row — tappable, opens the inline form ═══ -->
                <Button Command="{Binding OpenConfigPickerCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        CornerRadius="{StaticResource RadiusSm}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="12,8">
                        <!-- Flag-like icon -->
                        <Border Grid.Column="0" Width="24" Height="24"
                                CornerRadius="{StaticResource RadiusXs}"
                                Background="{DynamicResource AccentBgSubtleBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="⚑" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentFgBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static loc:Strings.SmpConfigRowLabel}"
                                       FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding SimpleConfigModeSummary}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="Consolas, 'Segoe UI Mono', monospace"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="›" FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- ═══ Collapsible detail form (input · mode · autostart).
                     Bound to SmpFormExpanded. The config row above toggles it. ═══ -->
                <Border IsVisible="{Binding SmpFormExpanded}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        CornerRadius="{StaticResource RadiusSm}"
                        Padding="12">
                    <StackPanel Spacing="14">
                        <!-- Input -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Static loc:Strings.SmpInputLabel}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Text="{Binding SmpInput}"
                                     Watermark="{x:Static loc:Strings.SmpInputWatermark}"
                                     FontSize="11" Padding="10,7"
                                     AcceptsReturn="False"
                                     CornerRadius="{StaticResource RadiusXs}"/>
                            <TextBlock Text="{x:Static loc:Strings.SmpInputHint}"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SmpErrorText}"
                                       FontSize="10"
                                       Foreground="{DynamicResource DangerFgBrush}"
                                       IsVisible="{Binding SmpErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Tunnel mode -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Static loc:Strings.SmpTunnelModeLabel}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <StackPanel Spacing="8">
                                <StackPanel Spacing="1">
                                    <RadioButton GroupName="SmpTunnel"
                                                 IsChecked="{Binding IsSplitTunnel}"
                                                 Content="{x:Static loc:Strings.SmpSplitOption}"
                                                 FontSize="11" FontWeight="SemiBold"
                                                 MinHeight="0" Padding="4,0"/>
                                    <TextBlock Text="{x:Static loc:Strings.SmpSplitHint}"
                                               FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="24,0,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="1">
                                    <RadioButton GroupName="SmpTunnel"
                                                 IsChecked="{Binding !IsSplitTunnel, Mode=OneWay}"
                                                 Content="{x:Static loc:Strings.SmpFullOption}"
                                                 FontSize="11" FontWeight="SemiBold"
                                                 MinHeight="0" Padding="4,0"/>
                                    <TextBlock Text="{x:Static loc:Strings.SmpFullHint}"
                                               FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="24,0,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Autostart -->
                        <CheckBox IsChecked="{Binding SmpAutostartChecked}"
                                  Content="{x:Static loc:Strings.SmpAutostartLabel}"
                                  ToolTip.Tip="{x:Static loc:Strings.SmpTipAutostart}"
                                  FontSize="11"
                                  MinHeight="0" Padding="4,0"/>
                    </StackPanel>
                </Border>

                <!-- ═══ CTA — three mutually-exclusive variants ═══ -->
                <!-- ON: Disconnect — accent-solid, NOT red (per design) -->
                <Button Command="{Binding SmpToggleConnectCommand}"
                        Content="{Binding SimpleCtaText}"
                        IsVisible="{Binding SimpleCtaIsConnected}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="0,12" FontSize="12" FontWeight="Bold"
                        Background="{DynamicResource AccentSolidBrush}"
                        Foreground="{DynamicResource AccentOnSolidBrush}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource RadiusSm}"/>

                <!-- WARN: Cancel — sunken, progress cursor -->
                <Button Command="{Binding SmpToggleConnectCommand}"
                        Content="{Binding SimpleCtaText}"
                        IsVisible="{Binding SimpleCtaIsConnecting}"
                        IsEnabled="False"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="0,12" FontSize="12" FontWeight="Bold"
                        Background="{DynamicResource SurfaceSunkenBrush}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource RadiusSm}"/>

                <!-- OFF: Connect — outlined, accent fg -->
                <Button Command="{Binding SmpToggleConnectCommand}"
                        Content="{Binding SimpleCtaText}"
                        IsVisible="{Binding SimpleCtaIsDisconnected}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="0,12" FontSize="12" FontWeight="Bold"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        Foreground="{DynamicResource AccentFgBrush}"
                        BorderBrush="{DynamicResource AccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSm}"/>

                <!-- ═══ Advanced settings card ═══ -->
                <Button Command="{Binding ToggleUiModeCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        CornerRadius="{StaticResource RadiusMd}"
                        ToolTip.Tip="{Binding UiModeToggleTooltip}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="14,12">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static loc:Strings.SmpAdvCardTitle}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{x:Static loc:Strings.SmpAdvCardSubtitle}"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="28" Height="28"
                                CornerRadius="{StaticResource RadiusSm}"
                                Background="{DynamicResource AccentBgSubtleBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="›" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentFgBrush}"/>
                        </Border>
                    </Grid>
                </Button>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

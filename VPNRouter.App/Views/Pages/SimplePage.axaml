<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:conv="using:VPNRouter.App"
             xmlns:vui="using:VPNRouter.UI.Controls"
             x:Class="VPNRouter.App.Views.Pages.SimplePage"
             x:DataType="vm:MainWindowViewModel">

    <!--
      v2.18.0 — Compact Simple mode (Variant A · Calm).
      Layout sourced from "VPNRouter Design System 2/handoff/SimpleMode.html".
      The page owns its own mini-header (logo + brand + status chips + ⋯ menu),
      so the big MainWindow header is hidden in Simple mode. Three states —
      on / warn / off — each shown via IsVisible on mutually-exclusive VM
      flags (SimpleStatusIsOn / IsWarn / IsOff, same for CTA).
      Don't re-introduce a red destructive CTA for "Disconnect" — per design
      it's a benign toggle, accent-solid.
    -->
    <!-- v2.19.0: Mini-header moved to MainWindow level, so the converters
         the header used (BoolToStatusColorConverter, BoolToLangConverter)
         are no longer needed in this file. SimplePage is now pure body
         content. -->

    <!-- v2.28.4-r8: same r7 pattern — push horizontal padding from
         ScrollViewer to inner Grid Margin so the centered Grid doesn't
         shift when the scrollbar appears on resize. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  AllowAutoHide="False"
                  Padding="0,12,0,16">
        <Grid Margin="16,0,16,0">
        <Grid MaxWidth="420" HorizontalAlignment="Center">
            <StackPanel Spacing="14">

                <!-- ═══ Mini-header reinstated v2.32.0 (parity audit F-02
                     row 1, F-05) ═══
                     Android's first-page scroller shows mascot + "Virtual
                     Penguin Network" + VPN/Zapret/TG chips at the very
                     top — mirrors desktop's MainWindow header but inside
                     the page itself. Re-added here so a stand-alone
                     SimplePage capture (PageScreenshotTests) shows the
                     brand without bringing along the whole MainWindow
                     chrome. MainWindow's mascot + brand columns hide
                     when IsSimpleMode=true so users don't see the brand
                     twice at runtime; the ⋯ kebab stays in MainWindow. -->
                <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                    <Border Grid.Column="0" Width="28" Height="28"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="{DynamicResource AccentBgSubtleBrush}"
                            ClipToBounds="True"
                            VerticalAlignment="Center">
                        <Image Source="{Binding LogoSource}"
                               Width="26" Height="26" Stretch="Uniform"
                               RenderOptions.BitmapInterpolationMode="HighQuality"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Virtual Penguin Network"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <!-- VPN pill chip — 3 mutually-exclusive states.
                                 Identical bindings to MainWindow.axaml's
                                 brand row so flipping IsSimpleMode swaps
                                 visual location without splitting state. -->
                            <Button Command="{Binding NavigateToVpnCommand}"
                                    ToolTip.Tip="{Binding VpnBadgeTooltip}"
                                    Padding="5,1" MinHeight="0"
                                    Background="{DynamicResource SuccessBgBrush}"
                                    BorderThickness="0"
                                    CornerRadius="{StaticResource RadiusPill}"
                                    Cursor="Hand"
                                    IsVisible="{Binding SimpleStatusIsOn}">
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <Ellipse Width="4" Height="4" VerticalAlignment="Center"
                                             Fill="{DynamicResource SuccessSolidBrush}"/>
                                    <TextBlock Text="VPN" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessFgBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NavigateToVpnCommand}"
                                    ToolTip.Tip="{Binding VpnBadgeTooltip}"
                                    Padding="5,1" MinHeight="0"
                                    Background="{DynamicResource WarningBgBrush}"
                                    BorderThickness="0"
                                    CornerRadius="{StaticResource RadiusPill}"
                                    Cursor="Hand"
                                    IsVisible="{Binding SimpleStatusIsWarn}">
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <Ellipse Classes="pulse"
                                             Width="4" Height="4" VerticalAlignment="Center"
                                             Fill="{DynamicResource WarningSolidBrush}"/>
                                    <TextBlock Text="VPN" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{DynamicResource WarningFgBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NavigateToVpnCommand}"
                                    ToolTip.Tip="{Binding VpnBadgeTooltip}"
                                    Padding="5,1" MinHeight="0"
                                    Background="{DynamicResource SurfaceSunkenBrush}"
                                    BorderThickness="0"
                                    CornerRadius="{StaticResource RadiusPill}"
                                    Cursor="Hand"
                                    IsVisible="{Binding SimpleStatusIsOff}">
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <Ellipse Width="4" Height="4" VerticalAlignment="Center"
                                             Fill="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="VPN" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </Button>

                            <!-- Zapret + TG chips: Windows-only (winws.exe +
                                 Python embeddable). IsZapretAvailable /
                                 IsTgProxyAvailable already filter on Linux. -->
                            <Button Command="{Binding NavigateToZapretCommand}"
                                    ToolTip.Tip="{Binding ZapretBadgeTooltip}"
                                    IsVisible="{Binding IsZapretAvailable}"
                                    Padding="5,1" MinHeight="0"
                                    Background="{Binding ZapretBadgeBrush}"
                                    BorderThickness="0"
                                    CornerRadius="{StaticResource RadiusPill}"
                                    Cursor="Hand">
                                <TextBlock Text="Zapret" FontSize="9" FontWeight="SemiBold"
                                           Foreground="White"/>
                            </Button>
                            <Button Command="{Binding NavigateToTgProxyCommand}"
                                    ToolTip.Tip="{Binding TgProxyBadgeTooltip}"
                                    IsVisible="{Binding IsTgProxyAvailable}"
                                    Padding="5,1" MinHeight="0"
                                    Background="{Binding TgProxyBadgeBrush}"
                                    BorderThickness="0"
                                    CornerRadius="{StaticResource RadiusPill}"
                                    Cursor="Hand">
                                <TextBlock Text="TG" FontSize="9" FontWeight="SemiBold"
                                           Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ═══ Status card — 3 variants via IsVisible on SimpleStatusIs* ═══
                     v3.0 Phase G step 1 (2026-05-09): visual treatment moved
                     into the shared VPNRouter.Avalonia.UI.Controls.StatusCard
                     UserControl so desktop + Android render the same Border /
                     dot / typography from one .axaml. Three bool styled
                     properties map 1:1 to the existing SimpleStatusIs* VM
                     getters; Title/Subtitle bind verbatim. -->
                <vui:StatusCard IsOn="{Binding SimpleStatusIsOn}"
                                IsWarn="{Binding SimpleStatusIsWarn}"
                                IsOff="{Binding SimpleStatusIsOff}"
                                Title="{Binding SimpleStatusTitle}"
                                Subtitle="{Binding SimpleStatusDescription}"/>

                <!-- ═══ Config row — tappable, opens the inline form ═══
                     v2.31.6-r9 A11y: same card-as-button pattern as the
                     Advanced settings card below. Bind Name to the
                     L_SmpConfigRowLabel («Конфиг» / «Config») which is
                     also the visible header inside the button. -->
                <Button Command="{Binding OpenConfigPickerCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        CornerRadius="{StaticResource RadiusSm}"
                        AutomationProperties.Name="{Binding L_SmpConfigRowLabel}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="12,8">
                        <!-- Flag-like icon -->
                        <Border Grid.Column="0" Width="24" Height="24"
                                CornerRadius="{StaticResource RadiusXs}"
                                Background="{DynamicResource AccentBgSubtleBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="⚑" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentFgBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding L_SmpConfigRowLabel}"
                                       FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding SimpleConfigModeSummary}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="Consolas, 'Segoe UI Mono', monospace"/>
                        </StackPanel>
                        <!-- v2.31.0-r4 (F-3 / UX-2): chevron now flips with
                             SmpFormExpanded so users can tell the section is
                             open vs collapsed at a glance. Pre-fix the static
                             `›` glyph was identical in both states and looked
                             like a glitch on the first accidental click. -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding SmpFormExpanded,
                                          Converter={x:Static conv:BoolToChevronConverter.Instance},
                                          ConverterParameter=▽|›}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- ═══ Collapsible detail form (input · mode · autostart).
                     Bound to SmpFormExpanded. The config row above toggles it. ═══ -->
                <Border IsVisible="{Binding SmpFormExpanded}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        CornerRadius="{StaticResource RadiusSm}"
                        Padding="12">
                    <StackPanel Spacing="14">
                        <!-- Input -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding L_SmpInputLabel}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Text="{Binding SmpInput, UpdateSourceTrigger=PropertyChanged}"
                                     Watermark="{Binding L_SmpInputWatermark}"
                                     FontSize="11" Padding="10,7"
                                     AcceptsReturn="False"
                                     CornerRadius="{StaticResource RadiusXs}"/>
                            <TextBlock Text="{Binding L_SmpInputHint}"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                            <!-- v2.32.0 parity audit F-11 (2026-05-09): inline
                                 auto-detect hint mirrors Android's sub-tab
                                 feedback. Visible only when the input matches
                                 a recognised scheme — empty input keeps the
                                 row collapsed so the form doesn't visually
                                 jitter on first render. -->
                            <TextBlock Text="{Binding SmpInputDetectedHint}"
                                       FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentFgBrush}"
                                       IsVisible="{Binding SmpInputDetectedHintVisible}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SmpErrorText}"
                                       FontSize="10"
                                       Foreground="{DynamicResource DangerFgBrush}"
                                       IsVisible="{Binding SmpErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       TextWrapping="Wrap"/>
                            <!-- v2.32.0 parity audit F-02 row 6: Save + Refresh
                                 buttons next to the input mirror Android's
                                 main-scroller action row. QR is Android-only
                                 (no camera surface on desktop).
                                 v2.32.0 F-11 (2026-05-09): IsEnabled bound to
                                 dirty + detected-kind so Save lights up only
                                 on a fresh recognised paste; Refresh requires
                                 a saved subscription. -->
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        HorizontalAlignment="Right" Margin="0,2,0,0">
                                <Button Command="{Binding SmpSaveCommand}"
                                        Content="{Binding L_SmpSaveButton}"
                                        IsEnabled="{Binding SmpSaveEnabled}"
                                        FontSize="10" Padding="10,4"
                                        MinHeight="0"
                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusXs}"/>
                                <Button Command="{Binding SmpRefreshCommand}"
                                        Content="{Binding L_SmpRefreshButton}"
                                        IsEnabled="{Binding SmpRefreshEnabled}"
                                        FontSize="10" Padding="10,4"
                                        MinHeight="0"
                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusXs}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Tunnel mode -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding L_SmpTunnelModeLabel}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <StackPanel Spacing="8">
                                <StackPanel Spacing="1">
                                    <RadioButton GroupName="SmpTunnel"
                                                 IsChecked="{Binding IsSplitTunnel}"
                                                 Content="{Binding L_SmpSplitOption}"
                                                 FontSize="11" FontWeight="SemiBold"
                                                 MinHeight="0" Padding="4,0"/>
                                    <TextBlock Text="{Binding L_SmpSplitHint}"
                                               FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="24,0,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="1">
                                    <RadioButton GroupName="SmpTunnel"
                                                 IsChecked="{Binding !IsSplitTunnel, Mode=OneWay}"
                                                 Content="{Binding L_SmpFullOption}"
                                                 FontSize="11" FontWeight="SemiBold"
                                                 MinHeight="0" Padding="4,0"/>
                                    <TextBlock Text="{Binding L_SmpFullHint}"
                                               FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="24,0,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Autostart link-card (v2.27.0-r2) — old Simple
                             checkbox was a parallel toggle to the Advanced
                             master that needed a three-input computed to
                             stay in sync. User feedback (r1): "а как его
                             отключить?" + constant Running status were the
                             symptoms. Dropped the mirror; Simple now opens
                             Advanced → Autostart via OpenAutostartSettings
                             Command. Status pill keeps Simple informative
                             ("service running" / "configure autostart"). -->
                        <Button Command="{Binding OpenAutostartSettingsCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="10,8"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                Background="{DynamicResource SurfaceSunkenBrush}"
                                CornerRadius="{StaticResource RadiusSm}"
                                ToolTip.Tip="{Binding L_SmpTipAutostart}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding L_SmpAutostartCardTitle}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding L_SmpAutostartCardStatus}"
                                               FontSize="9"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="›"
                                           FontSize="14" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentFgBrush}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ═══ Save / Refresh toast ═══
                     v2.32.0 parity audit F-11 (2026-05-09). Shown for ~2.5 s
                     after Save / Refresh so the user has explicit feedback
                     ("Saved as subscription", "Subscription refreshed").
                     Mirrors RulesToastText pattern in Network page. -->
                <Border IsVisible="{Binding HasSmpToast}"
                        Background="{DynamicResource AccentBgSubtleBrush}"
                        BorderBrush="{DynamicResource AccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusXs}"
                        Padding="10,6">
                    <TextBlock Text="{Binding SmpToastText}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentFgBrush}"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- ═══ CTA — three mutually-exclusive variants ═══
                     v2.31.6-r9 A11y: each variant binds AutomationProperties.Name
                     to SimpleCtaText so screen readers announce the state-
                     appropriate verb ("Connect" / "Disconnect" / "Cancel").
                     Same string drives Content visually + Name for a11y. -->
                <!-- ON: Disconnect — accent-solid, NOT red (per design) -->
                <Button Command="{Binding SmpToggleConnectCommand}"
                        Content="{Binding SimpleCtaText}"
                        IsVisible="{Binding SimpleCtaIsConnected}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="0,12" FontSize="12" FontWeight="Bold"
                        Background="{DynamicResource AccentSolidBrush}"
                        Foreground="{DynamicResource AccentOnSolidBrush}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource RadiusSm}"
                        AutomationProperties.Name="{Binding SimpleCtaText}"/>

                <!-- WARN: Cancel — sunken, progress cursor -->
                <Button Command="{Binding SmpToggleConnectCommand}"
                        Content="{Binding SimpleCtaText}"
                        IsVisible="{Binding SimpleCtaIsConnecting}"
                        IsEnabled="False"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="0,12" FontSize="12" FontWeight="Bold"
                        Background="{DynamicResource SurfaceSunkenBrush}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource RadiusSm}"
                        AutomationProperties.Name="{Binding SimpleCtaText}"/>

                <!-- OFF: Connect — outlined, accent fg.
                     v2.32.0 parity audit F-12 (2026-05-09): IsEnabled gates
                     Connect on SmpInputDirty so the silent ConfigMode flip
                     (paste URL → Connect → empty subscription) is unreachable
                     from the UI. User must Save first. -->
                <Button Command="{Binding SmpToggleConnectCommand}"
                        Content="{Binding SimpleCtaText}"
                        IsVisible="{Binding SimpleCtaIsDisconnected}"
                        IsEnabled="{Binding SmpConnectEnabled}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="0,12" FontSize="12" FontWeight="Bold"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        Foreground="{DynamicResource AccentFgBrush}"
                        BorderBrush="{DynamicResource AccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSm}"
                        AutomationProperties.Name="{Binding SimpleCtaText}"/>

                <!-- ═══ Advanced settings card ═══
                     v2.31.6-r9 A11y: this is a Button rendered as a card; the
                     Content is composed of inner Grid + TextBlocks rather than
                     a plain string label, so screen readers can't fall back
                     to a default name. Bind Name to L_SmpAdvCardTitle so the
                     announcement matches the visible primary text «Advanced
                     settings» / «Расширенные настройки». -->
                <Button Command="{Binding ToggleUiModeCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        CornerRadius="{StaticResource RadiusMd}"
                        ToolTip.Tip="{Binding UiModeToggleTooltip}"
                        AutomationProperties.Name="{Binding L_SmpAdvCardTitle}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="14,12">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding L_SmpAdvCardTitle}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding L_SmpAdvCardSubtitle}"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="28" Height="28"
                                CornerRadius="{StaticResource RadiusSm}"
                                Background="{DynamicResource AccentBgSubtleBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="›" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentFgBrush}"/>
                        </Border>
                    </Grid>
                </Button>

            </StackPanel>
        </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:icons="using:VPNRouter.App.Controls"
             x:Class="VPNRouter.App.Views.Pages.SimplePage"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  AllowAutoHide="False"
                  Padding="0,12,0,16">
        <Grid Margin="16,0,16,0">
        <Grid MaxWidth="420" HorizontalAlignment="Center">
            <StackPanel Spacing="14">

                <Border BorderThickness="1"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="14">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <icons:Pictogram Id="status" Width="20" Height="20" VerticalAlignment="Center"
                                     Foreground="{DynamicResource SuccessSolidBrush}"
                                     IsVisible="{Binding SimpleStatusIsOn}"/>
                            <icons:Pictogram Id="status" Width="20" Height="20" VerticalAlignment="Center"
                                     Foreground="{DynamicResource WarningSolidBrush}"
                                     IsVisible="{Binding SimpleStatusIsWarn}"/>
                            <icons:Pictogram Id="status" Width="20" Height="20" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     IsVisible="{Binding SimpleStatusIsOff}"/>
                            <TextBlock Text="{Binding SimpleStatusTitle}"
                                       FontSize="15" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock icons:PictogramText.Icons="warning" icons:PictogramText.PrefixOnly="True" icons:PictogramText.Text="{Binding SimpleStatusDescription}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="20,0,0,0"
                                   LineHeight="15"/>
                        <TextBlock icons:PictogramText.Icons="arrow-down,arrow-up" icons:PictogramText.Text="{Binding ConnectionStatsText}"
                                   IsVisible="{Binding HasConnectionStats}"
                                   FontSize="10"
                                   FontFamily="Consolas,Menlo,monospace"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="20,0,0,0"
                                   LineHeight="15"/>
                    </StackPanel>
                </Border>

                <Border IsVisible="{Binding IsBadComboWarningVisible}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource WarningBorderBrush}"
                        Background="{DynamicResource WarningBgBrush}"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="14,12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding LblBadComboWarningTitle}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="{DynamicResource WarningFgBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LblBadComboWarningBody}"
                                   FontSize="11"
                                   LineHeight="16"
                                   Foreground="{DynamicResource WarningFgBrush}"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="{Binding LblBadComboDisableLockdown}"
                                    Command="{Binding DisableBadComboLockdownCommand}"
                                    FontSize="11"
                                    Padding="10,5"
                                    CornerRadius="{StaticResource RadiusSm}"/>
                            <Button Content="{Binding LblBadComboDisableRuBypass}"
                                    Command="{Binding DisableBadComboRuBypassCommand}"
                                    FontSize="11"
                                    Padding="10,5"
                                    CornerRadius="{StaticResource RadiusSm}"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource WarningBorderBrush}"
                                    BorderThickness="1"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Command="{Binding OpenConfigPickerCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        CornerRadius="{StaticResource RadiusSm}"
                        AutomationProperties.Name="{Binding L_SmpConfigRowLabel}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="12,8">
                        <Border Grid.Column="0" Width="24" Height="24"
                                CornerRadius="{StaticResource RadiusXs}"
                                Background="{DynamicResource AccentBgSubtleBrush}"
                                VerticalAlignment="Center">
                            <TextBlock icons:PictogramText.Icons="flag" icons:PictogramText.Text="⚑" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentFgBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding L_SmpConfigRowLabel}"
                                       FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding SimpleConfigModeSummary}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="Consolas, 'Segoe UI Mono', monospace"/>
                            <TextBlock Text="{Binding SimpleActiveOutboundLine}"
                                       IsVisible="{Binding SimpleActiveOutboundNormalVisible}"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontFamily="Consolas, 'Segoe UI Mono', monospace"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="4"
                                        IsVisible="{Binding SimpleActiveOutboundSuspectVisible}">
                                <TextBlock icons:PictogramText.Icons="warning" icons:PictogramText.Text="⚠"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource DangerFgBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SimpleActiveOutboundLine}"
                                           FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerFgBrush}"
                                           FontFamily="Consolas, 'Segoe UI Mono', monospace"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="2" Classes="disclosure-pill">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding L_SmpConfigRowToggle}"/>
                                <icons:Pictogram Id="chevron-down" Classes="disclosure"
                                                 Classes.open="{Binding SmpFormExpanded}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Button>

                <Border IsVisible="{Binding SmpFormExpanded}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        CornerRadius="{StaticResource RadiusSm}"
                        Padding="12">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding L_SmpInputLabel}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Text="{Binding SmpInput}"
                                     PlaceholderText="{Binding L_SmpInputWatermark}"
                                     FontSize="11" Padding="10,7"
                                     AcceptsReturn="False"
                                     CornerRadius="{StaticResource RadiusXs}"/>
                            <TextBlock Text="{Binding L_SmpInputHint}"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SmpErrorText}"
                                       FontSize="10"
                                       Foreground="{DynamicResource DangerFgBrush}"
                                       IsVisible="{Binding SmpErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Spacing="4" IsEnabled="{Binding !IsApplying}">
                            <TextBlock Text="{Binding L_SmpTunnelModeLabel}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <StackPanel Spacing="8">
                                <StackPanel Spacing="1">
                                    <RadioButton GroupName="SmpTunnel"
                                                 IsChecked="{Binding IsSplitTunnel}"
                                                 Content="{Binding L_SmpSplitOption}"
                                                 FontSize="11" FontWeight="SemiBold"
                                                 MinHeight="0" Padding="4,0"/>
                                    <TextBlock Text="{Binding L_SmpSplitHint}"
                                               FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="24,0,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="1">
                                    <RadioButton GroupName="SmpTunnel"
                                                 IsChecked="{Binding !IsSplitTunnel, Mode=OneWay}"
                                                 Content="{Binding L_SmpFullOption}"
                                                 FontSize="11" FontWeight="SemiBold"
                                                 MinHeight="0" Padding="4,0"/>
                                    <TextBlock Text="{Binding L_SmpFullHint}"
                                               FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="24,0,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Button Command="{Binding OpenAutostartSettingsCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="10,8"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                Background="{DynamicResource SurfaceSunkenBrush}"
                                CornerRadius="{StaticResource RadiusSm}"
                                ToolTip.Tip="{Binding L_SmpTipAutostart}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding L_SmpAutostartCardTitle}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding L_SmpAutostartCardStatus}"
                                               FontSize="9"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" icons:PictogramText.Icons="chevron-right" icons:PictogramText.Text="›"
                                           FontSize="14" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentFgBrush}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <Button Classes="solid" Command="{Binding SmpToggleConnectCommand}"
                        Content="{Binding SimpleCtaText}"
                        IsVisible="{Binding SimpleCtaIsConnected}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="0,12" FontSize="12" FontWeight="Bold"
                        Background="{DynamicResource AccentSolidBrush}"
                        Foreground="{DynamicResource AccentOnSolidBrush}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource RadiusSm}"
                        AutomationProperties.Name="{Binding SimpleCtaText}"/>

                <Button Command="{Binding SmpToggleConnectCommand}"
                        Content="{Binding SimpleCtaText}"
                        IsVisible="{Binding SimpleCtaIsConnecting}"
                        IsEnabled="False"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="0,12" FontSize="12" FontWeight="Bold"
                        Background="{DynamicResource SurfaceSunkenBrush}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource RadiusSm}"
                        AutomationProperties.Name="{Binding SimpleCtaText}"/>

                <Button Command="{Binding SmpToggleConnectCommand}"
                        Content="{Binding SimpleCtaText}"
                        IsVisible="{Binding SimpleCtaIsDisconnected}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="0,12" FontSize="12" FontWeight="Bold"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        Foreground="{DynamicResource AccentFgBrush}"
                        BorderBrush="{DynamicResource AccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSm}"
                        AutomationProperties.Name="{Binding SimpleCtaText}"/>

                <Button Command="{Binding ToggleUiModeCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        CornerRadius="{StaticResource RadiusMd}"
                        ToolTip.Tip="{Binding UiModeToggleTooltip}"
                        AutomationProperties.Name="{Binding L_SmpAdvCardTitle}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="14,12">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding L_SmpAdvCardTitle}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding L_SmpAdvCardSubtitle}"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="28" Height="28"
                                CornerRadius="{StaticResource RadiusSm}"
                                Background="{DynamicResource AccentBgSubtleBrush}"
                                VerticalAlignment="Center">
                            <TextBlock icons:PictogramText.Icons="chevron-right" icons:PictogramText.Text="›" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentFgBrush}"/>
                        </Border>
                    </Grid>
                </Button>

            </StackPanel>
        </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:conv="using:VPNRouter.App"
             x:Class="VPNRouter.App.Views.Pages.SimplePage"
             x:DataType="vm:MainWindowViewModel">

    <!--
      v2.18.0 — Compact Simple mode (Variant A · Calm).
      Layout sourced from "VPNRouter Design System 2/handoff/SimpleMode.html".
      The page owns its own mini-header (logo + brand + status chips + ⋯ menu),
      so the big MainWindow header is hidden in Simple mode. Three states —
      on / warn / off — each shown via IsVisible on mutually-exclusive VM
      flags (SimpleStatusIsOn / IsWarn / IsOff, same for CTA).
      Don't re-introduce a red destructive CTA for "Disconnect" — per design
      it's a benign toggle, accent-solid.
    -->
    <!-- v2.19.0: Mini-header moved to MainWindow level, so the converters
         the header used (BoolToStatusColorConverter, BoolToLangConverter)
         are no longer needed in this file. SimplePage is now pure body
         content. -->

    <!-- v2.28.4-r8: same r7 pattern — push horizontal padding from
         ScrollViewer to inner Grid Margin so the centered Grid doesn't
         shift when the scrollbar appears on resize. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  AllowAutoHide="False"
                  Padding="0,12,0,16">
        <Grid Margin="16,0,16,0">
        <Grid MaxWidth="420" HorizontalAlignment="Center">
            <StackPanel Spacing="14">

                <!-- ═══ Mini-header removed in v2.19.0 ═══
                     The compact logo + brand + VPN/Zapret/TG chips + ⋯ menu
                     now live at the MainWindow level (MainWindow.axaml Row=0),
                     shared by both Simple and Advanced modes. This keeps
                     total header height identical when the user flips modes
                     and avoids duplicating the bindings across two files. -->

                <!-- ═══ Status card — 3 variants via IsVisible on SimpleStatusIs* ═══ -->
                <Border BorderThickness="1"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        CornerRadius="{StaticResource RadiusMd}"
                        Padding="14">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <!-- Status dot — only one visible at a time -->
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{DynamicResource SuccessSolidBrush}"
                                     IsVisible="{Binding SimpleStatusIsOn}"/>
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{DynamicResource WarningSolidBrush}"
                                     IsVisible="{Binding SimpleStatusIsWarn}"/>
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{DynamicResource TextMutedBrush}"
                                     IsVisible="{Binding SimpleStatusIsOff}"/>
                            <TextBlock Text="{Binding SimpleStatusTitle}"
                                       FontSize="15" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SimpleStatusDescription}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="20,0,0,0"
                                   LineHeight="15"/>
                    </StackPanel>
                </Border>

                <!-- ═══ Config row — tappable, opens the inline form ═══
                     v2.31.6-r9 A11y: same card-as-button pattern as the
                     Advanced settings card below. Bind Name to the
                     L_SmpConfigRowLabel («Конфиг» / «Config») which is
                     also the visible header inside the button. -->
                <Button Command="{Binding OpenConfigPickerCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        CornerRadius="{StaticResource RadiusSm}"
                        AutomationProperties.Name="{Binding L_SmpConfigRowLabel}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="12,8">
                        <!-- Flag-like icon -->
                        <Border Grid.Column="0" Width="24" Height="24"
                                CornerRadius="{StaticResource RadiusXs}"
                                Background="{DynamicResource AccentBgSubtleBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="⚑" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentFgBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding L_SmpConfigRowLabel}"
                                       FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding SimpleConfigModeSummary}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="Consolas, 'Segoe UI Mono', monospace"/>
                        </StackPanel>
                        <!-- v2.31.0-r4 (F-3 / UX-2): chevron now flips with
                             SmpFormExpanded so users can tell the section is
                             open vs collapsed at a glance. Pre-fix the static
                             `›` glyph was identical in both states and looked
                             like a glitch on the first accidental click. -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding SmpFormExpanded,
                                          Converter={x:Static conv:BoolToChevronConverter.Instance},
                                          ConverterParameter=▽|›}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- ═══ Collapsible detail form (input · mode · autostart).
                     Bound to SmpFormExpanded. The config row above toggles it. ═══ -->
                <Border IsVisible="{Binding SmpFormExpanded}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        CornerRadius="{StaticResource RadiusSm}"
                        Padding="12">
                    <StackPanel Spacing="14">
                        <!-- Input -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding L_SmpInputLabel}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Text="{Binding SmpInput}"
                                     Watermark="{Binding L_SmpInputWatermark}"
                                     FontSize="11" Padding="10,7"
                                     AcceptsReturn="False"
                                     CornerRadius="{StaticResource RadiusXs}"/>
                            <TextBlock Text="{Binding L_SmpInputHint}"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SmpErrorText}"
                                       FontSize="10"
                                       Foreground="{DynamicResource DangerFgBrush}"
                                       IsVisible="{Binding SmpErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Tunnel mode -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding L_SmpTunnelModeLabel}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <StackPanel Spacing="8">
                                <StackPanel Spacing="1">
                                    <RadioButton GroupName="SmpTunnel"
                                                 IsChecked="{Binding IsSplitTunnel}"
                                                 Content="{Binding L_SmpSplitOption}"
                                                 FontSize="11" FontWeight="SemiBold"
                                                 MinHeight="0" Padding="4,0"/>
                                    <TextBlock Text="{Binding L_SmpSplitHint}"
                                               FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="24,0,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="1">
                                    <RadioButton GroupName="SmpTunnel"
                                                 IsChecked="{Binding !IsSplitTunnel, Mode=OneWay}"
                                                 Content="{Binding L_SmpFullOption}"
                                                 FontSize="11" FontWeight="SemiBold"
                                                 MinHeight="0" Padding="4,0"/>
                                    <TextBlock Text="{Binding L_SmpFullHint}"
                                               FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="24,0,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Autostart link-card (v2.27.0-r2) — old Simple
                             checkbox was a parallel toggle to the Advanced
                             master that needed a three-input computed to
                             stay in sync. User feedback (r1): "а как его
                             отключить?" + constant Running status were the
                             symptoms. Dropped the mirror; Simple now opens
                             Advanced → Autostart via OpenAutostartSettings
                             Command. Status pill keeps Simple informative
                             ("service running" / "configure autostart"). -->
                        <Button Command="{Binding OpenAutostartSettingsCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="10,8"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                Background="{DynamicResource SurfaceSunkenBrush}"
                                CornerRadius="{StaticResource RadiusSm}"
                                ToolTip.Tip="{Binding L_SmpTipAutostart}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding L_SmpAutostartCardTitle}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding L_SmpAutostartCardStatus}"
                                               FontSize="9"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="›"
                                           FontSize="14" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentFgBrush}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ═══ CTA — three mutually-exclusive variants ═══
                     v2.31.6-r9 A11y: each variant binds AutomationProperties.Name
                     to SimpleCtaText so screen readers announce the state-
                     appropriate verb ("Connect" / "Disconnect" / "Cancel").
                     Same string drives Content visually + Name for a11y. -->
                <!-- ON: Disconnect — accent-solid, NOT red (per design) -->
                <Button Command="{Binding SmpToggleConnectCommand}"
                        Content="{Binding SimpleCtaText}"
                        IsVisible="{Binding SimpleCtaIsConnected}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="0,12" FontSize="12" FontWeight="Bold"
                        Background="{DynamicResource AccentSolidBrush}"
                        Foreground="{DynamicResource AccentOnSolidBrush}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource RadiusSm}"
                        AutomationProperties.Name="{Binding SimpleCtaText}"/>

                <!-- WARN: Cancel — sunken, progress cursor -->
                <Button Command="{Binding SmpToggleConnectCommand}"
                        Content="{Binding SimpleCtaText}"
                        IsVisible="{Binding SimpleCtaIsConnecting}"
                        IsEnabled="False"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="0,12" FontSize="12" FontWeight="Bold"
                        Background="{DynamicResource SurfaceSunkenBrush}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource RadiusSm}"
                        AutomationProperties.Name="{Binding SimpleCtaText}"/>

                <!-- OFF: Connect — outlined, accent fg -->
                <Button Command="{Binding SmpToggleConnectCommand}"
                        Content="{Binding SimpleCtaText}"
                        IsVisible="{Binding SimpleCtaIsDisconnected}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="0,12" FontSize="12" FontWeight="Bold"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        Foreground="{DynamicResource AccentFgBrush}"
                        BorderBrush="{DynamicResource AccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSm}"
                        AutomationProperties.Name="{Binding SimpleCtaText}"/>

                <!-- ═══ Advanced settings card ═══
                     v2.31.6-r9 A11y: this is a Button rendered as a card; the
                     Content is composed of inner Grid + TextBlocks rather than
                     a plain string label, so screen readers can't fall back
                     to a default name. Bind Name to L_SmpAdvCardTitle so the
                     announcement matches the visible primary text «Advanced
                     settings» / «Расширенные настройки». -->
                <Button Command="{Binding ToggleUiModeCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        CornerRadius="{StaticResource RadiusMd}"
                        ToolTip.Tip="{Binding UiModeToggleTooltip}"
                        AutomationProperties.Name="{Binding L_SmpAdvCardTitle}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="14,12">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding L_SmpAdvCardTitle}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding L_SmpAdvCardSubtitle}"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="28" Height="28"
                                CornerRadius="{StaticResource RadiusSm}"
                                Background="{DynamicResource AccentBgSubtleBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="›" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentFgBrush}"/>
                        </Border>
                    </Grid>
                </Button>

            </StackPanel>
        </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:conv="using:VPNRouter.App"
             xmlns:icons="using:VPNRouter.App.Controls"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="500"
             x:Class="VPNRouter.App.Views.Pages.ApplicationsPage"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel"
             Background="{DynamicResource SurfaceAppBrush}">

  <UserControl.Styles>

    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <Style Selector="Border.banner">
      <Setter Property="Background" Value="{DynamicResource WarningBgBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="14,8"/>
    </Style>
    <Style Selector="Border.banner TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource WarningFgBrush}"/>
    </Style>
    <Style Selector="Border.banner icons|Pictogram">
      <Setter Property="Width" Value="14"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource WarningFgBrush}"/>
    </Style>

    <Style Selector="Border.segments">
      <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
      <Setter Property="Padding" Value="3"/>
    </Style>
    <Style Selector="ToggleButton.apps-mode-seg">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="ToggleButton.apps-mode-seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="ToggleButton.apps-mode-seg:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBgMutedBrush}"/>
    </Style>
    <Style Selector="ToggleButton.apps-mode-seg:checked /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton.apps-mode-seg:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton.apps-mode-seg:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowSm}"/>
    </Style>

    <Style Selector="ListBox.cat-list ListBoxItem">
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style Selector="TextBlock.cat-name">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Border.cat-count">
      <Setter Property="Background" Value="{DynamicResource PillNeutralBgBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="5,0"/>
      <Setter Property="MinWidth" Value="18"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.cat-count TextBlock">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource PillNeutralFgBrush}"/>
    </Style>
    <Style Selector="ListBox.cat-list ListBoxItem:selected Border.cat-count">
      <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
    </Style>
    <Style Selector="ListBox.cat-list ListBoxItem:selected Border.cat-count TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
    </Style>

    <Style Selector="ListBox.apps-list ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style Selector="ListBox.apps-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.apps-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.apps-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.apps-list ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.app-row">
      <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
      <Setter Property="Padding" Value="10,0,4,0"/>
      <Setter Property="MinHeight" Value="38"/>
    </Style>
    <Style Selector="ListBox.apps-list ListBoxItem:pointerover Border.app-row">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
    </Style>
    <Style Selector="Border.app-row TextBlock.app-name">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}"/>
      <Setter Property="Padding" Value="5,1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Border.vpn-badge">
      <Setter Property="Background" Value="{DynamicResource PillFastBgBrush}"/>
    </Style>
    <Style Selector="Border.vpn-badge TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PillFastFgBrush}"/>
    </Style>
    <Style Selector="Border.direct-badge">
      <Setter Property="Background" Value="{DynamicResource PillSlowBgBrush}"/>
    </Style>
    <Style Selector="Border.direct-badge TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PillSlowFgBrush}"/>
    </Style>
    <Style Selector="Border.custom-badge">
      <Setter Property="Background" Value="{DynamicResource PillNeutralBgBrush}"/>
    </Style>
    <Style Selector="Border.custom-badge TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PillNeutralFgBrush}"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style Selector="Button.icon-btn">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}"/>
    </Style>
    <Style Selector="Button.small">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="StackPanel.empty-state">
      <Setter Property="Spacing" Value="8"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="MaxWidth" Value="260"/>
      <Setter Property="Margin" Value="16"/>
    </Style>
    <Style Selector="StackPanel.empty-state icons|Pictogram">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="StackPanel.empty-state TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*">

    <Border Grid.Row="0" Classes="banner" IsVisible="{Binding IsFullTunnel}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <icons:Pictogram Grid.Column="0" Id="info"/>
        <TextBlock Grid.Column="1" Text="{Binding L_AppsFullTunnelBanner}"/>
        <Button Classes="solid small" Grid.Column="2"
                Content="{Binding L_AppsFullTunnelBannerAction}"
                Command="{Binding SwitchToSplitTunnelCommand}"
                FontWeight="SemiBold"
                Background="{DynamicResource AccentSolidBrush}"
                Foreground="{DynamicResource AccentOnSolidBrush}"/>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            IsVisible="{Binding IsSplitTunnel}"
            IsEnabled="{Binding !IsApplying}"
            Padding="12,10,12,10"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            Background="{DynamicResource SurfaceBaseBrush}">
      <StackPanel Spacing="6">
        <TextBlock Classes="section-title" Text="{Binding L_AppsModeSectionTitle}"/>
        <Border Classes="segments">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="3">
            <ToggleButton Grid.Column="0"
                          Classes="apps-mode-seg"
                          IsChecked="{Binding IsRoutingAppsModeInclude, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding L_AppsModeInclude}">
              <TextBlock Text="{Binding L_AppsModeInclude}"
                         TextWrapping="Wrap"
                         TextAlignment="Center"/>
            </ToggleButton>
            <ToggleButton Grid.Column="1"
                          Classes="apps-mode-seg"
                          IsChecked="{Binding IsRoutingAppsModeExclude, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding L_AppsModeExclude}">
              <TextBlock Text="{Binding L_AppsModeExclude}"
                         TextWrapping="Wrap"
                         TextAlignment="Center"/>
            </ToggleButton>
          </Grid>
        </Border>
        <TextBlock Classes="hint" Text="{Binding L_CurrentAppsModeHint}"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Classes="banner" IsVisible="{Binding IsTrueSplitStatusVisible}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <icons:Pictogram Grid.Column="0" Id="warning"/>
        <TextBlock Grid.Column="1" Text="{Binding TrueSplitStatusText}"/>
        <Button Classes="solid small" Grid.Column="2"
                Content="{Binding L_TrueSplitRetry}"
                Command="{Binding RestartTrueSplitCommand}"
                IsVisible="{Binding IsTrueSplitRetryVisible}"
                FontWeight="SemiBold"
                Background="{DynamicResource WarningSolidBrush}"
                Foreground="White"/>
      </Grid>
    </Border>

    <Grid Grid.Row="3"
          ColumnDefinitions="136,*"
          IsEnabled="{Binding !IsApplying}"
          Opacity="{Binding IsSplitTunnel, Converter={x:Static conv:BoolTo10or05Converter.Instance}}"
          IsHitTestVisible="{Binding IsSplitTunnel}"
          Cursor="{Binding IsFullTunnel, Converter={x:Static conv:FullTunnelCursorConverter.Instance}}">

    <Border Grid.Column="0"
            BorderThickness="0,0,1,0"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            Background="{DynamicResource SurfaceSunkenBrush}">
      <Grid RowDefinitions="*,Auto">
        <ListBox Grid.Row="0"
                 Classes="cat-list sub-tabs"
                 ItemsSource="{Binding ActiveAppGroups}"
                 SelectedItem="{Binding SelectedActiveAppGroup}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="6"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AppGroupViewModel">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="cat-name"
                           Text="{Binding DisplayName}"
                           ToolTip.Tip="{Binding DisplayName}"/>
                <Border Grid.Column="1" Classes="cat-count"
                        IsVisible="{Binding Apps.Count}">
                  <TextBlock Text="{Binding Apps.Count}"/>
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="1"
                Padding="6,8,6,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderSubtleBrush}">
          <StackPanel Spacing="6">
            <TextBox x:Name="NewCategoryInput"
                     Text="{Binding NewCategoryName}"
                     PlaceholderText="{Binding L_CategoryNameWatermark}"
                     FontSize="11" Padding="8,5"
                     CornerRadius="{StaticResource RadiusSm}"/>
            <Button Classes="small" Padding="4,3"
                    icons:PictogramText.Icons="add" icons:PictogramText.Content="{Binding L_AddCategory}"
                    Command="{Binding AddCategoryCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto"
          DataContext="{Binding SelectedActiveAppGroup}"
          x:DataType="vm:AppGroupViewModel"
          IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6"
            Margin="12,10,10,8">
        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="14" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"/>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="4">
          <Button Classes="small"
                  Content="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_SelectAllApps}"
                  Command="{Binding SelectAllCommand}"/>
          <Button Classes="small"
                  Content="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_ClearAllApps}"
                  Command="{Binding ClearAllCommand}"/>
        </StackPanel>
        <Button Grid.Column="1" Classes="icon-btn"
                IsVisible="{Binding IsCustomCategory}"
                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RemoveCategoryCommand}"
                CommandParameter="{Binding}"
                ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipRemoveCategory}"
                AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipRemoveCategory}">
          <icons:Pictogram Id="delete" Width="15" Height="15"/>
        </Button>
      </Grid>

      <StackPanel Grid.Row="1" Classes="empty-state" IsVisible="{Binding !Apps.Count}">
        <icons:Pictogram Id="tab-apps"/>
        <TextBlock Text="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_AppsGroupEmpty}"/>
      </StackPanel>

      <ListBox Grid.Row="1"
               Classes="apps-list"
               ItemsSource="{Binding Apps}"
               Background="Transparent"
               BorderThickness="0"
               Padding="12,0,12,8"
               SelectionMode="Single"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               IsVisible="{Binding Apps.Count}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AppItemViewModel">
            <Border Classes="app-row">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsChecked}"
                          AutomationProperties.Name="{Binding ProcessName}"
                          MinHeight="0" Padding="0"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Classes="app-name"
                           Text="{Binding ProcessName}"
                           MinWidth="0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding ProcessName}"/>
                <Panel Grid.Column="2" IsVisible="{Binding IsChecked}">
                  <Border Classes="badge vpn-badge"
                          ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_AppsListInclude}"
                          IsVisible="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).IsRoutingAppsModeInclude}">
                    <TextBlock Text="VPN"/>
                  </Border>
                  <Border Classes="badge direct-badge"
                          ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_AppsListExclude}"
                          IsVisible="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).IsRoutingAppsModeExclude}">
                    <TextBlock Text="BYPASS"/>
                  </Border>
                </Panel>
                <Border Grid.Column="3" Classes="badge custom-badge"
                        IsVisible="{Binding IsCustom}">
                  <TextBlock Text="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_LblCustomBadge}"/>
                </Border>
                <Button Grid.Column="4" Classes="icon-btn"
                        IsVisible="{Binding IsCustom}"
                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RemoveCustomAppCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipRemoveApp}"
                        AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipRemoveApp}">
                  <icons:Pictogram Id="delete" Width="14" Height="14"/>
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Row="2"
              Padding="12,10"
              BorderThickness="0,1,0,0"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              Background="{DynamicResource SurfaceBaseBrush}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6"
                IsVisible="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).HasPendingAppChanges}">
            <icons:Pictogram Grid.Column="0" Id="warning" Width="13" Height="13" VerticalAlignment="Top" Margin="0,1,0,0"
                             Foreground="{DynamicResource WarningFgBrush}"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_AppsPendingApplyHint}"
                       TextWrapping="Wrap"
                       FontSize="10"
                       Foreground="{DynamicResource WarningFgBrush}"/>
          </Grid>
          <Button Classes="solid" icons:PictogramText.Icons="apply" icons:PictogramText.Content="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_ApplyChanges}"
                  Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ApplyPendingChangesCommand}"
                  IsVisible="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).HasPendingAppChanges}"
                  IsEnabled="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CanApplyAppChanges}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Background="{DynamicResource WarningSolidBrush}" Foreground="White"
                  FontSize="11" FontWeight="SemiBold"
                  Padding="0,7" CornerRadius="{StaticResource RadiusSm}"/>
          <Button Content="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_ImportSteamGames}"
                  Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ImportSteamGamesCommand}"
                  IsVisible="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).IsAppsListEditorExclude}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  FontSize="11" FontWeight="SemiBold"
                  Padding="0,6" CornerRadius="{StaticResource RadiusSm}"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox Grid.Column="0" x:Name="CustomAppInput"
                     PlaceholderText="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_AddAppHint}"
                     FontSize="11" Padding="8,6"
                     VerticalContentAlignment="Center"
                     CornerRadius="{StaticResource RadiusSm}"/>
            <Button Classes="solid" Grid.Column="1" x:Name="AddCustomAppButton"
                    icons:PictogramText.Icons="add" icons:PictogramText.Content="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_AddCustomAppBtn}"
                    Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).AddCustomAppCommand}"
                    CommandParameter="{Binding #CustomAppInput.Text}"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    Padding="14,0" FontSize="11" CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentOnSolidBrush}"
                    FontWeight="SemiBold"/>
          </Grid>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
            <Button Grid.Column="0" x:Name="BrowseExeButton" Classes="small"
                    Click="OnBrowseExeClicked"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <icons:Pictogram Id="folder" Width="13" Height="13" VerticalAlignment="Center"/>
                <TextBlock x:Name="BrowseExeLabel" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Grid.Column="1" x:Name="RunningProcessesButton" Classes="small"
                    Click="OnSelectRunningProcessClicked"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <icons:Pictogram Id="running" Width="13" Height="13" VerticalAlignment="Center"/>
                <TextBlock x:Name="RunningProcessesLabel" VerticalAlignment="Center"/>
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout Placement="TopEdgeAlignedRight"/>
              </Button.Flyout>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <StackPanel Grid.Column="1" Classes="empty-state"
                IsVisible="{Binding SelectedActiveAppGroup, Converter={x:Static ObjectConverters.IsNull}}">
      <icons:Pictogram Id="arrow-left"/>
      <TextBlock Text="{Binding L_SelectCategoryLabel}"/>
    </StackPanel>
    </Grid>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:conv="using:VPNRouter.App"
             xmlns:icons="using:VPNRouter.App.Controls"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="500"
             x:Class="VPNRouter.App.Views.Pages.ApplicationsPage"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">

  <UserControl.Styles>

    <Style Selector="TextBlock.cat-name">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.cat-count">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontFamily" Value="Consolas, 'SF Mono', 'Cascadia Code', 'Ubuntu Mono', monospace"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="4,0,4,0"/>
    </Style>

    <Style Selector="ListBox.cat-list ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
    </Style>
    <Style Selector="ListBox.cat-list ListBoxItem:selected TextBlock.cat-name">
      <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="ListBox.cat-list ListBoxItem:selected TextBlock.cat-count">
      <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
    </Style>

    <Style Selector="Border.app-row">
      <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
      <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style Selector="Border.app-row TextBlock.app-name">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.custom-badge">
      <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}"/>
      <Setter Property="Padding" Value="5,1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.routing-badge">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}"/>
      <Setter Property="Padding" Value="4,1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.vpn-badge">
      <Setter Property="Background" Value="{DynamicResource PillFastBgBrush}"/>
    </Style>
    <Style Selector="Border.vpn-badge TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PillFastFgBrush}"/>
    </Style>
    <Style Selector="Border.direct-badge">
      <Setter Property="Background" Value="{DynamicResource PillSlowBgBrush}"/>
    </Style>
    <Style Selector="Border.direct-badge TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PillSlowFgBrush}"/>
    </Style>

    <Style Selector="ListBox.cat-list ListBoxItem">
      <Setter Property="Padding" Value="4,0"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="ListBox.apps-list ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
  </UserControl.Styles>

  <UserControl.Styles>
    <Style Selector="ToggleButton.apps-mode-seg">
      <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="ToggleButton.apps-mode-seg:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSolidBrush}"/>
      <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentOnSolidBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*">

    <Border Grid.Row="0"
            IsVisible="{Binding IsFullTunnel}"
            Background="{DynamicResource WarningBgBrush}"
            BorderBrush="{DynamicResource WarningBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,10">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Grid.Column="0"
                   Text="{Binding L_AppsFullTunnelBanner}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource WarningFgBrush}"/>
        <Button Grid.Column="1"
                Content="{Binding L_AppsFullTunnelBannerAction}"
                Command="{Binding SwitchToSplitTunnelCommand}"
                FontSize="11" FontWeight="SemiBold"
                Padding="10,4"
                CornerRadius="{StaticResource RadiusSm}"
                Background="{DynamicResource AccentSolidBrush}"
                Foreground="{DynamicResource AccentOnSolidBrush}"
                VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            IsVisible="{Binding IsSplitTunnel}"
            IsEnabled="{Binding !IsApplying}"
            Padding="14,8,14,4"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource BorderSubtleBrush}">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding L_AppsModeSectionTitle}"
                   FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
          <ToggleButton Grid.Column="0"
                        Classes="apps-mode-seg"
                        IsChecked="{Binding IsRoutingAppsModeInclude, Mode=TwoWay}"
                        AutomationProperties.Name="{Binding L_AppsModeInclude}">
            <TextBlock Text="{Binding L_AppsModeInclude}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
          </ToggleButton>
          <ToggleButton Grid.Column="1"
                        Classes="apps-mode-seg"
                        IsChecked="{Binding IsRoutingAppsModeExclude, Mode=TwoWay}"
                        AutomationProperties.Name="{Binding L_AppsModeExclude}">
            <TextBlock Text="{Binding L_AppsModeExclude}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
          </ToggleButton>
        </Grid>
        <TextBlock Text="{Binding L_CurrentAppsModeHint}"
                   FontSize="10"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="2"
            IsVisible="{Binding IsTrueSplitStatusVisible}"
            Background="{DynamicResource WarningBgBrush}"
            BorderBrush="{DynamicResource WarningBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,7">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Grid.Column="0"
                   Text="{Binding TrueSplitStatusText}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource WarningFgBrush}"/>
        <Button Grid.Column="1"
                Content="{Binding L_TrueSplitRetry}"
                Command="{Binding RestartTrueSplitCommand}"
                IsVisible="{Binding IsTrueSplitRetryVisible}"
                FontSize="11" FontWeight="SemiBold"
                Padding="10,4"
                CornerRadius="{StaticResource RadiusSm}"
                Background="{DynamicResource WarningSolidBrush}"
                Foreground="White"
                VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Grid Grid.Row="3"
          ColumnDefinitions="120,*"
          IsEnabled="{Binding !IsApplying}"
          Opacity="{Binding IsSplitTunnel, Converter={x:Static conv:BoolTo10or05Converter.Instance}}"
          IsHitTestVisible="{Binding IsSplitTunnel}"
          Cursor="{Binding IsFullTunnel, Converter={x:Static conv:FullTunnelCursorConverter.Instance}}">

    <Border Grid.Column="0"
            BorderThickness="0,0,1,0"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            Background="{DynamicResource SurfaceSunkenBrush}">
      <Grid RowDefinitions="*,Auto,Auto">
        <ListBox Grid.Row="0"
                 Classes="cat-list"
                 ItemsSource="{Binding ActiveAppGroups}"
                 SelectedItem="{Binding SelectedActiveAppGroup}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AppGroupViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,4">
                <TextBlock Grid.Column="0" Classes="cat-name"
                           Text="{Binding DisplayName}"/>
                <TextBlock Grid.Column="1" Classes="cat-count"
                           Text="{Binding Apps.Count}"
                           IsVisible="{Binding Apps.Count}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBox Grid.Row="1" x:Name="NewCategoryInput"
                 Text="{Binding NewCategoryName}"
                 PlaceholderText="{Binding L_CategoryNamePrompt}"
                 FontSize="10" Padding="6,4" Margin="4,4,4,2"/>
        <Button Grid.Row="2"
                icons:PictogramText.Icons="add" icons:PictogramText.Content="{Binding L_AddCategory}"
                Command="{Binding AddCategoryCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Margin="4,0,4,4" Padding="4,4"
                FontSize="10" FontWeight="SemiBold" CornerRadius="{StaticResource RadiusSm}"
                Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentOnSolidBrush}"/>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto"
          DataContext="{Binding SelectedActiveAppGroup}"
          x:DataType="vm:AppGroupViewModel"
          IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto"
            Margin="14,10,14,6">
        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="1" icons:PictogramText.Icons="delete" icons:PictogramText.Content="✕"
                IsVisible="{Binding IsCustomCategory}"
                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RemoveCategoryCommand}"
                CommandParameter="{Binding}"
                Background="Transparent" BorderThickness="0"
                Padding="8,2" MinHeight="0" FontSize="11"
                Opacity="0.6"
                ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipRemoveCategory}" AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipRemoveCategory}"/>
      </Grid>

      <Border Grid.Row="1" Padding="14,4,14,8">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_SelectAllApps}"
                  Command="{Binding SelectAllCommand}"
                  HorizontalContentAlignment="Center" FontSize="11" Padding="6,4"/>
          <Button Content="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_ClearAllApps}"
                  Command="{Binding ClearAllCommand}"
                  HorizontalContentAlignment="Center" FontSize="11" Padding="6,4"/>
        </StackPanel>
      </Border>

      <TextBlock Grid.Row="2" Text="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_AppsGroupEmpty}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="11" Opacity="0.5" FontStyle="Italic"
                 IsVisible="{Binding !Apps.Count}"/>

      <ListBox Grid.Row="2"
               Classes="apps-list"
               ItemsSource="{Binding Apps}"
               Background="Transparent"
               BorderThickness="0"
               Padding="10,0,10,6"
               SelectionMode="Single"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               IsVisible="{Binding Apps.Count}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AppItemViewModel">
            <Border Classes="app-row">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsChecked}"
                          AutomationProperties.Name="{Binding ProcessName}"
                          MinHeight="0" Padding="0"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Classes="app-name"
                           Text="{Binding ProcessName}"
                           MinWidth="0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding ProcessName}"/>
                <Panel Grid.Column="2" IsVisible="{Binding IsChecked}">
                  <Border Classes="routing-badge vpn-badge"
                          ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_AppsListInclude}"
                          IsVisible="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).IsRoutingAppsModeInclude}">
                    <TextBlock Text="VPN" FontSize="9" FontWeight="Bold"/>
                  </Border>
                  <Border Classes="routing-badge direct-badge"
                          ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_AppsListExclude}"
                          IsVisible="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).IsRoutingAppsModeExclude}">
                    <TextBlock Text="BYPASS" FontSize="9" FontWeight="Bold"/>
                  </Border>
                </Panel>
                <Border Grid.Column="3" Classes="custom-badge"
                        IsVisible="{Binding IsCustom}">
                  <TextBlock Text="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_LblCustomBadge}"
                             FontSize="9"
                             Foreground="{DynamicResource TextMutedBrush}"/>
                </Border>
                <Button Grid.Column="4" icons:PictogramText.Icons="delete" icons:PictogramText.Content="✕"
                        IsVisible="{Binding IsCustom}"
                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RemoveCustomAppCommand}"
                        CommandParameter="{Binding}"
                        Background="Transparent" BorderThickness="0"
                        Padding="6,0" MinHeight="0" FontSize="11"
                        Foreground="{DynamicResource TextMutedBrush}"
                        ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipRemoveApp}" AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipRemoveApp}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Row="3"
              Padding="10,8"
              BorderThickness="0,1,0,0"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              Background="{DynamicResource SurfaceSunkenBrush}">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_AppsPendingApplyHint}"
                     IsVisible="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).HasPendingAppChanges}"
                     TextWrapping="Wrap"
                     FontSize="10"
                     Foreground="{DynamicResource WarningFgBrush}"/>
          <Button icons:PictogramText.Icons="apply" icons:PictogramText.Content="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_ApplyChanges}"
                  Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ApplyPendingChangesCommand}"
                  IsVisible="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).HasPendingAppChanges}"
                  IsEnabled="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CanApplyAppChanges}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Background="{DynamicResource WarningSolidBrush}" Foreground="White"
                  FontSize="11" FontWeight="SemiBold"
                  Padding="0,6" CornerRadius="{StaticResource RadiusSm}"/>
          <Button Content="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_ImportSteamGames}"
                  Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ImportSteamGamesCommand}"
                  IsVisible="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).IsAppsListEditorExclude}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  FontSize="11" FontWeight="SemiBold"
                  Padding="0,5" CornerRadius="{StaticResource RadiusSm}"/>
          <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
            <TextBox Grid.Row="0" x:Name="CustomAppInput"
                     PlaceholderText="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_AddAppHint}"
                     FontSize="11" Padding="8,5"
                     CornerRadius="{StaticResource RadiusSm}"
                     HorizontalAlignment="Stretch"/>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6">
              <Button Grid.Column="0" x:Name="BrowseExeButton"
                      Click="OnBrowseExeClicked"
                      Padding="8,5" FontSize="11" CornerRadius="{StaticResource RadiusSm}"
                      Background="{DynamicResource SurfaceBaseBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"/>
              <Button Grid.Column="1" x:Name="RunningProcessesButton"
                      Click="OnSelectRunningProcessClicked"
                      Padding="8,5" FontSize="11" CornerRadius="{StaticResource RadiusSm}"
                      Background="{DynamicResource SurfaceBaseBrush}"
                      BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <Button.Flyout>
                  <MenuFlyout Placement="TopEdgeAlignedRight"/>
                </Button.Flyout>
              </Button>
              <Button Grid.Column="2" x:Name="AddCustomAppButton"
                      icons:PictogramText.Icons="add" icons:PictogramText.Content="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_AddCustomAppBtn}"
                      Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).AddCustomAppCommand}"
                      CommandParameter="{Binding #CustomAppInput.Text}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Padding="10,5" FontSize="11" CornerRadius="{StaticResource RadiusSm}"
                      Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentOnSolidBrush}"
                      FontWeight="SemiBold"/>
            </Grid>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <TextBlock Grid.Column="1"
               icons:PictogramText.Icons="arrow-left" icons:PictogramText.Text="{Binding L_SelectCategoryHint}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               FontSize="11" Opacity="0.5" FontStyle="Italic"
               IsVisible="{Binding SelectedActiveAppGroup, Converter={x:Static ObjectConverters.IsNull}}"/>
    </Grid>
  </Grid>
</UserControl>

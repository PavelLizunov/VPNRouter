<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:conv="using:VPNRouter.App"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="500"
             x:Class="VPNRouter.App.Views.Pages.ApplicationsPage"
             x:DataType="vm:MainWindowViewModel">

  <!-- v2.25.5 — Applications page redesign per Claude Design handoff
       section 5. Split trimmed 160 → 120. Category counter flipped from
       pill-badge (solid arctic bg + white "23" inside) to plain mono
       muted number — the badge visual was too much like a notification
       count and pulled focus; the number is already enough signal of
       "size of the group". Selected category row gets surface-base fg
       highlight + arctic fg name. App rows on the right become soft
       pill-like rounded blocks to make the checkbox grid read as a
       stack of separate items rather than a raw list. -->

  <UserControl.Styles>

    <!-- Category row — title + mono counter -->
    <Style Selector="TextBlock.cat-name">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.cat-count">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontFamily" Value="Consolas, 'SF Mono', 'Cascadia Code', 'Ubuntu Mono', monospace"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="4,0,4,0"/>
    </Style>

    <!-- Active (selected) category — arctic fg + highlighted background -->
    <Style Selector="ListBox.cat-list ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
    </Style>
    <Style Selector="ListBox.cat-list ListBoxItem:selected TextBlock.cat-name">
      <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="ListBox.cat-list ListBoxItem:selected TextBlock.cat-count">
      <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
    </Style>

    <!-- Each app row = soft rounded block -->
    <Style Selector="Border.app-row">
      <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
      <Setter Property="Padding" Value="10,7"/>
    </Style>
    <Style Selector="Border.app-row TextBlock.app-name">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Custom-app badge — subtle mono pill, not loud -->
    <Style Selector="Border.custom-badge">
      <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}"/>
      <Setter Property="Padding" Value="5,1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="ListBox.cat-list ListBoxItem">
      <Setter Property="Padding" Value="4,0"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="ListBox.apps-list ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
  </UserControl.Styles>

  <!-- v2.29.0 — full-tunnel banner replaces the silent IsEnabled disable
       that previously read as "broken" to Mac testers (feedback 2026-04-29).
       Banner sits as Row 0; main grid sits as Row 1 with reduced opacity
       + IsHitTestVisible=false instead of IsEnabled=false (visual hint
       that selection is unused, not that the page is broken).
       When IsSplitTunnel = true the banner row collapses (Height=Auto +
       IsVisible=false → 0px).
       v2.32 (r10) — added Row 1: Include/Exclude segmented toggle.
       Master-detail moved to Row 2. -->

  <UserControl.Styles>
    <!-- v2.32 — segmented mode toggle (Include / Exclude). Pattern
         mirrors the existing radio-styled buttons elsewhere; active
         button gets AccentSolid background. -->
    <Style Selector="ToggleButton.apps-mode-seg">
      <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="ToggleButton.apps-mode-seg:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSolidBrush}"/>
      <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentOnSolidBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Full-tunnel hint banner — shown only when IsFullTunnel -->
    <Border Grid.Row="0"
            IsVisible="{Binding IsFullTunnel}"
            Background="{DynamicResource WarningBgBrush}"
            BorderBrush="{DynamicResource WarningBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,10">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Grid.Column="0"
                   Text="{Binding L_AppsFullTunnelBanner}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource WarningFgBrush}"/>
        <Button Grid.Column="1"
                Content="{Binding L_AppsFullTunnelBannerAction}"
                Command="{Binding SwitchToSplitTunnelCommand}"
                FontSize="11" FontWeight="SemiBold"
                Padding="10,4"
                CornerRadius="{StaticResource RadiusSm}"
                Background="{DynamicResource AccentSolidBrush}"
                Foreground="{DynamicResource AccentOnSolidBrush}"
                VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- Row 1: Apps Mode segmented toggle (v2.32 r10).
         Only meaningful in Split-tunnel mode; collapsed in Full-tunnel. -->
    <Border Grid.Row="1"
            IsVisible="{Binding IsSplitTunnel}"
            Padding="14,8,14,4"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource BorderSubtleBrush}">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding L_AppsModeSectionTitle}"
                   FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
          <ToggleButton Grid.Column="0"
                        Classes="apps-mode-seg"
                        IsChecked="{Binding IsRoutingAppsModeInclude, Mode=TwoWay}"
                        Content="{Binding L_AppsModeInclude}"
                        AutomationProperties.Name="{Binding L_AppsModeInclude}"/>
          <ToggleButton Grid.Column="1"
                        Classes="apps-mode-seg"
                        IsChecked="{Binding IsRoutingAppsModeExclude, Mode=TwoWay}"
                        Content="{Binding L_AppsModeExclude}"
                        AutomationProperties.Name="{Binding L_AppsModeExclude}"/>
        </Grid>
        <TextBlock Text="{Binding L_CurrentAppsModeHint}"
                   FontSize="10"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}"/>
      </StackPanel>
    </Border>

    <!-- v2.30.3-r1 (BUG-36 fix): when Full Tunnel is active the sidebar
         category list looked clickable (low opacity but no cursor hint),
         users clicked categories 5+ times before realizing it's no-op.
         Now the disabled state is more pronounced + a not-allowed cursor
         appears on hover so the visual disabled-ness matches the actual
         IsHitTestVisible=false behaviour. -->
    <Grid Grid.Row="2"
          ColumnDefinitions="120,*"
          Opacity="{Binding IsSplitTunnel, Converter={x:Static conv:BoolTo10or05Converter.Instance}}"
          IsHitTestVisible="{Binding IsSplitTunnel}"
          Cursor="{Binding IsFullTunnel, Converter={x:Static conv:FullTunnelCursorConverter.Instance}}">

    <!-- ─── MASTER (left): category list + inline add ─── -->
    <Border Grid.Column="0"
            BorderThickness="0,0,1,0"
            BorderBrush="{DynamicResource BorderDefaultBrush}"
            Background="{DynamicResource SurfaceSunkenBrush}">
      <Grid RowDefinitions="*,Auto,Auto">
        <ListBox Grid.Row="0"
                 Classes="cat-list"
                 ItemsSource="{Binding AppGroups}"
                 SelectedItem="{Binding SelectedAppGroup}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AppGroupViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,4">
                <TextBlock Grid.Column="0" Classes="cat-name"
                           Text="{Binding DisplayName}"/>
                <!-- v2.25.5: counter is now plain mono muted number,
                     not a filled arctic pill. Hidden at 0 to keep the
                     visual weight aligned with the single-line nav. -->
                <TextBlock Grid.Column="1" Classes="cat-count"
                           Text="{Binding Apps.Count}"
                           IsVisible="{Binding Apps.Count}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- New category input -->
        <TextBox Grid.Row="1" x:Name="NewCategoryInput"
                 Text="{Binding NewCategoryName}"
                 Watermark="{Binding L_CategoryNamePrompt}"
                 FontSize="10" Padding="6,4" Margin="4,4,4,2"/>
        <Button Grid.Row="2"
                Content="{Binding L_AddCategory}"
                Command="{Binding AddCategoryCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Margin="4,0,4,4" Padding="4,4"
                FontSize="10" FontWeight="SemiBold" CornerRadius="{StaticResource RadiusSm}"
                Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentOnSolidBrush}"/>
      </Grid>
    </Border>

    <!-- ─── DETAIL (right): header + master toggle + apps + add ─── -->
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto"
          DataContext="{Binding SelectedAppGroup}"
          x:DataType="vm:AppGroupViewModel"
          IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">

      <!-- Header: DisplayName + Delete button (custom only) -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto"
            Margin="14,10,14,6">
        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="✕"
                IsVisible="{Binding IsCustomCategory}"
                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RemoveCategoryCommand}"
                CommandParameter="{Binding}"
                Background="Transparent" BorderThickness="0"
                Padding="8,2" MinHeight="0" FontSize="11"
                Opacity="0.6"
                ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipRemoveCategory}"/>
      </Grid>

      <!-- Master enable toggle -->
      <!-- v2.28.3: TextWrapping fix for narrow-window overflow. -->
      <Border Grid.Row="1" Padding="14,4,14,8">
        <CheckBox IsChecked="{Binding IsChecked}"
                  AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_EnableWholeGroup}"
                  FontWeight="SemiBold" FontSize="12"
                  MinHeight="0" Padding="4,0">
          <TextBlock Text="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_EnableWholeGroup}"
                     TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12"/>
        </CheckBox>
      </Border>

      <!-- Empty state -->
      <TextBlock Grid.Row="2" Text="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_AppsGroupEmpty}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="11" Opacity="0.5" FontStyle="Italic"
                 IsVisible="{Binding !Apps.Count}"/>

      <!-- Apps list — each row is a soft rounded block -->
      <ListBox Grid.Row="2"
               Classes="apps-list"
               ItemsSource="{Binding Apps}"
               Background="Transparent"
               BorderThickness="0"
               Padding="10,0,10,6"
               SelectionMode="Single"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               IsVisible="{Binding Apps.Count}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AppItemViewModel">
            <Border Classes="app-row">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsChecked}"
                          AutomationProperties.Name="{Binding ProcessName}"
                          MinHeight="0" Padding="0"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Classes="app-name"
                           Text="{Binding ProcessName}"/>
                <Border Grid.Column="2" Classes="custom-badge"
                        IsVisible="{Binding IsCustom}">
                  <TextBlock Text="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_LblCustomBadge}"
                             FontSize="9"
                             Foreground="{DynamicResource TextMutedBrush}"/>
                </Border>
                <Button Grid.Column="3" Content="✕"
                        IsVisible="{Binding IsCustom}"
                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RemoveCustomAppCommand}"
                        CommandParameter="{Binding}"
                        Background="Transparent" BorderThickness="0"
                        Padding="6,0" MinHeight="0" FontSize="11"
                        Foreground="{DynamicResource TextMutedBrush}"
                        ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_TipRemoveApp}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Add app input + Apply button -->
      <Border Grid.Row="3"
              Padding="14,8"
              BorderThickness="0,1,0,0"
              BorderBrush="{DynamicResource BorderDefaultBrush}"
              Background="{DynamicResource SurfaceSunkenBrush}">
        <StackPanel Spacing="6">
          <Button Content="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_ApplyChanges}"
                  Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ApplyPendingChangesCommand}"
                  IsVisible="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).HasPendingAppChanges}"
                  IsEnabled="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).IsConnected}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Background="{DynamicResource WarningSolidBrush}" Foreground="White"
                  FontSize="11" FontWeight="SemiBold"
                  Padding="0,6" CornerRadius="{StaticResource RadiusSm}"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" x:Name="CustomAppInput"
                     Watermark="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_AddAppHint}"
                     FontSize="11" Padding="6,4"/>
            <!-- v2.30.6-r1 (UX-41 fix): hardcoded "+ Add" → bilingual binding. -->
            <Button Grid.Column="1"
                    Content="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_AddCustomAppBtn}"
                    Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).AddCustomAppCommand}"
                    CommandParameter="{Binding #CustomAppInput.Text}"
                    Margin="6,0,0,0"
                    Padding="14,5" FontSize="11" CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentOnSolidBrush}"
                    FontWeight="SemiBold"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Empty state when no group selected -->
    <TextBlock Grid.Column="1"
               Text="{Binding L_SelectCategoryHint}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               FontSize="11" Opacity="0.5" FontStyle="Italic"
               IsVisible="{Binding SelectedAppGroup, Converter={x:Static ObjectConverters.IsNull}}"/>
    </Grid>
  </Grid>
</UserControl>

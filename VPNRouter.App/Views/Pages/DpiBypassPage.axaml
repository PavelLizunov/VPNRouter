<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:conv="using:VPNRouter.App"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="600"
             x:Class="VPNRouter.App.Views.Pages.DpiBypassPage"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <conv:BoolToStatusColorConverter x:Key="StatusColorConverter"/>
    </UserControl.Resources>

    <!--
      v2.36.0-r8 — Zapret OneTap redesign per
      `plans/research-one-button-zapret-deep-2026-05-24.md` (variant A
      Centered stack, mirroring the TgProxyOneTap r7 pattern).

      Pre-r8 the page was a 5-section master-detail (Status / Strategy / Hosts
      / Filters / Advanced) requiring 4-6 clicks for first-run config. r8
      consolidates into:
        1. Hero card with shield icon, state-driven title/lede, big primary
           magic button, 3 step chips (stopped state).
        2. AV-block toast (Bug-r9-G) preserved verbatim.
        3. «Тонкая настройка» expander stows every r5-era control —
           Strategy ComboBox, Update Zapret, Custom args, IPSet, Game filter,
           Discord/Flowseal hosts toggles, Run diagnostics, Clear cache,
           Service menu, Folder/GitHub. Nothing removed.
        4. Footer kept (mirrors TgProxyOneTap) — status dot + compact toggle.

      The hero magic button binds to ZapretOneClickCommand which orchestrates:
        download (if missing) → Discord hosts ensure-installed → auto-probe
        loop (ALT3 → general → general (ALT) with HEAD probe to youtube.com).
      Per-attempt progress surfaces as state-aware lede ("Тестирую (2/3):
      general — пробую открыть youtube.com…"). On Tier1 winner stays running.

      Don'ts (carried from TgProxyOneTap):
        - No emoji in copy.
        - No "1-click" phrasing — implicit, not stated.
      -->

    <Grid RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      AllowAutoHide="False"
                      Padding="0,8,0,60">
            <!-- v2.37.0-r21/r22 — bumped bottom padding from 10 → 24 (r21,
                 not enough) → 60 (r22). The cache UI row at the bottom of
                 the expanded "Тонкая настройка" was still clipped after r21.
                 60 px gives the cache button row (~32 px tall) + comfortable
                 margin above the fixed footer. -->
            <Grid Margin="12,0,14,0">
                <StackPanel Spacing="12">

                    <!-- ════════ Download progress (visible while downloading
                         zapret or installing hosts via the magic button). -->
                    <StackPanel IsVisible="{Binding IsZapretDownloading}" Spacing="6">
                        <ProgressBar IsIndeterminate="True"
                                     Height="3"
                                     CornerRadius="{StaticResource RadiusXs}"
                                     Foreground="{DynamicResource AccentSolidBrush}"/>
                        <TextBlock Text="{Binding ZapretStatus}"
                                   TextWrapping="Wrap"
                                   FontSize="10"
                                   Opacity="0.7"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- ════════ Bug-r9-G AV-block toast — preserved verbatim
                         from pre-r8. Auto-clears after 8 s; Copy path button
                         puts whitelist dir on clipboard. Suppressed during
                         OneTap probing via _suppressZapretAvToast. -->
                    <Border IsVisible="{Binding HasZapretAvBlockToast}"
                            Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                            Background="{DynamicResource DangerBgBrush}"
                            BorderBrush="{DynamicResource DangerBorderBrush}"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="!"
                                       Foreground="{DynamicResource DangerFgBrush}"
                                       FontSize="14" FontWeight="Bold"
                                       VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                       FontSize="10"
                                       Foreground="{DynamicResource DangerFgBrush}"
                                       VerticalAlignment="Center"
                                       Text="{Binding ZapretAvBlockToast}"/>
                            <Button Grid.Column="2"
                                    Content="{Binding L_ZapretAvBlockCopyPath}"
                                    Command="{Binding CopyZapretWhitelistPathCommand}"
                                    Padding="8,2" MinHeight="0" FontSize="10"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource DangerBorderBrush}"
                                    BorderThickness="1"
                                    Foreground="{DynamicResource DangerFgBrush}"
                                    VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="X"
                                    Command="{Binding DismissZapretAvBlockToastCommand}"
                                    Padding="6,2" MinHeight="0" FontSize="10"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource DangerFgBrush}"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Dismiss"/>
                        </Grid>
                    </Border>

                    <!-- ════════ Hero card — accent glow + centered stack. -->
                    <Border CornerRadius="{StaticResource RadiusLg}"
                            Background="{DynamicResource SurfaceBaseBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="20,24,20,22"
                            ClipToBounds="True">
                        <Grid>
                            <!-- Soft accent glow disc behind the content. -->
                            <Ellipse Width="320" Height="320"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Opacity="0.65"
                                     IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="50%,50%" Center="50%,50%" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Offset="0.0"  Color="{DynamicResource AccentBgSubtle}"/>
                                        <GradientStop Offset="0.65" Color="Transparent"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="380">

                                <!-- Shield-with-bolt icon: a Path that draws
                                     the shield outline + lightning bolt. 46x46
                                     rounded container mirrors TgProxyOneTap. -->
                                <Border Width="46" Height="46"
                                        CornerRadius="14"
                                        Background="{DynamicResource SurfaceBaseBrush}"
                                        BorderBrush="{DynamicResource AccentBorderBrush}"
                                        BorderThickness="1"
                                        BoxShadow="0 2 6 0 #14000000"
                                        HorizontalAlignment="Center">
                                    <Path Width="22" Height="22"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource AccentFgBrush}"
                                          StrokeThickness="1.8"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M12,2 L4,5 L4,11 C4,16 7.5,20 12,22 C16.5,20 20,16 20,11 L20,5 z M13,7 L9,13 L12,13 L11,17 L15,11 L12,11 z"/>
                                </Border>

                                <!-- Title (state-driven). -->
                                <TextBlock Text="{Binding LblZapretHeroTitle}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"/>

                                <!-- Lede (state-driven, embeds live probe index). -->
                                <TextBlock Text="{Binding LblZapretHeroLede}"
                                           FontSize="12"
                                           LineHeight="18"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           MaxWidth="340"/>

                                <!-- Magic button — fires ZapretOneClickCommand
                                     which orchestrates the whole flow. Same
                                     command bound to footer button (muscle
                                     memory). Disabled during download/probing. -->
                                <Button Command="{Binding ZapretOneClickCommand}"
                                        IsEnabled="{Binding IsZapretMagicButtonEnabled}"
                                        Background="{DynamicResource AccentSolidBrush}"
                                        Foreground="{DynamicResource AccentOnSolidBrush}"
                                        BorderThickness="0"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="22,12"
                                        MinWidth="260"
                                        HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        FontWeight="Bold"
                                        FontSize="13"
                                        AutomationProperties.Name="{Binding LblZapretMagicButton}">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Path Width="11" Height="11"
                                              Stretch="Uniform"
                                              Fill="{DynamicResource AccentOnSolidBrush}"
                                              VerticalAlignment="Center"
                                              IsVisible="{Binding !ZapretEnabled}"
                                              Data="M8,5 L8,19 L19,12 z"/>
                                        <Border Width="10" Height="10"
                                                CornerRadius="2"
                                                Background="{DynamicResource AccentOnSolidBrush}"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding ZapretEnabled}"/>
                                        <TextBlock Text="{Binding LblZapretMagicButton}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- 3-step chips (only when stopped + not probing). -->
                                <ItemsControl HorizontalAlignment="Center">
                                    <ItemsControl.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="!ZapretEnabled"/>
                                            <Binding Path="!IsZapretProbing"/>
                                            <Binding Path="!IsZapretFallback"/>
                                        </MultiBinding>
                                    </ItemsControl.IsVisible>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel HorizontalAlignment="Center" ItemSpacing="6" LineSpacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <Border CornerRadius="{StaticResource RadiusPill}"
                                            Background="{DynamicResource SurfaceBaseBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Width="14" Height="14"
                                                    CornerRadius="7"
                                                    Background="{DynamicResource AccentBgSubtleBrush}">
                                                <TextBlock Text="1" FontSize="9" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentFgBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding L_ZapretOneTapStep1}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="{StaticResource RadiusPill}"
                                            Background="{DynamicResource SurfaceBaseBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Width="14" Height="14"
                                                    CornerRadius="7"
                                                    Background="{DynamicResource AccentBgSubtleBrush}">
                                                <TextBlock Text="2" FontSize="9" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentFgBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding L_ZapretOneTapStep2}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="{StaticResource RadiusPill}"
                                            Background="{DynamicResource SurfaceBaseBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Width="14" Height="14"
                                                    CornerRadius="7"
                                                    Background="{DynamicResource AccentBgSubtleBrush}">
                                                <TextBlock Text="3" FontSize="9" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentFgBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding L_ZapretOneTapStep3}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ItemsControl>

                                <!-- Probe progress bar (only during probing). -->
                                <StackPanel IsVisible="{Binding IsZapretProbing}"
                                            Spacing="6"
                                            HorizontalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True"
                                                 Height="3"
                                                 Width="240"
                                                 CornerRadius="{StaticResource RadiusXs}"
                                                 Foreground="{DynamicResource AccentSolidBrush}"/>
                                    <!-- r21 — live elapsed time + ETA estimate.
                                         Surfaces "Прошло 0:25 · осталось ~3:40"
                                         so users see the probe is actually
                                         making progress (and how long left). -->
                                    <TextBlock Text="{Binding LblZapretProbeElapsed}"
                                               FontSize="10"
                                               Opacity="0.7"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Air pill (only when running). -->
                                <Border IsVisible="{Binding ZapretEnabled}"
                                        CornerRadius="{StaticResource RadiusPill}"
                                        Background="{DynamicResource SuccessBgBrush}"
                                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                                        BorderThickness="1"
                                        Padding="10,5"
                                        HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6"
                                                 Fill="{DynamicResource SuccessSolidBrush}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LblZapretAirPill}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SuccessFgBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ════════ r24 — Hero strategy summary card.
                         Sits between the main button and Тонкая настройка so
                         the user sees "what's cached, how fresh, is it OK"
                         at a glance without opening the expander.

                         Hidden entirely when no cache exists (clean slate
                         for first-time users — they just see the magic
                         button without a confusing empty card).

                         The 2 buttons:
                           [Перепроверить] → ForceFreshProbeCommand
                                              (full re-sweep, same as
                                              "Найти стратегию заново")
                           [Подробнее]     → ExpandZapretTuneSection
                                              (programmatically opens the
                                              expander below) -->
                    <Border IsVisible="{Binding IsZapretSummaryVisible}"
                            Background="{DynamicResource SurfaceBaseBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="14,10"
                            Margin="0,8,0,0">
                        <StackPanel Spacing="8">
                            <!-- Status icon + header on one line.
                                 Icon is text glyph so it scales with FontSize.
                                 Switches ✓ → ⚠ via IsZapretCacheStale. -->
                            <Grid ColumnDefinitions="Auto,*">
                                <!-- Fresh icon (✓) -->
                                <TextBlock Grid.Column="0"
                                           Text="✓"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SuccessSolidBrush}"
                                           IsVisible="{Binding !IsZapretCacheStale}"/>
                                <!-- Stale icon (⚠) -->
                                <TextBlock Grid.Column="0"
                                           Text="⚠"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource WarningSolidBrush}"
                                           IsVisible="{Binding IsZapretCacheStale}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding LblZapretSummaryHeader}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>

                            <!-- Subtext: "4 из 5 целей · проверено 12 мин назад" -->
                            <TextBlock Text="{Binding LblZapretSummarySubtext}"
                                       FontSize="11"
                                       Opacity="0.75"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <!-- Stale-only nudge: "Стратегия проверялась более 7 дней назад..." -->
                            <TextBlock Text="{Binding L_ZapretSummaryStaleHint}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningFgBrush}"
                                       IsVisible="{Binding IsZapretCacheStale}"/>

                            <!-- Action buttons. WrapPanel so they reflow on
                                 narrow windows instead of clipping. -->
                            <WrapPanel ItemSpacing="6" LineSpacing="6">
                                <Button Content="{Binding L_ZapretReverifyButton}"
                                        Command="{Binding ForceFreshProbeCommand}"
                                        IsEnabled="{Binding !IsZapretProbing}"
                                        ToolTip.Tip="{Binding L_ZapretReverifyHint}"
                                        FontSize="11" Padding="10,5"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <Button Content="{Binding L_ZapretSummaryDetailsButton}"
                                        Command="{Binding ExpandZapretTuneSectionCommand}"
                                        FontSize="11" Padding="10,5"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                                        BorderThickness="1"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- ════════ r25 — Тонкая настройка as TabControl, not Expander.
                         Historical bug we hit repeatedly r10..r22: an Expander
                         inside the outer ScrollViewer wouldn't reliably scroll
                         to the bottom of its expanded content. Padding bumps
                         (10→24→60) were workarounds, not fixes — the underlying
                         layout pathology stayed.
                         TabControl makes each section its own viewport-sized
                         page, so no nested scroll, no overflow ambiguity, and
                         the chronic complaint ("не получается доскролить до
                         самого низа") is structurally gone. Pattern matches
                         the Apps page sidebar (different visual orientation —
                         tabs are horizontal here for the narrower 520px
                         default window). -->

                    <!-- Description + warning banner stay OUTSIDE the TabControl
                         so they're visible regardless of which tab is active. -->
                    <TextBlock TextWrapping="Wrap" FontSize="11" LineHeight="16" Opacity="0.7"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding LblDpiDescription}"
                               Margin="0,4,0,0"/>

                    <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                            Background="{DynamicResource WarningBgBrush}"
                            BorderBrush="{DynamicResource WarningBorderBrush}"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="!"
                                       Foreground="{DynamicResource WarningFgBrush}"
                                       FontSize="11" FontWeight="Bold"
                                       VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                       FontSize="10"
                                       Foreground="{DynamicResource WarningFgBrush}"
                                       Text="{Binding LblDpiWarning}"/>
                        </Grid>
                    </Border>

                    <!-- r26: explicit MaxHeight bounds the TabControl so the
                         inner per-TabItem ScrollViewer (added in r26 alongside)
                         has a known max for engagement. Without this, the
                         outer ScrollViewer gives TabControl infinite vertical
                         space → inner ScrollViewer never knows to engage →
                         user can scroll outer to its end but tab content's
                         tail stays clipped below TabControl's reported
                         (and incorrect) measured height. With MaxHeight=420,
                         inner ScrollViewer engages whenever the active tab
                         content > 420 px, which covers the Tools tab
                         (~480 px with diagnostics + cache controls). -->
                    <TabControl SelectedIndex="{Binding ZapretActiveTabIndex, Mode=TwoWay}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSm}"
                                MaxHeight="420"
                                Padding="10,6">

                        <!-- ─── Tab 1: Strategy ─── -->
                        <!-- r26: each TabItem wraps content in its OWN ScrollViewer.
                             r25 hit a residual scroll bug — outer ScrollViewer's
                             scrollable extent stopped short of the active TabItem's
                             actual content height (Avalonia 11 TabControl Carousel
                             measures the visible tab into the layout but doesn't
                             always propagate the height delta back to the parent
                             on tab switch). Per-tab ScrollViewer guarantees the
                             bottom of any tab content is reachable even when the
                             outer scroll can't extend further. -->
                        <TabItem Header="{Binding L_ZapretSecStrategy}" FontSize="11">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="0,6,4,12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding L_ZapretSecStrategyDesc}"
                                           TextWrapping="Wrap" FontSize="10"
                                           Opacity="0.7"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding ZapretStrategies}"
                                          SelectedIndex="{Binding ZapretStrategyIndex}"
                                          HorizontalAlignment="Stretch"
                                          Padding="8,4" FontSize="11"/>
                                <!-- v2.37.0-r21 — direct-start path for power users.
                                     "Запустить с этой стратегией" applies the
                                     selected ComboBox strategy immediately,
                                     skipping the 2-7min auto-probe. Cached as
                                     a success so warm-start kicks in next time. -->
                                <Button Content="{Binding L_ZapretStartSelectedStrategyButton}"
                                        Command="{Binding StartZapretWithSelectedStrategyCommand}"
                                        IsEnabled="{Binding !IsZapretProbing}"
                                        ToolTip.Tip="{Binding L_ZapretStartSelectedStrategyHint}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Background="{DynamicResource AccentBgSubtleBrush}"
                                        Foreground="{DynamicResource AccentFgBrush}"
                                        BorderBrush="{DynamicResource AccentBorderBrush}"
                                        BorderThickness="1"/>
                                <TextBlock Text="{Binding L_ZapretStartSelectedStrategyHint}"
                                           FontSize="9" Opacity="0.6"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding ZapretVersionText}"
                                               FontSize="10" Opacity="0.5"
                                               VerticalAlignment="Center"/>
                                    <Button Content="{Binding LblUpdateZapret}"
                                            Command="{Binding UpdateZapretCommand}"
                                            FontSize="10" Padding="8,4"
                                            CornerRadius="{StaticResource RadiusSm}"
                                            IsEnabled="{Binding !IsZapretDownloading}"/>
                                </StackPanel>
                                <TextBox Text="{Binding ZapretCustomArgs}"
                                         IsVisible="{Binding IsCustomStrategy}"
                                         PlaceholderText="{Binding L_WmZapretCustomArgs}"
                                         FontSize="10" Padding="6,4"
                                         AcceptsReturn="True" MinHeight="50" MaxHeight="80"/>
                                <Button Content="{Binding L_UpdateIpSet}"
                                        Command="{Binding UpdateIpSetListCommand}"
                                        IsEnabled="{Binding !IsZapretActionRunning}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <CheckBox IsChecked="{Binding ZapretAutoUpdateCheck}"
                                          AutomationProperties.Name="{Binding L_AutoUpdateCheckLabel}"
                                          ToolTip.Tip="{Binding L_TipZapretAutoUpdate}"
                                          FontSize="10" MinHeight="0" Padding="4,0">
                                    <TextBlock Text="{Binding L_AutoUpdateCheckLabel}"
                                               TextWrapping="Wrap" FontSize="10"/>
                                </CheckBox>
                            </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ─── Tab 2: Hosts ─── -->
                        <TabItem Header="{Binding L_ZapretSecHosts}" FontSize="11">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="0,6,4,12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding L_ZapretSecHostsDesc}"
                                           TextWrapping="Wrap" FontSize="10"
                                           Opacity="0.7"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                                        Background="{DynamicResource SurfaceSunkenBrush}">
                                    <StackPanel Spacing="4">
                                        <Button Content="{Binding LblDiscordHosts}"
                                                Command="{Binding ToggleDiscordHostsCommand}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                FontSize="10" Padding="8,4"
                                                CornerRadius="{StaticResource RadiusSm}"
                                                Foreground="{Binding DiscordHostsInstalled,
                                                             Converter={x:Static conv:BoolToBrushConverter.Instance},
                                                             ConverterParameter=DangerSolidBrush|TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding LblDiscordHostsDesc}"
                                                   TextWrapping="Wrap" FontSize="9" Opacity="0.6"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                                        Background="{DynamicResource SurfaceSunkenBrush}">
                                    <StackPanel Spacing="4">
                                        <Button Content="{Binding LblFlowsealHosts}"
                                                Command="{Binding ToggleFlowsealHostsCommand}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                FontSize="10" Padding="8,4"
                                                CornerRadius="{StaticResource RadiusSm}"
                                                Foreground="{Binding FlowsealHostsInstalled,
                                                             Converter={x:Static conv:BoolToBrushConverter.Instance},
                                                             ConverterParameter=DangerSolidBrush|TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="9" Opacity="0.6"
                                                   Text="{Binding L_ZapretHostsHint}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ─── Tab 3: Filters ─── -->
                        <TabItem Header="{Binding L_ZapretSecFilters}" FontSize="11">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="0,6,4,12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding L_ZapretSecFiltersDesc}"
                                           TextWrapping="Wrap" FontSize="10"
                                           Opacity="0.7"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding L_GameFilter}"
                                               FontWeight="SemiBold" FontSize="10"/>
                                    <ComboBox SelectedIndex="{Binding GameFilterModeIndex}"
                                              HorizontalAlignment="Stretch"
                                              Padding="6,3" FontSize="10">
                                        <ComboBoxItem Content="{Binding L_GameFilterOff}"/>
                                        <ComboBoxItem Content="{Binding L_GameFilterAll}"/>
                                        <ComboBoxItem Content="{Binding L_GameFilterTcp}"/>
                                        <ComboBoxItem Content="{Binding L_GameFilterUdp}"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding L_IpSetFilter}"
                                               FontWeight="SemiBold" FontSize="10"/>
                                    <ComboBox SelectedIndex="{Binding IpSetModeIndex}"
                                              HorizontalAlignment="Stretch"
                                              Padding="6,3" FontSize="10">
                                        <ComboBoxItem Content="{Binding L_IpSetAny}"/>
                                        <ComboBoxItem Content="{Binding L_IpSetLoaded}"/>
                                        <ComboBoxItem Content="{Binding L_IpSetNone}"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ─── Tab 4: Tools (Diagnostics + Cache + Service) ─── -->
                        <TabItem Header="{Binding L_ZapretSecAdvanced}" FontSize="11">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="0,6,4,12">
                            <StackPanel Spacing="6">
                                <Button Content="{Binding L_RunDiagnostics}"
                                        Command="{Binding RunZapretDiagnosticsCommand}"
                                        IsEnabled="{Binding !IsZapretActionRunning}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <Border IsVisible="{Binding ZapretActionOutput.Count}"
                                        Padding="8" MaxHeight="200"
                                        Background="{DynamicResource SurfaceSunkenBrush}"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSm}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding ZapretActionTitle}"
                                                   FontWeight="SemiBold" FontSize="10" Opacity="0.7"/>
                                        <ScrollViewer MaxHeight="160"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ZapretActionOutput}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="9"
                                                                   FontFamily="Consolas,Courier New,monospace"
                                                                   TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                                <Button Content="{Binding L_ClearDiscordCache}"
                                        Command="{Binding ClearDiscordCacheCommand}"
                                        IsEnabled="{Binding !IsZapretActionRunning}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <Button Content="{Binding L_RunTestsLabel}"
                                        Command="{Binding RunZapretTestsCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <Button Content="{Binding L_RemoveServiceLabel}"
                                        Command="{Binding RemoveZapretServiceCommand}"
                                        IsEnabled="{Binding !IsZapretActionRunning}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Foreground="{DynamicResource DangerSolidBrush}"/>
                                <Button Content="{Binding L_OpenServiceMenu}"
                                        Command="{Binding OpenZapretServiceMenuCommand}"
                                        ToolTip.Tip="{Binding L_TipOpenServiceMenu}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                    <Button Content="{Binding L_OpenFolder}"
                                            Command="{Binding OpenZapretFolderCommand}"
                                            FontSize="10" Padding="8,4"
                                            CornerRadius="{StaticResource RadiusSm}"/>
                                    <Button Content="{Binding L_OpenGitHub}"
                                            Command="{Binding OpenZapretGitHubCommand}"
                                            FontSize="10" Padding="8,4"
                                            CornerRadius="{StaticResource RadiusSm}"
                                            Foreground="{DynamicResource AccentSolidBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Flowseal/zapret-discord-youtube"
                                           FontSize="9" Opacity="0.4"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Left"/>

                                <!-- v2.37.0-r11 — Zapret probe cache controls — now
                                     live INSIDE the Tools tab (was a sibling of the
                                     Diagnostics section in the old Expander layout).
                                     r25 — TabItem already gives this a clean viewport,
                                     so no more padding-bump dance to keep the buttons
                                     visible. Border-separated to group visually. -->
                                <Border Margin="0,8,0,0" Padding="0,8,0,0"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="0,1,0,0">
                                    <StackPanel Spacing="6">
                                        <WrapPanel ItemSpacing="6" LineSpacing="6">
                                            <Button Content="{Binding L_ZapretForceFreshProbeButton}"
                                                    Command="{Binding ForceFreshProbeCommand}"
                                                    IsEnabled="{Binding !IsZapretProbing}"
                                                    FontSize="10" Padding="8,4"
                                                    CornerRadius="{StaticResource RadiusSm}"/>
                                            <Button Content="{Binding L_ZapretClearCacheButton}"
                                                    Command="{Binding ClearZapretCacheCommand}"
                                                    FontSize="10" Padding="8,4"
                                                    CornerRadius="{StaticResource RadiusSm}"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding LblZapretCacheStatus}"
                                                   FontSize="10" Opacity="0.6"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                    </TabControl>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ════════ Footer — same shape as TgProxyOneTap r7.
             Status dot + ZapretStatus + compact magic button. Footer bound
             to the same ZapretOneClickCommand so both surfaces fire the
             same orchestrator. -->
        <Border Grid.Row="1" Padding="14,7,14,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                Background="{DynamicResource SurfaceSunkenBrush}">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" ColumnSpacing="8">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             VerticalAlignment="Center"
                             Fill="{Binding ZapretEnabled, Converter={StaticResource StatusColorConverter}}"/>
                    <TextBlock Text="{Binding ZapretStatus}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{Binding LblZapretMagicButton}"
                        Command="{Binding ZapretOneClickCommand}"
                        IsEnabled="{Binding IsZapretMagicButtonEnabled}"
                        FontSize="10" FontWeight="SemiBold"
                        Padding="10,5"
                        CornerRadius="{StaticResource RadiusSm}"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

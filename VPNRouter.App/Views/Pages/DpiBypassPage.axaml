<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:conv="using:VPNRouter.App"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="500"
             x:Class="VPNRouter.App.Views.Pages.DpiBypassPage"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <conv:BoolToStatusColorConverter x:Key="StatusColorConverter"/>
    </UserControl.Resources>

    <!-- v2.31.6-r6 — sidebar selection style now matches production
         standard. Pre-r6 the override below set selected ListBoxItem
         bg to SurfaceBaseBrush + fg to AccentFgBrush, producing a
         very subtle "white card with accent text" highlight. The
         v2.25.6 comment that introduced it claimed parity with
         NetworkPage / ApplicationsPage, but a side-by-side audit
         on 2026-05-04 found NetworkPage uses NO such override —
         it falls back to Avalonia's default ListBoxItem:selected
         which paints AccentBgSubtleBrush + AccentFgBrush. So
         Settings sidebar ("Routing") looked vivid blue while
         Zapret sidebar ("Status") looked washed-out grey. r6
         drops the override here so DpiBypass matches NetworkPage's
         default. ApplicationsPage keeps its own (class-scoped
         `ListBox.cat-list` selector) since its sidebar items
         have a different inner template. -->
    <!-- (no UserControl.Styles needed — relying on default
         ListBoxItem:selected appearance) -->

    <Grid RowDefinitions="*,Auto">

        <!-- Master-detail content -->
        <Grid Grid.Row="0" ColumnDefinitions="140,*">

            <!-- Master: section list -->
            <Border Grid.Column="0"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    Background="{DynamicResource SurfaceSunkenBrush}">
                <!-- v2.31.6-r5 (ZAPRET-2): 7 → 5 sections per user
                     feedback 2026-05-03 night («упростить»). Diagnostics
                     (1 button) merged into Status; Updates (2 elements)
                     merged into Strategy. See MainWindowViewModel
                     SelectedZapretSectionIndex comment for rationale. -->
                <ListBox SelectedIndex="{Binding SelectedZapretSectionIndex}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBoxItem Content="{Binding L_ZapretSecStatus}"   Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
                    <ListBoxItem Content="{Binding L_ZapretSecStrategy}" Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
                    <ListBoxItem Content="{Binding L_ZapretSecHosts}"    Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
                    <ListBoxItem Content="{Binding L_ZapretSecFilters}"  Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
                    <ListBoxItem Content="{Binding L_ZapretSecAdvanced}" Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
                </ListBox>
            </Border>

            <!-- Detail. v2.28.4-r7: same pattern as FreeConfigsPage r6 fix —
                 push horizontal padding from ScrollViewer to an inner Grid
                 Margin. Decouples the page's right edge from the scrollbar
                 reservation so the visible right padding stays locked even
                 when card heights change on resize / text wrap. -->
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          AllowAutoHide="False"
                          Padding="0,10,0,10">
              <Grid Margin="12,0,14,0">
              <StackPanel>

                <!-- ═══ Status ═══
                     v2.31.6-r5 (ZAPRET-2): absorbs the former Diagnostics
                     section (which had a single «Run diagnostics» button
                     + output panel). Diagnosing is the natural follow-up
                     to checking status, so keeping both in the same pane
                     removes a navigation step without crowding the page —
                     the output Border only appears once a diagnostic
                     run has produced output. -->
                <StackPanel Spacing="10" IsVisible="{Binding IsZapretStatusSection}">
                    <TextBlock Text="{Binding L_ZapretSecStatus}" FontWeight="Bold" FontSize="13"/>
                    <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.7"
                               Text="{Binding LblDpiDescription}"/>
                    <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                            Background="{DynamicResource SurfaceSunkenBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding ZapretEnabled, Converter={StaticResource StatusColorConverter}}"/>
                            <TextBlock Text="{Binding ZapretStatus}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- v2.25.6: warning banner (было муdded italic text).
                         Дизайн hand-off показывает явную жёлтую плашку — видимее. -->
                    <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                            Background="{DynamicResource WarningBgBrush}"
                            BorderBrush="{DynamicResource WarningBorderBrush}"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="⚠"
                                       Foreground="{DynamicResource WarningFgBrush}"
                                       FontSize="11" FontWeight="Bold"
                                       VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                       FontSize="10"
                                       Foreground="{DynamicResource WarningFgBrush}"
                                       Text="{Binding LblDpiWarning}"/>
                        </Grid>
                    </Border>

                    <!-- v2.31.6-r5: Run diagnostics, ex-Diagnostics section.
                         Output panel only renders when ZapretActionOutput
                         is non-empty so the Status pane stays compact
                         pre-run. -->
                    <Button Content="{Binding L_RunDiagnostics}"
                            Command="{Binding RunZapretDiagnosticsCommand}"
                            IsEnabled="{Binding !IsZapretActionRunning}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            FontSize="10" Padding="8,4" CornerRadius="{StaticResource RadiusSm}"/>

                    <Border IsVisible="{Binding ZapretActionOutput.Count}"
                            Padding="8" MaxHeight="260"
                            Background="{DynamicResource SurfaceSunkenBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusSm}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding ZapretActionTitle}"
                                       FontWeight="SemiBold" FontSize="10" Opacity="0.7"/>
                            <ScrollViewer MaxHeight="220"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ZapretActionOutput}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="9"
                                                       FontFamily="Consolas,Courier New,monospace"
                                                       TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══ Strategy ═══
                     v2.30.5-r1 (UX-47 fix): dropped redundant secondary
                     "Стратегия" label below the page title — both showed
                     the same word. Now only the page title remains.
                     v2.31.6-r5 (ZAPRET-2): absorbs the former Updates
                     section (Update IPSet button + auto-check Zapret
                     updates checkbox). Both belong to the «keep
                     binary + lists fresh» domain that already lives
                     here via the «Update Zapret» button. Consolidating
                     keeps all version/update controls in one place. -->
                <StackPanel Spacing="8" IsVisible="{Binding IsZapretStrategySection}">
                    <TextBlock Text="{Binding L_ZapretSecStrategy}" FontWeight="Bold" FontSize="13"/>
                    <ComboBox ItemsSource="{Binding ZapretStrategies}"
                              SelectedIndex="{Binding ZapretStrategyIndex}"
                              HorizontalAlignment="Stretch"
                              Padding="8,4" FontSize="11"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding ZapretVersionText}" FontSize="10" Opacity="0.5" VerticalAlignment="Center"/>
                        <Button Content="{Binding LblUpdateZapret}"
                                Command="{Binding UpdateZapretCommand}"
                                FontSize="10" Padding="8,4" CornerRadius="{StaticResource RadiusSm}"
                                IsEnabled="{Binding !IsZapretDownloading}"/>
                        <ProgressBar IsVisible="{Binding IsZapretDownloading}"
                                     IsIndeterminate="True" Height="4" Width="100"
                                     CornerRadius="{StaticResource RadiusXs}" VerticalAlignment="Center"
                                     Foreground="{DynamicResource AccentFgBrush}"/>
                    </StackPanel>
                    <TextBox Text="{Binding ZapretCustomArgs}"
                             IsVisible="{Binding IsCustomStrategy}"
                             Watermark="{Binding L_WmZapretCustomArgs}"
                             FontSize="10" Padding="6,4"
                             AcceptsReturn="True" MinHeight="50" MaxHeight="80"/>

                    <!-- v2.31.6-r5: ex-Updates section content. -->
                    <Button Content="{Binding L_UpdateIpSet}"
                            Command="{Binding UpdateIpSetListCommand}"
                            IsEnabled="{Binding !IsZapretActionRunning}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            FontSize="10" Padding="8,4" CornerRadius="{StaticResource RadiusSm}"/>
                    <CheckBox IsChecked="{Binding ZapretAutoUpdateCheck}"
                              AutomationProperties.Name="{Binding L_AutoUpdateCheckLabel}"
                              ToolTip.Tip="{Binding L_TipZapretAutoUpdate}"
                              FontSize="10" MinHeight="0" Padding="4,0">
                        <TextBlock Text="{Binding L_AutoUpdateCheckLabel}"
                                   TextWrapping="Wrap" FontSize="10"/>
                    </CheckBox>
                </StackPanel>

                <!-- ═══ Hosts ═══ -->
                <StackPanel Spacing="10" IsVisible="{Binding IsZapretHostsSection}">
                    <TextBlock Text="{Binding L_ZapretSecHosts}" FontWeight="Bold" FontSize="13"/>

                    <!-- v2.30.7-r4 — F-12 fix: hosts buttons are toggle-state.
                         When installed=true, click = REMOVE (destructive) →
                         red foreground. When not installed, click = ADD →
                         normal text colour. -->
                    <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                            Background="{DynamicResource SurfaceSunkenBrush}">
                        <StackPanel Spacing="4">
                            <Button Content="{Binding LblDiscordHosts}"
                                    Command="{Binding ToggleDiscordHostsCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    FontSize="10" Padding="8,4" CornerRadius="{StaticResource RadiusSm}"
                                    Foreground="{Binding DiscordHostsInstalled,
                                                 Converter={x:Static conv:BoolToBrushConverter.Instance},
                                                 ConverterParameter=DangerSolidBrush|TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding LblDiscordHostsDesc}"
                                       TextWrapping="Wrap" FontSize="9" Opacity="0.6"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                            Background="{DynamicResource SurfaceSunkenBrush}">
                        <StackPanel Spacing="4">
                            <Button Content="{Binding LblFlowsealHosts}"
                                    Command="{Binding ToggleFlowsealHostsCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    FontSize="10" Padding="8,4" CornerRadius="{StaticResource RadiusSm}"
                                    Foreground="{Binding FlowsealHostsInstalled,
                                                 Converter={x:Static conv:BoolToBrushConverter.Instance},
                                                 ConverterParameter=DangerSolidBrush|TextPrimaryBrush}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="9" Opacity="0.6"
                                       Text="{Binding L_ZapretHostsHint}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══ Filters ═══ -->
                <StackPanel Spacing="10" IsVisible="{Binding IsZapretFiltersSection}">
                    <TextBlock Text="{Binding L_ZapretSecFilters}" FontWeight="Bold" FontSize="13"/>

                    <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                            Background="{DynamicResource SurfaceSunkenBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding L_GameFilter}" FontWeight="SemiBold" FontSize="10"/>
                            <ComboBox SelectedIndex="{Binding GameFilterModeIndex}"
                                      HorizontalAlignment="Stretch"
                                      Padding="6,3" FontSize="10">
                                <ComboBoxItem Content="{Binding L_GameFilterOff}"/>
                                <ComboBoxItem Content="{Binding L_GameFilterAll}"/>
                                <ComboBoxItem Content="{Binding L_GameFilterTcp}"/>
                                <ComboBoxItem Content="{Binding L_GameFilterUdp}"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                            Background="{DynamicResource SurfaceSunkenBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding L_IpSetFilter}" FontWeight="SemiBold" FontSize="10"/>
                            <ComboBox SelectedIndex="{Binding IpSetModeIndex}"
                                      HorizontalAlignment="Stretch"
                                      Padding="6,3" FontSize="10">
                                <ComboBoxItem Content="{Binding L_IpSetAny}"/>
                                <ComboBoxItem Content="{Binding L_IpSetLoaded}"/>
                                <ComboBoxItem Content="{Binding L_IpSetNone}"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- v2.31.6-r5 (ZAPRET-2): standalone Updates and Diagnostics
                     sections removed — content merged into Strategy and
                     Status respectively. See SelectedZapretSectionIndex
                     comment in MainWindowViewModel for full rationale. -->

                <!-- ═══ Advanced ═══ -->
                <StackPanel Spacing="6" IsVisible="{Binding IsZapretAdvancedSection}">
                    <TextBlock Text="{Binding L_ZapretSecAdvanced}" FontWeight="Bold" FontSize="13"/>

                    <Button Content="{Binding L_ClearDiscordCache}"
                            Command="{Binding ClearDiscordCacheCommand}"
                            IsEnabled="{Binding !IsZapretActionRunning}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            FontSize="10" Padding="8,4" CornerRadius="{StaticResource RadiusSm}"/>
                    <Button Content="{Binding L_RunTestsLabel}"
                            Command="{Binding RunZapretTestsCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            FontSize="10" Padding="8,4" CornerRadius="{StaticResource RadiusSm}"/>
                    <!-- v2.30.3-r1 (UX-54 fix): destructive action gets
                         Danger foreground so accidental clicks are less
                         likely. Whole button is foreground-tinted; on
                         hover the system Button hover bg keeps
                         legibility. -->
                    <Button Content="{Binding L_RemoveServiceLabel}"
                            Command="{Binding RemoveZapretServiceCommand}"
                            IsEnabled="{Binding !IsZapretActionRunning}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            FontSize="10" Padding="8,4" CornerRadius="{StaticResource RadiusSm}"
                            Foreground="{DynamicResource DangerSolidBrush}"/>
                    <Button Content="{Binding L_OpenServiceMenu}"
                            Command="{Binding OpenZapretServiceMenuCommand}"
                            ToolTip.Tip="{Binding L_TipOpenServiceMenu}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            FontSize="10" Padding="8,4" CornerRadius="{StaticResource RadiusSm}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                        <Button Content="{Binding L_OpenFolder}"
                                Command="{Binding OpenZapretFolderCommand}"
                                FontSize="10" Padding="8,4" CornerRadius="{StaticResource RadiusSm}"/>
                        <Button Content="{Binding L_OpenGitHub}"
                                Command="{Binding OpenZapretGitHubCommand}"
                                FontSize="10" Padding="8,4" CornerRadius="{StaticResource RadiusSm}"
                                Foreground="{DynamicResource AccentFgBrush}"/>
                        <TextBlock Text="Flowseal/zapret-discord-youtube" FontSize="9" Opacity="0.4"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

              </StackPanel>
              </Grid>
            </ScrollViewer>
        </Grid>

        <!-- v2.31.6-r6 — footer matches production NetworkPage Apply
             bar pattern (`Padding="14,7,14,8"`, `SurfaceSunkenBrush`
             bg, `0,1,0,0` divider). Pre-r6 footer was a full-width
             arctic-blue mega-CTA (FontSize 12 Bold, Padding 0,8,
             HorizontalAlignment Stretch) which dominated the layout
             and visually competed with the global Start VPN footer
             below. Audit 2026-05-04 found this is the only page that
             uses such a wide solid-blue strip; NetworkPage's Apply
             button is compact right-aligned (`Padding="10,5"
             FontSize="10" SemiBold`) while keeping primary blue
             style for emphasis.

             r6 brings both into consistency:
             - Border: SurfaceSunkenBrush bg + canonical 14,7,14,8
               padding so the footer reads as a "footer bar" (was a
               bare divider line on transparent bg pre-r6).
             - Status indicator on left: color dot + ZapretStatus text
               so the user always sees current state regardless of
               which sidebar section they're on. Mirrors the
               "✓ Auto-saved" hint NetworkPage uses on the same row.
             - Button compact right-aligned: Padding 10,5, FontSize 10,
               SemiBold (was Bold) — still primary blue (the action
               itself remains primary), just sized to match the rest
               of the app. -->
        <Border Grid.Row="1" Padding="14,7,14,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                Background="{DynamicResource SurfaceSunkenBrush}">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" ColumnSpacing="8">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             VerticalAlignment="Center"
                             Fill="{Binding ZapretEnabled, Converter={StaticResource StatusColorConverter}}"/>
                    <TextBlock Text="{Binding ZapretStatus}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{Binding LblDpiToggle}"
                        Command="{Binding ToggleZapretCommand}"
                        FontSize="10" FontWeight="SemiBold"
                        Padding="10,5"
                        CornerRadius="{StaticResource RadiusSm}"
                        Background="{DynamicResource AccentSolidBrush}"
                        Foreground="{DynamicResource AccentOnSolidBrush}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:conv="using:VPNRouter.App"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="500"
             x:Class="VPNRouter.App.Views.Pages.DpiBypassPage"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <conv:BoolToStatusColorConverter x:Key="StatusColorConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="10,8,16,12">
            <StackPanel Spacing="10">

                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                           Text="DPI Bypass fragments TLS handshake packets to prevent ISP/TSPU from detecting and blocking VPN connections. Use when your VPN server is blocked by DPI (not by IP)."/>

                <StackPanel Spacing="4">
                    <TextBlock Text="Strategy" FontWeight="SemiBold" Opacity="0.7"/>
                    <ComboBox ItemsSource="{Binding ZapretStrategies}"
                              SelectedIndex="{Binding ZapretStrategyIndex}"
                              MinWidth="200" Padding="8,4" FontSize="11"/>
                </StackPanel>

                <Border Padding="8,6" CornerRadius="4"
                        Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="10" Opacity="0.6" TextWrapping="Wrap"
                                   Text="• multisplit — splits ClientHello into fragments (safest)"/>
                        <TextBlock FontSize="10" Opacity="0.6" TextWrapping="Wrap"
                                   Text="• fake+multisplit — fake packet + fragments (stronger)"/>
                        <TextBlock FontSize="10" Opacity="0.6" TextWrapping="Wrap"
                                   Text="• fake+disorder — fake + out-of-order segments (strongest)"/>
                        <TextBlock FontSize="10" Opacity="0.6" TextWrapping="Wrap"
                                   Text="• custom — your own winws.exe arguments"/>
                    </StackPanel>
                </Border>

                <!-- Custom args -->
                <TextBox Text="{Binding ZapretCustomArgs}"
                         Watermark="--wf-tcp=443 --dpi-desync=fake,multisplit ..."
                         FontSize="10" Padding="6,4"
                         AcceptsReturn="True" MinHeight="50" MaxHeight="80"/>

                <!-- Status -->
                <Border Padding="10,8" CornerRadius="4"
                        Background="{DynamicResource SystemControlBackgroundListLowBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding ZapretEnabled, Converter={StaticResource StatusColorConverter}}"/>
                        <TextBlock Text="{Binding ZapretStatus}" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.5" FontStyle="Italic"
                           Text="⚠ DPI bypass helps only when server is blocked by TLS detection, NOT when IP itself is blocked. Windows only. Start zapret BEFORE connecting VPN."/>

            </StackPanel>
        </ScrollViewer>

        <!-- Toggle button -->
        <Border Grid.Row="1" Padding="10,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
            <Button Command="{Binding ToggleZapretCommand}"
                    FontSize="12" FontWeight="Bold"
                    Padding="0,8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Background="#7C3AED" Foreground="White"
                    CornerRadius="5">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding ZapretEnabled,
                        Converter={x:Static conv:BoolToChevronConverter.Instance}}"
                        FontSize="10"/>
                    <TextBlock Text="Toggle DPI Bypass"/>
                </StackPanel>
            </Button>
        </Border>
    </Grid>
</UserControl>

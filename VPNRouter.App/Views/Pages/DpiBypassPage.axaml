<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:conv="using:VPNRouter.App"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="500"
             x:Class="VPNRouter.App.Views.Pages.DpiBypassPage"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <conv:BoolToStatusColorConverter x:Key="StatusColorConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="10,8,16,12">
            <StackPanel Spacing="10">

                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                           Text="{Binding LblDpiDescription}"/>

                <!-- Strategy selector + version + update -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding LblDpiStrategy}" FontWeight="SemiBold" Opacity="0.7"/>
                    <ComboBox ItemsSource="{Binding ZapretStrategies}"
                              SelectedIndex="{Binding ZapretStrategyIndex}"
                              MinWidth="220" Padding="8,4" FontSize="11"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                        <TextBlock Text="{Binding ZapretVersionText}" FontSize="10" Opacity="0.5"
                                   VerticalAlignment="Center"/>
                        <Button Content="{Binding LblUpdateZapret}"
                                Command="{Binding UpdateZapretCommand}"
                                FontSize="10" Padding="8,4"
                                CornerRadius="4" VerticalAlignment="Center"
                                IsEnabled="{Binding !IsZapretDownloading}"/>
                        <ProgressBar IsVisible="{Binding IsZapretDownloading}"
                                     IsIndeterminate="True"
                                     Height="4" Width="100" CornerRadius="2"
                                     VerticalAlignment="Center"
                                     Foreground="#7C3AED"/>
                    </StackPanel>
                </StackPanel>

                <!-- Custom args (only when "custom" strategy selected) -->
                <TextBox Text="{Binding ZapretCustomArgs}"
                         IsVisible="{Binding IsCustomStrategy}"
                         Watermark="--wf-tcp=443 --dpi-desync=fake,multisplit ..."
                         FontSize="10" Padding="6,4"
                         AcceptsReturn="True" MinHeight="50" MaxHeight="80"/>

                <!-- Status -->
                <Border Padding="10,8" CornerRadius="4"
                        Background="{DynamicResource SystemControlBackgroundListLowBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding ZapretEnabled, Converter={StaticResource StatusColorConverter}}"/>
                        <TextBlock Text="{Binding ZapretStatus}" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.5" FontStyle="Italic"
                           Text="{Binding LblDpiWarning}"/>

                <!-- Open folder + GitHub -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                    <Button Content="{x:Static loc:Strings.OpenFolder}"
                            Command="{Binding OpenZapretFolderCommand}"
                            FontSize="10" Padding="8,4" CornerRadius="4"/>
                    <Button Content="{x:Static loc:Strings.OpenGitHub}"
                            Command="{Binding OpenZapretGitHubCommand}"
                            FontSize="10" Padding="8,4" CornerRadius="4"
                            Foreground="#7C3AED"/>
                    <TextBlock Text="Flowseal/zapret-discord-youtube" FontSize="9" Opacity="0.4"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Discord hosts fix -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                    <Button Content="{Binding LblDiscordHosts}"
                            Command="{Binding ToggleDiscordHostsCommand}"
                            FontSize="10" Padding="8,4"
                            CornerRadius="4" VerticalAlignment="Center"/>
                    <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.5"
                               VerticalAlignment="Center" MaxWidth="300"
                               Text="{Binding LblDiscordHostsDesc}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="10,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
            <Button Content="{Binding LblDpiToggle}"
                    Command="{Binding ToggleZapretCommand}"
                    FontSize="12" FontWeight="Bold"
                    Padding="0,8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Background="#7C3AED" Foreground="White"
                    CornerRadius="5"/>
        </Border>
    </Grid>
</UserControl>

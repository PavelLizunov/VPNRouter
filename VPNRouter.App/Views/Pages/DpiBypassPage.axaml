<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:conv="using:VPNRouter.App"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="600"
             x:Class="VPNRouter.App.Views.Pages.DpiBypassPage"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <conv:BoolToStatusColorConverter x:Key="StatusColorConverter"/>
    </UserControl.Resources>

    <!-- r46 — colored status badges in the strategy ComboBox.
         TextBlock.zglyph-* classes drive Foreground via DynamicResource brushes
         (theme-safe: light/dark switch repaints without reload).
         Used by ComboBox.ItemTemplate AND inline in legend below dropdown. -->
    <UserControl.Styles>
        <Style Selector="TextBlock.zglyph-success">
            <Setter Property="Foreground" Value="{DynamicResource SuccessSolidBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.zglyph-warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningSolidBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.zglyph-danger">
            <Setter Property="Foreground" Value="{DynamicResource DangerSolidBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.zglyph-stale">
            <!-- WarningSolidBrush — stale is orange/amber per design system -->
            <Setter Property="Foreground" Value="{DynamicResource WarningSolidBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.zglyph-muted">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <!-- r49: bold matches success/warning/danger/stale glyphs so the
                 prefix column has uniform vertical rhythm in the dropdown. -->
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Styles>

    <!--
      v2.36.0-r8 — Zapret OneTap redesign per
      `plans/research-one-button-zapret-deep-2026-05-24.md` (variant A
      Centered stack, mirroring the TgProxyOneTap r7 pattern).

      Pre-r8 the page was a 5-section master-detail (Status / Strategy / Hosts
      / Filters / Advanced) requiring 4-6 clicks for first-run config. r8
      consolidates into:
        1. Hero card with shield icon, state-driven title/lede, big primary
           magic button, 3 step chips (stopped state).
        2. AV-block toast (Bug-r9-G) preserved verbatim.
        3. «Тонкая настройка» expander stows every r5-era control —
           Strategy ComboBox, Update Zapret, Custom args, IPSet, Game filter,
           Discord/Flowseal hosts toggles, Run diagnostics, Clear cache,
           Service menu, Folder/GitHub. Nothing removed.
        4. Footer kept (mirrors TgProxyOneTap) — status dot + compact toggle.

      The hero magic button binds to ZapretOneClickCommand which orchestrates:
        download (if missing) → Discord hosts ensure-installed → auto-probe
        loop (ALT3 → general → general (ALT) with HEAD probe to youtube.com).
      Per-attempt progress surfaces as state-aware lede ("Тестирую (2/3):
      general — пробую открыть youtube.com…"). On Tier1 winner stays running.

      Don'ts (carried from TgProxyOneTap):
        - No emoji in copy.
        - No "1-click" phrasing — implicit, not stated.
      -->

    <Grid RowDefinitions="*,Auto">

        <!-- r27: outer ScrollViewer REMOVED. r25 (Expander→TabControl) and
             r26 (MaxHeight + inner per-tab ScrollViewer) both failed to
             solve the user's complaint «не получается доскролить до низа
             вкладки». Root cause: outer ScrollViewer gave TabControl
             unbounded vertical space → Avalonia 11 TabControl's Carousel
             clipped its content based on layout-slot height without
             propagating actual measured height back to the parent. Inner
             ScrollViewers never engaged because they never saw a bounded
             parent.
             r27 fixes this structurally: Grid with Auto/* rows where
             TabControl is in a * row. Now TabControl has a real bounded
             viewport, inner ScrollViewer in each TabItem engages
             deterministically when content exceeds the bound. -->
        <!-- r31: 4-row Grid. Hero card + TabStrip are ALWAYS VISIBLE
             (Auto rows). TabContent gets remaining * row, scrolls inside
             per-tab ScrollViewer if overflows. User rule: «магия одного
             клика значит что кнопка всегда должна быть видна без скролла».
             Compact Hero (r31: 3 step chips removed, padding 24→14)
             keeps it under ~260 px so always fits. -->
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto,*" Margin="12,8,14,8">
            <StackPanel Grid.Row="0" Spacing="8">

                    <!-- ════════ Download progress (visible while downloading
                         zapret or installing hosts via the magic button). -->
                    <StackPanel IsVisible="{Binding IsZapretDownloading}" Spacing="6">
                        <ProgressBar IsIndeterminate="True"
                                     Height="3"
                                     CornerRadius="{StaticResource RadiusXs}"
                                     Foreground="{DynamicResource AccentSolidBrush}"/>
                        <TextBlock Text="{Binding ZapretStatus}"
                                   TextWrapping="Wrap"
                                   FontSize="10"
                                   Opacity="0.7"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- ════════ Bug-r9-G AV-block toast — preserved verbatim
                         from pre-r8. Auto-clears after 8 s; Copy path button
                         puts whitelist dir on clipboard. Suppressed during
                         OneTap probing via _suppressZapretAvToast. -->
                    <Border IsVisible="{Binding HasZapretAvBlockToast}"
                            Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                            Background="{DynamicResource DangerBgBrush}"
                            BorderBrush="{DynamicResource DangerBorderBrush}"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="!"
                                       Foreground="{DynamicResource DangerFgBrush}"
                                       FontSize="14" FontWeight="Bold"
                                       VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                       FontSize="10"
                                       Foreground="{DynamicResource DangerFgBrush}"
                                       VerticalAlignment="Center"
                                       Text="{Binding ZapretAvBlockToast}"/>
                            <Button Grid.Column="2"
                                    Content="{Binding L_ZapretAvBlockCopyPath}"
                                    Command="{Binding CopyZapretWhitelistPathCommand}"
                                    Padding="8,2" MinHeight="0" FontSize="10"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource DangerBorderBrush}"
                                    BorderThickness="1"
                                    Foreground="{DynamicResource DangerFgBrush}"
                                    VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="X"
                                    Command="{Binding DismissZapretAvBlockToastCommand}"
                                    Padding="6,2" MinHeight="0" FontSize="10"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource DangerFgBrush}"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding L_TipDismiss}"/>
                        </Grid>
                    </Border>

                    <!-- ════════ Hero card — accent glow + centered stack.
                         r31: Padding 24→14 + Spacing 12→8 + icon 46→38 → ~260 px
                         total, fits in viewport without scroll (rule: one-click
                         magic means user sees the button NO scroll needed). -->
                    <Border CornerRadius="{StaticResource RadiusLg}"
                            Background="{DynamicResource SurfaceBaseBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="16,10,16,12"
                            ClipToBounds="True">
                        <Grid>
                            <!-- Soft accent glow disc — smaller after r48 layout
                                 change (icon-left instead of icon-top). -->
                            <Ellipse Width="140" Height="140"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Opacity="0.5"
                                     IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="50%,50%" Center="50%,50%" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Offset="0.0"  Color="{DynamicResource AccentBgSubtle}"/>
                                        <GradientStop Offset="0.65" Color="Transparent"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <StackPanel Spacing="10" HorizontalAlignment="Stretch" MaxWidth="420">

                                <!-- r48: icon-LEFT header. Pre-r48 icon was
                                     centered on top, then title + lede stacked
                                     below — vertical scan, ~110px just for
                                     icon+title. r48 puts icon col 0 + title/
                                     lede col 1 side-by-side, saving ~40px and
                                     surfacing the title at the very top of the
                                     Hero (visible without scroll on narrow
                                     windows). Icon shrunk 46→36 to match the
                                     more compact rhythm. -->
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                    <Border Grid.Column="0" Grid.RowSpan="2"
                                            Width="36" Height="36"
                                            CornerRadius="10"
                                            Background="{DynamicResource SurfaceBaseBrush}"
                                            BorderBrush="{DynamicResource AccentBorderBrush}"
                                            BorderThickness="1"
                                            BoxShadow="0 2 6 0 #14000000"
                                            VerticalAlignment="Top"
                                            Margin="0,2,12,0">
                                        <Path Width="20" Height="20"
                                              Stretch="Uniform"
                                              Stroke="{DynamicResource AccentFgBrush}"
                                              StrokeThickness="1.8"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M12,2.5 L4.5,5.4 L4.5,10.8 C4.5,16 7.7,19.8 12,21.8 C16.3,19.8 19.5,16 19.5,10.8 L19.5,5.4 Z M13.5,6.8 L9.2,12.8 L12,12.8 L10.8,17.3 L15.2,11.2 L12.4,11.2 Z"/>
                                    </Border>

                                    <TextBlock Grid.Column="1" Grid.Row="0"
                                               Text="{Binding LblZapretHeroTitle}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top"/>

                                    <TextBlock Grid.Column="1" Grid.Row="1"
                                               Text="{Binding LblZapretHeroLede}"
                                               FontSize="11"
                                               LineHeight="15"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </Grid>

                                <!-- Magic button — fires ZapretOneClickCommand
                                     which orchestrates the whole flow. Same
                                     command bound to footer button (muscle
                                     memory). Disabled during download/probing. -->
                                <Button Command="{Binding ZapretOneClickCommand}"
                                        IsEnabled="{Binding IsZapretMagicButtonEnabled}"
                                        Background="{DynamicResource AccentSolidBrush}"
                                        Foreground="{DynamicResource AccentOnSolidBrush}"
                                        BorderThickness="0"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="22,12"
                                        MinWidth="260"
                                        HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        FontWeight="Bold"
                                        FontSize="13"
                                        AutomationProperties.Name="{Binding LblZapretMagicButton}">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Path Width="11" Height="11"
                                              Stretch="Uniform"
                                              Fill="{DynamicResource AccentOnSolidBrush}"
                                              VerticalAlignment="Center"
                                              IsVisible="{Binding !ZapretEnabled}"
                                              Data="M8.5,5.5 L8.5,18.5 L18.5,12 Z"/>
                                        <Border Width="10" Height="10"
                                                CornerRadius="2"
                                                Background="{DynamicResource AccentOnSolidBrush}"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding ZapretEnabled}"/>
                                        <TextBlock Text="{Binding LblZapretMagicButton}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- r34: Quick-strategy mini-row for power users.
                                     ComboBox со списком стратегий + ▶ кнопка
                                     запуска без probe. По дефолту главная
                                     кнопка делает probe автоматически; эта
                                     строка для тех кто знает свою стратегию
                                     и не хочет ждать 2-7 мин probe.
                                     Hidden during probe/running to avoid clutter. -->
                                <!-- r50: Hero quick-strategy row reworked per design review.
                                     - Mini ▶ replaced with explicit label "Запустить"
                                       (user said unlabeled icon was unclear).
                                     - Legend MOVED INTO ComboBox tooltip (was free-
                                       floating below, disconnected from dropdown).
                                     - ComboBox + button grid kept; sunken bg dropped
                                       for cleaner card-on-card hierarchy. -->
                                <Border IsVisible="{Binding HasZapretStrategiesForQuickStart}"
                                        Padding="0"
                                        Margin="0,4,0,0"
                                        MaxWidth="380"
                                        HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding ZapretStrategiesDisplay}"
                                                  SelectedIndex="{Binding ZapretStrategyIndex}"
                                                  FontSize="10"
                                                  Padding="6,2"
                                                  MinHeight="0"
                                                  HorizontalAlignment="Stretch"
                                                  ToolTip.Tip="{Binding LblStrategyBadgeLegend}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate DataType="vm:ZapretStrategyDisplayItem">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding Glyph}"
                                                                   FontSize="10"
                                                                   MinWidth="40"
                                                                   Classes.zglyph-success="{Binding IsSuccess}"
                                                                   Classes.zglyph-warning="{Binding IsWarning}"
                                                                   Classes.zglyph-danger="{Binding IsDanger}"
                                                                   Classes.zglyph-muted="{Binding IsMuted}"
                                                                   Classes.zglyph-stale="{Binding IsStale}"/>
                                                        <TextBlock Text="{Binding NameText}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <!-- r50: explicit label "Запустить" instead of bare ▶ glyph -->
                                        <Button Grid.Column="1"
                                                Command="{Binding StartZapretWithSelectedStrategyCommand}"
                                                IsEnabled="{Binding !IsZapretProbing}"
                                                ToolTip.Tip="{Binding L_ZapretStartSelectedStrategyHint}"
                                                FontSize="10" Padding="10,2"
                                                MinHeight="0"
                                                CornerRadius="{StaticResource RadiusSm}"
                                                Background="{DynamicResource AccentBgSubtleBrush}"
                                                Foreground="{DynamicResource AccentFgBrush}"
                                                BorderBrush="{DynamicResource AccentBorderBrush}"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="▶" FontSize="9" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding LblZapretRunSelected}" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- r51: legend restored as compact visible row
                                     (user feedback: tooltip-only too hidden).
                                     Smaller font (8) + tighter ItemSpacing so
                                     it sits right below ComboBox like a
                                     caption strip. Still attached to dropdown
                                     by tight Margin top=0. -->
                                <WrapPanel IsVisible="{Binding HasZapretStrategiesForQuickStart}"
                                           HorizontalAlignment="Center"
                                           ItemSpacing="6"
                                           Margin="0,2,0,0"
                                           MaxWidth="380">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock Text="✓" FontSize="8" Classes="zglyph-success"/>
                                        <TextBlock Text="{Binding LblLegendWorking}" FontSize="8" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock Text="⚠" FontSize="8" Classes="zglyph-warning"/>
                                        <TextBlock Text="{Binding LblLegendPartial}" FontSize="8" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock Text="✗" FontSize="8" Classes="zglyph-danger"/>
                                        <TextBlock Text="{Binding LblLegendFailed}" FontSize="8" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock Text="◌" FontSize="8" Classes="zglyph-muted"/>
                                        <TextBlock Text="{Binding LblLegendUntested}" FontSize="8" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock Text="⏱" FontSize="8" Classes="zglyph-stale"/>
                                        <TextBlock Text="{Binding LblLegendStale}" FontSize="8" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </WrapPanel>

                                <!-- r47: "Open probe log" button MOVED out of Hero
                                     to Дополнительно tab — Hero was getting too
                                     tall after r45/r46 added legend + colored
                                     badges, pushing the tab strip below the
                                     520x680 default window viewport. -->

                                <!-- Probe progress bar (only during probing).
                                     r33: + Cancel button so user can abort the
                                     2-7 min sweep at any time. -->
                                <StackPanel IsVisible="{Binding IsZapretProbing}"
                                            Spacing="6"
                                            HorizontalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True"
                                                 Height="3"
                                                 Width="240"
                                                 CornerRadius="{StaticResource RadiusXs}"
                                                 Foreground="{DynamicResource AccentSolidBrush}"/>
                                    <!-- r21 — live elapsed time + ETA estimate.
                                         Surfaces "Прошло 0:25 · осталось ~3:40"
                                         so users see the probe is actually
                                         making progress (and how long left). -->
                                    <TextBlock Text="{Binding LblZapretProbeElapsed}"
                                               FontSize="10"
                                               Opacity="0.7"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                    <!-- r33: Cancel button. Triggers cts.Cancel
                                         in MVM → proc.Kill in ZapretAutoStrategy. -->
                                    <Button Content="{Binding L_ZapretCancelProbeButton}"
                                            Command="{Binding CancelZapretProbeCommand}"
                                            FontSize="10" Padding="10,3"
                                            CornerRadius="{StaticResource RadiusSm}"
                                            HorizontalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource DangerBorderBrush}"
                                            BorderThickness="1"
                                            Foreground="{DynamicResource DangerSolidBrush}"/>
                                </StackPanel>

                                <!-- Air pill (only when running). -->
                                <Border IsVisible="{Binding ZapretEnabled}"
                                        CornerRadius="{StaticResource RadiusPill}"
                                        Background="{DynamicResource SuccessBgBrush}"
                                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                                        BorderThickness="1"
                                        Padding="10,5"
                                        HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6"
                                                 Fill="{DynamicResource SuccessSolidBrush}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LblZapretAirPill}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SuccessFgBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ════════ r24 — Hero strategy summary card.
                         Sits between the main button and Тонкая настройка so
                         the user sees "what's cached, how fresh, is it OK"
                         at a glance without opening the expander.

                         Hidden entirely when no cache exists (clean slate
                         for first-time users — they just see the magic
                         button without a confusing empty card).

                         The 2 buttons:
                           [Перепроверить] → ForceFreshProbeCommand
                                              (full re-sweep, same as
                                              "Найти стратегию заново")
                           [Подробнее]     → ExpandZapretTuneSection
                                              (programmatically opens the
                                              expander below) -->
                    <!-- r50: minimal summary strip. Pre-r50 had big card with
                         redundant "Стратегия XXX работает" title that
                         duplicated the ComboBox ✓ badge. User design feedback:
                         "блок 'Стратегия "general (ALT3)" работает' + футер
                         дублируют информацию о текущей стратегии". Reduced
                         to a single line: only the cache-age + Re-verify
                         button. No card border, no big icon — just a status
                         hint that ties to the ComboBox above. -->
                    <Grid IsVisible="{Binding IsZapretSummaryVisible}"
                          ColumnDefinitions="*,Auto"
                          Margin="0,4,0,0">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding LblZapretSummarySubtext}"
                                   FontSize="10"
                                   Opacity="0.7"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Button Grid.Column="1"
                                Content="{Binding L_ZapretReverifyButton}"
                                Command="{Binding ForceFreshProbeCommand}"
                                IsEnabled="{Binding !IsZapretProbing}"
                                ToolTip.Tip="{Binding L_ZapretReverifyHint}"
                                FontSize="10" Padding="8,3"
                                CornerRadius="{StaticResource RadiusSm}"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentBgSubtleBrush}"
                                Foreground="{DynamicResource AccentFgBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}"
                                BorderThickness="1"/>
                    </Grid>

                    <!-- ════════ r25 — Тонкая настройка as TabControl, not Expander.
                         Historical bug we hit repeatedly r10..r22: an Expander
                         inside the outer ScrollViewer wouldn't reliably scroll
                         to the bottom of its expanded content. Padding bumps
                         (10→24→60) were workarounds, not fixes — the underlying
                         layout pathology stayed.
                         TabControl makes each section its own viewport-sized
                         page, so no nested scroll, no overflow ambiguity, and
                         the chronic complaint ("не получается доскролить до
                         самого низа") is structurally gone. Pattern matches
                         the Apps page sidebar (different visual orientation —
                         tabs are horizontal here for the narrower 520px
                         default window). -->

                    <!-- r32: Description + Warning REMOVED from Row 0. They
                         duplicated the Hero card's lede ("Скачаем zapret,
                         поставим Discord hosts, подберём рабочую стратегию")
                         and ate ~100px that pushed tabs off-screen. Warning
                         "Только Windows" already conveyed by the platform-
                         gated commands themselves (tabs are no-ops on
                         Linux/macOS). User rule satisfied: main button
                         always visible + tabs always visible. -->

            </StackPanel>

            <!-- r31 tab strip — ToggleButton with underline-active style,
                 matching the main app's top tabs (Серверы/Подписка/etc.).
                 No radio dot. Just text + accent underline on selected.
                 r29 used RadioButton which user feedback flagged as
                 «похоже на пубо настроки» — radio glyph wrong for tabs. -->
            <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,8,0,0">
                <ToggleButton IsChecked="{Binding IsZapretTab0}"
                              Command="{Binding SetZapretTabCommand}"
                              CommandParameter="0"
                              Classes="TabStripPill"
                              Content="{Binding L_ZapretSecStrategy}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"/>
                <ToggleButton IsChecked="{Binding IsZapretTab1}"
                              Command="{Binding SetZapretTabCommand}"
                              CommandParameter="1"
                              Classes="TabStripPill"
                              Content="{Binding L_ZapretSecHosts}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"/>
                <ToggleButton IsChecked="{Binding IsZapretTab2}"
                              Command="{Binding SetZapretTabCommand}"
                              CommandParameter="2"
                              Classes="TabStripPill"
                              Content="{Binding L_ZapretSecFilters}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"/>
                <ToggleButton IsChecked="{Binding IsZapretTab3}"
                              Command="{Binding SetZapretTabCommand}"
                              CommandParameter="3"
                              Classes="TabStripPill"
                              Content="{Binding L_ZapretSecAdvanced}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"/>
            </UniformGrid>

            <!-- Optional thin divider between strip and content -->
            <Border Grid.Row="2"
                    Height="1"
                    Background="{DynamicResource BorderSubtleBrush}"
                    Margin="0,0,0,6"/>

            <!-- Tab content area (Grid.Row=3, gets * remaining space).
                 Panel hosts all 4 ScrollViewers, only one visible. -->
            <Border Grid.Row="3"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}"
                    Padding="10,6">
                <Panel>

                        <!-- ─── Tab 0: Strategy ─── -->
                        <ScrollViewer IsVisible="{Binding IsZapretTab0}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding L_ZapretSecStrategyDesc}"
                                           TextWrapping="Wrap" FontSize="10"
                                           Opacity="0.7"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <!-- r49: parity with Hero ComboBox — bind to
                                     ZapretStrategiesDisplay (colored badges)
                                     instead of raw ZapretStrategies. User
                                     was seeing two different visual treatments
                                     for the same data ('◌ general (ALT3)' in
                                     Hero vs bare 'general (ALT3)' here). -->
                                <ComboBox ItemsSource="{Binding ZapretStrategiesDisplay}"
                                          SelectedIndex="{Binding ZapretStrategyIndex}"
                                          HorizontalAlignment="Stretch"
                                          Padding="8,4" FontSize="11">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="vm:ZapretStrategyDisplayItem">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Glyph}"
                                                           FontSize="11"
                                                           MinWidth="44"
                                                           Classes.zglyph-success="{Binding IsSuccess}"
                                                           Classes.zglyph-warning="{Binding IsWarning}"
                                                           Classes.zglyph-danger="{Binding IsDanger}"
                                                           Classes.zglyph-muted="{Binding IsMuted}"
                                                           Classes.zglyph-stale="{Binding IsStale}"/>
                                                <TextBlock Text="{Binding NameText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <!-- r50 — REMOVED "Запустить с этой стратегией"
                                     button + help-text per design review:
                                     duplicate CTA. Hero magic button + Hero
                                     mini ▶ cover both "auto-pick" and
                                     "use selected" intents already. Strategy
                                     tab is now a pure setting (which strategy
                                     to use), not a third action. -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding ZapretVersionText}"
                                               FontSize="10" Opacity="0.5"
                                               VerticalAlignment="Center"/>
                                    <Button Content="{Binding LblUpdateZapret}"
                                            Command="{Binding UpdateZapretCommand}"
                                            FontSize="10" Padding="8,4"
                                            CornerRadius="{StaticResource RadiusSm}"
                                            IsEnabled="{Binding !IsZapretDownloading}"/>
                                </StackPanel>
                                <TextBox Text="{Binding ZapretCustomArgs}"
                                         IsVisible="{Binding IsCustomStrategy}"
                                         PlaceholderText="{Binding L_WmZapretCustomArgs}"
                                         FontSize="10" Padding="6,4"
                                         AcceptsReturn="True" MinHeight="50" MaxHeight="80"/>
                                <Button Content="{Binding L_UpdateIpSet}"
                                        Command="{Binding UpdateIpSetListCommand}"
                                        IsEnabled="{Binding !IsZapretActionRunning}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <CheckBox IsChecked="{Binding ZapretAutoUpdateCheck}"
                                          AutomationProperties.Name="{Binding L_AutoUpdateCheckLabel}"
                                          ToolTip.Tip="{Binding L_TipZapretAutoUpdate}"
                                          FontSize="10" MinHeight="0" Padding="4,0">
                                    <TextBlock Text="{Binding L_AutoUpdateCheckLabel}"
                                               TextWrapping="Wrap" FontSize="10"/>
                                </CheckBox>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ─── Tab 1: Hosts ─── -->
                        <ScrollViewer IsVisible="{Binding IsZapretTab1}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding L_ZapretSecHostsDesc}"
                                           TextWrapping="Wrap" FontSize="10"
                                           Opacity="0.7"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                                        Background="{DynamicResource SurfaceSunkenBrush}">
                                    <StackPanel Spacing="4">
                                        <Button Content="{Binding LblDiscordHosts}"
                                                Command="{Binding ToggleDiscordHostsCommand}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                FontSize="10" Padding="8,4"
                                                CornerRadius="{StaticResource RadiusSm}"
                                                Foreground="{Binding DiscordHostsInstalled,
                                                             Converter={x:Static conv:BoolToBrushConverter.Instance},
                                                             ConverterParameter=DangerSolidBrush|TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding LblDiscordHostsDesc}"
                                                   TextWrapping="Wrap" FontSize="9" Opacity="0.6"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                                        Background="{DynamicResource SurfaceSunkenBrush}">
                                    <StackPanel Spacing="4">
                                        <Button Content="{Binding LblFlowsealHosts}"
                                                Command="{Binding ToggleFlowsealHostsCommand}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                FontSize="10" Padding="8,4"
                                                CornerRadius="{StaticResource RadiusSm}"
                                                Foreground="{Binding FlowsealHostsInstalled,
                                                             Converter={x:Static conv:BoolToBrushConverter.Instance},
                                                             ConverterParameter=DangerSolidBrush|TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="9" Opacity="0.6"
                                                   Text="{Binding L_ZapretHostsHint}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ─── Tab 2: Filters ─── -->
                        <ScrollViewer IsVisible="{Binding IsZapretTab2}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding L_ZapretSecFiltersDesc}"
                                           TextWrapping="Wrap" FontSize="10"
                                           Opacity="0.7"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding L_GameFilter}"
                                               FontWeight="SemiBold" FontSize="10"/>
                                    <ComboBox SelectedIndex="{Binding GameFilterModeIndex}"
                                              HorizontalAlignment="Stretch"
                                              Padding="6,3" FontSize="10">
                                        <ComboBoxItem Content="{Binding L_GameFilterOff}"/>
                                        <ComboBoxItem Content="{Binding L_GameFilterAll}"/>
                                        <ComboBoxItem Content="{Binding L_GameFilterTcp}"/>
                                        <ComboBoxItem Content="{Binding L_GameFilterUdp}"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding L_IpSetFilter}"
                                               FontWeight="SemiBold" FontSize="10"/>
                                    <ComboBox SelectedIndex="{Binding IpSetModeIndex}"
                                              HorizontalAlignment="Stretch"
                                              Padding="6,3" FontSize="10">
                                        <ComboBoxItem Content="{Binding L_IpSetAny}"/>
                                        <ComboBoxItem Content="{Binding L_IpSetLoaded}"/>
                                        <ComboBoxItem Content="{Binding L_IpSetNone}"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ─── Tab 3: Tools (Diagnostics + Cache + Service) ─── -->
                        <ScrollViewer IsVisible="{Binding IsZapretTab3}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="6">
                                <Button Content="{Binding L_RunDiagnostics}"
                                        Command="{Binding RunZapretDiagnosticsCommand}"
                                        IsEnabled="{Binding !IsZapretActionRunning}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <Border IsVisible="{Binding ZapretActionOutput.Count}"
                                        Padding="8" MaxHeight="200"
                                        Background="{DynamicResource SurfaceSunkenBrush}"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSm}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding ZapretActionTitle}"
                                                   FontWeight="SemiBold" FontSize="10" Opacity="0.7"/>
                                        <ScrollViewer MaxHeight="160"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ZapretActionOutput}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="9"
                                                                   FontFamily="Consolas,Courier New,monospace"
                                                                   TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                                <Button Content="{Binding L_ClearDiscordCache}"
                                        Command="{Binding ClearDiscordCacheCommand}"
                                        IsEnabled="{Binding !IsZapretActionRunning}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <Button Content="{Binding L_RunTestsLabel}"
                                        Command="{Binding RunZapretTestsCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <Button Content="{Binding L_RemoveServiceLabel}"
                                        Command="{Binding RemoveZapretServiceCommand}"
                                        IsEnabled="{Binding !IsZapretActionRunning}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Foreground="{DynamicResource DangerSolidBrush}"/>
                                <!-- r47: "Open probe log" — moved here from Hero.
                                     Was in the magic-button card pre-r47 but
                                     contributed to Hero overflow. Lives in
                                     Дополнительно tab now so it doesn't push
                                     Strategy/Hosts tabs below the viewport. -->
                                <Button Content="{Binding LblOpenProbeLog}"
                                        Command="{Binding OpenProbeLogCommand}"
                                        IsVisible="{Binding HasLastProbeLog}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <Button Content="{Binding L_OpenServiceMenu}"
                                        Command="{Binding OpenZapretServiceMenuCommand}"
                                        ToolTip.Tip="{Binding L_TipOpenServiceMenu}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                    <Button Content="{Binding L_OpenFolder}"
                                            Command="{Binding OpenZapretFolderCommand}"
                                            FontSize="10" Padding="8,4"
                                            CornerRadius="{StaticResource RadiusSm}"/>
                                    <Button Content="{Binding L_OpenGitHub}"
                                            Command="{Binding OpenZapretGitHubCommand}"
                                            FontSize="10" Padding="8,4"
                                            CornerRadius="{StaticResource RadiusSm}"
                                            Foreground="{DynamicResource AccentSolidBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Flowseal/zapret-discord-youtube"
                                           FontSize="9" Opacity="0.4"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Left"/>

                                <!-- v2.37.0-r11 — Zapret probe cache controls — now
                                     live INSIDE the Tools tab (was a sibling of the
                                     Diagnostics section in the old Expander layout).
                                     r25 — TabItem already gives this a clean viewport,
                                     so no more padding-bump dance to keep the buttons
                                     visible. Border-separated to group visually. -->
                                <Border Margin="0,8,0,0" Padding="0,8,0,0"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="0,1,0,0">
                                    <StackPanel Spacing="6">
                                        <WrapPanel ItemSpacing="6" LineSpacing="6">
                                            <Button Content="{Binding L_ZapretForceFreshProbeButton}"
                                                    Command="{Binding ForceFreshProbeCommand}"
                                                    IsEnabled="{Binding !IsZapretProbing}"
                                                    FontSize="10" Padding="8,4"
                                                    CornerRadius="{StaticResource RadiusSm}"/>
                                            <Button Content="{Binding L_ZapretClearCacheButton}"
                                                    Command="{Binding ClearZapretCacheCommand}"
                                                    FontSize="10" Padding="8,4"
                                                    CornerRadius="{StaticResource RadiusSm}"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding LblZapretCacheStatus}"
                                                   FontSize="10" Opacity="0.6"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                </Panel>
            </Border>
        </Grid>

        <!-- ════════ Footer — same shape as TgProxyOneTap r7.
             Status dot + ZapretStatus + compact magic button. Footer bound
             to the same ZapretOneClickCommand so both surfaces fire the
             same orchestrator. -->
        <Border Grid.Row="1" Padding="14,7,14,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                Background="{DynamicResource SurfaceSunkenBrush}">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" ColumnSpacing="8">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             VerticalAlignment="Center"
                             Fill="{Binding ZapretEnabled, Converter={StaticResource StatusColorConverter}}"/>
                    <TextBlock Text="{Binding ZapretStatus}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <!-- r51 — footer CTA button REMOVED. User design feedback:
                     "Footer 'Включить обход блокировок' дублирует Hero
                     magic button." Hero ALREADY has a big magic button
                     at the top of the page, prominent and always visible.
                     Footer now shows ONLY status (dot + text), no button.
                     Saves visual noise + eliminates the "which one do I
                     click?" confusion. -->
                <Button Grid.Column="1"
                        IsVisible="False"
                        Content="{Binding LblZapretMagicButton}"
                        Command="{Binding ZapretOneClickCommand}"
                        IsEnabled="{Binding IsZapretMagicButtonEnabled}"
                        FontSize="10" FontWeight="SemiBold"
                        Padding="10,5"
                        CornerRadius="{StaticResource RadiusSm}"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:conv="using:VPNRouter.App"
             xmlns:icons="using:VPNRouter.App.Controls"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="600"
             x:Class="VPNRouter.App.Views.Pages.DpiBypassPage"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <conv:BoolToStatusColorConverter x:Key="StatusColorConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.zglyph-success">
            <Setter Property="Foreground" Value="{DynamicResource SuccessSolidBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.zglyph-warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningSolidBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.zglyph-danger">
            <Setter Property="Foreground" Value="{DynamicResource DangerSolidBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.zglyph-stale">
            <Setter Property="Foreground" Value="{DynamicResource WarningSolidBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.zglyph-muted">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">

        <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto,*" Margin="12,8,14,8">
            <StackPanel Grid.Row="0" Spacing="8">

                    <StackPanel IsVisible="{Binding IsZapretDownloading}" Spacing="6">
                        <ProgressBar IsIndeterminate="True"
                                     Height="3"
                                     CornerRadius="{StaticResource RadiusXs}"
                                     Foreground="{DynamicResource AccentSolidBrush}"/>
                        <TextBlock Text="{Binding ZapretStatus}"
                                   TextWrapping="Wrap"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <Border IsVisible="{Binding HasZapretAvBlockToast}"
                            Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                            Background="{DynamicResource DangerBgBrush}"
                            BorderBrush="{DynamicResource DangerBorderBrush}"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" icons:PictogramText.Icons="warning" icons:PictogramText.Text="!"
                                       Foreground="{DynamicResource DangerFgBrush}"
                                       FontSize="14" FontWeight="Bold"
                                       VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                       FontSize="10"
                                       Foreground="{DynamicResource DangerFgBrush}"
                                       VerticalAlignment="Center"
                                       Text="{Binding ZapretAvBlockToast}"/>
                            <Button Grid.Column="2"
                                    Content="{Binding L_ZapretAvBlockCopyPath}"
                                    Command="{Binding CopyZapretWhitelistPathCommand}"
                                    Padding="8,2" MinHeight="0" FontSize="10"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource DangerBorderBrush}"
                                    BorderThickness="1"
                                    Foreground="{DynamicResource DangerFgBrush}"
                                    VerticalAlignment="Center"/>
                            <Button Grid.Column="3" icons:PictogramText.Icons="close" icons:PictogramText.Content="X"
                                    Command="{Binding DismissZapretAvBlockToastCommand}"
                                    Padding="6,2" MinHeight="0" FontSize="10"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource DangerFgBrush}"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding L_TipDismiss}" AutomationProperties.Name="{Binding L_TipDismiss}"/>
                        </Grid>
                    </Border>

                    <Border CornerRadius="{StaticResource RadiusLg}"
                            Background="{DynamicResource SurfaceBaseBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="16,10,16,12"
                            ClipToBounds="True">
                        <Grid>
                            <Ellipse Width="140" Height="140"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Opacity="0.5"
                                     IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="50%,50%" Center="50%,50%" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop Offset="0.0"  Color="{DynamicResource AccentBgSubtle}"/>
                                        <GradientStop Offset="0.65" Color="Transparent"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <StackPanel Spacing="10" HorizontalAlignment="Stretch" MaxWidth="420">

                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                    <Border Grid.Column="0" Grid.RowSpan="2"
                                            Width="36" Height="36"
                                            CornerRadius="10"
                                            Background="{DynamicResource SurfaceBaseBrush}"
                                            BorderBrush="{DynamicResource AccentBorderBrush}"
                                            BorderThickness="1"
                                            BoxShadow="0 2 6 0 #14000000"
                                            VerticalAlignment="Top"
                                            Margin="0,2,12,0">
                                        <icons:Pictogram Id="shield-bolt" Width="20" Height="20"
                                                         Foreground="{DynamicResource AccentFgBrush}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Grid.Column="1" Grid.Row="0"
                                               Text="{Binding LblZapretHeroTitle}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top"/>

                                    <TextBlock Grid.Column="1" Grid.Row="1"
                                               Text="{Binding LblZapretHeroLede}"
                                               FontSize="11"
                                               LineHeight="15"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </Grid>

                                <Button Classes="solid" Command="{Binding ZapretOneClickCommand}"
                                        IsEnabled="{Binding IsZapretMagicButtonEnabled}"
                                        Background="{DynamicResource AccentSolidBrush}"
                                        Foreground="{DynamicResource AccentOnSolidBrush}"
                                        BorderThickness="0"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="22,12"
                                        MinWidth="260"
                                        HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        FontWeight="Bold"
                                        FontSize="13"
                                        AutomationProperties.Name="{Binding LblZapretMagicButton}">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <icons:Pictogram Id="play" Width="14" Height="14"
                                                         Foreground="{DynamicResource AccentOnSolidBrush}"
                                                         VerticalAlignment="Center"
                                                         IsVisible="{Binding !ZapretEnabled}"/>
                                        <icons:Pictogram Id="stop" Width="14" Height="14"
                                                         Foreground="{DynamicResource AccentOnSolidBrush}"
                                                         VerticalAlignment="Center"
                                                         IsVisible="{Binding ZapretEnabled}"/>
                                        <TextBlock Text="{Binding LblZapretMagicButton}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Border IsVisible="{Binding HasZapretStrategiesForQuickStart}"
                                        Padding="0"
                                        Margin="0,4,0,0"
                                        MaxWidth="380"
                                        HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding ZapretStrategiesDisplay}"
                                                  SelectedIndex="{Binding ZapretStrategyIndex}"
                                                  FontSize="10"
                                                  Padding="6,2"
                                                  MinHeight="0"
                                                  HorizontalAlignment="Stretch"
                                                  icons:PictogramText.Tip="{Binding LblStrategyBadgeLegend}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate DataType="vm:ZapretStrategyDisplayItem">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock icons:PictogramText.Icons="check,warning,error,untested,timer" icons:PictogramText.Text="{Binding Glyph}"
                                                                   FontSize="10"
                                                                   MinWidth="40"
                                                                   Classes.zglyph-success="{Binding IsSuccess}"
                                                                   Classes.zglyph-warning="{Binding IsWarning}"
                                                                   Classes.zglyph-danger="{Binding IsDanger}"
                                                                   Classes.zglyph-muted="{Binding IsMuted}"
                                                                   Classes.zglyph-stale="{Binding IsStale}"/>
                                                        <TextBlock Text="{Binding NameText}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="1"
                                                Command="{Binding StartZapretWithSelectedStrategyCommand}"
                                                IsEnabled="{Binding !IsZapretProbing}"
                                                ToolTip.Tip="{Binding L_ZapretStartSelectedStrategyHint}"
                                                FontSize="10" Padding="10,2"
                                                MinHeight="0"
                                                CornerRadius="{StaticResource RadiusSm}"
                                                Background="{DynamicResource AccentBgSubtleBrush}"
                                                Foreground="{DynamicResource AccentFgBrush}"
                                                BorderBrush="{DynamicResource AccentBorderBrush}"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock icons:PictogramText.Icons="play" icons:PictogramText.Text="▶" FontSize="9" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding LblZapretRunSelected}" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <WrapPanel IsVisible="{Binding HasZapretStrategiesForQuickStart}"
                                           HorizontalAlignment="Center"
                                           ItemSpacing="10"
                                           Margin="0,2,0,0"
                                           MaxWidth="380">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <TextBlock icons:PictogramText.Icons="check" icons:PictogramText.Text="✓" FontSize="10" Classes="zglyph-success"/>
                                        <TextBlock Text="{Binding LblLegendWorking}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <TextBlock icons:PictogramText.Icons="warning" icons:PictogramText.Text="⚠" FontSize="10" Classes="zglyph-warning"/>
                                        <TextBlock Text="{Binding LblLegendPartial}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <TextBlock icons:PictogramText.Icons="error" icons:PictogramText.Text="✗" FontSize="10" Classes="zglyph-danger"/>
                                        <TextBlock Text="{Binding LblLegendFailed}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <TextBlock icons:PictogramText.Icons="untested" icons:PictogramText.Text="◌" FontSize="10" Classes="zglyph-muted"/>
                                        <TextBlock Text="{Binding LblLegendUntested}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <TextBlock icons:PictogramText.Icons="timer" icons:PictogramText.Text="⏱" FontSize="10" Classes="zglyph-stale"/>
                                        <TextBlock Text="{Binding LblLegendStale}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </WrapPanel>

                                <StackPanel IsVisible="{Binding IsZapretProbing}"
                                            Spacing="6"
                                            HorizontalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True"
                                                 Height="3"
                                                 Width="240"
                                                 CornerRadius="{StaticResource RadiusXs}"
                                                 Foreground="{DynamicResource AccentSolidBrush}"/>
                                    <TextBlock Text="{Binding LblZapretProbeElapsed}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                    <Button Content="{Binding L_ZapretCancelProbeButton}"
                                            Command="{Binding CancelZapretProbeCommand}"
                                            FontSize="10" Padding="10,3"
                                            CornerRadius="{StaticResource RadiusSm}"
                                            HorizontalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource DangerBorderBrush}"
                                            BorderThickness="1"
                                            Foreground="{DynamicResource DangerSolidBrush}"/>
                                </StackPanel>

                                <Border IsVisible="{Binding ZapretEnabled}"
                                        CornerRadius="{StaticResource RadiusPill}"
                                        Background="{DynamicResource SuccessBgBrush}"
                                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                                        BorderThickness="1"
                                        Padding="10,5"
                                        HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <icons:Pictogram Id="status" Width="12" Height="12"
                                                 Foreground="{DynamicResource SuccessSolidBrush}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LblZapretAirPill}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SuccessFgBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid IsVisible="{Binding IsZapretSummaryVisible}"
                          ColumnDefinitions="*,Auto"
                          Margin="0,4,0,0">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding LblZapretSummarySubtext}"
                                   FontSize="10"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <Button Grid.Column="1"
                                Content="{Binding L_ZapretReverifyButton}"
                                Command="{Binding ForceFreshProbeCommand}"
                                IsEnabled="{Binding !IsZapretProbing}"
                                ToolTip.Tip="{Binding L_ZapretReverifyHint}"
                                FontSize="10" Padding="8,3"
                                CornerRadius="{StaticResource RadiusSm}"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentBgSubtleBrush}"
                                Foreground="{DynamicResource AccentFgBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}"
                                BorderThickness="1"/>
                    </Grid>

            </StackPanel>

            <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,8,0,0">
                <ToggleButton IsChecked="{Binding IsZapretTab0}"
                              Command="{Binding SetZapretTabCommand}"
                              CommandParameter="0"
                              Classes="TabStripPill"
                              Content="{Binding L_ZapretSecStrategy}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"/>
                <ToggleButton IsChecked="{Binding IsZapretTab1}"
                              Command="{Binding SetZapretTabCommand}"
                              CommandParameter="1"
                              Classes="TabStripPill"
                              Content="{Binding L_ZapretSecHosts}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"/>
                <ToggleButton IsChecked="{Binding IsZapretTab2}"
                              Command="{Binding SetZapretTabCommand}"
                              CommandParameter="2"
                              Classes="TabStripPill"
                              Content="{Binding L_ZapretSecFilters}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"/>
                <ToggleButton IsChecked="{Binding IsZapretTab3}"
                              Command="{Binding SetZapretTabCommand}"
                              CommandParameter="3"
                              Classes="TabStripPill"
                              Content="{Binding L_ZapretSecAdvanced}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"/>
            </UniformGrid>

            <Border Grid.Row="2"
                    Height="1"
                    Background="{DynamicResource BorderSubtleBrush}"
                    Margin="0,0,0,6"/>

            <Border Grid.Row="3"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource SurfaceBaseBrush}"
                    Padding="10,8">
                <Panel>

                        <ScrollViewer IsVisible="{Binding IsZapretTab0}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding L_ZapretSecStrategyDesc}"
                                           TextWrapping="Wrap" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding ZapretStrategiesDisplay}"
                                          SelectedIndex="{Binding ZapretStrategyIndex}"
                                          HorizontalAlignment="Stretch"
                                          Padding="8,4" FontSize="11">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="vm:ZapretStrategyDisplayItem">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock icons:PictogramText.Icons="check,warning,error,untested,timer" icons:PictogramText.Text="{Binding Glyph}"
                                                           FontSize="11"
                                                           MinWidth="44"
                                                           Classes.zglyph-success="{Binding IsSuccess}"
                                                           Classes.zglyph-warning="{Binding IsWarning}"
                                                           Classes.zglyph-danger="{Binding IsDanger}"
                                                           Classes.zglyph-muted="{Binding IsMuted}"
                                                           Classes.zglyph-stale="{Binding IsStale}"/>
                                                <TextBlock Text="{Binding NameText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="{Binding ZapretVersionText}"
                                               FontSize="10"
                                               VerticalAlignment="Center"/>
                                    <Button Content="{Binding LblUpdateZapret}"
                                            Command="{Binding UpdateZapretCommand}"
                                            FontSize="10" Padding="8,4"
                                            CornerRadius="{StaticResource RadiusSm}"
                                            IsEnabled="{Binding !IsZapretDownloading}"/>
                                </StackPanel>
                                <TextBox Text="{Binding ZapretCustomArgs}"
                                         IsVisible="{Binding IsCustomStrategy}"
                                         PlaceholderText="{Binding L_WmZapretCustomArgs}"
                                         FontSize="10" Padding="6,4"
                                         AcceptsReturn="True" MinHeight="50" MaxHeight="80"/>
                                <Button Content="{Binding L_UpdateIpSet}"
                                        Command="{Binding UpdateIpSetListCommand}"
                                        IsEnabled="{Binding !IsZapretActionRunning}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <CheckBox IsChecked="{Binding ZapretAutoUpdateCheck}"
                                          AutomationProperties.Name="{Binding L_AutoUpdateCheckLabel}"
                                          ToolTip.Tip="{Binding L_TipZapretAutoUpdate}"
                                          FontSize="10" MinHeight="0" Padding="4,0">
                                    <TextBlock Text="{Binding L_AutoUpdateCheckLabel}"
                                               TextWrapping="Wrap" FontSize="10"/>
                                </CheckBox>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer IsVisible="{Binding IsZapretTab1}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding L_ZapretSecHostsDesc}"
                                           TextWrapping="Wrap" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                                        Background="{DynamicResource SurfaceSunkenBrush}">
                                    <StackPanel Spacing="4">
                                        <Button Content="{Binding LblDiscordHosts}"
                                                Command="{Binding ToggleDiscordHostsCommand}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                FontSize="10" Padding="8,4"
                                                CornerRadius="{StaticResource RadiusSm}"
                                                Foreground="{Binding DiscordHostsInstalled,
                                                             Converter={x:Static conv:BoolToBrushConverter.Instance},
                                                             ConverterParameter=DangerSolidBrush|TextPrimaryBrush}"/>
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="{Binding LblDiscordHostsDesc}"
                                                   TextWrapping="Wrap" FontSize="9"/>
                                    </StackPanel>
                                </Border>
                                <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                                        Background="{DynamicResource SurfaceSunkenBrush}">
                                    <StackPanel Spacing="4">
                                        <Button Content="{Binding LblFlowsealHosts}"
                                                Command="{Binding ToggleFlowsealHostsCommand}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                FontSize="10" Padding="8,4"
                                                CornerRadius="{StaticResource RadiusSm}"
                                                Foreground="{Binding FlowsealHostsInstalled,
                                                             Converter={x:Static conv:BoolToBrushConverter.Instance},
                                                             ConverterParameter=DangerSolidBrush|TextPrimaryBrush}"/>
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" FontSize="9"
                                                   Text="{Binding L_ZapretHostsHint}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer IsVisible="{Binding IsZapretTab2}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding L_ZapretSecFiltersDesc}"
                                           TextWrapping="Wrap" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding L_GameFilter}"
                                               FontWeight="SemiBold" FontSize="10"/>
                                    <ComboBox SelectedIndex="{Binding GameFilterModeIndex}"
                                              HorizontalAlignment="Stretch"
                                              Padding="6,3" FontSize="10">
                                        <ComboBoxItem Content="{Binding L_GameFilterOff}"/>
                                        <ComboBoxItem Content="{Binding L_GameFilterAll}"/>
                                        <ComboBoxItem Content="{Binding L_GameFilterTcp}"/>
                                        <ComboBoxItem Content="{Binding L_GameFilterUdp}"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding L_IpSetFilter}"
                                               FontWeight="SemiBold" FontSize="10"/>
                                    <ComboBox SelectedIndex="{Binding IpSetModeIndex}"
                                              HorizontalAlignment="Stretch"
                                              Padding="6,3" FontSize="10">
                                        <ComboBoxItem Content="{Binding L_IpSetAny}"/>
                                        <ComboBoxItem Content="{Binding L_IpSetLoaded}"/>
                                        <ComboBoxItem Content="{Binding L_IpSetNone}"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer IsVisible="{Binding IsZapretTab3}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="6">
                                <Button Content="{Binding L_RunDiagnostics}"
                                        Command="{Binding RunZapretDiagnosticsCommand}"
                                        IsEnabled="{Binding !IsZapretActionRunning}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <Border IsVisible="{Binding ZapretActionOutput.Count}"
                                        Padding="8" MaxHeight="200"
                                        Background="{DynamicResource SurfaceSunkenBrush}"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSm}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="{Binding ZapretActionTitle}"
                                                   FontWeight="SemiBold" FontSize="10"/>
                                        <ScrollViewer MaxHeight="160"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ZapretActionOutput}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="9"
                                                                   FontFamily="Consolas,Courier New,monospace"
                                                                   TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                                <Button Content="{Binding L_ClearDiscordCache}"
                                        Command="{Binding ClearDiscordCacheCommand}"
                                        IsEnabled="{Binding !IsZapretActionRunning}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <Button Content="{Binding L_RunTestsLabel}"
                                        Command="{Binding RunZapretTestsCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <Button Content="{Binding L_RemoveServiceLabel}"
                                        Command="{Binding RemoveZapretServiceCommand}"
                                        IsEnabled="{Binding !IsZapretActionRunning}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Classes="danger-soft"/>
                                <Button Content="{Binding LblOpenProbeLog}"
                                        Command="{Binding OpenProbeLogCommand}"
                                        IsVisible="{Binding HasLastProbeLog}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <Button Content="{Binding L_OpenServiceMenu}"
                                        Command="{Binding OpenZapretServiceMenuCommand}"
                                        ToolTip.Tip="{Binding L_TipOpenServiceMenu}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        FontSize="10" Padding="8,4"
                                        CornerRadius="{StaticResource RadiusSm}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                    <Button Content="{Binding L_OpenFolder}"
                                            Command="{Binding OpenZapretFolderCommand}"
                                            FontSize="10" Padding="8,4"
                                            CornerRadius="{StaticResource RadiusSm}"/>
                                    <Button Content="{Binding L_OpenGitHub}"
                                            Command="{Binding OpenZapretGitHubCommand}"
                                            FontSize="10" Padding="8,4"
                                            CornerRadius="{StaticResource RadiusSm}"/>
                                </StackPanel>
                                <TextBlock Text="Flowseal/zapret-discord-youtube"
                                           FontSize="9"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Left"/>

                                <Border Margin="0,8,0,0" Padding="0,8,0,0"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="0,1,0,0">
                                    <StackPanel Spacing="6">
                                        <WrapPanel ItemSpacing="6" LineSpacing="6">
                                            <Button Content="{Binding L_ZapretForceFreshProbeButton}"
                                                    Command="{Binding ForceFreshProbeCommand}"
                                                    IsEnabled="{Binding !IsZapretProbing}"
                                                    FontSize="10" Padding="8,4"
                                                    CornerRadius="{StaticResource RadiusSm}"/>
                                            <Button Content="{Binding L_ZapretClearCacheButton}"
                                                    Command="{Binding ClearZapretCacheCommand}"
                                                    FontSize="10" Padding="8,4"
                                                    CornerRadius="{StaticResource RadiusSm}"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding LblZapretCacheStatus}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                </Panel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Padding="14,7,14,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                Background="{DynamicResource SurfaceSunkenBrush}">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" ColumnSpacing="8">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <icons:Pictogram Id="status" Width="16" Height="16"
                             VerticalAlignment="Center"
                             Foreground="{Binding ZapretEnabled, Converter={StaticResource StatusColorConverter}}"/>
                    <TextBlock Text="{Binding ZapretStatus}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1"
                        IsVisible="False"
                        Content="{Binding LblZapretMagicButton}"
                        Command="{Binding ZapretOneClickCommand}"
                        IsEnabled="{Binding IsZapretMagicButtonEnabled}"
                        FontSize="10" FontWeight="SemiBold"
                        Padding="10,5"
                        CornerRadius="{StaticResource RadiusSm}"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

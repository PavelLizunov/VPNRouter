<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="500"
             x:Class="VPNRouter.App.Views.Pages.NetworkPage"
             x:DataType="vm:MainWindowViewModel">

    <!-- Master-detail: section list left, controls right -->
    <Grid ColumnDefinitions="160,*">

        <!-- MASTER (left): section navigator -->
        <Border Grid.Column="0"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}">
            <ListBox SelectedIndex="{Binding SelectedSettingsIndex}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBoxItem Content="{Binding LblSettingsRouting}"    Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
                <ListBoxItem Content="{Binding LblSettingsLeak}"       Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
                <ListBoxItem Content="{Binding LblSettingsContent}"    Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
                <ListBoxItem Content="{Binding LblSettingsUpdates}"    Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
                <ListBoxItem Content="{Binding LblAutostartSection}"   Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
            </ListBox>
        </Border>

        <!-- DETAIL (right): selected section -->
        <ScrollViewer Grid.Column="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="14,10,14,12">
          <StackPanel>

            <!-- Routing section -->
            <StackPanel Spacing="10" IsVisible="{Binding IsSettingsRoutingSelected}">
                <TextBlock Text="{Binding LblSettingsRouting}" FontWeight="Bold" FontSize="14"/>

                <StackPanel Spacing="4">
                    <TextBlock Text="Routing mode" FontWeight="SemiBold" Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton Content="{Binding LblSplitTunnel}"
                                     IsChecked="{Binding IsSplitTunnel}"
                                     GroupName="RoutingMode"/>
                        <RadioButton Content="{Binding LblFullTunnel}"
                                     GroupName="RoutingMode"/>
                    </StackPanel>
                </StackPanel>

                <Border Padding="8,6" CornerRadius="4"
                        Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="2">
                        <CheckBox IsChecked="{Binding BypassRussianTraffic}"
                                  Content="{Binding BypassRuLabel}" FontWeight="SemiBold"
                                  MinHeight="0" Padding="4,0"/>
                        <TextBlock Text="{Binding BypassRuHint}"
                                   FontSize="9" Opacity="0.6" Margin="22,0,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Leak Protection section -->
            <StackPanel Spacing="10" IsVisible="{Binding IsSettingsLeakSelected}">
                <TextBlock Text="{Binding LblSettingsLeak}" FontWeight="Bold" FontSize="14"/>

                <Border Padding="8,6" CornerRadius="4"
                        Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="4">
                        <CheckBox IsChecked="{Binding StrictMode}" Content="{Binding StrictModeLabel}"
                                  MinHeight="0" Padding="4,0"/>
                        <CheckBox IsChecked="{Binding ForceIpv4Only}" Content="{Binding ForceIpv4Label}"
                                  MinHeight="0" Padding="4,0"/>
                        <CheckBox IsChecked="{Binding FlushDnsOnStart}" Content="{Binding FlushDnsLabel}"
                                  MinHeight="0" Padding="4,0"/>
                        <CheckBox IsChecked="{Binding StrictDns}" Content="{Binding StrictDnsLabel}"
                                  MinHeight="0" Padding="4,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Content section -->
            <StackPanel Spacing="10" IsVisible="{Binding IsSettingsContentSelected}">
                <TextBlock Text="{Binding LblSettingsContent}" FontWeight="Bold" FontSize="14"/>

                <Border Padding="8,6" CornerRadius="4"
                        Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="2">
                        <CheckBox IsChecked="{Binding BlockAds}"
                                  Content="{Binding BlockAdsLabel}" FontWeight="SemiBold"
                                  MinHeight="0" Padding="4,0"/>
                        <TextBlock Text="{Binding BlockAdsHint}"
                                   FontSize="9" Opacity="0.6" Margin="22,0,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Updates section -->
            <StackPanel Spacing="10" IsVisible="{Binding IsSettingsUpdatesSelected}">
                <TextBlock Text="{Binding LblSettingsUpdates}" FontWeight="Bold" FontSize="14"/>

                <Border Padding="8,6" CornerRadius="4"
                        Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding UpdateChannelHeader}" FontWeight="SemiBold" Opacity="0.7"/>
                        <CheckBox IsChecked="{Binding ReceivePrereleases}"
                                  Content="{Binding ReceivePrereleasesLabel}"
                                  MinHeight="0" Padding="4,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Autostart section -->
            <StackPanel Spacing="10" IsVisible="{Binding IsSettingsAutostartSelected}">
                <TextBlock Text="{Binding LblAutostartSection}" FontWeight="Bold" FontSize="14"/>

                <Border Padding="8,6" CornerRadius="4"
                        Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="6">
                        <CheckBox IsChecked="{Binding AutostartVpn}"
                                  Content="{Binding LblAutostartVpn}"
                                  MinHeight="0" Padding="4,0"/>
                        <CheckBox IsChecked="{Binding AutostartZapret}"
                                  Content="{Binding LblAutostartZapret}"
                                  MinHeight="0" Padding="4,0"/>
                        <CheckBox IsChecked="{Binding AutostartTgProxy}"
                                  Content="{Binding LblAutostartTgProxy}"
                                  MinHeight="0" Padding="4,0"/>
                        <CheckBox IsChecked="{Binding AutostartUi}"
                                  Content="{Binding LblAutostartUi}"
                                  MinHeight="0" Padding="4,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

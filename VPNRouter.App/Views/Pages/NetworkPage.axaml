<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:conv="using:VPNRouter.App"
             xmlns:icons="using:VPNRouter.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="500"
             x:Class="VPNRouter.App.Views.Pages.NetworkPage"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">

  <UserControl.Resources>
    <ControlTheme x:Key="IosToggleCheckBox" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="MinHeight" Value="18"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource BorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <ControlTemplate>
          <icons:Pictogram Name="SwitchIcon" Id="switch"
                           Width="32" Height="24"
                           Foreground="{TemplateBinding Background}"
                           RenderTransformOrigin="50%,50%"/>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource SuccessSolidBrush}"/>
      </Style>
      <Style Selector="^ /template/ icons|Pictogram#SwitchIcon">
        <Setter Property="RenderTransform">
          <ScaleTransform ScaleX="-1"/>
        </Setter>
      </Style>
      <Style Selector="^:checked /template/ icons|Pictogram#SwitchIcon">
        <Setter Property="RenderTransform">
          <ScaleTransform ScaleX="1"/>
        </Setter>
      </Style>
    </ControlTheme>

  </UserControl.Resources>

  <UserControl.Styles>

    <Style Selector="Border.rule-card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.rule-card:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
    </Style>

    <Style Selector="Button.bulk-it">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.bulk-it:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
    </Style>
    <Style Selector="Button.bulk-it.danger">
      <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}"/>
    </Style>
    <Style Selector="Button.bulk-it.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
    </Style>

    <Style Selector="FlyoutPresenter.bulk-pop-host">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="Border.radio-card">
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
      <Setter Property="Padding" Value="10,10"/>
    </Style>
    <Style Selector="Border.radio-card.active">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}"/>
      <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
    </Style>

    <Style Selector="TextBlock.card-title">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.card-sub">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="Border.checkbox-card">
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
      <Setter Property="Padding" Value="10,10"/>
    </Style>
    <Style Selector="Border.checkbox-card.active">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}"/>
      <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
    </Style>

    <Style Selector="Border.service-pill">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
      <Setter Property="Padding" Value="8,2"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto" ColumnDefinitions="140,*">

    <Border Grid.Row="0" Grid.Column="0"
            BorderThickness="0,0,1,0"
            BorderBrush="{DynamicResource BorderDefaultBrush}"
            Background="{DynamicResource SurfaceSunkenBrush}">
      <ListBox SelectedIndex="{Binding SelectedSettingsIndex}"
               Background="Transparent"
               BorderThickness="0"
               Padding="6"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBoxItem Classes="sub-tab" Content="{Binding LblSettingsRouting}"    Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
        <ListBoxItem Classes="sub-tab" Content="{Binding LblSettingsRules}"      Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
        <ListBoxItem Classes="sub-tab" Content="{Binding LblSettingsLeak}"       Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
        <ListBoxItem Classes="sub-tab" Content="{Binding LblSettingsContent}"    Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
        <ListBoxItem Classes="sub-tab" Content="{Binding LblSettingsUpdates}"    Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
        <ListBoxItem Classes="sub-tab" Content="{Binding LblAutostartSection}"   Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
      </ListBox>
    </Border>

    <ScrollViewer Grid.Row="0" Grid.Column="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  AllowAutoHide="False"
                  Padding="0,10,0,12">
      <Grid Margin="14,0,14,0">
        <StackPanel HorizontalAlignment="Stretch">

        <StackPanel Spacing="10" IsVisible="{Binding IsSettingsRoutingSelected}">
          <TextBlock Text="{Binding LblSettingsRouting}" FontWeight="Bold" FontSize="13"/>
          <TextBlock Text="{Binding L_RoutingDescription}"
                     FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap"/>

          <Border Classes="radio-card" Classes.active="{Binding IsSplitTunnel}">
            <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
              <RadioButton Grid.Column="0"
                           IsChecked="{Binding IsSplitTunnel}"
                           GroupName="RoutingMode"
                           VerticalAlignment="Top"
                           MinWidth="0" MinHeight="0"
                           Margin="0,1,0,0"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="card-title"
                           Text="{Binding L_SplitTunnelTitle}"/>
                <TextBlock Classes="card-sub"
                           Text="{Binding L_SplitTunnelSubtitle}"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="radio-card" Classes.active="{Binding IsFullTunnel}">
            <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
              <RadioButton Grid.Column="0"
                           IsChecked="{Binding IsFullTunnel}"
                           GroupName="RoutingMode"
                           VerticalAlignment="Top"
                           MinWidth="0" MinHeight="0"
                           Margin="0,1,0,0"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="card-title"
                           Text="{Binding L_FullTunnelTitle}"/>
                <TextBlock Classes="card-sub"
                           Text="{Binding L_FullTunnelSubtitle}"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="checkbox-card" Classes.active="{Binding BypassRussianTraffic}">
            <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
              <CheckBox Grid.Column="0"
                        IsChecked="{Binding BypassRussianTraffic}"
                        AutomationProperties.Name="{Binding BypassRuLabel}"
                        VerticalAlignment="Top"
                        MinWidth="0" MinHeight="0" Padding="0"
                        Margin="0,1,0,0"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="card-title"
                           Text="{Binding BypassRuLabel}"/>
                <TextBlock Classes="card-sub"
                           Text="{Binding BypassRuHint}"/>
              </StackPanel>
            </Grid>
          </Border>

        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding IsSettingsRulesSelected}">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding LblSettingsRules}"
                       FontWeight="Bold" FontSize="13"
                       VerticalAlignment="Center"/>
            <WrapPanel Orientation="Horizontal">
              <Border Margin="0,0,6,0"
                      Padding="2"
                      CornerRadius="{StaticResource RadiusSm}"
                      Background="{DynamicResource SurfaceSunkenBrush}"
                      BorderThickness="0"
                      VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Content="{Binding L_RulesViewCards}"
                          Command="{Binding SetRulesViewCardsCommand}"
                          FontSize="10" FontWeight="SemiBold"
                          Padding="8,3" MinHeight="0"
                          BorderThickness="0"
                          CornerRadius="{StaticResource RadiusXs}"
                          ToolTip.Tip="{Binding L_RulesViewCardsTooltip}"
                          Background="{Binding IsRulesViewCards,
                                       Converter={x:Static conv:BoolToBrushConverter.Instance},
                                       ConverterParameter=SurfaceBaseBrush|Transparent}"
                          Foreground="{Binding IsRulesViewCards,
                                       Converter={x:Static conv:BoolToBrushConverter.Instance},
                                       ConverterParameter=AccentFgBrush|TextSecondaryBrush}"/>
                  <Button Content="{Binding L_RulesViewRead}"
                          Command="{Binding SetRulesViewReadCommand}"
                          FontSize="10" FontWeight="SemiBold"
                          Padding="8,3" MinHeight="0"
                          BorderThickness="0"
                          CornerRadius="{StaticResource RadiusXs}"
                          ToolTip.Tip="{Binding L_RulesViewReadTooltip}"
                          Background="{Binding IsRulesViewRead,
                                       Converter={x:Static conv:BoolToBrushConverter.Instance},
                                       ConverterParameter=SurfaceBaseBrush|Transparent}"
                          Foreground="{Binding IsRulesViewRead,
                                       Converter={x:Static conv:BoolToBrushConverter.Instance},
                                       ConverterParameter=AccentFgBrush|TextSecondaryBrush}"/>
                  <Button Content="{Binding L_RulesViewEdit}"
                          Command="{Binding SetRulesViewEditCommand}"
                          FontSize="10" FontWeight="SemiBold"
                          Padding="8,3" MinHeight="0"
                          BorderThickness="0"
                          CornerRadius="{StaticResource RadiusXs}"
                          ToolTip.Tip="{Binding L_RulesViewEditTooltip}"
                          Background="{Binding IsRulesViewEdit,
                                       Converter={x:Static conv:BoolToBrushConverter.Instance},
                                       ConverterParameter=SurfaceBaseBrush|Transparent}"
                          Foreground="{Binding IsRulesViewEdit,
                                       Converter={x:Static conv:BoolToBrushConverter.Instance},
                                       ConverterParameter=AccentFgBrush|TextSecondaryBrush}"/>
                </StackPanel>
              </Border>
              <Button Margin="0,0,6,0"
                      Content="{Binding L_CustomRulesImport}"
                      Command="{Binding ImportCustomRulesCommand}"
                      FontSize="10" Padding="8,3" MinHeight="0"
                      ToolTip.Tip="{Binding L_CustomRulesImportTooltip}"/>
              <Button Content="{Binding L_CustomRulesExport}"
                      Command="{Binding ExportCustomRulesCommand}"
                      FontSize="10" Padding="8,3" MinHeight="0"
                      ToolTip.Tip="{Binding L_CustomRulesExportTooltip}"/>
            </WrapPanel>
          </StackPanel>

          <Border IsVisible="{Binding !IsRulesHelpBannerDismissed}"
                  Padding="12,10"
                  CornerRadius="{StaticResource RadiusMd}"
                  Background="{DynamicResource InfoBgBrush}"
                  BorderBrush="{DynamicResource InfoBorderBrush}"
                  BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <TextBlock Grid.Column="0"
                         icons:PictogramText.Icons="info" icons:PictogramText.Text="ⓘ"
                         FontSize="14" FontWeight="Bold"
                         Foreground="{DynamicResource InfoFgBrush}"
                         VerticalAlignment="Top" Margin="0,1,0,0"/>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{Binding L_RulesHelpHeader}"
                           FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource InfoFgBrush}"/>
                <TextBlock FontSize="10"
                           TextWrapping="Wrap" LineHeight="15"
                           Foreground="{DynamicResource InfoFgBrush}">
                  <Run Text="•  "/>
                  <Run Text="{Binding L_RulesHelpB1Pre}"/>
                  <Run Text="{Binding L_RulesHelpB1T1}" FontWeight="SemiBold"/>
                  <Run Text="{Binding L_RulesHelpB1Mid}"/>
                  <Run Text="{Binding L_RulesHelpB1T2}" FontWeight="SemiBold"/>
                  <Run Text="{Binding L_RulesHelpB1Suf}"/>
                </TextBlock>
                <TextBlock FontSize="10"
                           TextWrapping="Wrap" LineHeight="15"
                           Foreground="{DynamicResource InfoFgBrush}">
                  <Run Text="•  "/>
                  <Run Text="{Binding L_RulesHelpB2Pre}"/>
                  <Run Text="10.0.0.0/8"
                       FontFamily="Consolas, 'SF Mono', monospace"
                       FontSize="10"/>
                  <Run Text=", "/>
                  <Run Text="192.168.0.0/16"
                       FontFamily="Consolas, 'SF Mono', monospace"
                       FontSize="10"/>
                  <Run Text=", "/>
                  <Run Text="172.16.0.0/12"
                       FontFamily="Consolas, 'SF Mono', monospace"
                       FontSize="10"/>
                  <Run Text="{Binding L_RulesHelpB2Mid}"/>
                  <Run Text="direct"
                       FontFamily="Consolas, 'SF Mono', monospace"
                       FontSize="10"/>
                  <Run Text="{Binding L_RulesHelpB2Suf}"/>
                </TextBlock>
                <TextBlock FontSize="10"
                           TextWrapping="Wrap" LineHeight="15"
                           Foreground="{DynamicResource InfoFgBrush}">
                  <Run Text="•  "/>
                  <Run Text="{Binding L_RulesHelpB3Pre}"/>
                  <Run Text="{Binding L_RulesHelpB3Bold}" FontWeight="SemiBold"/>
                  <Run Text="{Binding L_RulesHelpB3Suf}"/>
                </TextBlock>
              </StackPanel>
              <Button Grid.Column="2"
                      icons:PictogramText.Icons="close" icons:PictogramText.Content="✕"
                      Command="{Binding DismissRulesHelpBannerCommand}" AutomationProperties.Name="{Binding L_TipDismiss}"
                      FontSize="11"
                      Padding="4,1" MinHeight="0"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{DynamicResource InfoFgBrush}"
                      Opacity="0.6"
                      VerticalAlignment="Top"/>
            </Grid>
          </Border>

          <StackPanel Spacing="10" IsVisible="{Binding IsRulesViewCards}">

          <Border Padding="10,8"
                  CornerRadius="{StaticResource RadiusSm}"
                  Background="{DynamicResource SurfaceSunkenBrush}"
                  BorderBrush="{DynamicResource BorderDefaultBrush}"
                  BorderThickness="1">
            <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
              <CheckBox Grid.Column="0"
                        IsChecked="{Binding CustomRulesAboveToggles}"
                        AutomationProperties.Name="{Binding L_RulesCustomAboveToggles}"
                        MinHeight="0" Padding="0"
                        VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding L_RulesCustomAboveToggles}"
                           FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding L_RulesCustomAboveTogglesHint}"
                           FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border IsVisible="{Binding !IsRulesNarrow}"
                  Padding="14"
                  CornerRadius="{StaticResource RadiusMd}"
                  Background="{DynamicResource SurfaceBaseBrush}"
                  BorderBrush="{DynamicResource BorderDefaultBrush}"
                  BorderThickness="1"
                  ClipToBounds="True">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding L_CustomRulesAddTitle}"
                         FontSize="9" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextMutedBrush}"
                         TextTrimming="CharacterEllipsis"/>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130"/>
                  <ColumnDefinition Width="160"/>
                  <ColumnDefinition Width="*" MinWidth="60"/>
                  <ColumnDefinition Width="*" MinWidth="60"/>
                  <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{Binding L_RulesAddLabelAction}" FontSize="9"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextMutedBrush}"/>
                  <ComboBox ItemsSource="{Binding AvailableRuleActions}"
                            SelectedItem="{Binding NewRuleAction}"
                            HorizontalAlignment="Stretch"
                            FontSize="11" Padding="6,3" MinHeight="0"
                            ToolTip.Tip="{Binding NewRuleActionHint}"/>
                  <TextBlock Text="{Binding NewRuleActionHint}"
                             FontSize="9"
                             FontFamily="Consolas, 'SF Mono', monospace"
                             Foreground="{DynamicResource TextMutedBrush}"
                             MinHeight="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="{Binding L_RulesAddLabelType}" FontSize="9"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextMutedBrush}"/>
                  <ComboBox ItemsSource="{Binding AvailableRuleTypes}"
                            SelectedItem="{Binding NewRuleType}"
                            HorizontalAlignment="Stretch"
                            FontSize="11" Padding="6,3" MinHeight="0"
                            ToolTip.Tip="{Binding NewRuleTypeHint}"/>
                  <TextBlock Text="{Binding NewRuleTypeHint}"
                             FontSize="9"
                             FontFamily="Consolas, 'SF Mono', monospace"
                             Foreground="{DynamicResource TextMutedBrush}"
                             MinHeight="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                  <TextBlock Text="{Binding L_RulesAddLabelValue}" FontSize="9"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextMutedBrush}"/>
                  <TextBox Text="{Binding NewRuleValue}"
                           PlaceholderText="{Binding NewRuleValuePlaceholder}"
                           FontSize="11" Padding="6,3" MinHeight="0"
                           FontFamily="Consolas, 'SF Mono', monospace"
                           BorderBrush="{Binding NewRuleValueBorderColor,
                                         Converter={x:Static conv:BoolToBrushConverter.Instance},
                                         ConverterParameter=DangerBorderBrush|SuccessBorderBrush}"/>
                  <TextBlock icons:PictogramText.Icons="check,error" icons:PictogramText.PrefixOnly="True" icons:PictogramText.Text="{Binding NewRuleValueHint}"
                             FontSize="9"
                             FontFamily="Consolas, 'SF Mono', monospace"
                             MinHeight="11" TextTrimming="CharacterEllipsis"
                             Foreground="{Binding NewRuleValueIsValid,
                                          Converter={x:Static conv:BoolToBrushConverter.Instance},
                                          ConverterParameter=SuccessFgBrush|DangerFgBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="3">
                  <TextBlock FontSize="9" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextMutedBrush}">
                    <Run Text="{Binding L_RulesAddLabelComment}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding L_RulesAddLabelOpt}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         FontWeight="Normal"/>
                  </TextBlock>
                  <TextBox Text="{Binding NewRuleComment}"
                           PlaceholderText="{Binding L_CustomRulesCommentLabel}"
                           FontSize="11" Padding="6,3" MinHeight="0"/>
                  <TextBlock Text=" " FontSize="9" MinHeight="11"/>
                </StackPanel>
                <Button Classes="solid" Grid.Column="4"
                        icons:PictogramText.Icons="add" icons:PictogramText.Content="{Binding L_CustomRulesAddBtn}"
                        Command="{Binding AddCustomRuleFromFormCommand}"
                        FontSize="11" FontWeight="SemiBold"
                        Padding="8,5" MinHeight="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,15,0,0"
                        Background="{DynamicResource AccentSolidBrush}"
                        Foreground="{DynamicResource AccentOnSolidBrush}"
                        CornerRadius="{StaticResource RadiusSm}"
                        BorderThickness="0"/>
              </Grid>
              <TextBlock Text="{Binding NewRuleValidationError}"
                         FontSize="10"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource DangerFgBrush}"
                         IsVisible="{Binding NewRuleValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </Border>

          <Border IsVisible="{Binding IsRulesNarrow}"
                  Padding="12"
                  CornerRadius="{StaticResource RadiusMd}"
                  Background="{DynamicResource SurfaceBaseBrush}"
                  BorderBrush="{DynamicResource BorderDefaultBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="7">
              <TextBlock Text="{Binding L_CustomRulesAddTitle}"
                         FontSize="9" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextMutedBrush}"/>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding AvailableRuleActions}"
                          SelectedItem="{Binding NewRuleAction}"
                          HorizontalAlignment="Stretch"
                          FontSize="11" Padding="6,3" MinHeight="0"
                          ToolTip.Tip="{Binding NewRuleActionHint}"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableRuleTypes}"
                          SelectedItem="{Binding NewRuleType}"
                          HorizontalAlignment="Stretch"
                          FontSize="11" Padding="6,3" MinHeight="0"
                          ToolTip.Tip="{Binding NewRuleTypeHint}"/>
              </Grid>
              <TextBox Text="{Binding NewRuleValue}"
                       PlaceholderText="{Binding NewRuleValuePlaceholder}"
                       FontSize="11" Padding="6,3" MinHeight="0"
                       FontFamily="Consolas, 'SF Mono', monospace"
                       BorderBrush="{Binding NewRuleValueBorderColor,
                                     Converter={x:Static conv:BoolToBrushConverter.Instance},
                                     ConverterParameter=DangerBorderBrush|SuccessBorderBrush}"/>
              <TextBlock icons:PictogramText.Icons="check,error" icons:PictogramText.PrefixOnly="True" icons:PictogramText.Text="{Binding NewRuleValueHint}"
                         FontSize="9"
                         FontFamily="Consolas, 'SF Mono', monospace"
                         MinHeight="11" TextTrimming="CharacterEllipsis"
                         Foreground="{Binding NewRuleValueIsValid,
                                      Converter={x:Static conv:BoolToBrushConverter.Instance},
                                      ConverterParameter=SuccessFgBrush|DangerFgBrush}"/>
              <TextBox Text="{Binding NewRuleComment}"
                       PlaceholderText="{Binding L_CustomRulesCommentLabel}"
                       FontSize="11" Padding="6,3" MinHeight="0"/>
              <Button Classes="solid" icons:PictogramText.Icons="add" icons:PictogramText.Content="{Binding L_CustomRulesAddBtn}"
                      Command="{Binding AddCustomRuleFromFormCommand}"
                      FontSize="11" FontWeight="SemiBold"
                      Padding="14,5" MinHeight="0"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Background="{DynamicResource AccentSolidBrush}"
                      Foreground="{DynamicResource AccentOnSolidBrush}"
                      CornerRadius="{StaticResource RadiusSm}"
                      BorderThickness="0"/>
              <TextBlock Text="{Binding NewRuleValidationError}"
                         FontSize="10"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource DangerFgBrush}"
                         IsVisible="{Binding NewRuleValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,Auto"
                IsVisible="{Binding CustomRulesList.Count}"
                Margin="0,4,0,0">
            <TextBlock Grid.Column="0"
                       Text="{Binding L_CustomRulesExistingHeader}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding CustomRulesCountText}"
                       FontSize="10"
                       Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center"/>
          </Grid>

        <StackPanel IsVisible="{Binding CustomRulesList.Count}" Spacing="6">
          <Grid ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="6"
                IsVisible="{Binding !IsRulesNarrow}">
            <TextBox Grid.Column="0"
                     Text="{Binding CustomRulesSearchText}"
                     PlaceholderText="{Binding L_CustomRulesSearchPlaceholder}"
                     FontSize="11" Padding="6,3" MinHeight="0"/>
            <Border Grid.Column="1"
                    Padding="2"
                    CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource SurfaceSunkenBrush}">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Command="{Binding SetRulesActionFilterCommand}"
                        CommandParameter="all"
                        FontSize="10" FontWeight="SemiBold"
                        Padding="7,3" MinHeight="0"
                        BorderThickness="0"
                        CornerRadius="{StaticResource RadiusXs}"
                        Background="{Binding IsRulesFilterAll,
                                     Converter={x:Static conv:BoolToBrushConverter.Instance},
                                     ConverterParameter=SurfaceBaseBrush|Transparent}"
                        Foreground="{Binding IsRulesFilterAll,
                                     Converter={x:Static conv:BoolToBrushConverter.Instance},
                                     ConverterParameter=AccentFgBrush|TextSecondaryBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <TextBlock Text="{Binding L_RulesFilterAll}"/>
                    <TextBlock Text="{Binding RulesFilterCountAll}"
                               FontFamily="Consolas, 'SF Mono', monospace"
                               FontSize="9"
                               FontWeight="Normal"
                               Opacity="0.6"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Command="{Binding SetRulesActionFilterCommand}"
                        CommandParameter="direct"
                        FontSize="10" FontWeight="SemiBold"
                        Padding="7,3" MinHeight="0"
                        BorderThickness="0"
                        CornerRadius="{StaticResource RadiusXs}"
                        Background="{Binding IsRulesFilterDirect,
                                     Converter={x:Static conv:BoolToBrushConverter.Instance},
                                     ConverterParameter=SurfaceBaseBrush|Transparent}"
                        Foreground="{Binding IsRulesFilterDirect,
                                     Converter={x:Static conv:BoolToBrushConverter.Instance},
                                     ConverterParameter=AccentFgBrush|TextSecondaryBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <TextBlock Text="direct"/>
                    <TextBlock Text="{Binding RulesFilterCountDirect}"
                               FontFamily="Consolas, 'SF Mono', monospace"
                               FontSize="9"
                               FontWeight="Normal"
                               Opacity="0.6"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Command="{Binding SetRulesActionFilterCommand}"
                        CommandParameter="proxy"
                        FontSize="10" FontWeight="SemiBold"
                        Padding="7,3" MinHeight="0"
                        BorderThickness="0"
                        CornerRadius="{StaticResource RadiusXs}"
                        Background="{Binding IsRulesFilterProxy,
                                     Converter={x:Static conv:BoolToBrushConverter.Instance},
                                     ConverterParameter=SurfaceBaseBrush|Transparent}"
                        Foreground="{Binding IsRulesFilterProxy,
                                     Converter={x:Static conv:BoolToBrushConverter.Instance},
                                     ConverterParameter=AccentFgBrush|TextSecondaryBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <TextBlock Text="proxy"/>
                    <TextBlock Text="{Binding RulesFilterCountProxy}"
                               FontFamily="Consolas, 'SF Mono', monospace"
                               FontSize="9"
                               FontWeight="Normal"
                               Opacity="0.6"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Command="{Binding SetRulesActionFilterCommand}"
                        CommandParameter="block"
                        FontSize="10" FontWeight="SemiBold"
                        Padding="7,3" MinHeight="0"
                        BorderThickness="0"
                        CornerRadius="{StaticResource RadiusXs}"
                        Background="{Binding IsRulesFilterBlock,
                                     Converter={x:Static conv:BoolToBrushConverter.Instance},
                                     ConverterParameter=SurfaceBaseBrush|Transparent}"
                        Foreground="{Binding IsRulesFilterBlock,
                                     Converter={x:Static conv:BoolToBrushConverter.Instance},
                                     ConverterParameter=AccentFgBrush|TextSecondaryBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <TextBlock Text="block"/>
                    <TextBlock Text="{Binding RulesFilterCountBlock}"
                               FontFamily="Consolas, 'SF Mono', monospace"
                               FontSize="9"
                               FontWeight="Normal"
                               Opacity="0.6"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
            <Button Grid.Column="2"
                    Name="BulkBtnWide"
                    Width="28" Height="28" Padding="0" MinHeight="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    Background="{DynamicResource SurfaceBaseBrush}"
                    CornerRadius="{StaticResource RadiusSm}"
                    ToolTip.Tip="{Binding L_RulesBulkActions}">
              <TextBlock icons:PictogramText.Icons="more-horizontal" icons:PictogramText.Text="⋯"
                         FontSize="16"
                         FontWeight="Bold"
                         LineHeight="16"
                         TextAlignment="Center"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight"
                        FlyoutPresenterClasses="bulk-pop-host">
                  <Border Background="{DynamicResource SurfaceBaseBrush}"
                          BorderBrush="{DynamicResource BorderDefaultBrush}"
                          BorderThickness="1"
                          CornerRadius="{StaticResource RadiusMd}"
                          BoxShadow="{StaticResource ShadowLg}"
                          Padding="6"
                          MinWidth="200">
                    <StackPanel Spacing="1">
                      <Button Classes="bulk-it"
                              Command="{Binding EnableAllCustomRulesCommand}"
                              Click="OnBulkItemClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock icons:PictogramText.Icons="add-circle" icons:PictogramText.Text="⊕" Width="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding L_CustomRulesEnableAll}"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                      <Button Classes="bulk-it"
                              Command="{Binding DisableAllCustomRulesCommand}"
                              Click="OnBulkItemClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock icons:PictogramText.Icons="remove-circle" icons:PictogramText.Text="⊝" Width="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding L_CustomRulesDisableAll}"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                      <Button Classes="bulk-it"
                              Command="{Binding SortCustomRulesByTypeCommand}"
                              Click="OnBulkItemClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock icons:PictogramText.Icons="sort" icons:PictogramText.Text="↕" Width="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding L_RulesSortByType}"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                      <Border Height="1"
                              Background="{DynamicResource BorderSubtleBrush}"
                              Margin="2,4"/>
                      <Button Classes="bulk-it danger"
                              Command="{Binding ClearAllCustomRulesCommand}"
                              Click="OnBulkItemClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock icons:PictogramText.Icons="delete" icons:PictogramText.Text="✕" Width="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding L_CustomRulesClearAll}"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Border>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>

          <StackPanel IsVisible="{Binding IsRulesNarrow}" Spacing="6">
            <TextBox Text="{Binding CustomRulesSearchText}"
                     PlaceholderText="{Binding L_CustomRulesSearchPlaceholder}"
                     FontSize="11" Padding="6,3" MinHeight="0"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <Border Grid.Column="0"
                      Padding="2"
                      CornerRadius="{StaticResource RadiusSm}"
                      Background="{DynamicResource SurfaceSunkenBrush}">
                <UniformGrid Columns="4" Rows="1">
                  <Button Command="{Binding SetRulesActionFilterCommand}"
                          CommandParameter="all"
                          FontSize="10" FontWeight="SemiBold"
                          Padding="4,3" MinHeight="0"
                          BorderThickness="0"
                          CornerRadius="{StaticResource RadiusXs}"
                          HorizontalContentAlignment="Center"
                          Background="{Binding IsRulesFilterAll,
                                       Converter={x:Static conv:BoolToBrushConverter.Instance},
                                       ConverterParameter=SurfaceBaseBrush|Transparent}"
                          Foreground="{Binding IsRulesFilterAll,
                                       Converter={x:Static conv:BoolToBrushConverter.Instance},
                                       ConverterParameter=AccentFgBrush|TextSecondaryBrush}"
                          Content="{Binding L_RulesFilterAll}"/>
                  <Button Command="{Binding SetRulesActionFilterCommand}"
                          CommandParameter="direct"
                          FontSize="10" FontWeight="SemiBold"
                          Padding="4,3" MinHeight="0"
                          BorderThickness="0"
                          CornerRadius="{StaticResource RadiusXs}"
                          HorizontalContentAlignment="Center"
                          Background="{Binding IsRulesFilterDirect,
                                       Converter={x:Static conv:BoolToBrushConverter.Instance},
                                       ConverterParameter=SurfaceBaseBrush|Transparent}"
                          Foreground="{Binding IsRulesFilterDirect,
                                       Converter={x:Static conv:BoolToBrushConverter.Instance},
                                       ConverterParameter=AccentFgBrush|TextSecondaryBrush}"
                          Content="direct"/>
                  <Button Command="{Binding SetRulesActionFilterCommand}"
                          CommandParameter="proxy"
                          FontSize="10" FontWeight="SemiBold"
                          Padding="4,3" MinHeight="0"
                          BorderThickness="0"
                          CornerRadius="{StaticResource RadiusXs}"
                          HorizontalContentAlignment="Center"
                          Background="{Binding IsRulesFilterProxy,
                                       Converter={x:Static conv:BoolToBrushConverter.Instance},
                                       ConverterParameter=SurfaceBaseBrush|Transparent}"
                          Foreground="{Binding IsRulesFilterProxy,
                                       Converter={x:Static conv:BoolToBrushConverter.Instance},
                                       ConverterParameter=AccentFgBrush|TextSecondaryBrush}"
                          Content="proxy"/>
                  <Button Command="{Binding SetRulesActionFilterCommand}"
                          CommandParameter="block"
                          FontSize="10" FontWeight="SemiBold"
                          Padding="4,3" MinHeight="0"
                          BorderThickness="0"
                          CornerRadius="{StaticResource RadiusXs}"
                          HorizontalContentAlignment="Center"
                          Background="{Binding IsRulesFilterBlock,
                                       Converter={x:Static conv:BoolToBrushConverter.Instance},
                                       ConverterParameter=SurfaceBaseBrush|Transparent}"
                          Foreground="{Binding IsRulesFilterBlock,
                                       Converter={x:Static conv:BoolToBrushConverter.Instance},
                                       ConverterParameter=AccentFgBrush|TextSecondaryBrush}"
                          Content="block"/>
                </UniformGrid>
              </Border>
              <Button Grid.Column="1"
                      Name="BulkBtnNarrow"
                      Width="28" Height="28" Padding="0" MinHeight="0"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource BorderDefaultBrush}"
                      Background="{DynamicResource SurfaceBaseBrush}"
                      CornerRadius="{StaticResource RadiusSm}"
                      ToolTip.Tip="{Binding L_RulesBulkActions}">
                <TextBlock icons:PictogramText.Icons="more-horizontal" icons:PictogramText.Text="⋯"
                           FontSize="16"
                           FontWeight="Bold"
                           LineHeight="16"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight"
                          FlyoutPresenterClasses="bulk-pop-host">
                    <Border Background="{DynamicResource SurfaceBaseBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            BoxShadow="{StaticResource ShadowLg}"
                            Padding="6"
                            MinWidth="200">
                      <StackPanel Spacing="1">
                        <Button Classes="bulk-it"
                                Command="{Binding EnableAllCustomRulesCommand}"
                                Click="OnBulkItemClick">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock icons:PictogramText.Icons="add-circle" icons:PictogramText.Text="⊕" Width="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding L_CustomRulesEnableAll}"
                                       VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                        <Button Classes="bulk-it"
                                Command="{Binding DisableAllCustomRulesCommand}"
                                Click="OnBulkItemClick">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock icons:PictogramText.Icons="remove-circle" icons:PictogramText.Text="⊝" Width="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding L_CustomRulesDisableAll}"
                                       VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                        <Button Classes="bulk-it"
                                Command="{Binding SortCustomRulesByTypeCommand}"
                                Click="OnBulkItemClick">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock icons:PictogramText.Icons="sort" icons:PictogramText.Text="↕" Width="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding L_RulesSortByType}"
                                       VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                        <Border Height="1"
                                Background="{DynamicResource BorderSubtleBrush}"
                                Margin="2,4"/>
                        <Button Classes="bulk-it danger"
                                Command="{Binding ClearAllCustomRulesCommand}"
                                Click="OnBulkItemClick">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock icons:PictogramText.Icons="delete" icons:PictogramText.Text="✕" Width="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding L_CustomRulesClearAll}"
                                       VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Border>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Grid>
          </StackPanel>
        </StackPanel>

          <Border IsVisible="{Binding ClearAllConfirmPending}"
                  Padding="10,8"
                  CornerRadius="{StaticResource RadiusSm}"
                  Background="{DynamicResource DangerBgBrush}"
                  BorderBrush="{DynamicResource DangerBorderBrush}"
                  BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding ClearAllConfirmText}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource DangerFgBrush}"/>
                <TextBlock Text="{Binding L_RulesClearAllHint}"
                           FontSize="10"
                           Foreground="{DynamicResource DangerFgBrush}"
                           Opacity="0.85"
                           TextWrapping="Wrap"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Content="{Binding L_Cancel}"
                      Command="{Binding CancelClearAllCustomRulesCommand}"
                      FontSize="10" Padding="10,4" MinHeight="0"
                      Background="Transparent"
                      BorderBrush="{DynamicResource DangerBorderBrush}"
                      BorderThickness="1"
                      Foreground="{DynamicResource DangerFgBrush}"
                      CornerRadius="{StaticResource RadiusXs}"/>
              <Button Classes="solid" Grid.Column="2"
                      Content="{Binding L_RulesClearAllConfirm}"
                      Command="{Binding ConfirmClearAllCustomRulesCommand}"
                      FontSize="10" FontWeight="SemiBold"
                      Padding="10,4" MinHeight="0"
                      Background="{DynamicResource DangerSolidBrush}"
                      Foreground="White"
                      BorderThickness="0"
                      CornerRadius="{StaticResource RadiusXs}"/>
            </Grid>
          </Border>

        <StackPanel IsVisible="{Binding CustomRulesList.Count}" Spacing="0">
          <ListBox ItemsSource="{Binding FilteredCustomRulesList}"
                   IsVisible="{Binding !IsRulesNarrow}"
                   MaxHeight="360"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0,0,0,4"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerTheme>
              <ControlTheme TargetType="ListBoxItem"
                            BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Margin" Value="0"/>
              </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CustomRuleViewModel">
                <Border Classes="rule-card"
                        Opacity="{Binding RowOpacity}">
                  <Grid ColumnDefinitions="74,110,*,Auto,Auto,Auto"
                        ColumnSpacing="12" VerticalAlignment="Center">
                    <Border Grid.Column="0"
                            CornerRadius="10"
                            Padding="10,2"
                            MinWidth="58"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Background="{Binding Action,
                                         Converter={x:Static conv:ActionToTokenBrushConverter.Instance},
                                         ConverterParameter=Bg}"
                            BorderBrush="{Binding Action,
                                         Converter={x:Static conv:ActionToTokenBrushConverter.Instance},
                                         ConverterParameter=Border}">
                      <TextBlock Text="{Binding Action}"
                                 FontSize="10"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center"
                                 Foreground="{Binding Action,
                                              Converter={x:Static conv:ActionToTokenBrushConverter.Instance},
                                              ConverterParameter=Fg}"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Type}"
                               FontSize="10"
                               FontFamily="Consolas, 'SF Mono', monospace"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding Value}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               FontFamily="Consolas, 'SF Mono', monospace"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               ToolTip.Tip="{Binding Comment}"/>
                    <TextBlock Grid.Column="3"
                               Text="{Binding Comment}"
                               FontSize="10"
                               FontStyle="Italic"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="200"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding Comment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <CheckBox Grid.Column="4"
                              Theme="{StaticResource IosToggleCheckBox}"
                              IsChecked="{Binding Enabled}"
                              AutomationProperties.Name="{Binding Value}"
                              VerticalAlignment="Center"/>
                    <Button Grid.Column="5"
                            Width="24" Height="24"
                            Padding="0" MinHeight="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_RulesBulkActions}">
                      <TextBlock icons:PictogramText.Icons="more-horizontal" icons:PictogramText.Text="⋯"
                                 FontSize="14"
                                 FontWeight="Bold"
                                 LineHeight="14"
                                 TextAlignment="Center"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextMutedBrush}"/>
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_CustomRulesDelete}"
                                    Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).LblRemove}"
                                    Foreground="{DynamicResource DangerFgBrush}"/>
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <ListBox ItemsSource="{Binding FilteredCustomRulesList}"
                   IsVisible="{Binding IsRulesNarrow}"
                   MaxHeight="360"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0,0,0,4"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerTheme>
              <ControlTheme TargetType="ListBoxItem"
                            BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Margin" Value="0"/>
              </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CustomRuleViewModel">
                <Border Classes="rule-card"
                        Opacity="{Binding RowOpacity}">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                        RowDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="10" RowSpacing="3">
                    <Border Grid.Row="0" Grid.Column="0"
                            CornerRadius="10"
                            Padding="10,2"
                            MinWidth="58"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Background="{Binding Action,
                                         Converter={x:Static conv:ActionToTokenBrushConverter.Instance},
                                         ConverterParameter=Bg}"
                            BorderBrush="{Binding Action,
                                         Converter={x:Static conv:ActionToTokenBrushConverter.Instance},
                                         ConverterParameter=Border}">
                      <TextBlock Text="{Binding Action}"
                                 FontSize="10"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center"
                                 Foreground="{Binding Action,
                                              Converter={x:Static conv:ActionToTokenBrushConverter.Instance},
                                              ConverterParameter=Fg}"/>
                    </Border>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding Type}"
                               FontSize="10"
                               FontFamily="Consolas, 'SF Mono', monospace"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <CheckBox Grid.Row="0" Grid.Column="2"
                              Theme="{StaticResource IosToggleCheckBox}"
                              IsChecked="{Binding Enabled}"
                              AutomationProperties.Name="{Binding Value}"
                              VerticalAlignment="Center"/>
                    <Button Grid.Row="0" Grid.Column="3"
                            Width="24" Height="24"
                            Padding="0" MinHeight="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_RulesBulkActions}">
                      <TextBlock icons:PictogramText.Icons="more-horizontal" icons:PictogramText.Text="⋯"
                                 FontSize="14"
                                 FontWeight="Bold"
                                 LineHeight="14"
                                 TextAlignment="Center"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextMutedBrush}"/>
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_CustomRulesDelete}"
                                    Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).LblRemove}"
                                    Foreground="{DynamicResource DangerFgBrush}"/>
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                               Text="{Binding Value}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               FontFamily="Consolas, 'SF Mono', monospace"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Comment}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                               Text="{Binding Comment}"
                               FontSize="10"
                               FontStyle="Italic"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextMutedBrush}"
                               IsVisible="{Binding Comment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>

          <TextBlock Text="{Binding L_CustomRulesEmpty}"
                     FontSize="11"
                     FontStyle="Italic"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}"
                     IsVisible="{Binding !CustomRulesList.Count}"/>

          </StackPanel>

          <StackPanel Spacing="4" IsVisible="{Binding IsRulesViewRead}">
            <Border Padding="0,8"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource SurfaceAppBrush}">
              <StackPanel Spacing="2">
                <StackPanel IsVisible="{Binding ReadModeDirectRules.Count}" Spacing="0">
                  <TextBlock Text="{Binding ReadModeDirectHeader}"
                             FontSize="9"
                             FontFamily="Consolas, 'SF Mono', monospace"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextMutedBrush}"
                             Padding="14,6,14,4"/>
                  <ItemsControl ItemsSource="{Binding ReadModeDirectRules}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CustomRuleViewModel">
                        <StackPanel Spacing="0">
                        <Grid ColumnDefinitions="20,70,140,*,Auto"
                              ColumnSpacing="10"
                              Margin="14,1"
                              Opacity="{Binding RowOpacity}"
                              IsVisible="{Binding !$parent[UserControl].((vm:MainWindowViewModel)DataContext).IsRulesNarrow}">
                          <TextBlock Grid.Column="0"
                                     icons:PictogramText.Icons="status" icons:PictogramText.Text="●"
                                     FontFamily="Consolas, 'SF Mono', monospace"
                                     FontSize="11"
                                     Foreground="{DynamicResource SuccessFgBrush}"
                                     VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding Action}"
                                     FontFamily="Consolas, 'SF Mono', monospace"
                                     FontSize="11"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="2"
                                     Text="{Binding Type}"
                                     FontFamily="Consolas, 'SF Mono', monospace"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="3"
                                     Text="{Binding Value}"
                                     FontFamily="Consolas, 'SF Mono', monospace"
                                     FontSize="11"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center"
                                     ToolTip.Tip="{Binding Comment}"/>
                          <Button Grid.Column="4"
                                  icons:PictogramText.Icons="delete" icons:PictogramText.Content="✕"
                                  Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).LblRemove}"
                                  FontSize="11"
                                  Padding="6,0" MinHeight="0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="{DynamicResource TextMutedBrush}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="14,1" Opacity="{Binding RowOpacity}"
                              IsVisible="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).IsRulesNarrow}">
                          <StackPanel Grid.Column="0" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock icons:PictogramText.Icons="status" icons:PictogramText.Text="●" FontFamily="Consolas, 'SF Mono', monospace" FontSize="11"
                                         Foreground="{DynamicResource SuccessFgBrush}" VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding Action}" FontFamily="Consolas, 'SF Mono', monospace" FontSize="11"
                                         FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding Type}" FontFamily="Consolas, 'SF Mono', monospace" FontSize="11"
                                         Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Value}" FontFamily="Consolas, 'SF Mono', monospace" FontSize="11" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Comment}"/>
                          </StackPanel>
                          <Button Grid.Column="1" icons:PictogramText.Icons="delete" icons:PictogramText.Content="✕" Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).LblRemove}" FontSize="11" Padding="6,0" MinHeight="0"
                                  Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <StackPanel IsVisible="{Binding ReadModeProxyRules.Count}" Spacing="0">
                  <TextBlock Text="{Binding ReadModeProxyHeader}"
                             FontSize="9"
                             FontFamily="Consolas, 'SF Mono', monospace"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextMutedBrush}"
                             Padding="14,8,14,4"/>
                  <ItemsControl ItemsSource="{Binding ReadModeProxyRules}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CustomRuleViewModel">
                        <StackPanel Spacing="0">
                        <Grid ColumnDefinitions="20,70,140,*,Auto"
                              ColumnSpacing="10"
                              Margin="14,1"
                              Opacity="{Binding RowOpacity}"
                              IsVisible="{Binding !$parent[UserControl].((vm:MainWindowViewModel)DataContext).IsRulesNarrow}">
                          <TextBlock Grid.Column="0" icons:PictogramText.Icons="status" icons:PictogramText.Text="●"
                                     FontFamily="Consolas, 'SF Mono', monospace"
                                     FontSize="11"
                                     Foreground="{DynamicResource SuccessFgBrush}"
                                     VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{Binding Action}"
                                     FontFamily="Consolas, 'SF Mono', monospace"
                                     FontSize="11" FontWeight="Bold"
                                     Foreground="{DynamicResource AccentFgBrush}"
                                     VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="2" Text="{Binding Type}"
                                     FontFamily="Consolas, 'SF Mono', monospace"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="3" Text="{Binding Value}"
                                     FontFamily="Consolas, 'SF Mono', monospace"
                                     FontSize="11" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center"
                                     ToolTip.Tip="{Binding Comment}"/>
                          <Button Grid.Column="4" icons:PictogramText.Icons="delete" icons:PictogramText.Content="✕"
                                  Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).LblRemove}"
                                  FontSize="11" Padding="6,0" MinHeight="0"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{DynamicResource TextMutedBrush}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="14,1" Opacity="{Binding RowOpacity}"
                              IsVisible="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).IsRulesNarrow}">
                          <StackPanel Grid.Column="0" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock icons:PictogramText.Icons="status" icons:PictogramText.Text="●" FontFamily="Consolas, 'SF Mono', monospace" FontSize="11"
                                         Foreground="{DynamicResource SuccessFgBrush}" VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding Action}" FontFamily="Consolas, 'SF Mono', monospace" FontSize="11"
                                         FontWeight="Bold" Foreground="{DynamicResource AccentFgBrush}" VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding Type}" FontFamily="Consolas, 'SF Mono', monospace" FontSize="11"
                                         Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Value}" FontFamily="Consolas, 'SF Mono', monospace" FontSize="11" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Comment}"/>
                          </StackPanel>
                          <Button Grid.Column="1" icons:PictogramText.Icons="delete" icons:PictogramText.Content="✕" Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).LblRemove}" FontSize="11" Padding="6,0" MinHeight="0"
                                  Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <StackPanel IsVisible="{Binding ReadModeBlockRules.Count}" Spacing="0">
                  <TextBlock Text="{Binding ReadModeBlockHeader}"
                             FontSize="9"
                             FontFamily="Consolas, 'SF Mono', monospace"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextMutedBrush}"
                             Padding="14,8,14,4"/>
                  <ItemsControl ItemsSource="{Binding ReadModeBlockRules}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CustomRuleViewModel">
                        <StackPanel Spacing="0">
                        <Grid ColumnDefinitions="20,70,140,*,Auto"
                              ColumnSpacing="10"
                              Margin="14,1"
                              Opacity="{Binding RowOpacity}"
                              IsVisible="{Binding !$parent[UserControl].((vm:MainWindowViewModel)DataContext).IsRulesNarrow}">
                          <TextBlock Grid.Column="0" icons:PictogramText.Icons="status" icons:PictogramText.Text="●"
                                     FontFamily="Consolas, 'SF Mono', monospace"
                                     FontSize="11"
                                     Foreground="{DynamicResource SuccessFgBrush}"
                                     VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{Binding Action}"
                                     FontFamily="Consolas, 'SF Mono', monospace"
                                     FontSize="11" FontWeight="Bold"
                                     Foreground="{DynamicResource DangerFgBrush}"
                                     VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="2" Text="{Binding Type}"
                                     FontFamily="Consolas, 'SF Mono', monospace"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="3" Text="{Binding Value}"
                                     FontFamily="Consolas, 'SF Mono', monospace"
                                     FontSize="11" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center"
                                     ToolTip.Tip="{Binding Comment}"/>
                          <Button Grid.Column="4" icons:PictogramText.Icons="delete" icons:PictogramText.Content="✕"
                                  Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).LblRemove}"
                                  FontSize="11" Padding="6,0" MinHeight="0"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{DynamicResource TextMutedBrush}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="14,1" Opacity="{Binding RowOpacity}"
                              IsVisible="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).IsRulesNarrow}">
                          <StackPanel Grid.Column="0" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock icons:PictogramText.Icons="status" icons:PictogramText.Text="●" FontFamily="Consolas, 'SF Mono', monospace" FontSize="11"
                                         Foreground="{DynamicResource SuccessFgBrush}" VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding Action}" FontFamily="Consolas, 'SF Mono', monospace" FontSize="11"
                                         FontWeight="Bold" Foreground="{DynamicResource DangerFgBrush}" VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding Type}" FontFamily="Consolas, 'SF Mono', monospace" FontSize="11"
                                         Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Value}" FontFamily="Consolas, 'SF Mono', monospace" FontSize="11" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Comment}"/>
                          </StackPanel>
                          <Button Grid.Column="1" icons:PictogramText.Icons="delete" icons:PictogramText.Content="✕" Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).LblRemove}" FontSize="11" Padding="6,0" MinHeight="0"
                                  Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <TextBlock Text="{Binding L_CustomRulesEmpty}"
                           FontSize="11" FontStyle="Italic"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Padding="14,8"
                           IsVisible="{Binding !CustomRulesList.Count}"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding IsRulesViewEdit}">

            <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource SurfaceAppBrush}"
                    ClipToBounds="True">
              <Grid ColumnDefinitions="Auto,*"
                    MinHeight="160"
                    MaxHeight="280">
                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceSunkenBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="10,8,8,8"
                        IsHitTestVisible="False">
                  <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                HorizontalScrollBarVisibility="Hidden">
                    <TextBlock Text="{Binding RulesEditorLineNumbers}"
                               FontFamily="Consolas, 'SF Mono', 'Cascadia Code', 'Ubuntu Mono', monospace"
                               FontSize="11"
                               LineHeight="18"
                               TextAlignment="Right"
                               Foreground="{DynamicResource TextMutedBrush}"
                               MinWidth="22"/>
                  </ScrollViewer>
                </Border>
                <TextBox Grid.Column="1"
                         Text="{Binding EditedCustomRulesText}"
                         PlaceholderText="{Binding L_CustomRulesPlaceholder}"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas, 'SF Mono', 'Cascadia Code', 'Ubuntu Mono', monospace"
                         FontSize="11"
                         LineHeight="18"
                         Padding="10,8,12,8"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
              <TextBlock Grid.Column="0"
                         Text="{Binding RulesEditorStatusText}"
                         FontSize="10"
                         FontFamily="Consolas, 'SF Mono', monospace"
                         Foreground="{DynamicResource TextMutedBrush}"
                         VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1"
                         icons:PictogramText.Icons="status" icons:PictogramText.Text="{Binding L_RulesEditorDirty}"
                         FontSize="10"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource WarningFgBrush}"
                         IsVisible="{Binding RulesEditorIsDirty}"
                         VerticalAlignment="Center"
                         Margin="0,0,4,0"/>
              <Button Grid.Column="2"
                      Content="{Binding L_RulesEditorRevert}"
                      Command="{Binding RevertEditedRulesCommand}"
                      FontSize="10" Padding="8,3" MinHeight="0"
                      IsEnabled="{Binding RulesEditorIsDirty}"/>
              <Button Classes="solid" Grid.Column="3"
                      Content="{Binding RulesEditorApplyText}"
                      Command="{Binding ApplyEditedRulesCommand}"
                      FontSize="10" FontWeight="SemiBold"
                      Padding="10,3" MinHeight="0"
                      Background="{DynamicResource AccentSolidBrush}"
                      Foreground="{DynamicResource AccentOnSolidBrush}"
                      CornerRadius="{StaticResource RadiusSm}"
                      IsEnabled="{Binding RulesEditorIsDirty}"/>
            </Grid>

            <Border IsVisible="{Binding RulesEditorErrorListText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Padding="8,6"
                    CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource DangerBgBrush}"
                    BorderBrush="{DynamicResource DangerBorderBrush}"
                    BorderThickness="1">
              <TextBlock Text="{Binding RulesEditorErrorListText}"
                         FontSize="10"
                         FontFamily="Consolas, 'SF Mono', monospace"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource DangerFgBrush}"/>
            </Border>

            <Border IsVisible="{Binding CustomRulesConflictText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Padding="8,5"
                    CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource WarningBgBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="1">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding L_CustomRulesConflictHeader}"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource WarningFgBrush}"/>
                <TextBlock Text="{Binding CustomRulesConflictText}"
                           FontSize="10"
                           FontFamily="Consolas, 'SF Mono', monospace"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WarningFgBrush}"/>
              </StackPanel>
            </Border>

            <Border Padding="10,7"
                    CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource SurfaceSunkenBrush}">
              <TextBlock Text="{Binding L_RulesEditorFormatHint}"
                         FontSize="10"
                         FontFamily="Consolas, 'SF Mono', monospace"
                         TextWrapping="Wrap"
                         LineHeight="16"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding IsSettingsLeakSelected}">
          <TextBlock Text="{Binding LblSettingsLeak}" FontWeight="Bold" FontSize="13"/>

          <Border Padding="8,6" CornerRadius="{StaticResource RadiusSm}"
                  Background="{DynamicResource SurfaceSunkenBrush}"
                  BorderBrush="{DynamicResource BorderDefaultBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="24,*" ColumnSpacing="6"
                    ToolTip.Tip="{Binding L_TipLeakStrictMode}">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding StrictMode}"
                          AutomationProperties.Name="{Binding StrictModeLabel}"
                          MinHeight="0" Padding="0"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding StrictModeLabel}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
              </Grid>
              <Grid ColumnDefinitions="24,*" ColumnSpacing="6"
                    ToolTip.Tip="{Binding L_TipLeakForceIpv4}">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding ForceIpv4Only}"
                          AutomationProperties.Name="{Binding ForceIpv4Label}"
                          MinHeight="0" Padding="0"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding ForceIpv4Label}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
              </Grid>
              <Grid ColumnDefinitions="24,*" ColumnSpacing="6"
                    ToolTip.Tip="{Binding L_TipLeakFlushDns}">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding FlushDnsOnStart}"
                          AutomationProperties.Name="{Binding FlushDnsLabel}"
                          MinHeight="0" Padding="0"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding FlushDnsLabel}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
              </Grid>
              <Grid ColumnDefinitions="24,*" ColumnSpacing="6"
                    ToolTip.Tip="{Binding L_TipLeakStrictDns}">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding StrictDns}"
                          AutomationProperties.Name="{Binding StrictDnsLabel}"
                          MinHeight="0" Padding="0"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding StrictDnsLabel}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
              </Grid>
              <Grid ColumnDefinitions="24,*" ColumnSpacing="6"
                    ToolTip.Tip="{Binding L_TipDnsLeakLockdown}">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsDnsLeakLockdownEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding IsDnsLeakLockdownAvailable}"
                          AutomationProperties.Name="{Binding DnsLeakLockdownLabel}"
                          MinHeight="0" Padding="0"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding DnsLeakLockdownLabel}"
                           TextWrapping="Wrap"
                           IsEnabled="{Binding IsDnsLeakLockdownAvailable}"
                           VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Text="{Binding L_DnsLeakLockdownUnavailableNote}"
                         IsVisible="{Binding !IsDnsLeakLockdownAvailable}"
                         Foreground="{DynamicResource WarningFgBrush}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Margin="30,-2,0,0"/>
            </StackPanel>
          </Border>

          <Border Padding="8,6" CornerRadius="{StaticResource RadiusSm}"
                  Background="{DynamicResource SurfaceSunkenBrush}"
                  BorderBrush="{DynamicResource BorderDefaultBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="4" ToolTip.Tip="{Binding MtuHint}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           Text="{Binding MtuLabel}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         Text="{Binding TunMtu}"
                         Width="90"
                         VerticalAlignment="Center"
                         HorizontalContentAlignment="Right"
                         AutomationProperties.Name="{Binding MtuLabel}"/>
              </Grid>
              <Button Content="{Binding MtuAutoTuneButton}"
                      Command="{Binding AutoTuneMtuCommand}"
                      IsEnabled="{Binding !IsMtuAutoTuneRunning}"
                      Padding="10,5"
                      HorizontalAlignment="Right"/>
              <TextBlock Text="{Binding TunMtuWarning}"
                         IsVisible="{Binding TunMtuWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         Foreground="{DynamicResource WarningFgBrush}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Margin="0,2,0,0"/>
              <TextBlock Text="{Binding MtuAutoTuneStatus}"
                         IsVisible="{Binding MtuAutoTuneStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Margin="0,2,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding IsSettingsContentSelected}">
          <TextBlock Text="{Binding LblSettingsContent}" FontWeight="Bold" FontSize="13"/>

          <Border Classes="checkbox-card" Classes.active="{Binding BlockAds}">
            <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
              <CheckBox Grid.Column="0"
                        IsChecked="{Binding BlockAds}"
                        AutomationProperties.Name="{Binding BlockAdsLabel}"
                        VerticalAlignment="Top"
                        MinWidth="0" MinHeight="0" Padding="0"
                        Margin="0,1,0,0"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="card-title" Text="{Binding BlockAdsLabel}"/>
                <TextBlock Classes="card-sub" Text="{Binding BlockAdsHint}"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding IsSettingsUpdatesSelected}">
          <TextBlock Text="{Binding LblSettingsUpdates}" FontWeight="Bold" FontSize="13"/>

          <Border Padding="8,6" CornerRadius="{StaticResource RadiusSm}"
                  Background="{DynamicResource SurfaceSunkenBrush}"
                  BorderBrush="{DynamicResource BorderDefaultBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="3">
              <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="{Binding UpdateChannelHeader}" FontWeight="SemiBold"
                         TextWrapping="Wrap"/>
              <CheckBox IsChecked="{Binding ReceivePrereleases}"
                        AutomationProperties.Name="{Binding ReceivePrereleasesLabel}"
                        MinHeight="0" Padding="4,0">
                <TextBlock Text="{Binding ReceivePrereleasesLabel}" TextWrapping="Wrap"/>
              </CheckBox>
            </StackPanel>
          </Border>

          <Border Padding="8,6" CornerRadius="{StaticResource RadiusSm}"
                  Background="{DynamicResource SurfaceSunkenBrush}"
                  BorderBrush="{DynamicResource BorderDefaultBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="6">
              <StackPanel Spacing="2">
                <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="{Binding L_CurrentVersion}"
                           FontSize="10" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding AppVersionShortText}"
                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
              </StackPanel>
              <Button Content="{Binding UpdateVm.CheckLinkText}"
                      Command="{Binding UpdateVm.CheckManuallyCommand}"
                      FontSize="10" Padding="10,5" MinHeight="0"
                      CornerRadius="{StaticResource RadiusSm}"
                      HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>

          <Button Command="{Binding UpdateVm.ToggleVersionHistoryCommand}"
                  IsEnabled="{Binding !UpdateVm.IsDownloading}"
                  HorizontalAlignment="Left"
                  FontSize="10" Padding="10,5" MinHeight="0"
                  CornerRadius="{StaticResource RadiusSm}"
                  AutomationProperties.AutomationId="UpdateVersionHistoryButton">
            <TextBlock Text="{Binding UpdateVm.VersionHistoryButtonText}"
                       TextWrapping="Wrap"/>
          </Button>

          <Border IsVisible="{Binding UpdateVm.IsVersionHistoryVisible}"
                  Padding="8" CornerRadius="{StaticResource RadiusSm}"
                  Background="{DynamicResource SurfaceSunkenBrush}"
                  BorderBrush="{DynamicResource BorderDefaultBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="7">
              <TextBlock Text="{Binding UpdateVm.VersionHistoryMessage}"
                         Classes="card-sub" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding UpdateVm.StableVersions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RollbackReleaseItemViewModel">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                      <TextBlock Grid.Column="0" Text="{Binding Version, StringFormat=v{0}}"
                                 VerticalAlignment="Center" FontWeight="SemiBold"/>
                      <Button Grid.Column="1"
                              Command="{Binding SelectCommand}"
                              IsEnabled="{Binding !IsInstalled}"
                              FontSize="10" Padding="10,4" MinHeight="0"
                              CornerRadius="{StaticResource RadiusSm}">
                        <TextBlock Text="{Binding StateText}" TextWrapping="Wrap"/>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border IsVisible="{Binding UpdateVm.IsRollbackConfirmationVisible}"
                      Padding="8" CornerRadius="{StaticResource RadiusSm}"
                      Background="{DynamicResource WarningBgBrush}"
                      BorderBrush="{DynamicResource WarningBorderBrush}"
                      BorderThickness="1">
                <StackPanel Spacing="7">
                  <TextBlock Text="{Binding UpdateVm.RollbackConfirmationText}"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource WarningFgBrush}"/>
                  <StackPanel Spacing="6">
                    <Button Classes="solid" Command="{Binding UpdateVm.ConfirmRollbackCommand}"
                            Background="{DynamicResource WarningSolidBrush}"
                            Foreground="White"
                            HorizontalAlignment="Stretch"
                            FontSize="10" Padding="10,5" MinHeight="0"
                            AutomationProperties.AutomationId="ConfirmVersionRollbackButton">
                      <TextBlock Text="{Binding UpdateVm.ConfirmRollbackText}"
                                 TextWrapping="Wrap" TextAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding UpdateVm.CancelRollbackCommand}"
                            HorizontalAlignment="Stretch"
                            FontSize="10" Padding="10,5" MinHeight="0">
                      <TextBlock Text="{Binding UpdateVm.CancelRollbackText}"
                                 TextWrapping="Wrap" TextAlignment="Center"/>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}"
                  Padding="0,10,0,0" Margin="0,2,0,0">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding L_DiagSupportHeader}" FontWeight="SemiBold" FontSize="12"/>
              <TextBlock Text="{Binding L_DiagExportHint}" Classes="card-sub"
                         TextWrapping="Wrap" Opacity="0.8"/>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{Binding L_DiagExportButton}"
                        Command="{Binding ExportDiagnosticsCommand}"
                        IsEnabled="{Binding !IsExportingDiagnostics}"
                        FontSize="11" Padding="12,6" MinHeight="0"
                        CornerRadius="{StaticResource RadiusSm}"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                        AutomationProperties.Name="{Binding L_DiagExportButton}"/>
                <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="{Binding L_DiagExporting}"
                           IsVisible="{Binding IsExportingDiagnostics}"
                           VerticalAlignment="Center" FontSize="11"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="14" IsVisible="{Binding IsSettingsAutostartSelected}">
          <TextBlock Text="{Binding LblAutostartSection}" FontWeight="Bold" FontSize="13"/>

          <StackPanel Spacing="8" IsVisible="{Binding IsWindowsPlatform}">
            <TextBlock Text="{Binding L_AutostartBootSectionTitle}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <TextBlock Text="{Binding L_AutostartBootSectionSub}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Opacity="0.85"/>

            <Border Classes="checkbox-card"
                    Classes.active="{Binding ServiceVm.AutostartChecked}">
              <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding ServiceVm.AutostartChecked}"
                          IsEnabled="{Binding !ServiceVm.IsBusy}"
                          AutomationProperties.Name="{Binding L_ServiceMasterTitle}"
                          VerticalAlignment="Top"
                          MinWidth="0" MinHeight="0" Padding="0"
                          Margin="0,1,0,0"/>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Classes="card-title"
                             Text="{Binding L_ServiceMasterTitle}"/>
                  <TextBlock Classes="card-sub"
                             Text="{Binding L_ServiceMasterSubtitle}"/>

                  <WrapPanel Orientation="Horizontal"
                             Margin="0,6,0,0"
                             IsVisible="{Binding ServiceVm.IsInstalled}">
                    <TextBlock icons:PictogramText.Icons="status" icons:PictogramText.Text="{Binding L_ServiceRunningLine}"
                               IsVisible="{Binding ServiceVm.IsRunning}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource SuccessFgBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,4"/>
                    <TextBlock icons:PictogramText.Icons="status-off" icons:PictogramText.Text="{Binding L_ServiceStoppedLine}"
                               IsVisible="{Binding !ServiceVm.IsRunning}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,4"/>
                    <Button Content="{Binding L_RestartService}"
                            Command="{Binding ServiceVm.RestartServiceCommand}"
                            IsVisible="{Binding ServiceVm.IsRunning}"
                            IsEnabled="{Binding !ServiceVm.IsBusy}"
                            Padding="10,3" FontSize="10"
                            CornerRadius="{StaticResource RadiusSm}"
                            Margin="0,0,6,4"/>
                    <Button Content="{Binding L_ReinstallService}"
                            Command="{Binding ServiceVm.ReinstallServiceCommand}"
                            IsEnabled="{Binding !ServiceVm.IsBusy}"
                            Padding="10,3" FontSize="10"
                            CornerRadius="{StaticResource RadiusSm}"
                            Margin="0,0,6,4"/>
                  </WrapPanel>

                  <StackPanel IsVisible="{Binding ServiceVm.IsBusy}"
                              Margin="0,6,0,0" Spacing="3">
                    <ProgressBar IsIndeterminate="True"
                                 Height="3" MinHeight="3"
                                 Foreground="{DynamicResource AccentSolidBrush}"/>
                    <TextBlock Text="{Binding ServiceVm.StatusMessage}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentSolidBrush}"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource SurfaceSunkenBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1">
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding L_ServiceComponentsHeader}"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <StackPanel Spacing="5">
                  <StackPanel Spacing="2"
                              IsEnabled="{Binding ServiceVm.IsInstalled}">
                    <CheckBox IsChecked="{Binding AutostartVpn}"
                              AutomationProperties.Name="{Binding LblAutostartVpn}"
                              MinHeight="0" Padding="4,0">
                      <TextBlock Text="{Binding LblAutostartVpn}" TextWrapping="Wrap"/>
                    </CheckBox>
                    <TextBlock icons:PictogramText.Icons="check" icons:PictogramText.PrefixOnly="True" icons:PictogramText.Text="{Binding LblAutostartVpnStatus}"
                               TextWrapping="Wrap"
                               FontSize="9"
                               Margin="22,0,0,0"
                               IsVisible="{Binding IsAutostartVpnStatusGood}"
                               Foreground="{DynamicResource SuccessFgBrush}"/>
                    <TextBlock icons:PictogramText.Icons="check" icons:PictogramText.PrefixOnly="True" icons:PictogramText.Text="{Binding LblAutostartVpnStatus}"
                               TextWrapping="Wrap"
                               FontSize="9"
                               Margin="22,0,0,0"
                               IsVisible="{Binding IsAutostartVpnStatusWarn}"
                               Foreground="{DynamicResource WarningFgBrush}"/>
                    <TextBlock icons:PictogramText.Icons="check" icons:PictogramText.PrefixOnly="True" icons:PictogramText.Text="{Binding LblAutostartVpnStatus}"
                               TextWrapping="Wrap"
                               FontSize="9"
                               Margin="22,0,0,0"
                               IsVisible="{Binding IsAutostartVpnStatusBad}"
                               Foreground="{DynamicResource DangerFgBrush}"/>
                  </StackPanel>
                  <StackPanel Spacing="2"
                              IsEnabled="{Binding ServiceVm.IsInstalled}">
                    <CheckBox IsChecked="{Binding AutostartZapret}"
                              AutomationProperties.Name="{Binding LblAutostartZapret}"
                              MinHeight="0" Padding="4,0">
                      <TextBlock Text="{Binding LblAutostartZapret}" TextWrapping="Wrap"/>
                    </CheckBox>
                    <TextBlock icons:PictogramText.Icons="check" icons:PictogramText.PrefixOnly="True" icons:PictogramText.Text="{Binding LblAutostartZapretStatus}"
                               TextWrapping="Wrap"
                               FontSize="9"
                               Margin="22,0,0,0"
                               IsVisible="{Binding IsAutostartZapretStatusGood}"
                               Foreground="{DynamicResource SuccessFgBrush}"/>
                    <TextBlock icons:PictogramText.Icons="check" icons:PictogramText.PrefixOnly="True" icons:PictogramText.Text="{Binding LblAutostartZapretStatus}"
                               TextWrapping="Wrap"
                               FontSize="9"
                               Margin="22,0,0,0"
                               IsVisible="{Binding IsAutostartZapretStatusWarn}"
                               Foreground="{DynamicResource WarningFgBrush}"/>
                    <TextBlock icons:PictogramText.Icons="check" icons:PictogramText.PrefixOnly="True" icons:PictogramText.Text="{Binding LblAutostartZapretStatus}"
                               TextWrapping="Wrap"
                               FontSize="9"
                               Margin="22,0,0,0"
                               IsVisible="{Binding IsAutostartZapretStatusBad}"
                               Foreground="{DynamicResource DangerFgBrush}"/>
                  </StackPanel>
                  <StackPanel Spacing="2"
                              IsEnabled="{Binding ServiceVm.IsInstalled}">
                    <CheckBox IsChecked="{Binding AutostartTgProxy}"
                              AutomationProperties.Name="{Binding LblAutostartTgProxy}"
                              MinHeight="0" Padding="4,0">
                      <TextBlock Text="{Binding LblAutostartTgProxy}" TextWrapping="Wrap"/>
                    </CheckBox>
                    <TextBlock icons:PictogramText.Icons="check" icons:PictogramText.PrefixOnly="True" icons:PictogramText.Text="{Binding LblAutostartTgProxyStatus}"
                               TextWrapping="Wrap"
                               FontSize="9"
                               Margin="22,0,0,0"
                               IsVisible="{Binding IsAutostartTgProxyStatusGood}"
                               Foreground="{DynamicResource SuccessFgBrush}"/>
                    <TextBlock icons:PictogramText.Icons="check" icons:PictogramText.PrefixOnly="True" icons:PictogramText.Text="{Binding LblAutostartTgProxyStatus}"
                               TextWrapping="Wrap"
                               FontSize="9"
                               Margin="22,0,0,0"
                               IsVisible="{Binding IsAutostartTgProxyStatusWarn}"
                               Foreground="{DynamicResource WarningFgBrush}"/>
                    <TextBlock icons:PictogramText.Icons="check" icons:PictogramText.PrefixOnly="True" icons:PictogramText.Text="{Binding LblAutostartTgProxyStatus}"
                               TextWrapping="Wrap"
                               FontSize="9"
                               Margin="22,0,0,0"
                               IsVisible="{Binding IsAutostartTgProxyStatusBad}"
                               Foreground="{DynamicResource DangerFgBrush}"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Spacing="4"
                            IsVisible="{Binding !ServiceVm.IsInstalled}"
                            Margin="0,2,0,0">
                  <TextBlock Text="{Binding L_AutostartComponentsInfoHint}"
                             FontSize="9" FontStyle="Italic"
                             Foreground="{DynamicResource WarningFgBrush}"
                             TextWrapping="Wrap"/>
                  <Button Content="{Binding L_BtnInstallServiceInlineCta}"
                          Command="{Binding InstallServiceForAutostartCommand}"
                          ToolTip.Tip="{Binding L_TipInstallServiceInlineCta}"
                          IsEnabled="{Binding !ServiceVm.IsBusy}"
                          HorizontalAlignment="Left"
                          FontSize="10" Padding="10,4"
                          CornerRadius="{StaticResource RadiusSm}"
                          Background="{DynamicResource AccentBgSubtleBrush}"
                          Foreground="{DynamicResource AccentFgBrush}"
                          BorderBrush="{DynamicResource BorderAccentBrush}"
                          BorderThickness="1"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Text="{Binding L_AutostartLoginSectionTitle}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource SurfaceSunkenBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1">
              <StackPanel Spacing="5">
                <CheckBox IsChecked="{Binding AutostartUi}"
                          AutomationProperties.Name="{Binding LblAutostartUi}"
                          MinHeight="0" Padding="4,0">
                  <TextBlock Text="{Binding LblAutostartUi}" TextWrapping="Wrap"/>
                </CheckBox>
                <TextBlock Text="{Binding L_AutostartLoginAppDescription}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Opacity="0.85"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

      </StackPanel>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
            Padding="14,7,14,8"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource BorderDefaultBrush}"
            Background="{DynamicResource SurfaceSunkenBrush}">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" ColumnSpacing="8">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <TextBlock icons:PictogramText.Icons="check" icons:PictogramText.Text="✓" FontSize="11"
                     Foreground="{DynamicResource SuccessSolidBrush}"
                     VerticalAlignment="Center"/>
          <TextBlock Text="{Binding L_SettingsAutosaved}"
                     FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource SuccessFgBrush}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Button Classes="solid" Grid.Column="1"
                icons:PictogramText.Icons="apply" icons:PictogramText.Content="{Binding L_ApplyNowReloadVpn}"
                Command="{Binding ApplyPendingChangesCommand}"
                IsEnabled="{Binding IsConnected}"
                Padding="10,5" FontSize="10" FontWeight="SemiBold" CornerRadius="{StaticResource RadiusSm}"
                Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentOnSolidBrush}"
                ToolTip.Tip="{Binding L_ApplyNowHint}"
                AutomationProperties.Name="{Binding L_ApplyNowReloadVpn}"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="500"
             x:Class="VPNRouter.App.Views.Pages.NetworkPage"
             x:DataType="vm:MainWindowViewModel">
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="10,8,16,12">
            <StackPanel Spacing="10">
                <!-- Routing Mode -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Routing mode" FontWeight="SemiBold" Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton Content="{Binding LblSplitTunnel}"
                                     IsChecked="{Binding IsSplitTunnel}"
                                     GroupName="RoutingMode"/>
                        <RadioButton Content="{Binding LblFullTunnel}"
                                     GroupName="RoutingMode"/>
                    </StackPanel>
                </StackPanel>

                <!-- Russian Geo Bypass -->
                <Border Padding="8,6" CornerRadius="4"
                        Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="2">
                        <CheckBox IsChecked="{Binding BypassRussianTraffic}"
                                  Content="{Binding BypassRuLabel}" FontWeight="SemiBold"
                                  MinHeight="0" Padding="4,0"/>
                        <TextBlock Text="{Binding BypassRuHint}"
                                   FontSize="9" Opacity="0.6" Margin="22,0,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Update channel -->
                <Border Padding="8,6" CornerRadius="4"
                        Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding UpdateChannelHeader}" FontWeight="SemiBold" Opacity="0.7"/>
                        <CheckBox IsChecked="{Binding ReceivePrereleases}"
                                  Content="{Binding ReceivePrereleasesLabel}"
                                  MinHeight="0" Padding="4,0"/>
                    </StackPanel>
                </Border>

                <!-- Leak protection -->
                <Border Padding="8,6" CornerRadius="4"
                        Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Leak protection" FontWeight="SemiBold" Opacity="0.7"/>
                        <CheckBox IsChecked="{Binding StrictMode}" Content="{Binding StrictModeLabel}"
                                  MinHeight="0" Padding="4,0"/>
                        <CheckBox IsChecked="{Binding ForceIpv4Only}" Content="{Binding ForceIpv4Label}"
                                  MinHeight="0" Padding="4,0"/>
                        <CheckBox IsChecked="{Binding FlushDnsOnStart}" Content="{Binding FlushDnsLabel}"
                                  MinHeight="0" Padding="4,0"/>
                        <CheckBox IsChecked="{Binding StrictDns}" Content="{Binding StrictDnsLabel}"
                                  MinHeight="0" Padding="4,0"/>
                    </StackPanel>
                </Border>
                <!-- Ad blocking -->
                <Border Padding="8,6" CornerRadius="4"
                        Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="2">
                        <CheckBox IsChecked="{Binding BlockAds}"
                                  Content="{Binding BlockAdsLabel}" FontWeight="SemiBold"
                                  MinHeight="0" Padding="4,0"/>
                        <TextBlock Text="{Binding BlockAdsHint}"
                                   FontSize="9" Opacity="0.6" Margin="22,0,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

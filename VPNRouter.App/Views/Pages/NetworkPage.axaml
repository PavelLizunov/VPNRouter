<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="500"
             x:Class="VPNRouter.App.Views.Pages.NetworkPage"
             x:DataType="vm:MainWindowViewModel">

  <!-- v2.25.4 — Settings page redesign per Claude Design handoff section 4.
       Shape stays the same master-detail split (left nav + right pane)
       but the Routing section becomes the showcase:
         • Full-width radio-CARDS (not inline RadioButtons) — title + sub
           line inside a bordered block; active card gets arctic border
           and arctic-bg-subtle fill.
         • .ru bypass upgraded to a filled-arctic checkbox card with
           explanation paragraph inside.
         • Left split trimmed 160 → 140 (matches design handoff).
         • Autostart section — Windows users now also get Service
           Restart / Reinstall buttons directly in the panel (they lived
           in the footer through v2.24.4 and had no home after the
           v2.25.0 footer compact until now).
         • Apply button moved to right-aligned compact with an
           "Autosave is on" left hint (design wants the Apply row tight,
           not a full-width button bar). -->

  <UserControl.Styles>

    <!-- Radio card: full-width clickable block with title + sub -->
    <Style Selector="Border.radio-card">
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
      <Setter Property="Padding" Value="10,10"/>
    </Style>
    <Style Selector="Border.radio-card.active">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}"/>
      <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
    </Style>

    <Style Selector="TextBlock.card-title">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.card-sub">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Checkbox card (for .ru bypass + future toggles) -->
    <Style Selector="Border.checkbox-card">
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
      <Setter Property="Padding" Value="10,10"/>
    </Style>
    <Style Selector="Border.checkbox-card.active">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}"/>
      <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
    </Style>

    <!-- Service pill — small status chip next to "VPN Service" label -->
    <Style Selector="Border.service-pill">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
      <Setter Property="Padding" Value="8,2"/>
    </Style>
  </UserControl.Styles>

  <!-- Master-detail: nav list left, pane right + bottom apply bar -->
  <Grid RowDefinitions="*,Auto" ColumnDefinitions="140,*">

    <!-- MASTER (left): section navigator -->
    <Border Grid.Row="0" Grid.Column="0"
            BorderThickness="0,0,1,0"
            BorderBrush="{DynamicResource BorderDefaultBrush}"
            Background="{DynamicResource SurfaceSunkenBrush}">
      <ListBox SelectedIndex="{Binding SelectedSettingsIndex}"
               Background="Transparent"
               BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBoxItem Content="{Binding LblSettingsRouting}"    Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
        <ListBoxItem Content="{Binding LblSettingsLeak}"       Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
        <ListBoxItem Content="{Binding LblSettingsContent}"    Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
        <ListBoxItem Content="{Binding LblSettingsUpdates}"    Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
        <ListBoxItem Content="{Binding LblAutostartSection}"   Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
      </ListBox>
    </Border>

    <!-- DETAIL (right): selected section -->
    <ScrollViewer Grid.Row="0" Grid.Column="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Padding="14,10,14,12">
      <StackPanel>

        <!-- ═══ Routing (Phase 4 showcase) ═══ -->
        <StackPanel Spacing="10" IsVisible="{Binding IsSettingsRoutingSelected}">
          <TextBlock Text="{Binding LblSettingsRouting}" FontWeight="Bold" FontSize="13"/>
          <TextBlock Text="{Binding L_RoutingDescription}"
                     FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap"/>

          <!-- Split Tunnel card -->
          <Border Classes="radio-card" Classes.active="{Binding IsSplitTunnel}">
            <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
              <RadioButton Grid.Column="0"
                           IsChecked="{Binding IsSplitTunnel}"
                           GroupName="RoutingMode"
                           VerticalAlignment="Top"
                           MinWidth="0" MinHeight="0"
                           Margin="0,1,0,0"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="card-title"
                           Text="{Binding L_SplitTunnelTitle}"/>
                <TextBlock Classes="card-sub"
                           Text="{Binding L_SplitTunnelSubtitle}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Full Tunnel card.
               v2.25.10 fix: explicit IsChecked binding to IsFullTunnel
               (new in VM). Before this the Full RadioButton had no
               binding and relied on GroupName exclusivity to flip Split
               — which broke after ReloadMainWindowForLocalization kept
               old + new windows alive briefly with the same GroupName,
               causing the group manager to cross-wire. With a proper
               two-way binding the radio state always mirrors the VM
               regardless of how many window instances live at once. -->
          <Border Classes="radio-card" Classes.active="{Binding IsFullTunnel}">
            <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
              <RadioButton Grid.Column="0"
                           IsChecked="{Binding IsFullTunnel}"
                           GroupName="RoutingMode"
                           VerticalAlignment="Top"
                           MinWidth="0" MinHeight="0"
                           Margin="0,1,0,0"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="card-title"
                           Text="{Binding L_FullTunnelTitle}"/>
                <TextBlock Classes="card-sub"
                           Text="{Binding L_FullTunnelSubtitle}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- .ru bypass checkbox card — filled when active -->
          <Border Classes="checkbox-card" Classes.active="{Binding BypassRussianTraffic}">
            <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
              <CheckBox Grid.Column="0"
                        IsChecked="{Binding BypassRussianTraffic}"
                        VerticalAlignment="Top"
                        MinWidth="0" MinHeight="0" Padding="0"
                        Margin="0,1,0,0"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="card-title"
                           Text="{Binding BypassRuLabel}"/>
                <TextBlock Classes="card-sub"
                           Text="{Binding BypassRuHint}"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <!-- ═══ Leak Protection ═══ -->
        <StackPanel Spacing="10" IsVisible="{Binding IsSettingsLeakSelected}">
          <TextBlock Text="{Binding LblSettingsLeak}" FontWeight="Bold" FontSize="13"/>

          <Border Padding="8,6" CornerRadius="{StaticResource RadiusSm}"
                  Background="{DynamicResource SurfaceSunkenBrush}"
                  BorderBrush="{DynamicResource BorderDefaultBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="4">
              <CheckBox IsChecked="{Binding StrictMode}" Content="{Binding StrictModeLabel}"
                        ToolTip.Tip="{Binding L_TipLeakStrictMode}"
                        MinHeight="0" Padding="4,0"/>
              <CheckBox IsChecked="{Binding ForceIpv4Only}" Content="{Binding ForceIpv4Label}"
                        ToolTip.Tip="{Binding L_TipLeakForceIpv4}"
                        MinHeight="0" Padding="4,0"/>
              <CheckBox IsChecked="{Binding FlushDnsOnStart}" Content="{Binding FlushDnsLabel}"
                        ToolTip.Tip="{Binding L_TipLeakFlushDns}"
                        MinHeight="0" Padding="4,0"/>
              <CheckBox IsChecked="{Binding StrictDns}" Content="{Binding StrictDnsLabel}"
                        ToolTip.Tip="{Binding L_TipLeakStrictDns}"
                        MinHeight="0" Padding="4,0"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ═══ Content ═══ -->
        <StackPanel Spacing="10" IsVisible="{Binding IsSettingsContentSelected}">
          <TextBlock Text="{Binding LblSettingsContent}" FontWeight="Bold" FontSize="13"/>

          <Border Classes="checkbox-card" Classes.active="{Binding BlockAds}">
            <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
              <CheckBox Grid.Column="0"
                        IsChecked="{Binding BlockAds}"
                        VerticalAlignment="Top"
                        MinWidth="0" MinHeight="0" Padding="0"
                        Margin="0,1,0,0"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="card-title" Text="{Binding BlockAdsLabel}"/>
                <TextBlock Classes="card-sub" Text="{Binding BlockAdsHint}"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <!-- ═══ Updates ═══ -->
        <StackPanel Spacing="10" IsVisible="{Binding IsSettingsUpdatesSelected}">
          <TextBlock Text="{Binding LblSettingsUpdates}" FontWeight="Bold" FontSize="13"/>

          <Border Padding="8,6" CornerRadius="{StaticResource RadiusSm}"
                  Background="{DynamicResource SurfaceSunkenBrush}"
                  BorderBrush="{DynamicResource BorderDefaultBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding UpdateChannelHeader}" FontWeight="SemiBold" Opacity="0.7"/>
              <CheckBox IsChecked="{Binding ReceivePrereleases}"
                        Content="{Binding ReceivePrereleasesLabel}"
                        MinHeight="0" Padding="4,0"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ═══ Autostart (v2.27 Bug C redesign) ═══
             Two logical sections grouped by WHEN the autostart happens
             (not which Windows mechanism powers it), per plans/v2.27 §3.

             Section A — "At Windows startup (before sign-in)":
               the Windows service master toggle + which components it
               should bring up at boot (VPN / Zapret / Telegram proxy).

             Section B — "At user sign-in":
               the HKCU Run key that launches VPNRouter on login. Gives
               a separate explanation that this opens the UI only; it
               does not start VPN itself — the user has to either start
               manually or flip Section A's master.

             Eliminates the v2.26 UX trap where three unrelated mechanisms
             (service install / component yaml flags / Run key) lived in
             one grouping and a user couldn't tell "what do I need to
             tick to get VPN before login?" without reading source. -->
        <StackPanel Spacing="14" IsVisible="{Binding IsSettingsAutostartSelected}">
          <TextBlock Text="{Binding LblAutostartSection}" FontWeight="Bold" FontSize="13"/>

          <!-- ══════════════════════════════════════════════════════════
               Section A — At Windows startup (before sign-in)
               ══════════════════════════════════════════════════════════ -->
          <StackPanel Spacing="8" IsVisible="{Binding IsWindowsPlatform}">
            <TextBlock Text="{Binding L_AutostartBootSectionTitle}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <TextBlock Text="{Binding L_AutostartBootSectionSub}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Opacity="0.85"/>

            <!-- ── Windows service master card ── -->
            <Border Classes="checkbox-card"
                    Classes.active="{Binding ServiceVm.AutostartChecked}">
              <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding ServiceVm.AutostartChecked}"
                          IsEnabled="{Binding !ServiceVm.IsBusy}"
                          VerticalAlignment="Top"
                          MinWidth="0" MinHeight="0" Padding="0"
                          Margin="0,1,0,0"/>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Classes="card-title"
                             Text="{Binding L_ServiceMasterTitle}"/>
                  <TextBlock Classes="card-sub"
                             Text="{Binding L_ServiceMasterSubtitle}"/>

                  <!-- v2.27 §4.5: prominent status line with PID — replaces
                       the tiny 9pt pill that users missed. Visible only
                       when service is installed. -->
                  <StackPanel Orientation="Horizontal" Spacing="6"
                              Margin="0,6,0,0"
                              IsVisible="{Binding ServiceVm.IsInstalled}">
                    <TextBlock Text="{Binding L_ServiceRunningLine}"
                               IsVisible="{Binding ServiceVm.IsRunning}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource SuccessFgBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding L_ServiceStoppedLine}"
                               IsVisible="{Binding !ServiceVm.IsRunning}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <Button Content="{Binding L_RestartService}"
                            Command="{Binding ServiceVm.RestartServiceCommand}"
                            IsVisible="{Binding ServiceVm.IsRunning}"
                            IsEnabled="{Binding !ServiceVm.IsBusy}"
                            Padding="10,3" FontSize="10"
                            CornerRadius="{StaticResource RadiusSm}"/>
                    <Button Content="{Binding L_ReinstallService}"
                            Command="{Binding ServiceVm.ReinstallServiceCommand}"
                            IsEnabled="{Binding !ServiceVm.IsBusy}"
                            Padding="10,3" FontSize="10"
                            CornerRadius="{StaticResource RadiusSm}"/>
                  </StackPanel>

                  <!-- v2.27 §4.5 busy indicator: indeterminate progress bar
                       + status message. Replaces bare italic text so the
                       user actually notices that the install is in flight. -->
                  <StackPanel IsVisible="{Binding ServiceVm.IsBusy}"
                              Margin="0,6,0,0" Spacing="3">
                    <ProgressBar IsIndeterminate="True"
                                 Height="3" MinHeight="3"
                                 Foreground="{DynamicResource AccentSolidBrush}"/>
                    <TextBlock Text="{Binding ServiceVm.StatusMessage}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentSolidBrush}"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <!-- ── Components to auto-start with the service ──
                 Interactable only when service is installed (flag values
                 are meaningless otherwise — nothing reads them on boot).
                 Info hint when service isn't installed yet. -->
            <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource SurfaceSunkenBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1">
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding L_ServiceComponentsHeader}"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <StackPanel Spacing="5"
                            IsEnabled="{Binding ServiceVm.IsInstalled}">
                  <CheckBox IsChecked="{Binding AutostartVpn}"
                            Content="{Binding LblAutostartVpn}"
                            MinHeight="0" Padding="4,0"/>
                  <CheckBox IsChecked="{Binding AutostartZapret}"
                            Content="{Binding LblAutostartZapret}"
                            MinHeight="0" Padding="4,0"/>
                  <CheckBox IsChecked="{Binding AutostartTgProxy}"
                            Content="{Binding LblAutostartTgProxy}"
                            MinHeight="0" Padding="4,0"/>
                </StackPanel>
                <TextBlock Text="{Binding L_AutostartComponentsInfoHint}"
                           IsVisible="{Binding !ServiceVm.IsInstalled}"
                           FontSize="9" FontStyle="Italic"
                           Foreground="{DynamicResource WarningFgBrush}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ══════════════════════════════════════════════════════════
               Section B — At user sign-in (HKCU Run key)
               ══════════════════════════════════════════════════════════ -->
          <StackPanel Spacing="8" IsVisible="{Binding IsWindowsPlatform}">
            <TextBlock Text="{Binding L_AutostartLoginSectionTitle}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource SurfaceSunkenBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1">
              <StackPanel Spacing="5">
                <CheckBox IsChecked="{Binding AutostartUi}"
                          Content="{Binding LblAutostartUi}"
                          MinHeight="0" Padding="4,0"/>
                <TextBlock Text="{Binding L_AutostartLoginAppDescription}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Opacity="0.85"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Non-Windows notice: replaces both sections above. -->
          <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                  Background="{DynamicResource InfoBgBrush}"
                  BorderBrush="{DynamicResource InfoBorderBrush}"
                  BorderThickness="1"
                  IsVisible="{Binding !IsWindowsPlatform}">
            <TextBlock Text="{Binding L_AutostartPlatformNotice}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource InfoFgBrush}"/>
          </Border>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- Apply bar: "Autosave is on" left hint + compact Apply right. -->
    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
            Padding="14,7,14,8"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource BorderDefaultBrush}"
            Background="{DynamicResource SurfaceSunkenBrush}">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <TextBlock Text="✓" FontSize="11"
                     Foreground="{DynamicResource SuccessSolidBrush}"
                     VerticalAlignment="Center"/>
          <TextBlock Text="{Binding L_SettingsAutosaved}"
                     FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource SuccessFgBrush}"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Column="1"
                Content="{Binding L_ApplyNowReloadVpn}"
                Command="{Binding ApplyPendingChangesCommand}"
                IsEnabled="{Binding IsConnected}"
                Padding="10,5" FontSize="10" FontWeight="SemiBold" CornerRadius="{StaticResource RadiusSm}"
                Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentOnSolidBrush}"
                ToolTip.Tip="{Binding L_ApplyNowHint}"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>

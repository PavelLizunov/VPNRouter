<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:conv="using:VPNRouter.App"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="500"
             x:Class="VPNRouter.App.Views.Pages.NetworkPage"
             x:DataType="vm:MainWindowViewModel">

  <!-- v2.25.4 — Settings page redesign per Claude Design handoff section 4.
       Shape stays the same master-detail split (left nav + right pane)
       but the Routing section becomes the showcase:
         • Full-width radio-CARDS (not inline RadioButtons) — title + sub
           line inside a bordered block; active card gets arctic border
           and arctic-bg-subtle fill.
         • .ru bypass upgraded to a filled-arctic checkbox card with
           explanation paragraph inside.
         • Left split trimmed 160 → 140 (matches design handoff).
         • Autostart section — Windows users now also get Service
           Restart / Reinstall buttons directly in the panel (they lived
           in the footer through v2.24.4 and had no home after the
           v2.25.0 footer compact until now).
         • Apply button moved to right-aligned compact with an
           "Autosave is on" left hint (design wants the Apply row tight,
           not a full-width button bar). -->

  <UserControl.Styles>

    <!-- Radio card: full-width clickable block with title + sub -->
    <Style Selector="Border.radio-card">
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
      <Setter Property="Padding" Value="10,10"/>
    </Style>
    <Style Selector="Border.radio-card.active">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}"/>
      <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
    </Style>

    <Style Selector="TextBlock.card-title">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <!-- v2.27.0-r2: wrap when card narrows. Without this, a long
           multi-word title (e.g. a localised "Windows background service")
           would keep the card wider than its ScrollViewer parent and push
           the right edge past the window — the overflow user reported. -->
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.card-sub">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Checkbox card (for .ru bypass + future toggles) -->
    <Style Selector="Border.checkbox-card">
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
      <Setter Property="Padding" Value="10,10"/>
    </Style>
    <Style Selector="Border.checkbox-card.active">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}"/>
      <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
    </Style>

    <!-- Service pill — small status chip next to "VPN Service" label -->
    <Style Selector="Border.service-pill">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
      <Setter Property="Padding" Value="8,2"/>
    </Style>
  </UserControl.Styles>

  <!-- Master-detail: nav list left, pane right + bottom apply bar -->
  <Grid RowDefinitions="*,Auto" ColumnDefinitions="140,*">

    <!-- MASTER (left): section navigator -->
    <Border Grid.Row="0" Grid.Column="0"
            BorderThickness="0,0,1,0"
            BorderBrush="{DynamicResource BorderDefaultBrush}"
            Background="{DynamicResource SurfaceSunkenBrush}">
      <ListBox SelectedIndex="{Binding SelectedSettingsIndex}"
               Background="Transparent"
               BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBoxItem Content="{Binding LblSettingsRouting}"    Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
        <!-- v2.30.0-r2: dedicated Rules section as a separate left-nav
             item (was buried inside the Routing section as an expander).
             Per user direction 2026-04-29: «Для кастомных настроек
             маршрутизации нужен отдельный пункт в меню». -->
        <ListBoxItem Content="{Binding LblSettingsRules}"      Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
        <ListBoxItem Content="{Binding LblSettingsLeak}"       Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
        <ListBoxItem Content="{Binding LblSettingsContent}"    Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
        <ListBoxItem Content="{Binding LblSettingsUpdates}"    Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
        <ListBoxItem Content="{Binding LblAutostartSection}"   Padding="10,7" FontSize="11" FontWeight="SemiBold"/>
      </ListBox>
    </Border>

    <!-- DETAIL (right): selected section.
         v2.27.0-r2: the border-overflow fix is entirely in the content
         tree (WrapPanel for the status+buttons row, TextWrapping on
         CheckBox content). The scrollbar was a red herring. Keeping
         VerticalScrollBarVisibility at Auto so short tabs don't get a
         cosmetic always-present scrollbar. -->
    <!-- v2.28.4-r7: same pattern as the FreeConfigsPage r6 fix — push the
         horizontal padding off the ScrollViewer onto an inner Grid via
         Margin. The ScrollViewer keeps only its vertical padding; the
         scrollbar reserves width with AllowAutoHide=False; and the inner
         Grid's `Margin="14,0,14,0"` is part of the Grid's external
         layout, decoupled from the ScrollViewer's scrollbar metrics —
         so right padding stays locked even when text inside cards wraps
         on resize. -->
    <ScrollViewer Grid.Row="0" Grid.Column="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  AllowAutoHide="False"
                  Padding="0,10,0,12">
      <Grid Margin="14,0,14,0">
        <StackPanel HorizontalAlignment="Stretch">

        <!-- ═══ Routing (Phase 4 showcase) ═══ -->
        <StackPanel Spacing="10" IsVisible="{Binding IsSettingsRoutingSelected}">
          <TextBlock Text="{Binding LblSettingsRouting}" FontWeight="Bold" FontSize="13"/>
          <TextBlock Text="{Binding L_RoutingDescription}"
                     FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap"/>

          <!-- Split Tunnel card -->
          <Border Classes="radio-card" Classes.active="{Binding IsSplitTunnel}">
            <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
              <RadioButton Grid.Column="0"
                           IsChecked="{Binding IsSplitTunnel}"
                           GroupName="RoutingMode"
                           VerticalAlignment="Top"
                           MinWidth="0" MinHeight="0"
                           Margin="0,1,0,0"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="card-title"
                           Text="{Binding L_SplitTunnelTitle}"/>
                <TextBlock Classes="card-sub"
                           Text="{Binding L_SplitTunnelSubtitle}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Full Tunnel card.
               v2.25.10 fix: explicit IsChecked binding to IsFullTunnel
               (new in VM). Before this the Full RadioButton had no
               binding and relied on GroupName exclusivity to flip Split
               — which broke after ReloadMainWindowForLocalization kept
               old + new windows alive briefly with the same GroupName,
               causing the group manager to cross-wire. With a proper
               two-way binding the radio state always mirrors the VM
               regardless of how many window instances live at once. -->
          <Border Classes="radio-card" Classes.active="{Binding IsFullTunnel}">
            <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
              <RadioButton Grid.Column="0"
                           IsChecked="{Binding IsFullTunnel}"
                           GroupName="RoutingMode"
                           VerticalAlignment="Top"
                           MinWidth="0" MinHeight="0"
                           Margin="0,1,0,0"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="card-title"
                           Text="{Binding L_FullTunnelTitle}"/>
                <TextBlock Classes="card-sub"
                           Text="{Binding L_FullTunnelSubtitle}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- .ru bypass checkbox card — filled when active -->
          <Border Classes="checkbox-card" Classes.active="{Binding BypassRussianTraffic}">
            <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
              <CheckBox Grid.Column="0"
                        IsChecked="{Binding BypassRussianTraffic}"
                        VerticalAlignment="Top"
                        MinWidth="0" MinHeight="0" Padding="0"
                        Margin="0,1,0,0"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="card-title"
                           Text="{Binding BypassRuLabel}"/>
                <TextBlock Classes="card-sub"
                           Text="{Binding BypassRuHint}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- v2.30.0-r2: Custom rules expander REMOVED from Routing
               section — moved to its own dedicated Rules section
               (left-nav index 1). See below. -->
        </StackPanel>

        <!-- ═══ Rules (v2.30.0-r7 — Cards/Edit view-mode toggle per
             RulesExplorations.html design handoff) ═══
             User direction 2026-04-29: «компоную контекст и дам тебе
             дизайн и переработку страницы правила». Design ships
             two view modes: Cards (default, structured) + Edit (full
             text-mode editor with line-numbered gutter, per-line errors,
             explicit Apply / Revert).
             v2.30.0-r2..r6 carry-over: structured row editor, search,
             bulk actions, Import/Export 3 formats, virtualization.
             Edit mode replaces the old "Advanced (text format)" expander
             at the bottom of the section. -->
        <StackPanel Spacing="10" IsVisible="{Binding IsSettingsRulesSelected}">
          <!-- Header row: title + Cards/Edit segmented toggle (right) +
               Import/Export. The toggle replaces the bottom Advanced
               expander; Cards is default friendly view, Edit is the
               power-user textarea. -->
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
            <TextBlock Grid.Column="0"
                       Text="{Binding LblSettingsRules}"
                       FontWeight="Bold" FontSize="13"
                       VerticalAlignment="Center"/>
            <!-- Segmented toggle (▦ Cards · ✎ Text). Each button is
                 borderless when inactive, filled+accent when active.
                 Sits in a Sunken-bg pill for visual grouping per
                 the design's `.view-seg` pattern. -->
            <Border Grid.Column="1"
                    Padding="2"
                    CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource SurfaceSunkenBrush}"
                    BorderThickness="0"
                    VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Content="{Binding L_RulesViewCards}"
                        Command="{Binding SetRulesViewCardsCommand}"
                        FontSize="10" FontWeight="SemiBold"
                        Padding="8,3" MinHeight="0"
                        BorderThickness="0"
                        CornerRadius="{StaticResource RadiusXs}"
                        ToolTip.Tip="{Binding L_RulesViewCardsTooltip}"
                        Background="{Binding IsRulesViewCards,
                                     Converter={x:Static conv:BoolToBrushConverter.Instance},
                                     ConverterParameter=SurfaceBaseBrush|Transparent}"
                        Foreground="{Binding IsRulesViewCards,
                                     Converter={x:Static conv:BoolToBrushConverter.Instance},
                                     ConverterParameter=AccentFgBrush|TextSecondaryBrush}"/>
                <Button Content="{Binding L_RulesViewEdit}"
                        Command="{Binding SetRulesViewEditCommand}"
                        FontSize="10" FontWeight="SemiBold"
                        Padding="8,3" MinHeight="0"
                        BorderThickness="0"
                        CornerRadius="{StaticResource RadiusXs}"
                        ToolTip.Tip="{Binding L_RulesViewEditTooltip}"
                        Background="{Binding IsRulesViewEdit,
                                     Converter={x:Static conv:BoolToBrushConverter.Instance},
                                     ConverterParameter=SurfaceBaseBrush|Transparent}"
                        Foreground="{Binding IsRulesViewEdit,
                                     Converter={x:Static conv:BoolToBrushConverter.Instance},
                                     ConverterParameter=AccentFgBrush|TextSecondaryBrush}"/>
              </StackPanel>
            </Border>
            <Button Grid.Column="2"
                    Content="{Binding L_CustomRulesImport}"
                    Command="{Binding ImportCustomRulesCommand}"
                    FontSize="10" Padding="8,3" MinHeight="0"
                    ToolTip.Tip="{Binding L_CustomRulesImportTooltip}"/>
            <Button Grid.Column="3"
                    Content="{Binding L_CustomRulesExport}"
                    Command="{Binding ExportCustomRulesCommand}"
                    FontSize="10" Padding="8,3" MinHeight="0"
                    ToolTip.Tip="{Binding L_CustomRulesExportTooltip}"/>
          </Grid>

          <!-- Help banner (info-tinted) — replaces the dense paragraph
               with key bullets about toggle precedence, LAN auto-direct,
               and order-doesn't-matter. Dismissable via X. -->
          <Border IsVisible="{Binding !IsRulesHelpBannerDismissed}"
                  Padding="10,8"
                  CornerRadius="{StaticResource RadiusMd}"
                  Background="{DynamicResource InfoBgBrush}"
                  BorderBrush="{DynamicResource InfoBorderBrush}"
                  BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0"
                         Text="ⓘ"
                         FontSize="13" FontWeight="Bold"
                         Foreground="{DynamicResource InfoFgBrush}"
                         VerticalAlignment="Top" Margin="0,1,0,0"/>
              <TextBlock Grid.Column="1"
                         Text="{Binding L_RulesHelpBanner}"
                         FontSize="10"
                         TextWrapping="Wrap"
                         LineHeight="15"
                         Foreground="{DynamicResource InfoFgBrush}"
                         VerticalAlignment="Center"/>
              <Button Grid.Column="2"
                      Content="✕"
                      Command="{Binding DismissRulesHelpBannerCommand}"
                      FontSize="11"
                      Padding="4,1" MinHeight="0"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{DynamicResource InfoFgBrush}"
                      Opacity="0.6"
                      VerticalAlignment="Top"/>
            </Grid>
          </Border>

          <!-- ═══ Cards view (default) — structured row-table editor ═══
               v2.30.0-r5 layout: description → add-form (top, primary)
               → existing-rules header → search → bulk → list. v2.30.0-r7
               wraps the whole thing in IsRulesViewCards visibility — the
               sibling Edit-view panel below is shown when the segmented
               toggle is flipped to Text. -->
          <StackPanel Spacing="10" IsVisible="{Binding IsRulesViewCards}">

          <!-- ═══ Add-rule form (primary action, top of section) ═══ -->
          <Border Padding="10"
                  CornerRadius="{StaticResource RadiusSm}"
                  Background="{DynamicResource SurfaceRaisedBrush}"
                  BorderBrush="{DynamicResource BorderDefaultBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding L_CustomRulesAddTitle}"
                         FontSize="11" FontWeight="SemiBold"/>
              <!-- Row 1: Action + Type (50/50). Each ComboBox flexes
                   with the available width; their open popups can never
                   overlap because they sit in distinct grid columns. -->
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding AvailableRuleActions}"
                          SelectedItem="{Binding NewRuleAction}"
                          HorizontalAlignment="Stretch"
                          FontSize="11" Padding="6,3" MinHeight="0"
                          ToolTip.Tip="{Binding L_CustomRulesActionLabel}"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableRuleTypes}"
                          SelectedItem="{Binding NewRuleType}"
                          HorizontalAlignment="Stretch"
                          FontSize="11" Padding="6,3" MinHeight="0"
                          ToolTip.Tip="{Binding L_CustomRulesTypeLabel}"/>
              </Grid>
              <!-- Row 2: Value full width. -->
              <TextBox Text="{Binding NewRuleValue}"
                       Watermark="{Binding L_CustomRulesValuePlaceholder}"
                       FontSize="11" Padding="6,3" MinHeight="0"
                       FontFamily="Consolas, 'SF Mono', monospace"/>
              <!-- Row 3: Comment + Add button. -->
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0"
                         Text="{Binding NewRuleComment}"
                         Watermark="{Binding L_CustomRulesCommentLabel}"
                         FontSize="11" Padding="6,3" MinHeight="0"/>
                <Button Grid.Column="1"
                        Content="{Binding L_CustomRulesAddBtn}"
                        Command="{Binding AddCustomRuleFromFormCommand}"
                        FontSize="11" FontWeight="SemiBold"
                        Padding="14,3" MinHeight="0"
                        Background="{DynamicResource AccentSolidBrush}"
                        Foreground="{DynamicResource AccentOnSolidBrush}"
                        CornerRadius="{StaticResource RadiusSm}"/>
              </Grid>
              <!-- Validation error inline -->
              <TextBlock Text="{Binding NewRuleValidationError}"
                         FontSize="10"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource DangerFgBrush}"
                         IsVisible="{Binding NewRuleValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </Border>

          <!-- ═══ Existing rules section ═══
               r5: separated visually from add-form via a header row,
               and bulk actions moved to their own row below search
               (was crammed into one 4-col row in r4). -->

          <!-- Section header: title + count -->
          <Grid ColumnDefinitions="*,Auto"
                IsVisible="{Binding CustomRulesList.Count}"
                Margin="0,4,0,0">
            <TextBlock Grid.Column="0"
                       Text="{Binding L_CustomRulesExistingHeader}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding CustomRulesCountText}"
                       FontSize="10"
                       Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center"/>
          </Grid>

          <!-- Search bar (full width on its own row — no width competition
               with bulk buttons, so search field can be sized comfortably
               even on narrow windows). -->
          <TextBox Text="{Binding CustomRulesSearchText}"
                   Watermark="{Binding L_CustomRulesSearchPlaceholder}"
                   FontSize="11" Padding="6,3" MinHeight="0"
                   IsVisible="{Binding CustomRulesList.Count}"/>

          <!-- Bulk action chips: own row, right-aligned. Each button is
               compact (FontSize 9, tight padding) so all three fit even
               at ~360px window width. r5: separated from search row to
               eliminate width competition. -->
          <Grid ColumnDefinitions="*,Auto"
                IsVisible="{Binding CustomRulesList.Count}">
            <TextBlock Grid.Column="0"
                       Text="{Binding ClearAllConfirmText}"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource DangerFgBrush}"
                       IsVisible="{Binding ClearAllConfirmText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
              <Button Content="{Binding L_CustomRulesEnableAll}"
                      Command="{Binding EnableAllCustomRulesCommand}"
                      FontSize="9" Padding="6,2" MinHeight="0"
                      ToolTip.Tip="{Binding L_CustomRulesEnableAllTooltip}"/>
              <Button Content="{Binding L_CustomRulesDisableAll}"
                      Command="{Binding DisableAllCustomRulesCommand}"
                      FontSize="9" Padding="6,2" MinHeight="0"
                      ToolTip.Tip="{Binding L_CustomRulesDisableAllTooltip}"/>
              <Button Content="{Binding L_CustomRulesClearAll}"
                      Command="{Binding ClearAllCustomRulesCommand}"
                      FontSize="9" Padding="6,2" MinHeight="0"
                      Background="{DynamicResource DangerBgBrush}"
                      Foreground="{DynamicResource DangerFgBrush}"
                      ToolTip.Tip="{Binding L_CustomRulesClearAllTooltip}"/>
            </StackPanel>
          </Grid>

          <!-- empty-state hint when list itself is empty -->
          <TextBlock Text="{Binding L_CustomRulesEmpty}"
                     FontSize="11"
                     FontStyle="Italic"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}"
                     IsVisible="{Binding !CustomRulesList.Count}"/>

          <!-- ListBox: virtualized, MaxHeight=360 (slight bump from r4
               since it's now the dominant lower section). -->
          <ListBox ItemsSource="{Binding FilteredCustomRulesList}"
                   IsVisible="{Binding CustomRulesList.Count}"
                   MaxHeight="360"
                   Background="Transparent"
                   BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerTheme>
              <ControlTheme TargetType="ListBoxItem"
                            BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
              </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CustomRuleViewModel">
                <Border Margin="0,0,0,4"
                        Padding="8,6"
                        CornerRadius="{StaticResource RadiusSm}"
                        Background="{DynamicResource SurfaceSunkenBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"
                        Opacity="{Binding RowOpacity}">
                  <Grid ColumnDefinitions="68,Auto,*,Auto,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                    <!-- Action chip — colored badge.
                         r5: shrunk 78→68 to give value column more room. -->
                    <Border Grid.Column="0"
                            CornerRadius="3"
                            Padding="5,2"
                            HorizontalAlignment="Left"
                            Background="{Binding Action, Converter={x:Static conv:ActionToChipColorConverter.Instance}}">
                      <TextBlock Text="{Binding Action}"
                                 FontSize="9"
                                 FontWeight="SemiBold"
                                 Foreground="White"
                                 HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Type}"
                               FontSize="10"
                               FontFamily="Consolas, 'SF Mono', monospace"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding Value}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               ToolTip.Tip="{Binding Comment}"/>
                    <CheckBox Grid.Column="3"
                              IsChecked="{Binding Enabled}"
                              MinHeight="0" Padding="0"
                              VerticalAlignment="Center"/>
                    <Button Grid.Column="4"
                            Content="✕"
                            Command="{Binding RemoveCommand}"
                            FontSize="10"
                            Padding="6,0" MinHeight="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextMutedBrush}"
                            ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_CustomRulesDelete}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          </StackPanel>
          <!-- ↑ End Cards view -->

          <!-- ═══ Edit view (Text mode) ═══
               v2.30.0-r7 — replaces the old Advanced expander. Per
               RulesExplorations.html design: textarea with line-numbered
               gutter, per-line errors, status strip with active count +
               dirty indicator, Apply / Revert buttons, error list, format
               hint. Unlike the old auto-saving expander, edits live in
               EditedCustomRulesText buffer until Apply commits. -->
          <StackPanel Spacing="8" IsVisible="{Binding IsRulesViewEdit}">

            <!-- Editor: gutter (Auto col) + TextBox (* col) inside a
                 Border with BorderDefault + RadiusSm. Both share font +
                 line-height so line numbers align with rules.
                 The TextBox has TextWrapping=NoWrap so a long single line
                 doesn't visually wrap and break the 1:1 line-to-number
                 mapping (horizontal scroll handles long values). -->
            <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource SurfaceAppBrush}"
                    ClipToBounds="True">
              <Grid ColumnDefinitions="Auto,*"
                    MinHeight="160"
                    MaxHeight="280">
                <!-- Gutter — read-only line numbers in muted mono.
                     IsHitTestVisible=False so clicks pass through to
                     the textbox. Padding mirrors the textbox so visual
                     line origin matches. -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceSunkenBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="10,8,8,8"
                        IsHitTestVisible="False">
                  <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                HorizontalScrollBarVisibility="Hidden">
                    <TextBlock Text="{Binding RulesEditorLineNumbers}"
                               FontFamily="Consolas, 'SF Mono', 'Cascadia Code', 'Ubuntu Mono', monospace"
                               FontSize="11"
                               LineHeight="18"
                               TextAlignment="Right"
                               Foreground="{DynamicResource TextMutedBrush}"
                               MinWidth="22"/>
                  </ScrollViewer>
                </Border>
                <!-- Editor TextBox. Borderless + transparent bg so the
                     parent Border owns the visual frame. AcceptsReturn,
                     NoWrap, monospace 11/18.
                     v2.30.0-r7 note: keystrokes update the buffer
                     (EditedCustomRulesText) but DON'T trigger SaveSettings.
                     Apply commits to the canonical CustomRulesText. -->
                <TextBox Grid.Column="1"
                         Text="{Binding EditedCustomRulesText}"
                         Watermark="{Binding L_CustomRulesPlaceholder}"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas, 'SF Mono', 'Cascadia Code', 'Ubuntu Mono', monospace"
                         FontSize="11"
                         LineHeight="18"
                         Padding="10,8,12,8"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
              </Grid>
            </Border>

            <!-- Status strip: active count + dirty indicator on left,
                 Revert + Apply buttons on right. -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
              <TextBlock Grid.Column="0"
                         Text="{Binding RulesEditorStatusText}"
                         FontSize="10"
                         FontFamily="Consolas, 'SF Mono', monospace"
                         Foreground="{DynamicResource TextMutedBrush}"
                         VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1"
                         Text="{Binding L_RulesEditorDirty}"
                         FontSize="10"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource WarningFgBrush}"
                         IsVisible="{Binding RulesEditorIsDirty}"
                         VerticalAlignment="Center"
                         Margin="0,0,4,0"/>
              <Button Grid.Column="2"
                      Content="{Binding L_RulesEditorRevert}"
                      Command="{Binding RevertEditedRulesCommand}"
                      FontSize="10" Padding="8,3" MinHeight="0"
                      IsEnabled="{Binding RulesEditorIsDirty}"/>
              <Button Grid.Column="3"
                      Content="{Binding RulesEditorApplyText}"
                      Command="{Binding ApplyEditedRulesCommand}"
                      FontSize="10" FontWeight="SemiBold"
                      Padding="10,3" MinHeight="0"
                      Background="{DynamicResource AccentSolidBrush}"
                      Foreground="{DynamicResource AccentOnSolidBrush}"
                      CornerRadius="{StaticResource RadiusSm}"
                      IsEnabled="{Binding RulesEditorIsDirty}"/>
            </Grid>

            <!-- Error list (visible only on parse errors). First 4 errors
                 with line-number prefix; "and N more…" if more exist. -->
            <Border IsVisible="{Binding RulesEditorErrorListText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Padding="8,6"
                    CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource DangerBgBrush}"
                    BorderBrush="{DynamicResource DangerBorderBrush}"
                    BorderThickness="1">
              <TextBlock Text="{Binding RulesEditorErrorListText}"
                         FontSize="10"
                         FontFamily="Consolas, 'SF Mono', monospace"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource DangerFgBrush}"/>
            </Border>

            <!-- Conflict warning (catch-all rule shadowing) — surfaced
                 from the canonical CustomRulesConflictText (computed at
                 Apply / SaveSettings time). Stays visible after Apply. -->
            <Border IsVisible="{Binding CustomRulesConflictText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Padding="8,5"
                    CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource WarningBgBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="1">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding L_CustomRulesConflictHeader}"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource WarningFgBrush}"/>
                <TextBlock Text="{Binding CustomRulesConflictText}"
                           FontSize="10"
                           FontFamily="Consolas, 'SF Mono', monospace"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WarningFgBrush}"/>
              </StackPanel>
            </Border>

            <!-- Format hint — small, muted, monospace. Reminds the user
                 of grammar + comment syntax. -->
            <Border Padding="10,7"
                    CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource SurfaceSunkenBrush}">
              <TextBlock Text="{Binding L_RulesEditorFormatHint}"
                         FontSize="10"
                         FontFamily="Consolas, 'SF Mono', monospace"
                         TextWrapping="Wrap"
                         LineHeight="16"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- ═══ Leak Protection ═══ -->
        <StackPanel Spacing="10" IsVisible="{Binding IsSettingsLeakSelected}">
          <TextBlock Text="{Binding LblSettingsLeak}" FontWeight="Bold" FontSize="13"/>

          <!-- v2.28.4-r1: switched from CheckBox.Content<TextBlock> to the
               radio-card 24,* pattern. The earlier v2.28.3-r1 fix wrapped
               labels in <TextBlock TextWrapping="Wrap"> but the inner
               TextBlock still inherited the CheckBox content-presenter's
               natural width — Avalonia's default CheckBox template gives
               the content slot all the space it asks for, so a long
               localised label (e.g. RU "Строгая защита от утечек") still
               pushed the parent Border past the ScrollViewer right edge
               on ~500px windows. The 24,* Grid pattern (proven in this
               same file's radio-card / checkbox-card sections) places the
               TextBlock in a sized * column so it gets the parent width
               as a real constraint and Wrap takes effect. -->
          <!-- v2.30.0-r6: switched checkbox + text both to VerticalAlignment=Center.
               User report: «текст съехал он стал выше галочек».
               Pre-r6 used Top alignment on both with a 1px top margin on
               the checkbox — was correct for multi-line wrapped labels
               (checkbox aligned with first line) but visually misaligned
               for single-line labels because CheckBox box sits a few px
               below its container's top while TextBlock baseline is
               higher. Center alignment works for both single-line and
               multi-line labels (checkbox sits at vertical center of
               multi-line block, which reads as "checkbox owns the row"). -->
          <Border Padding="8,6" CornerRadius="{StaticResource RadiusSm}"
                  Background="{DynamicResource SurfaceSunkenBrush}"
                  BorderBrush="{DynamicResource BorderDefaultBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="24,*" ColumnSpacing="6"
                    ToolTip.Tip="{Binding L_TipLeakStrictMode}">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding StrictMode}"
                          MinHeight="0" Padding="0"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding StrictModeLabel}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
              </Grid>
              <Grid ColumnDefinitions="24,*" ColumnSpacing="6"
                    ToolTip.Tip="{Binding L_TipLeakForceIpv4}">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding ForceIpv4Only}"
                          MinHeight="0" Padding="0"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding ForceIpv4Label}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
              </Grid>
              <Grid ColumnDefinitions="24,*" ColumnSpacing="6"
                    ToolTip.Tip="{Binding L_TipLeakFlushDns}">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding FlushDnsOnStart}"
                          MinHeight="0" Padding="0"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding FlushDnsLabel}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
              </Grid>
              <Grid ColumnDefinitions="24,*" ColumnSpacing="6"
                    ToolTip.Tip="{Binding L_TipLeakStrictDns}">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding StrictDns}"
                          MinHeight="0" Padding="0"
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding StrictDnsLabel}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ═══ Content ═══ -->
        <StackPanel Spacing="10" IsVisible="{Binding IsSettingsContentSelected}">
          <TextBlock Text="{Binding LblSettingsContent}" FontWeight="Bold" FontSize="13"/>

          <Border Classes="checkbox-card" Classes.active="{Binding BlockAds}">
            <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
              <CheckBox Grid.Column="0"
                        IsChecked="{Binding BlockAds}"
                        VerticalAlignment="Top"
                        MinWidth="0" MinHeight="0" Padding="0"
                        Margin="0,1,0,0"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="card-title" Text="{Binding BlockAdsLabel}"/>
                <TextBlock Classes="card-sub" Text="{Binding BlockAdsHint}"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <!-- ═══ Updates ═══ -->
        <StackPanel Spacing="10" IsVisible="{Binding IsSettingsUpdatesSelected}">
          <TextBlock Text="{Binding LblSettingsUpdates}" FontWeight="Bold" FontSize="13"/>

          <Border Padding="8,6" CornerRadius="{StaticResource RadiusSm}"
                  Background="{DynamicResource SurfaceSunkenBrush}"
                  BorderBrush="{DynamicResource BorderDefaultBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding UpdateChannelHeader}" FontWeight="SemiBold" Opacity="0.7"
                         TextWrapping="Wrap"/>
              <!-- v2.28.3: same TextWrapping fix as Section A's checkboxes. -->
              <CheckBox IsChecked="{Binding ReceivePrereleases}"
                        MinHeight="0" Padding="4,0">
                <TextBlock Text="{Binding ReceivePrereleasesLabel}" TextWrapping="Wrap"/>
              </CheckBox>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ═══ Autostart (v2.27 Bug C redesign) ═══
             Two logical sections grouped by WHEN the autostart happens
             (not which Windows mechanism powers it), per plans/v2.27 §3.

             Section A — "At Windows startup (before sign-in)":
               the Windows service master toggle + which components it
               should bring up at boot (VPN / Zapret / Telegram proxy).

             Section B — "At user sign-in":
               the HKCU Run key that launches VPNRouter on login. Gives
               a separate explanation that this opens the UI only; it
               does not start VPN itself — the user has to either start
               manually or flip Section A's master.

             Eliminates the v2.26 UX trap where three unrelated mechanisms
             (service install / component yaml flags / Run key) lived in
             one grouping and a user couldn't tell "what do I need to
             tick to get VPN before login?" without reading source. -->
        <StackPanel Spacing="14" IsVisible="{Binding IsSettingsAutostartSelected}">
          <TextBlock Text="{Binding LblAutostartSection}" FontWeight="Bold" FontSize="13"/>

          <!-- ══════════════════════════════════════════════════════════
               Section A — At Windows startup (before sign-in)
               ══════════════════════════════════════════════════════════ -->
          <StackPanel Spacing="8" IsVisible="{Binding IsWindowsPlatform}">
            <TextBlock Text="{Binding L_AutostartBootSectionTitle}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <TextBlock Text="{Binding L_AutostartBootSectionSub}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Opacity="0.85"/>

            <!-- ── Windows service master card ──
                 v2.27.0-r2: bound back to the raw ServiceVm.AutostartChecked
                 (install/uninstall the service, nothing more) after user
                 feedback on r1. The previous attempt to unify Simple and
                 Advanced via SmpAutostartChecked created two equally-wide
                 controls whose only job was to stay in sync with each other
                 — at which point you don't need two. Simple's checkbox is
                 now a link-card to this page, so this is the single source
                 of truth for the install state. Sub-checkboxes below turn
                 VPN / Zapret / Telegram on/off individually after install. -->
            <Border Classes="checkbox-card"
                    Classes.active="{Binding ServiceVm.AutostartChecked}">
              <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding ServiceVm.AutostartChecked}"
                          IsEnabled="{Binding !ServiceVm.IsBusy}"
                          VerticalAlignment="Top"
                          MinWidth="0" MinHeight="0" Padding="0"
                          Margin="0,1,0,0"/>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Classes="card-title"
                             Text="{Binding L_ServiceMasterTitle}"/>
                  <TextBlock Classes="card-sub"
                             Text="{Binding L_ServiceMasterSubtitle}"/>

                  <!-- v2.27 §4.5: prominent status line with PID — replaces
                       the tiny 9pt pill that users missed.
                       v2.27.0-r2 fix for user-reported narrow-window overflow:
                       WrapPanel lets status + Restart + Reinstall buttons flow
                       onto a second line when parent Border < ~350px wide,
                       instead of forcing a horizontal StackPanel wider than
                       the card and overflowing the right edge. -->
                  <WrapPanel Orientation="Horizontal"
                             Margin="0,6,0,0"
                             IsVisible="{Binding ServiceVm.IsInstalled}">
                    <TextBlock Text="{Binding L_ServiceRunningLine}"
                               IsVisible="{Binding ServiceVm.IsRunning}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource SuccessFgBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,4"/>
                    <TextBlock Text="{Binding L_ServiceStoppedLine}"
                               IsVisible="{Binding !ServiceVm.IsRunning}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,4"/>
                    <Button Content="{Binding L_RestartService}"
                            Command="{Binding ServiceVm.RestartServiceCommand}"
                            IsVisible="{Binding ServiceVm.IsRunning}"
                            IsEnabled="{Binding !ServiceVm.IsBusy}"
                            Padding="10,3" FontSize="10"
                            CornerRadius="{StaticResource RadiusSm}"
                            Margin="0,0,6,4"/>
                    <Button Content="{Binding L_ReinstallService}"
                            Command="{Binding ServiceVm.ReinstallServiceCommand}"
                            IsEnabled="{Binding !ServiceVm.IsBusy}"
                            Padding="10,3" FontSize="10"
                            CornerRadius="{StaticResource RadiusSm}"
                            Margin="0,0,6,4"/>
                  </WrapPanel>

                  <!-- v2.27 §4.5 busy indicator: indeterminate progress bar
                       + status message. Replaces bare italic text so the
                       user actually notices that the install is in flight. -->
                  <StackPanel IsVisible="{Binding ServiceVm.IsBusy}"
                              Margin="0,6,0,0" Spacing="3">
                    <ProgressBar IsIndeterminate="True"
                                 Height="3" MinHeight="3"
                                 Foreground="{DynamicResource AccentSolidBrush}"/>
                    <TextBlock Text="{Binding ServiceVm.StatusMessage}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentSolidBrush}"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <!-- ── Components to auto-start with the service ──
                 Interactable only when service is installed (flag values
                 are meaningless otherwise — nothing reads them on boot).
                 Info hint when service isn't installed yet. -->
            <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource SurfaceSunkenBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1">
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding L_ServiceComponentsHeader}"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <!-- v2.27.0-r2 narrow-window fix: wrap each CheckBox.Content
                     in an explicit TextBlock with TextWrapping="Wrap".
                     Default Avalonia CheckBox template renders bare-string
                     Content as a no-wrap TextBlock, which set the sub-card
                     min-width to the widest localised label (~180px for
                     "Start TgProxy on system boot") and blew past the
                     ScrollViewer right edge when window dropped to ~500px. -->
                <StackPanel Spacing="5"
                            IsEnabled="{Binding ServiceVm.IsInstalled}">
                  <CheckBox IsChecked="{Binding AutostartVpn}"
                            MinHeight="0" Padding="4,0">
                    <TextBlock Text="{Binding LblAutostartVpn}" TextWrapping="Wrap"/>
                  </CheckBox>
                  <CheckBox IsChecked="{Binding AutostartZapret}"
                            MinHeight="0" Padding="4,0">
                    <TextBlock Text="{Binding LblAutostartZapret}" TextWrapping="Wrap"/>
                  </CheckBox>
                  <CheckBox IsChecked="{Binding AutostartTgProxy}"
                            MinHeight="0" Padding="4,0">
                    <TextBlock Text="{Binding LblAutostartTgProxy}" TextWrapping="Wrap"/>
                  </CheckBox>
                </StackPanel>
                <TextBlock Text="{Binding L_AutostartComponentsInfoHint}"
                           IsVisible="{Binding !ServiceVm.IsInstalled}"
                           FontSize="9" FontStyle="Italic"
                           Foreground="{DynamicResource WarningFgBrush}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ══════════════════════════════════════════════════════════
               Section B — At user sign-in
               (Win HKCU\Run / Mac LaunchAgent / Linux XDG autostart)
               v2.29.0: cross-platform. Pre-r2 was Windows-only with the
               "available on Windows only" notice for Mac/Linux users.
               ══════════════════════════════════════════════════════════ -->
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding L_AutostartLoginSectionTitle}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <Border Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource SurfaceSunkenBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1">
              <StackPanel Spacing="5">
                <CheckBox IsChecked="{Binding AutostartUi}"
                          MinHeight="0" Padding="4,0">
                  <TextBlock Text="{Binding LblAutostartUi}" TextWrapping="Wrap"/>
                </CheckBox>
                <TextBlock Text="{Binding L_AutostartLoginAppDescription}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Opacity="0.85"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

      </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- Apply bar: "Autosave is on" left hint + compact Apply right. -->
    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
            Padding="14,7,14,8"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource BorderDefaultBrush}"
            Background="{DynamicResource SurfaceSunkenBrush}">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <TextBlock Text="✓" FontSize="11"
                     Foreground="{DynamicResource SuccessSolidBrush}"
                     VerticalAlignment="Center"/>
          <TextBlock Text="{Binding L_SettingsAutosaved}"
                     FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource SuccessFgBrush}"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Column="1"
                Content="{Binding L_ApplyNowReloadVpn}"
                Command="{Binding ApplyPendingChangesCommand}"
                IsEnabled="{Binding IsConnected}"
                Padding="10,5" FontSize="10" FontWeight="SemiBold" CornerRadius="{StaticResource RadiusSm}"
                Background="{DynamicResource AccentSolidBrush}" Foreground="{DynamicResource AccentOnSolidBrush}"
                ToolTip.Tip="{Binding L_ApplyNowHint}"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>

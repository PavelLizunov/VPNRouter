<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:fcvm="using:VPNRouter.App.ViewModels.FreeConfigs"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="520"
             x:Class="VPNRouter.App.Views.Pages.FreeConfigsPage"
             x:DataType="vm:MainWindowViewModel">

    <!-- v2.28.6-r3: restyled to match ServersPage / ToolsPage pattern.
         Sub-tab strip = ListBox (not TabControl) with horizontal
         StackPanel ItemsPanel. Outer Grid = "Auto,*,Auto" with Apply bar
         in the trailing row. Tab content uses IsVisible bindings on
         IsSearchTab / IsSavedTab. The empty-state CTA button on Search
         tab is removed — the green search card right above the list is
         the only "find configs" action, no second button below. -->

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ═══ Sub-tab strip (matches ServersPage / ToolsPage) ═══ -->
        <ListBox Grid.Row="0"
                 SelectedIndex="{Binding FreeConfigsVm.SelectedFreeTabIndex, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0,0,0,1"
                 BorderBrush="{DynamicResource BorderDefaultBrush}"
                 Padding="6,2">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBoxItem Content="{Binding L_FcTabSearch}" Padding="10,4" FontSize="11"/>
            <ListBoxItem Content="{Binding FreeConfigsVm.SavedTabHeaderText}"
                         Padding="10,4" FontSize="11"/>
        </ListBox>

        <!-- ═══ Tab content area ═══ -->
        <Grid Grid.Row="1">

            <!-- ──────────────────────────────────────────────────────────
                 Tab 1 — Поиск
                 ────────────────────────────────────────────────────────── -->
            <Grid IsVisible="{Binding FreeConfigsVm.IsSearchTab}"
                  RowDefinitions="Auto,Auto,*"
                  Margin="10,8,10,4">

                <!-- Green search card (Auto-height) -->
                <Border Grid.Row="0"
                        Padding="14,12"
                        CornerRadius="{StaticResource RadiusSm}"
                        Background="{DynamicResource SuccessBgBrush}"
                        BorderBrush="{DynamicResource SuccessSolidBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <!-- v2.31.0-r4 (F-18 / UX-65): pre-fix the
                             "✓✓ Найти рабочие конфиги" string appeared
                             twice — once as section header (this block),
                             once as the button label below. Visually
                             duplicative; dropped the header. The hint
                             below + the button label together carry the
                             same intent without the repetition. -->
                        <TextBlock Text="{Binding L_FcDeepHint}"
                                   FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SuccessFgBrush}"
                                   Opacity="0.85"/>
                        <!-- v2.31.6-r13 A11y: explicit Names for the
                             primary find/stop CTAs. The visible Content
                             already conveys the action, but a screen
                             reader could mis-announce when the button
                             swaps between Verify/Stop on busy state —
                             explicit Name matches the canonical label. -->
                        <Button Content="{Binding L_FcDeepVerify}"
                                Command="{Binding FreeConfigsVm.RefreshCommand}"
                                IsVisible="{Binding !FreeConfigsVm.IsBusy}"
                                Padding="0,10" FontSize="13" FontWeight="Bold"
                                CornerRadius="{StaticResource RadiusSm}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Background="{DynamicResource SuccessSolidBrush}"
                                Foreground="White"
                                ToolTip.Tip="{Binding L_FcDeepVerifyTooltip}"
                                AutomationProperties.Name="{Binding L_FcDeepVerify}"/>
                        <Button Content="{Binding L_FcDeepStop}"
                                Command="{Binding FreeConfigsVm.CancelCommand}"
                                IsVisible="{Binding FreeConfigsVm.IsBusy}"
                                Padding="0,10" FontSize="13" FontWeight="Bold"
                                CornerRadius="{StaticResource RadiusSm}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Background="{DynamicResource DangerSolidBrush}"
                                Foreground="White"
                                ToolTip.Tip="{Binding L_FcDeepStopTooltip}"
                                AutomationProperties.Name="{Binding L_FcDeepStop}"/>
                        <Expander Header="{Binding L_FcAdvancedSettings}"
                                  Background="Transparent"
                                  BorderBrush="{DynamicResource SuccessBorderBrush}"
                                  BorderThickness="0,1,0,0"
                                  Padding="0,4,0,0"
                                  Margin="0,4,0,0"
                                  Foreground="{DynamicResource SuccessFgBrush}"
                                  FontSize="11" FontWeight="SemiBold">
                            <StackPanel Spacing="8" Margin="0,6,0,2">
                                <WrapPanel Orientation="Horizontal" ItemWidth="NaN" ItemHeight="NaN">
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                Margin="0,0,12,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding L_FcTargetNLabel}"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SuccessFgBrush}"/>
                                        <NumericUpDown Value="{Binding FreeConfigsVm.LatencyGoalTarget}"
                                                       Minimum="5" Maximum="500" Increment="5"
                                                       FormatString="0"
                                                       MinWidth="84" Padding="4,2" FontSize="11"/>
                                        <TextBlock Text="{Binding L_FcConfigsWord}"
                                                   FontSize="11" Opacity="0.75"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SuccessFgBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                Margin="0,0,0,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding L_FcWithPingUnder}"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SuccessFgBrush}"/>
                                        <NumericUpDown Value="{Binding FreeConfigsVm.LatencyGoalMaxPingMs}"
                                                       Minimum="20" Maximum="1000" Increment="50"
                                                       FormatString="0"
                                                       MinWidth="92" Padding="4,2" FontSize="11"/>
                                        <TextBlock Text="{Binding L_FcMsUnit}"
                                                   FontSize="11" Opacity="0.75"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SuccessFgBrush}"/>
                                    </StackPanel>
                                </WrapPanel>
                                <Grid ColumnDefinitions="20,*" ColumnSpacing="4">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding FreeConfigsVm.ExcludeRu}"
                                              AutomationProperties.Name="{Binding L_FcDeepExcludeRu}"
                                              ToolTip.Tip="{Binding L_TipFcSkipRu}"
                                              MinHeight="0" Padding="0"
                                              VerticalAlignment="Top"
                                              Margin="0,1,0,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding L_FcDeepExcludeRu}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top"
                                               Foreground="{DynamicResource SuccessFgBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Compact list header (count). Matches ServersPage's
                     column-header row pattern. -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto"
                      Margin="2,8,2,4">
                    <TextBlock Grid.Column="0"
                               Text="{Binding L_FcListHeader}"
                               FontSize="9" FontWeight="SemiBold" Opacity="0.55"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               FontSize="9" Opacity="0.5" VerticalAlignment="Center">
                        <Run Text="{Binding FreeConfigsVm.DisplayedConfigs.Count}"/>
                        <Run Text="{Binding L_FcListShown}"/>
                    </TextBlock>
                </Grid>

                <!-- List area. Empty state = thin hint line (no CTA button —
                     the green card above is the single 'find configs' action). -->
                <Border Grid.Row="2"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusSm}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        ClipToBounds="True">
                    <Grid>
                        <!-- Populated list -->
                        <Grid IsVisible="{Binding FreeConfigsVm.IsListVisible}"
                              RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" Background="{DynamicResource SurfaceSunkenBrush}"
                                  ColumnDefinitions="44,*,80,80,72" Height="22">
                                <TextBlock Grid.Column="0" Text="{Binding L_FcColCountry}"
                                           FontWeight="SemiBold" FontSize="9" Opacity="0.55"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding L_FcColEndpoint}"
                                           FontWeight="SemiBold" FontSize="9" Opacity="0.55"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding L_FcColLatency}"
                                           FontWeight="SemiBold" FontSize="9" Opacity="0.55"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding L_FcColBandwidth}"
                                           FontWeight="SemiBold" FontSize="9" Opacity="0.55"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                <TextBlock Grid.Column="4" Text="{Binding L_FcColTransport}"
                                           FontWeight="SemiBold" FontSize="9" Opacity="0.55"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                            <ListBox Grid.Row="1"
                                     x:Name="ConfigsList"
                                     ItemsSource="{Binding FreeConfigsVm.DisplayedConfigs}"
                                     SelectedItem="{Binding FreeConfigsVm.SelectedItem}"
                                     DoubleTapped="ConfigsList_DoubleTapped"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="fcvm:FreeConfigItemViewModel">
                                        <Grid ColumnDefinitions="44,*,80,80,72" Height="22">
                                            <TextBlock Grid.Column="0" Text="{Binding CountryDisplay}"
                                                       FontFamily="{DynamicResource EmojiFlagFont}, $Default"
                                                       FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Endpoint}"
                                                       FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="2" CornerRadius="{StaticResource RadiusXs}"
                                                    Padding="4,1" HorizontalAlignment="Right" Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding LatencyColor}">
                                                <TextBlock Text="{Binding LatencyDisplay}"
                                                           Foreground="White" FontSize="9" FontWeight="SemiBold"/>
                                            </Border>
                                            <!-- v2.31.0-r4 (F-24 / UX-63):
                                                 added tooltip so "—" rows are
                                                 self-explanatory ("speed not
                                                 measured — run Deep verify").
                                                 Same hint used in Saved tab.
                                                 -->
                                            <TextBlock Grid.Column="3" Text="{Binding BandwidthDisplay}"
                                                       ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_FcSpeedColumnTooltip}"
                                                       FontSize="9" Opacity="0.75" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Transport}"
                                                       FontSize="9" Opacity="0.6"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- Empty / filtered-empty thin hint (no CTA button). -->
                        <TextBlock IsVisible="{Binding FreeConfigsVm.IsEmpty}"
                                   Text="{Binding L_FcSearchListEmptyHint}"
                                   FontSize="10" Opacity="0.45" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   MaxWidth="320" Margin="20"/>
                        <TextBlock IsVisible="{Binding FreeConfigsVm.IsFilteredEmpty}"
                                   Text="{Binding L_FcFilteredEmpty}"
                                   FontSize="10" Opacity="0.45" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   MaxWidth="360" Margin="20"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ──────────────────────────────────────────────────────────
                 Tab 2 — Сохранённые
                 ────────────────────────────────────────────────────────── -->
            <Grid IsVisible="{Binding FreeConfigsVm.IsSavedTab}"
                  RowDefinitions="Auto,Auto,*"
                  Margin="10,8,10,4">

                <!-- Bulk-action button row. Visible only when list non-empty. -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6"
                      Margin="2,0,2,8"
                      IsVisible="{Binding !FreeConfigsVm.IsSavedEmpty}">
                    <!-- v2.31.0-r4 (F-22 / UX-60): subtitle was being
                         truncated mid-sentence with CharacterEllipsis on
                         narrow windows. Switched to TextWrapping=Wrap so
                         the full hint stays visible (it's purposely
                         informative — explains why Saved configs may
                         break and how to recheck). -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding L_FcSavedTabHint}"
                               FontSize="9" Opacity="0.55"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="{Binding FreeConfigsVm.SavedRecheckStaleButtonText}"
                            Command="{Binding FreeConfigsVm.RecheckAllStaleCommand}"
                            IsEnabled="{Binding !FreeConfigsVm.IsBusy}"
                            IsVisible="{Binding FreeConfigsVm.HasStaleSaved}"
                            FontSize="10" Padding="10,4"
                            CornerRadius="{StaticResource RadiusSm}"/>
                    <!-- v2.30.7-r4 — F-23 fix: "✕ Удалить всё" is destructive
                         (wipes all saved configs); align with the danger-style
                         pattern used for "Сбросить настройки" / "Удалить службу
                         Zapret". Foreground swapped from neutral grey to the
                         Danger token. -->
                    <Button Grid.Column="2"
                            Content="{Binding L_FcSavedClearAllBtn}"
                            Command="{Binding FreeConfigsVm.ClearAllSavedCommand}"
                            IsEnabled="{Binding !FreeConfigsVm.IsBusy}"
                            FontSize="10" Padding="10,4"
                            CornerRadius="{StaticResource RadiusSm}"
                            Foreground="{DynamicResource DangerSolidBrush}"/>
                </Grid>

                <!-- Compact column-header strip — matches Search tab pattern. -->
                <Grid Grid.Row="1" ColumnDefinitions="44,*,72,72,68,52" Height="22"
                      Background="{DynamicResource SurfaceSunkenBrush}"
                      IsVisible="{Binding !FreeConfigsVm.IsSavedEmpty}">
                    <TextBlock Grid.Column="0" Text="{Binding L_FcColCountry}"
                               FontWeight="SemiBold" FontSize="9" Opacity="0.55"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding L_FcColEndpoint}"
                               FontWeight="SemiBold" FontSize="9" Opacity="0.55"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding L_FcColLatency}"
                               FontWeight="SemiBold" FontSize="9" Opacity="0.55"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                    <TextBlock Grid.Column="3" Text="{Binding L_FcColBandwidth}"
                               FontWeight="SemiBold" FontSize="9" Opacity="0.55"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                    <TextBlock Grid.Column="4" Text="{Binding L_FcSavedColStatus}"
                               FontWeight="SemiBold" FontSize="9" Opacity="0.55"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>

                <!-- List + empty state. Empty state = thin hint, no CTA. -->
                <Border Grid.Row="2"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusSm}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        ClipToBounds="True">
                    <Grid>
                        <ListBox x:Name="SavedConfigsList"
                                 IsVisible="{Binding !FreeConfigsVm.IsSavedEmpty}"
                                 ItemsSource="{Binding FreeConfigsVm.DisplayedSavedConfigs}"
                                 SelectedItem="{Binding FreeConfigsVm.SelectedItem}"
                                 DoubleTapped="ConfigsList_DoubleTapped"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="fcvm:FreeConfigItemViewModel">
                                    <Grid ColumnDefinitions="44,*,72,72,68,52" Height="22"
                                          Opacity="{Binding OpacityValue}">
                                        <TextBlock Grid.Column="0" Text="{Binding CountryDisplay}"
                                                   FontFamily="{DynamicResource EmojiFlagFont}, $Default"
                                                   FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Endpoint}"
                                                   FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="2" CornerRadius="{StaticResource RadiusXs}"
                                                Padding="4,1" HorizontalAlignment="Right" Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Background="{Binding LatencyColor}">
                                            <TextBlock Text="{Binding LatencyDisplay}"
                                                       Foreground="White" FontSize="9" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding BandwidthDisplay}"
                                                   ToolTip.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_FcSpeedColumnTooltip}"
                                                   FontSize="9" Opacity="0.85" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                        <TextBlock Grid.Column="4" Text="{Binding FreshnessLabel}"
                                                   FontSize="9" Opacity="0.7"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="↻"
                                                    Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).FreeConfigsVm.RecheckOneCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding !IsRecheckRunning}"
                                                    ToolTip.Tip="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).L_FcSavedRecheckOneTooltip}"
                                                    FontSize="10" Padding="4,1"
                                                    MinWidth="22" MinHeight="0"
                                                    CornerRadius="{StaticResource RadiusXs}"
                                                    Background="Transparent"/>
                                            <Button Content="✕"
                                                    Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).FreeConfigsVm.RemoveFromSavedCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).L_FcSavedRemoveOneTooltip}"
                                                    FontSize="10" Padding="4,1"
                                                    MinWidth="22" MinHeight="0"
                                                    CornerRadius="{StaticResource RadiusXs}"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource DangerSolidBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock IsVisible="{Binding FreeConfigsVm.IsSavedEmpty}"
                                   Text="{Binding L_FcSavedEmpty}"
                                   FontSize="10" Opacity="0.45" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   MaxWidth="320" Margin="20"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ Bottom action bar ═══ Matches ServersPage Padding="10,6"
             + BorderThickness="0,1,0,0" pattern. -->
        <Border Grid.Row="2" Padding="10,6"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderDefaultBrush}">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding FreeConfigsVm.StatusText}"
                               FontSize="10" Opacity="0.7"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1"
                               FontSize="10" Opacity="0.7"
                               VerticalAlignment="Center"
                               IsVisible="{Binding FreeConfigsVm.HasProgress}">
                        <Run Text="{Binding FreeConfigsVm.ProgressDone}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding FreeConfigsVm.ProgressTotal}"/>
                    </TextBlock>
                </Grid>
                <ProgressBar Value="{Binding FreeConfigsVm.ProgressDone}"
                             Maximum="{Binding FreeConfigsVm.ProgressTotal}"
                             IsVisible="{Binding FreeConfigsVm.HasProgress}"
                             Height="4" CornerRadius="{StaticResource RadiusXs}"/>
                <TextBlock Text="{Binding L_FcConnectHint}"
                           IsVisible="{Binding !FreeConfigsVm.HasSelection}"
                           FontSize="10" Opacity="0.55"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <!-- v2.31.6-r13 A11y: primary "Connect to selected"
                     CTA at the bottom of the right pane. -->
                <Button Content="{Binding L_FcApplySelected}"
                        Command="{Binding FreeConfigsVm.ApplySelectedCommand}"
                        IsEnabled="{Binding FreeConfigsVm.HasSelection}"
                        FontSize="13" FontWeight="Bold"
                        Padding="0,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="{DynamicResource AccentSolidBrush}"
                        Foreground="{DynamicResource AccentOnSolidBrush}"
                        CornerRadius="{StaticResource RadiusSm}"
                        AutomationProperties.Name="{Binding L_FcApplySelected}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

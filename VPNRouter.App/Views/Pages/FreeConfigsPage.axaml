<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:fcvm="using:VPNRouter.App.ViewModels.FreeConfigs"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="520"
             x:Class="VPNRouter.App.Views.Pages.FreeConfigsPage"
             x:DataType="vm:MainWindowViewModel">

    <!-- ═══ v2.28.3: Simple-only layout (per user request 2026-04-26).
         Dropped: left-nav with 6 sections (Overview / Scan / Deep verify
         / Filters / My Sources / Cleanup) — all collapsed into a single
         clean view. Find a server, click Apply selected, done.

         The 6 section flag properties (IsFreeOverviewSection / etc.)
         remain in MainWindowViewModel for source-compat with code that
         might still reference them, but they are no longer bound to UI.
         Empty-state CTA, list, and Apply-selected bar are the only
         user-facing elements now.

         All "advanced" features (preset picker, Smart-Refresh / Fast
         Scan toggles, Deep Verify, My Sources, Cleanup buttons) are
         intentionally hidden — they were the source of the
         "airplane-cockpit" complaint that triggered this rewrite.
         Power users who want them back can edit config.yaml directly
         or use the CLI commands.

         Default behaviour: Refresh fetches the server pool and stops
         testing once 100 working configs are found (early-stop in
         FreeConfigAggregator.RefreshAsync via goalTargetCount=100,
         goalMaxLatencyMs=300). Server-side pool.json fast path means
         most users never hit the per-source 14-fetch flow at all. ═══ -->
    <UserControl.Styles>
        <Style Selector="ListBox ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBgSubtleBrush}"/>
        </Style>
        <Style Selector="ListBox ListBoxItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ═══ Top: action bar + filters ═══ -->
        <Border Grid.Row="0"
                Padding="12,10,14,10"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderDefaultBrush}">
            <StackPanel Spacing="8">

                <!-- Busy banner: shows status + cancel button when an op is running.
                     Always visible during refresh so user can cancel without
                     hunting for a button. Replaces the old "Scan section"
                     status block from the 6-tab layout. -->
                <Border IsVisible="{Binding FreeConfigsVm.IsBusy}"
                        Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                        Background="{DynamicResource WarningBgBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FreeConfigsVm.StatusText}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarningFgBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Margin="0,3,0,0" Height="3"
                                         Minimum="0"
                                         Maximum="{Binding FreeConfigsVm.ProgressTotal}"
                                         Value="{Binding FreeConfigsVm.ProgressDone}"
                                         Foreground="{DynamicResource WarningSolidBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="{Binding L_FcCancel}"
                                Command="{Binding FreeConfigsVm.CancelCommand}"
                                Padding="14,6" FontSize="11"
                                CornerRadius="{StaticResource RadiusSm}"
                                Background="{DynamicResource DangerSolidBrush}"
                                Foreground="White"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Search-settings card.
                     v2.28.3-r3 redesign per user feedback on -r2:
                       1. Country dropdown dropped (redundant with Skip Russia
                          + the list already shows country flags inline).
                       2. "N" input got proper "Find ___ configs" label.
                       3. Max-ping input restored (was hidden behind a flag in
                          -r2; user wanted explicit control over the latency
                          ceiling that drives early-stop).
                       4. Wrapped in a Tokens-styled Border (Surface-sunken +
                          RadiusSm + Border) to match NetworkPage's grouped-
                          settings cards. Single big Refresh button below the
                          inputs replaces the inline action button — matches
                          the "settings card → primary action" pattern from
                          the rest of the app. -->
                <Border Padding="12,10" CornerRadius="{StaticResource RadiusSm}"
                        Background="{DynamicResource SurfaceSunkenBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="10">

                        <!-- Goal row: "Find N configs with ping < X ms" -->
                        <WrapPanel Orientation="Horizontal" ItemSpacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding L_FcTargetNLabel}"
                                           FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding FreeConfigsVm.LatencyGoalTarget}"
                                               Minimum="3" Maximum="500" Increment="5"
                                               FormatString="0"
                                               MinWidth="90" Padding="4,2" FontSize="11"
                                               VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding L_TipFcSmartRefresh}"/>
                                <TextBlock Text="{Binding L_FcConfigsWord}"
                                           FontSize="11" Opacity="0.7"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding L_FcWithPingUnder}"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding FreeConfigsVm.LatencyGoalMaxPingMs}"
                                               Minimum="20" Maximum="1000" Increment="50"
                                               FormatString="0"
                                               MinWidth="100" Padding="4,2" FontSize="11"
                                               VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding L_FcMsUnit}"
                                           FontSize="11" Opacity="0.7"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </WrapPanel>

                        <!-- Filter row: skip-RU + only-working -->
                        <WrapPanel Orientation="Horizontal" ItemSpacing="18">
                            <CheckBox Content="{Binding L_FcDeepExcludeRu}"
                                      IsChecked="{Binding FreeConfigsVm.ExcludeRu}"
                                      ToolTip.Tip="{Binding L_TipFcSkipRu}"
                                      FontSize="11"
                                      MinHeight="0" Padding="4,0"/>
                            <CheckBox Content="{Binding L_FcOnlyWorking}"
                                      IsChecked="{Binding FreeConfigsVm.OnlyWorking}"
                                      FontSize="11"
                                      MinHeight="0" Padding="4,0"/>
                        </WrapPanel>

                        <!-- Primary action: full-width Refresh button -->
                        <Button Content="{Binding L_FcRefreshSources}"
                                Command="{Binding FreeConfigsVm.RefreshCommand}"
                                IsEnabled="{Binding !FreeConfigsVm.IsBusy}"
                                Padding="0,9" FontSize="12" FontWeight="SemiBold"
                                CornerRadius="{StaticResource RadiusSm}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Background="{DynamicResource AccentSolidBrush}"
                                Foreground="{DynamicResource AccentOnSolidBrush}"
                                ToolTip.Tip="{Binding L_FcRefreshTooltip}"/>
                    </StackPanel>
                </Border>

                <!-- Counter line: "1247 servers · 230 working" — quick at-a-glance
                     stats without the 6-chip dashboard. Only shown when there's
                     something in the pool. -->
                <TextBlock IsVisible="{Binding FreeConfigsVm.IsListVisible}"
                           FontSize="10" Opacity="0.6">
                    <Run Text="{Binding FreeConfigsVm.DisplayedConfigs.Count}"/>
                    <Run Text="{Binding L_FcListShown}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding FreeConfigsVm.WorkingCount}"/>
                    <Run Text="{Binding L_FcDashboardWorking}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ═══ Middle: server list (or empty state) ═══ -->
        <Grid Grid.Row="1" Margin="12,8,14,8">

            <!-- Empty state CTA — main entry point for first-time users. -->
            <Border IsVisible="{Binding FreeConfigsVm.IsEmpty}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusMd}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    Padding="24,30"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="☁" FontSize="32" Opacity="0.5"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding L_FcEmptyCtaTitle}"
                               FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding L_FcEmptyCtaSubtitle}"
                               TextWrapping="Wrap" FontSize="11"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               MaxWidth="320"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <Button Content="{Binding L_FcEmptyCtaButton}"
                            Command="{Binding FreeConfigsVm.RefreshCommand}"
                            IsEnabled="{Binding !FreeConfigsVm.IsBusy}"
                            FontSize="12" FontWeight="SemiBold"
                            Padding="20,8" CornerRadius="{StaticResource RadiusSm}"
                            Margin="0,6,0,0"
                            Background="{DynamicResource AccentSolidBrush}"
                            Foreground="{DynamicResource AccentOnSolidBrush}"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Filtered-empty state — pool has servers, user's filter matches none. -->
            <Border IsVisible="{Binding FreeConfigsVm.IsFilteredEmpty}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusSm}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    Padding="20"
                    VerticalAlignment="Center">
                <StackPanel Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🔍" FontSize="22" HorizontalAlignment="Center" Opacity="0.5"/>
                    <TextBlock Text="{Binding L_FcFilteredEmpty}"
                               TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               MaxWidth="360"/>
                </StackPanel>
            </Border>

            <!-- Server list (with header row) -->
            <Border IsVisible="{Binding FreeConfigsVm.IsListVisible}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusSm}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" Background="{DynamicResource SurfaceSunkenBrush}"
                          ColumnDefinitions="44,*,88,70,72" Height="24">
                        <TextBlock Grid.Column="0" Text="{Binding L_FcColCountry}"
                                   FontWeight="SemiBold" FontSize="9" Opacity="0.65"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding L_FcColEndpoint}"
                                   FontWeight="SemiBold" FontSize="9" Opacity="0.65"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding L_FcColLatency}"
                                   FontWeight="SemiBold" FontSize="9" Opacity="0.65"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding L_FcColSni}"
                                   FontWeight="SemiBold" FontSize="9" Opacity="0.65"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="{Binding L_FcColTransport}"
                                   FontWeight="SemiBold" FontSize="9" Opacity="0.65"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                    <ListBox Grid.Row="1"
                             x:Name="ConfigsList"
                             ItemsSource="{Binding FreeConfigsVm.DisplayedConfigs}"
                             SelectedItem="{Binding FreeConfigsVm.SelectedItem}"
                             DoubleTapped="ConfigsList_DoubleTapped"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="fcvm:FreeConfigItemViewModel">
                                <Grid ColumnDefinitions="44,*,88,70,72" Height="22">
                                    <TextBlock Grid.Column="0" Text="{Binding CountryDisplay}"
                                               FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Endpoint}"
                                               FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="2" CornerRadius="{StaticResource RadiusXs}"
                                            Padding="4,1" HorizontalAlignment="Right" Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Background="{Binding LatencyColor}">
                                        <TextBlock Text="{Binding LatencyDisplay}"
                                                   Foreground="White" FontSize="9" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding Sni}"
                                               FontSize="9" Opacity="0.6"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Transport}"
                                               FontSize="9" Opacity="0.6"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ Bottom: status + Apply ═══ -->
        <Border Grid.Row="2"
                Padding="12,8,14,10"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderDefaultBrush}">
            <StackPanel Spacing="6">
                <!-- Status line (only when not busy — busy state has its own banner up top) -->
                <TextBlock Text="{Binding FreeConfigsVm.StatusText}"
                           IsVisible="{Binding !FreeConfigsVm.IsBusy}"
                           FontSize="10" Opacity="0.65"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Text="{Binding L_FcConnectHint}"
                           IsVisible="{Binding !FreeConfigsVm.HasSelection}"
                           FontSize="10" Opacity="0.55"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap"/>

                <Button Content="{Binding L_FcApplySelected}"
                        Command="{Binding FreeConfigsVm.ApplySelectedCommand}"
                        IsEnabled="{Binding FreeConfigsVm.HasSelection}"
                        FontSize="13" FontWeight="Bold"
                        Padding="0,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="{DynamicResource SuccessSolidBrush}" Foreground="White"
                        CornerRadius="{StaticResource RadiusSm}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VPNRouter.App.ViewModels"
             xmlns:fcvm="using:VPNRouter.App.ViewModels.FreeConfigs"
             xmlns:icons="using:VPNRouter.App.Controls"
             xmlns:loc="using:VPNRouter.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="520"
             x:Class="VPNRouter.App.Views.Pages.FreeConfigsPage"
             x:CompileBindings="True"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <Style Selector="Border.latency-badge">
            <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.latency-badge TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Border.latency-badge.badge-fast">
            <Setter Property="Background" Value="{DynamicResource PillFastBgBrush}"/>
        </Style>
        <Style Selector="Border.latency-badge.badge-fast TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PillFastFgBrush}"/>
        </Style>

        <Style Selector="Border.latency-badge.badge-medium">
            <Setter Property="Background" Value="{DynamicResource PillMediumBgBrush}"/>
        </Style>
        <Style Selector="Border.latency-badge.badge-medium TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PillMediumFgBrush}"/>
        </Style>

        <Style Selector="Border.latency-badge.badge-slow">
            <Setter Property="Background" Value="{DynamicResource PillSlowBgBrush}"/>
        </Style>
        <Style Selector="Border.latency-badge.badge-slow TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PillSlowFgBrush}"/>
        </Style>

        <Style Selector="Border.latency-badge.badge-danger">
            <Setter Property="Background" Value="{DynamicResource PillDangerBgBrush}"/>
        </Style>
        <Style Selector="Border.latency-badge.badge-danger TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PillDangerFgBrush}"/>
        </Style>

        <Style Selector="Border.latency-badge.badge-neutral">
            <Setter Property="Background" Value="{DynamicResource PillNeutralBgBrush}"/>
        </Style>
        <Style Selector="Border.latency-badge.badge-neutral TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PillNeutralFgBrush}"/>
        </Style>

        <Style Selector="UserControl.narrow TextBlock.col-aux">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <ListBox Grid.Row="0" Classes="hk-segs" Margin="10,8,10,6"
             SelectedIndex="{Binding FreeConfigsVm.SelectedFreeTabIndex, Mode=TwoWay}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1"/>
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
            <ListBoxItem Content="{Binding L_FcTabSearchLabel}"/>
            <ListBoxItem Content="{Binding FreeConfigsVm.SavedTabHeaderText}"/>
        </ListBox>

        <Grid Grid.Row="1">

            <Grid IsVisible="{Binding FreeConfigsVm.IsSearchTab}"
                  RowDefinitions="Auto,Auto,*"
                  Margin="10,8,10,4">

                <Border Grid.Row="0"
                        Padding="14,12"
                        CornerRadius="{StaticResource RadiusSm}"
                        Background="{DynamicResource SuccessBgBrush}"
                        BorderBrush="{DynamicResource SuccessSolidBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding L_FcDeepHint}"
                                   FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SuccessFgBrush}"
                                   Opacity="0.85"/>
                        <Button Classes="solid" icons:PictogramText.Icons="find-working" icons:PictogramText.Content="{Binding L_FcDeepVerify}"
                                Command="{Binding FreeConfigsVm.RefreshCommand}"
                                IsVisible="{Binding !FreeConfigsVm.IsBusy}"
                                Padding="0,10" FontSize="13" FontWeight="Bold"
                                CornerRadius="{StaticResource RadiusSm}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Background="{DynamicResource SuccessSolidBrush}"
                                Foreground="{DynamicResource SuccessOnSolidBrush}"
                                ToolTip.Tip="{Binding L_FcDeepVerifyTooltip}"
                                AutomationProperties.Name="{Binding L_FcDeepVerify}"/>
                        <Button Classes="solid" icons:PictogramText.Icons="stop" icons:PictogramText.Content="{Binding L_FcDeepStop}"
                                Command="{Binding FreeConfigsVm.CancelCommand}"
                                IsVisible="{Binding FreeConfigsVm.IsBusy}"
                                Padding="0,10" FontSize="13" FontWeight="Bold"
                                CornerRadius="{StaticResource RadiusSm}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Background="{DynamicResource DangerSolidBrush}"
                                Foreground="White"
                                ToolTip.Tip="{Binding L_FcDeepStopTooltip}"
                                AutomationProperties.Name="{Binding L_FcDeepStop}"/>
                        <Button Command="{Binding ToggleFcSettingsCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderBrush="{DynamicResource SuccessBorderBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0"
                                Padding="0,8,0,0"
                                Margin="0,4,0,0"
                                AutomationProperties.Name="{Binding L_FcSettingsLabel}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding L_FcSettingsLabel}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessFgBrush}"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Classes="disclosure-pill">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding L_FcSettingsToggle}"/>
                                        <icons:Pictogram Id="chevron-down" Classes="disclosure"
                                                         Classes.open="{Binding FcSettingsExpanded}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Button>
                        <Border IsVisible="{Binding FcSettingsExpanded}">
                            <StackPanel Spacing="8" Margin="0,6,0,2">
                                <WrapPanel Orientation="Horizontal" ItemWidth="NaN" ItemHeight="NaN">
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                Margin="0,0,12,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding L_FcTargetNLabel}"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SuccessFgBrush}"/>
                                        <NumericUpDown Value="{Binding FreeConfigsVm.LatencyGoalTarget}"
                                                       Minimum="5" Maximum="500" Increment="5"
                                                       FormatString="0"
                                                       MinWidth="84" Padding="4,2" FontSize="11"/>
                                        <TextBlock Text="{Binding L_FcConfigsWord}"
                                                   FontSize="11" Opacity="0.75"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SuccessFgBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                Margin="0,0,0,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding L_FcWithPingUnder}"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SuccessFgBrush}"/>
                                        <NumericUpDown Value="{Binding FreeConfigsVm.LatencyGoalMaxPingMs}"
                                                       Minimum="20" Maximum="1000" Increment="50"
                                                       FormatString="0"
                                                       MinWidth="92" Padding="4,2" FontSize="11"/>
                                        <TextBlock Text="{Binding L_FcMsUnit}"
                                                   FontSize="11" Opacity="0.75"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SuccessFgBrush}"/>
                                    </StackPanel>
                                </WrapPanel>
                                <Grid ColumnDefinitions="20,*" ColumnSpacing="4">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding FreeConfigsVm.ExcludeRu}"
                                              AutomationProperties.Name="{Binding L_FcDeepExcludeRu}"
                                              ToolTip.Tip="{Binding L_TipFcSkipRu}"
                                              MinHeight="0" Padding="0"
                                              VerticalAlignment="Top"
                                              Margin="0,1,0,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding L_FcDeepExcludeRu}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top"
                                               Foreground="{DynamicResource SuccessFgBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto"
                      Margin="2,8,2,4">
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" Grid.Column="0"
                               Text="{Binding L_FcListHeader}"
                               FontSize="9" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" Grid.Column="1"
                               FontSize="9" VerticalAlignment="Center">
                        <Run Text="{Binding FreeConfigsVm.DisplayedConfigs.Count}"/>
                        <Run Text="{Binding L_FcListShown}"/>
                    </TextBlock>
                </Grid>

                <Border Grid.Row="2"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusSm}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        ClipToBounds="True">
                    <Grid>
                        <Grid IsVisible="{Binding FreeConfigsVm.IsListVisible}"
                              RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" Background="{DynamicResource SurfaceSunkenBrush}"
                                  ColumnDefinitions="44,*,80,80,72" Height="22">
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" Grid.Column="0" Text="{Binding L_FcColCountry}"
                                           FontWeight="SemiBold" FontSize="9"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" Grid.Column="1" Text="{Binding L_FcColEndpoint}"
                                           FontWeight="SemiBold" FontSize="9"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" Grid.Column="2" Text="{Binding L_FcColLatency}"
                                           FontWeight="SemiBold" FontSize="9"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" Grid.Column="3" Classes="col-aux" Text="{Binding L_FcColBandwidth}"
                                           FontWeight="SemiBold" FontSize="9"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" Grid.Column="4" Classes="col-aux" Text="{Binding L_FcColTransport}"
                                           FontWeight="SemiBold" FontSize="9"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                            <ListBox Grid.Row="1"
                                     x:Name="ConfigsList"
                                     ItemsSource="{Binding FreeConfigsVm.DisplayedConfigs}"
                                     SelectedItem="{Binding FreeConfigsVm.SelectedItem}"
                                     DoubleTapped="ConfigsList_DoubleTapped"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="fcvm:FreeConfigItemViewModel">
                                        <Grid ColumnDefinitions="44,*,80,80,72" Height="22">
                                            <TextBlock Grid.Column="0" icons:PictogramText.Icons="globe" icons:PictogramText.Text="{Binding CountryDisplay}"
                                                       FontFamily="{DynamicResource EmojiFlagFont}, $Default"
                                                       FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Endpoint}"
                                                       MinWidth="110"
                                                       FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="2" Classes="latency-badge"
                                                    Classes.badge-fast="{Binding IsFast}"
                                                    Classes.badge-medium="{Binding IsMedium}"
                                                    Classes.badge-slow="{Binding IsSlow}"
                                                    Classes.badge-danger="{Binding IsDanger}"
                                                    Classes.badge-neutral="{Binding IsNeutral}">
                                                <TextBlock icons:PictogramText.Icons="verified,check" icons:PictogramText.Text="{Binding LatencyDisplay}"/>
                                            </Border>
                                            <TextBlock Grid.Column="3" Classes="col-aux" Text="{Binding BandwidthDisplay}"
                                                       icons:PictogramText.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_FcSpeedColumnTooltip}"
                                                       FontSize="9" Opacity="0.75" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                            <TextBlock Grid.Column="4" Classes="col-aux" Text="{Binding Transport}"
                                                       FontSize="9" Opacity="0.6"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding FreeConfigsVm.IsEmpty}"
                                   Text="{Binding L_FcSearchListEmptyHint}"
                                   FontSize="10" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   MaxWidth="320" Margin="20"/>
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding FreeConfigsVm.IsFilteredEmpty}"
                                   Text="{Binding L_FcFilteredEmpty}"
                                   FontSize="10" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   MaxWidth="360" Margin="20"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid IsVisible="{Binding FreeConfigsVm.IsSavedTab}"
                  RowDefinitions="Auto,Auto,*"
                  Margin="10,8,10,4">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6"
                      Margin="2,0,2,8"
                      IsVisible="{Binding !FreeConfigsVm.IsSavedEmpty}">
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" Grid.Column="0"
                               icons:PictogramText.Icons="retest" icons:PictogramText.Text="{Binding L_FcSavedTabHint}"
                               FontSize="9"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            icons:PictogramText.Icons="retest" icons:PictogramText.Content="{Binding FreeConfigsVm.SavedRecheckStaleButtonText}"
                            Command="{Binding FreeConfigsVm.RecheckAllStaleCommand}"
                            IsEnabled="{Binding !FreeConfigsVm.IsBusy}"
                            IsVisible="{Binding FreeConfigsVm.HasStaleSaved}"
                            FontSize="10" Padding="10,4"
                            CornerRadius="{StaticResource RadiusSm}"/>
                    <Button Grid.Column="2"
                            icons:PictogramText.Icons="delete" icons:PictogramText.Content="{Binding L_FcSavedClearAllBtn}"
                            Command="{Binding FreeConfigsVm.ClearAllSavedCommand}"
                            IsEnabled="{Binding !FreeConfigsVm.IsBusy}"
                            FontSize="10" Padding="10,4"
                            CornerRadius="{StaticResource RadiusSm}"
                            Foreground="{DynamicResource DangerSolidBrush}"/>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="44,*,72,72,68,52" Height="22"
                      Background="{DynamicResource SurfaceSunkenBrush}"
                      IsVisible="{Binding !FreeConfigsVm.IsSavedEmpty}">
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" Grid.Column="0" Text="{Binding L_FcColCountry}"
                               FontWeight="SemiBold" FontSize="9"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" Grid.Column="1" Text="{Binding L_FcColEndpoint}"
                               FontWeight="SemiBold" FontSize="9"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" Grid.Column="2" Text="{Binding L_FcColLatency}"
                               FontWeight="SemiBold" FontSize="9"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" Grid.Column="3" Classes="col-aux" Text="{Binding L_FcColBandwidth}"
                               FontWeight="SemiBold" FontSize="9"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" Grid.Column="4" Classes="col-aux" Text="{Binding L_FcSavedColStatus}"
                               FontWeight="SemiBold" FontSize="9"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>

                <Border Grid.Row="2"
                        BorderThickness="1" CornerRadius="{StaticResource RadiusSm}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        Background="{DynamicResource SurfaceBaseBrush}"
                        ClipToBounds="True">
                    <Grid>
                        <ListBox x:Name="SavedConfigsList"
                                 IsVisible="{Binding !FreeConfigsVm.IsSavedEmpty}"
                                 ItemsSource="{Binding FreeConfigsVm.DisplayedSavedConfigs}"
                                 SelectedItem="{Binding FreeConfigsVm.SelectedItem}"
                                 DoubleTapped="ConfigsList_DoubleTapped"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="fcvm:FreeConfigItemViewModel">
                                    <Grid ColumnDefinitions="44,*,72,72,68,52" Height="22">
                                        <TextBlock Grid.Column="0" icons:PictogramText.Icons="globe" icons:PictogramText.Text="{Binding CountryDisplay}"
                                                   FontFamily="{DynamicResource EmojiFlagFont}, $Default"
                                                   FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Endpoint}"
                                                   MinWidth="110"
                                                   Opacity="{Binding OpacityValue}"
                                                   FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="2" Classes="latency-badge"
                                                Classes.badge-fast="{Binding IsFast}"
                                                Classes.badge-medium="{Binding IsMedium}"
                                                Classes.badge-slow="{Binding IsSlow}"
                                                Classes.badge-danger="{Binding IsDanger}"
                                                Classes.badge-neutral="{Binding IsNeutral}">
                                            <TextBlock icons:PictogramText.Icons="verified,check" icons:PictogramText.Text="{Binding LatencyDisplay}"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Classes="col-aux" Text="{Binding BandwidthDisplay}"
                                                   icons:PictogramText.Tip="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).L_FcSpeedColumnTooltip}"
                                                   FontSize="9" Opacity="0.85" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" Grid.Column="4" Classes="col-aux" Text="{Binding FreshnessLabel}"
                                                   FontSize="9"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button icons:PictogramText.Icons="retest" icons:PictogramText.Content="↻"
                                                    Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).FreeConfigsVm.RecheckOneCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding !IsRecheckRunning}"
                                                    ToolTip.Tip="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).L_FcSavedRecheckOneTooltip}" AutomationProperties.Name="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).L_FcSavedRecheckOneTooltip}"
                                                    FontSize="10" Padding="4,1"
                                                    MinWidth="22" MinHeight="0"
                                                    CornerRadius="{StaticResource RadiusXs}"
                                                    Background="Transparent"/>
                                            <Button icons:PictogramText.Icons="delete" icons:PictogramText.Content="✕"
                                                    Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).FreeConfigsVm.RemoveFromSavedCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).L_FcSavedRemoveOneTooltip}" AutomationProperties.Name="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).L_FcSavedRemoveOneTooltip}"
                                                    FontSize="10" Padding="4,1"
                                                    MinWidth="22" MinHeight="0"
                                                    CornerRadius="{StaticResource RadiusXs}"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource DangerSolidBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding FreeConfigsVm.IsSavedEmpty}"
                                   Text="{Binding L_FcSavedEmpty}"
                                   FontSize="10" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   MaxWidth="320" Margin="20"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="10,6"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderDefaultBrush}">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" Grid.Column="0"
                               icons:PictogramText.Icons="verified,check,warning,error" icons:PictogramText.PrefixOnly="True" icons:PictogramText.Text="{Binding FreeConfigsVm.StatusText}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" Grid.Column="1"
                               FontSize="10"
                               VerticalAlignment="Center"
                               IsVisible="{Binding FreeConfigsVm.HasProgress}">
                        <Run Text="{Binding FreeConfigsVm.ProgressDone}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding FreeConfigsVm.ProgressTotal}"/>
                    </TextBlock>
                </Grid>
                <ProgressBar Value="{Binding FreeConfigsVm.ProgressDone}"
                             Maximum="{Binding FreeConfigsVm.ProgressTotal}"
                             IsVisible="{Binding FreeConfigsVm.HasProgress}"
                             Height="4" CornerRadius="{StaticResource RadiusXs}"/>
                <TextBlock Foreground="{DynamicResource TextMutedBrush}" icons:PictogramText.Icons="arrow-up" icons:PictogramText.Text="{Binding L_FcConnectHint}"
                           IsVisible="{Binding !FreeConfigsVm.HasSelection}"
                           FontSize="10"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <Button Classes="solid" Content="{Binding L_FcApplySelected}"
                        Command="{Binding FreeConfigsVm.ApplySelectedCommand}"
                        IsEnabled="{Binding FreeConfigsVm.HasSelection}"
                        FontSize="13" FontWeight="Bold"
                        Padding="0,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="{DynamicResource AccentSolidBrush}"
                        Foreground="{DynamicResource AccentOnSolidBrush}"
                        CornerRadius="{StaticResource RadiusSm}"
                        AutomationProperties.Name="{Binding L_FcApplySelected}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

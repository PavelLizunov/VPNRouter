<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeIdentifiers>win-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <RootNamespace>VPNRouter.App</RootNamespace>
    <AssemblyName>VPNRouter.App</AssemblyName>
  </PropertyGroup>

  <!-- Windows-specific: define PLATFORM_WINDOWS, reference Service for ServiceInstaller.
       v2.20.4: ApplicationIcon points at the new penguin_mascot.ico
       (generated from Assets/penguin_mascot.png, 7 sizes 16–256). v2.20.3
       removed ApplicationIcon entirely to get rid of the old ugly
       penguin_logo.ico — but that left Windows drawing its generic
       "no-icon" glyph in the title bar, which looks like an uninstalled
       app. New icon is the user-supplied transparent mascot and reads
       well even at 16×16 in the chrome. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);PLATFORM_WINDOWS</DefineConstants>
    <ApplicationIcon>Assets\penguin_mascot.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Wave 12 Phase 3 (2026-05-18) — Avalonia 11.3.12 -> 12.0.3 bump.
         12.x targets SkiaSharp 3.0 transitively (dropped 2.88 support) and
         the text shaper is now decoupled from the renderer (UseSkia no
         longer implies HarfBuzz). For our case UsePlatformDetect() is used
         in Program.BuildAvaloniaApp so HarfBuzz wiring happens automatically
         on real launches; we add Avalonia.HarfBuzz explicitly so the
         transitive graph is deterministic and TestAppBuilder's explicit
         UseSkia chain composes the same way. -->
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.0.4" />
    <!-- v2.20.5: direct SkiaSharp reference so we can call
         SKGraphics.SetFontCacheLimit/SetFontCacheCountLimit from
         App.axaml.cs. Bumped 2.88.9 -> 3.119.4-preview.1.1 to match Avalonia
         12.0.3's transitive Avalonia.Skia 12 -> SkiaSharp 3 graph (Avalonia
         12.0.3 pins SkiaSharp >= 3.119.4-preview.1.1 specifically; a lower
         stable version trips NU1605 downgrade-detected). API surface used
         (SKGraphics statics) is unchanged across the 2 -> 3 jump. -->
    <PackageReference Include="SkiaSharp" Version="4.150.0" />
    <!-- Avalonia 12 renamed the diagnostics package to
         AvaloniaUI.DiagnosticsSupport (separate side-cart on its own version
         track — 2.x). The attach helper changed from AttachDevTools to
         AttachDeveloperTools. We don't actually call it in App.axaml.cs
         (Avalonia auto-attaches in Debug when the package is referenced),
         so the rename is package-only here. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.2">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VPNRouter.Core\VPNRouter.Core.csproj" />
  </ItemGroup>

  <!-- v2.31.10: expose internal helpers (e.g.
       MainWindowViewModel.ComputeAutostartStatus pure-function dispatch)
       to the test project so we can pin them without making them public. -->
  <ItemGroup>
    <InternalsVisibleTo Include="VPNRouter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\profiles\default.json" Link="profiles\default.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\profiles\default-macos.json" Link="profiles\default-macos.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\profiles\default-linux.json" Link="profiles\default-linux.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\profiles\bypass-windows.json" Link="profiles\bypass-windows.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeIdentifiers>win-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <RootNamespace>VPNRouter.App</RootNamespace>
    <AssemblyName>VPNRouter.App</AssemblyName>
  </PropertyGroup>

  <!-- Windows-specific: define PLATFORM_WINDOWS, reference Service for ServiceInstaller.
       v2.20.4: ApplicationIcon points at the new penguin_mascot.ico
       (generated from Assets/penguin_mascot.png, 7 sizes 16–256). v2.20.3
       removed ApplicationIcon entirely to get rid of the old ugly
       penguin_logo.ico — but that left Windows drawing its generic
       "no-icon" glyph in the title bar, which looks like an uninstalled
       app. New icon is the user-supplied transparent mascot and reads
       well even at 16×16 in the chrome. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);PLATFORM_WINDOWS</DefineConstants>
    <ApplicationIcon>Assets\penguin_mascot.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <!-- v2.20.5: direct SkiaSharp reference (it's already pulled transitively
         via Avalonia.Skia 2.88.9) so we can call SKGraphics.SetFontCacheLimit
         and SKGraphics.PurgeAllCaches from MainWindowViewModel. -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.12">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VPNRouter.Core\VPNRouter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\profiles\default.json" Link="profiles\default.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\profiles\default-macos.json" Link="profiles\default-macos.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\profiles\default-linux.json" Link="profiles\default-linux.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">

            <Color x:Key="SurfaceApp">#FFF5F7FA</Color>
            <Color x:Key="SurfaceSunken">#FFEBEEF3</Color>
            <Color x:Key="SurfaceBase">#FFFFFFFF</Color>
            <Color x:Key="SurfaceRaised">#FFFFFFFF</Color>
            <Color x:Key="SurfaceOverlay">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="SurfaceAppBrush" Color="#FFF5F7FA"/>
            <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#FFEBEEF3"/>
            <SolidColorBrush x:Key="SurfaceBaseBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="#FFFFFFFF"/>

            <Color x:Key="TextPrimary">#FF0F1320</Color>
            <Color x:Key="TextSecondary">#FF475067</Color>
            <Color x:Key="TextMuted">#FF5B6A7F</Color>
            <Color x:Key="TextInverse">#FFFFFFFF</Color>
            <Color x:Key="TextAccent">#FF0369A1</Color>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF0F1320"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF475067"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#FF5B6A7F"/>
            <SolidColorBrush x:Key="TextInverseBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="TextAccentBrush" Color="#FF0369A1"/>

            <Color x:Key="BorderSubtle">#FFEBEEF3</Color>
            <Color x:Key="BorderDefault">#FFDCE1E9</Color>
            <Color x:Key="BorderStrong">#FFC2C9D5</Color>
            <Color x:Key="BorderAccent">#FF38BDF8</Color>
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#FFEBEEF3"/>
            <SolidColorBrush x:Key="BorderDefaultBrush" Color="#FFDCE1E9"/>
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#FFC2C9D5"/>
            <SolidColorBrush x:Key="BorderAccentBrush" Color="#FF38BDF8"/>

            <Color x:Key="AccentBgSubtle">#FFECFEFF</Color>
            <Color x:Key="AccentBgMuted">#FFCFFAFE</Color>
            <Color x:Key="AccentBorder">#FF67E8F9</Color>
            <Color x:Key="AccentFg">#FF0369A1</Color>
            <Color x:Key="AccentSolid">#FF0276B4</Color>
            <Color x:Key="AccentSolidHover">#FF0369A1</Color>
            <Color x:Key="AccentOnSolid">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="AccentBgSubtleBrush" Color="#FFECFEFF"/>
            <SolidColorBrush x:Key="AccentBgMutedBrush" Color="#FFCFFAFE"/>
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#FF67E8F9"/>
            <SolidColorBrush x:Key="AccentFgBrush" Color="#FF0369A1"/>
            <SolidColorBrush x:Key="AccentSolidBrush" Color="#FF0276B4"/>
            <SolidColorBrush x:Key="AccentSolidHoverBrush" Color="#FF0369A1"/>
            <SolidColorBrush x:Key="AccentOnSolidBrush" Color="#FFFFFFFF"/>

            <Color x:Key="SuccessBg">#FFDCFCE7</Color>
            <Color x:Key="SuccessBorder">#FF86EFAC</Color>
            <Color x:Key="SuccessFg">#FF166534</Color>
            <Color x:Key="SuccessSolid">#FF15803D</Color>
            <SolidColorBrush x:Key="SuccessBgBrush" Color="#FFDCFCE7"/>
            <SolidColorBrush x:Key="SuccessBorderBrush" Color="#FF86EFAC"/>
            <SolidColorBrush x:Key="SuccessFgBrush" Color="#FF166534"/>
            <SolidColorBrush x:Key="SuccessSolidBrush" Color="#FF15803D"/>
            <SolidColorBrush x:Key="SuccessOnSolidBrush" Color="#FFFFFFFF"/>

            <Color x:Key="WarningBg">#FFFEF3C7</Color>
            <Color x:Key="WarningBorder">#FFFCD34D</Color>
            <Color x:Key="WarningFg">#FF92400E</Color>
            <Color x:Key="WarningSolid">#FFD97706</Color>
            <SolidColorBrush x:Key="WarningBgBrush" Color="#FFFEF3C7"/>
            <SolidColorBrush x:Key="WarningBorderBrush" Color="#FFFCD34D"/>
            <SolidColorBrush x:Key="WarningFgBrush" Color="#FF92400E"/>
            <SolidColorBrush x:Key="WarningSolidBrush" Color="#FFD97706"/>

            <Color x:Key="DangerBg">#FFFEE2E2</Color>
            <Color x:Key="DangerBorder">#FFFCA5A5</Color>
            <Color x:Key="DangerFg">#FFB91C1C</Color>
            <Color x:Key="DangerSolid">#FFDC2626</Color>
            <SolidColorBrush x:Key="DangerBgBrush" Color="#FFFEE2E2"/>
            <SolidColorBrush x:Key="DangerBorderBrush" Color="#FFFCA5A5"/>
            <SolidColorBrush x:Key="DangerFgBrush" Color="#FFB91C1C"/>
            <SolidColorBrush x:Key="DangerSolidBrush" Color="#FFDC2626"/>

            <Color x:Key="InfoBg">#FFE0F2FE</Color>
            <Color x:Key="InfoBorder">#FF7DD3FC</Color>
            <Color x:Key="InfoFg">#FF075985</Color>
            <Color x:Key="InfoSolid">#FF0284C7</Color>
            <SolidColorBrush x:Key="InfoBgBrush" Color="#FFE0F2FE"/>
            <SolidColorBrush x:Key="InfoBorderBrush" Color="#FF7DD3FC"/>
            <SolidColorBrush x:Key="InfoFgBrush" Color="#FF075985"/>
            <SolidColorBrush x:Key="InfoSolidBrush" Color="#FF0284C7"/>

            <Color x:Key="PillFastBg">#FFDCFCE7</Color>
            <Color x:Key="PillFastFg">#FF14532D</Color>
            <SolidColorBrush x:Key="PillFastBgBrush" Color="#FFDCFCE7"/>
            <SolidColorBrush x:Key="PillFastFgBrush" Color="#FF14532D"/>

            <Color x:Key="PillMediumBg">#FFECFCCB</Color>
            <Color x:Key="PillMediumFg">#FF365314</Color>
            <SolidColorBrush x:Key="PillMediumBgBrush" Color="#FFECFCCB"/>
            <SolidColorBrush x:Key="PillMediumFgBrush" Color="#FF365314"/>

            <Color x:Key="PillSlowBg">#FFFEF3C7</Color>
            <Color x:Key="PillSlowFg">#FF78350F</Color>
            <SolidColorBrush x:Key="PillSlowBgBrush" Color="#FFFEF3C7"/>
            <SolidColorBrush x:Key="PillSlowFgBrush" Color="#FF78350F"/>

            <Color x:Key="PillDangerBg">#FFFEE2E2</Color>
            <Color x:Key="PillDangerFg">#FF7F1D1D</Color>
            <SolidColorBrush x:Key="PillDangerBgBrush" Color="#FFFEE2E2"/>
            <SolidColorBrush x:Key="PillDangerFgBrush" Color="#FF7F1D1D"/>

            <Color x:Key="PillNeutralBg">#FFF1F5F9</Color>
            <Color x:Key="PillNeutralFg">#FF334155</Color>
            <SolidColorBrush x:Key="PillNeutralBgBrush" Color="#FFF1F5F9"/>
            <SolidColorBrush x:Key="PillNeutralFgBrush" Color="#FF334155"/>

            <BoxShadows x:Key="ShadowXs">0 1 1 0 #0A0F1320</BoxShadows>
            <BoxShadows x:Key="ShadowSm">0 1 2 0 #0F0F1320, 0 1 1 0 #0A0F1320</BoxShadows>
            <BoxShadows x:Key="ShadowMd">0 4 12 0 #120F1320, 0 1 2 0 #0A0F1320</BoxShadows>
            <BoxShadows x:Key="ShadowLg">0 12 28 0 #1A0F1320, 0 2 6 0 #0D0F1320</BoxShadows>

            <!-- Fluent text box resources, so that every input follows the tokens (rounded by the page, a quiet border, an accent border on focus). -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FFC2C9D5"/>
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FF9AA5B8"/>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF0276B4"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF5B6A7F"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF5B6A7F"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF5B6A7F"/>

        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">

            <Color x:Key="SurfaceApp">#FF070A14</Color>
            <Color x:Key="SurfaceSunken">#FF0F1320</Color>
            <Color x:Key="SurfaceBase">#FF1C2231</Color>
            <Color x:Key="SurfaceRaised">#FF232A3B</Color>
            <Color x:Key="SurfaceOverlay">#FF2B3347</Color>
            <SolidColorBrush x:Key="SurfaceAppBrush" Color="#FF070A14"/>
            <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#FF0F1320"/>
            <SolidColorBrush x:Key="SurfaceBaseBrush" Color="#FF1C2231"/>
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FF232A3B"/>
            <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="#FF2B3347"/>

            <Color x:Key="TextPrimary">#FFEEF1F6</Color>
            <Color x:Key="TextSecondary">#FFA6B0C2</Color>
            <Color x:Key="TextMuted">#FF8791A6</Color>
            <Color x:Key="TextInverse">#FF0F1320</Color>
            <Color x:Key="TextAccent">#FF67E8F9</Color>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFEEF1F6"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA6B0C2"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#FF8791A6"/>
            <SolidColorBrush x:Key="TextInverseBrush" Color="#FF0F1320"/>
            <SolidColorBrush x:Key="TextAccentBrush" Color="#FF67E8F9"/>

            <Color x:Key="BorderSubtle">#0AFFFFFF</Color>
            <Color x:Key="BorderDefault">#14FFFFFF</Color>
            <Color x:Key="BorderStrong">#29FFFFFF</Color>
            <Color x:Key="BorderAccent">#FF38BDF8</Color>
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#0AFFFFFF"/>
            <SolidColorBrush x:Key="BorderDefaultBrush" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#29FFFFFF"/>
            <SolidColorBrush x:Key="BorderAccentBrush" Color="#FF38BDF8"/>

            <Color x:Key="AccentBgSubtle">#1438BDF8</Color>
            <Color x:Key="AccentBgMuted">#2938BDF8</Color>
            <Color x:Key="AccentBorder">#6638BDF8</Color>
            <Color x:Key="AccentFg">#FF67E8F9</Color>
            <Color x:Key="AccentSolid">#FF38BDF8</Color>
            <Color x:Key="AccentSolidHover">#FF67E8F9</Color>
            <Color x:Key="AccentOnSolid">#FF070A14</Color>
            <SolidColorBrush x:Key="AccentBgSubtleBrush" Color="#1438BDF8"/>
            <SolidColorBrush x:Key="AccentBgMutedBrush" Color="#2938BDF8"/>
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#6638BDF8"/>
            <SolidColorBrush x:Key="AccentFgBrush" Color="#FF67E8F9"/>
            <SolidColorBrush x:Key="AccentSolidBrush" Color="#FF38BDF8"/>
            <SolidColorBrush x:Key="AccentSolidHoverBrush" Color="#FF67E8F9"/>
            <SolidColorBrush x:Key="AccentOnSolidBrush" Color="#FF070A14"/>

            <Color x:Key="SuccessBg">#1F22C55E</Color>
            <Color x:Key="SuccessBorder">#5922C55E</Color>
            <Color x:Key="SuccessFg">#FF4ADE80</Color>
            <Color x:Key="SuccessSolid">#FF22C55E</Color>
            <SolidColorBrush x:Key="SuccessBgBrush" Color="#1F22C55E"/>
            <SolidColorBrush x:Key="SuccessBorderBrush" Color="#5922C55E"/>
            <SolidColorBrush x:Key="SuccessFgBrush" Color="#FF4ADE80"/>
            <SolidColorBrush x:Key="SuccessSolidBrush" Color="#FF22C55E"/>
            <SolidColorBrush x:Key="SuccessOnSolidBrush" Color="#FF052E16"/>

            <Color x:Key="WarningBg">#1FF59E0B</Color>
            <Color x:Key="WarningBorder">#59F59E0B</Color>
            <Color x:Key="WarningFg">#FFFCD34D</Color>
            <Color x:Key="WarningSolid">#FFF59E0B</Color>
            <SolidColorBrush x:Key="WarningBgBrush" Color="#1FF59E0B"/>
            <SolidColorBrush x:Key="WarningBorderBrush" Color="#59F59E0B"/>
            <SolidColorBrush x:Key="WarningFgBrush" Color="#FFFCD34D"/>
            <SolidColorBrush x:Key="WarningSolidBrush" Color="#FFF59E0B"/>

            <Color x:Key="DangerBg">#1FEF4444</Color>
            <Color x:Key="DangerBorder">#59EF4444</Color>
            <Color x:Key="DangerFg">#FFFCA5A5</Color>
            <Color x:Key="DangerSolid">#FFEF4444</Color>
            <SolidColorBrush x:Key="DangerBgBrush" Color="#1FEF4444"/>
            <SolidColorBrush x:Key="DangerBorderBrush" Color="#59EF4444"/>
            <SolidColorBrush x:Key="DangerFgBrush" Color="#FFFCA5A5"/>
            <SolidColorBrush x:Key="DangerSolidBrush" Color="#FFEF4444"/>

            <Color x:Key="InfoBg">#1F0EA5E9</Color>
            <Color x:Key="InfoBorder">#590EA5E9</Color>
            <Color x:Key="InfoFg">#FF7DD3FC</Color>
            <Color x:Key="InfoSolid">#FF0EA5E9</Color>
            <SolidColorBrush x:Key="InfoBgBrush" Color="#1F0EA5E9"/>
            <SolidColorBrush x:Key="InfoBorderBrush" Color="#590EA5E9"/>
            <SolidColorBrush x:Key="InfoFgBrush" Color="#FF7DD3FC"/>
            <SolidColorBrush x:Key="InfoSolidBrush" Color="#FF0EA5E9"/>

            <Color x:Key="PillFastBg">#FF1E3A2F</Color>
            <Color x:Key="PillFastFg">#FF6EE7B7</Color>
            <SolidColorBrush x:Key="PillFastBgBrush" Color="#FF1E3A2F"/>
            <SolidColorBrush x:Key="PillFastFgBrush" Color="#FF6EE7B7"/>

            <Color x:Key="PillMediumBg">#FF2D3B16</Color>
            <Color x:Key="PillMediumFg">#FFBEF264</Color>
            <SolidColorBrush x:Key="PillMediumBgBrush" Color="#FF2D3B16"/>
            <SolidColorBrush x:Key="PillMediumFgBrush" Color="#FFBEF264"/>

            <Color x:Key="PillSlowBg">#FF3D2E12</Color>
            <Color x:Key="PillSlowFg">#FFFDE68A</Color>
            <SolidColorBrush x:Key="PillSlowBgBrush" Color="#FF3D2E12"/>
            <SolidColorBrush x:Key="PillSlowFgBrush" Color="#FFFDE68A"/>

            <Color x:Key="PillDangerBg">#FF3B1A1A</Color>
            <Color x:Key="PillDangerFg">#FFFCA5A5</Color>
            <SolidColorBrush x:Key="PillDangerBgBrush" Color="#FF3B1A1A"/>
            <SolidColorBrush x:Key="PillDangerFgBrush" Color="#FFFCA5A5"/>

            <Color x:Key="PillNeutralBg">#FF1E2430</Color>
            <Color x:Key="PillNeutralFg">#FF94A3B8</Color>
            <SolidColorBrush x:Key="PillNeutralBgBrush" Color="#FF1E2430"/>
            <SolidColorBrush x:Key="PillNeutralFgBrush" Color="#FF94A3B8"/>

            <BoxShadows x:Key="ShadowXs">0 1 1 0 #66000000</BoxShadows>
            <BoxShadows x:Key="ShadowSm">0 1 2 0 #80000000, 0 1 1 0 #66000000</BoxShadows>
            <BoxShadows x:Key="ShadowMd">0 4 14 0 #8C000000, 0 1 2 0 #66000000</BoxShadows>
            <BoxShadows x:Key="ShadowLg">0 16 32 0 #A5000000, 0 2 6 0 #80000000</BoxShadows>

            <SolidColorBrush x:Key="TextControlBackground" Color="#FF0F1320"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF0F1320"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF0F1320"/>
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FF3A4560"/>
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FF56627F"/>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF38BDF8"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF8791A6"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF8791A6"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF8791A6"/>

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <sys:Double x:Key="Fs2Xs">9</sys:Double>
    <sys:Double x:Key="FsXs">10</sys:Double>
    <sys:Double x:Key="FsSm">11</sys:Double>
    <sys:Double x:Key="FsMd">12</sys:Double>
    <sys:Double x:Key="FsLg">13</sys:Double>
    <sys:Double x:Key="FsXl">15</sys:Double>
    <sys:Double x:Key="Fs2Xl">18</sys:Double>
    <sys:Double x:Key="Fs3Xl">22</sys:Double>

    <FontWeight x:Key="FwRegular">Normal</FontWeight>
    <FontWeight x:Key="FwMedium">Medium</FontWeight>
    <FontWeight x:Key="FwSemibold">SemiBold</FontWeight>
    <FontWeight x:Key="FwBold">Bold</FontWeight>

    <sys:Double x:Key="Space0">0</sys:Double>
    <sys:Double x:Key="Space1">2</sys:Double>
    <sys:Double x:Key="Space2">4</sys:Double>
    <sys:Double x:Key="Space3">6</sys:Double>
    <sys:Double x:Key="Space4">8</sys:Double>
    <sys:Double x:Key="Space5">12</sys:Double>
    <sys:Double x:Key="Space6">16</sys:Double>
    <sys:Double x:Key="Space7">20</sys:Double>
    <sys:Double x:Key="Space8">24</sys:Double>
    <sys:Double x:Key="Space9">32</sys:Double>
    <sys:Double x:Key="Space10">40</sys:Double>

    <CornerRadius x:Key="RadiusXs">3</CornerRadius>
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">10</CornerRadius>
    <CornerRadius x:Key="RadiusXl">14</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

</ResourceDictionary>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- v3.0 Phase G step 1 (2026-05-09) — shared XAML UserControl library
       for cross-platform Avalonia visual parity (desktop ↔ Android).

       Goal: one source of truth for UI controls so the same border-radius,
       padding, dot indicator, typography, and spacing render identically
       on every platform. Pre-G the Android UI was hand-built in C#
       (~5500 lines in AndroidApp.axaml.cs) and drifted from desktop's
       SimplePage.axaml even when the strings matched.

       Naming note: the originally proposed name was VPNRouter.Avalonia.UI
       but that introduces a VPNRouter.Avalonia sub-namespace, which
       breaks C# resolution of `using Avalonia.Input;` etc. inside any
       `namespace VPNRouter.*` (the compiler resolves nested namespaces
       inside-out, finds VPNRouter.Avalonia, then fails to locate .Input
       there). VPNRouter.UI sidesteps this entirely.

       Consumption pattern:
         • Desktop (VPNRouter.App): standard <ProjectReference>.
         • Android (VPNRouter.Android): source-link via <Compile Include=...>
           + <AvaloniaResource Include=...> because Android's csproj
           already source-links VPNRouter.Core (multi-target ProjectReference
           deadlock per Android csproj line 56-79). Source-linking from
           a non-Core-referencing UI library avoids any duplicate-types
           conflict.

       Why no <ProjectReference Include="..\VPNRouter.Core\...">:
         The MVP StatusCard control needs no Core types. Adding the
         reference would force Android to choose between ProjectReferencing
         this project (which transitively ProjectReferences Core) versus
         source-linking it — and Android already source-links Core. The
         two paths can't coexist without runtime duplicate types. We can
         add Core dependency later when extracting controls that genuinely
         need VPN state types (probably via shared interfaces in a
         VPNRouter.UI.Abstractions tier).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VPNRouter.UI</RootNamespace>
    <AssemblyName>VPNRouter.UI</AssemblyName>
    <!-- Compiled bindings stay off in this project so internal RelativeSource
         bindings inside UserControls work without per-file x:CompileBindings
         declarations. Consumers (desktop/Android) keep their own settings —
         the .axaml in this assembly is compiled in this assembly's MSBuild
         context, so the consumer's setting doesn't apply here. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <!-- CommunityToolkit.Mvvm intentionally omitted: this MVP UserControl
         only uses Avalonia StyledProperty (no [ObservableProperty] /
         [RelayCommand]). Adding it would force a version pick that
         conflicts with consumers — desktop App pins 8.2.1 while Android
         pins 8.4.0, so a single shared version breaks one or the other
         via NU1605 (package downgrade). Re-introduce here only after
         the consumers are aligned on a version, or via a separate
         VPNRouter.UI.Mvvm project that depends on it directly. -->
  </ItemGroup>

</Project>

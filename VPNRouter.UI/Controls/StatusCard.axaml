<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:VPNRouter.UI.Controls"
             x:Class="VPNRouter.UI.Controls.StatusCard">

    <!--
      v3.0 Phase G step 1 (2026-05-09) — shared status card.
      Extracted verbatim from VPNRouter.App/Views/Pages/SimplePage.axaml
      lines 144-174 (the «Status card — 3 variants via IsVisible…» block).
      One source of truth for desktop + Android visual parity.

      Three mutually-exclusive states are exposed as bool StyledProperties
      (IsOn / IsWarn / IsOff) instead of a single enum so existing desktop
      VM bindings (SimpleStatusIsOn / IsWarn / IsOff) plug in 1:1 with no
      converter layer. Title + Subtitle drive the text content.

      All visual treatment — border colour, corner radius, padding, dot
      size, typography — comes from Tokens.axaml at the App level. The
      consumer app just needs Tokens loaded into Application.Resources
      (already done in both VPNRouter.App/App.axaml and
      VPNRouter.Android/AndroidApp.axaml).
    -->
    <Border BorderThickness="1"
            BorderBrush="{DynamicResource BorderDefaultBrush}"
            Background="{DynamicResource SurfaceBaseBrush}"
            CornerRadius="{StaticResource RadiusMd}"
            Padding="14">
        <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- Status dot — only one of three is visible at a time. -->
                <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                         Fill="{DynamicResource SuccessSolidBrush}"
                         IsVisible="{Binding IsOn, RelativeSource={RelativeSource AncestorType={x:Type local:StatusCard}}}"/>
                <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                         Fill="{DynamicResource WarningSolidBrush}"
                         IsVisible="{Binding IsWarn, RelativeSource={RelativeSource AncestorType={x:Type local:StatusCard}}}"/>
                <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                         Fill="{DynamicResource TextMutedBrush}"
                         IsVisible="{Binding IsOff, RelativeSource={RelativeSource AncestorType={x:Type local:StatusCard}}}"/>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type local:StatusCard}}}"
                           FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
            <TextBlock Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType={x:Type local:StatusCard}}}"
                       FontSize="10"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="20,0,0,0"
                       LineHeight="15"/>
        </StackPanel>
    </Border>
</UserControl>

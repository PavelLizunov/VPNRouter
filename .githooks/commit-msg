#!/bin/bash

set -e
COMMIT_MSG_FILE="$1"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ERRORS=()
WARNINGS=()

subject=$(head -1 "$COMMIT_MSG_FILE")
if [ "${#subject}" -gt 72 ]; then
  ERRORS+=("M1: subject is ${#subject} chars (max 72). Move detail to body.")
fi

if ! echo "$subject" | grep -qE '^(feat|fix|docs|refactor|perf|test|chore|ci|build|style)(\([a-z]+\))?: '; then
  WARNINGS+=("M2: subject not in 'type(scope): subject' form. Recommended: feat/fix/docs/refactor/test/chore/ci/build.")
fi

if [ "${#WARNINGS[@]}" -gt 0 ]; then
  echo ""
  for w in "${WARNINGS[@]}"; do echo -e "  ${YELLOW}⚠ $w${NC}"; done
fi

if [ "${#ERRORS[@]}" -gt 0 ]; then
  echo ""
  echo -e "${RED}❌ commit-msg gates failed:${NC}"
  for e in "${ERRORS[@]}"; do echo -e "  ${RED}- $e${NC}"; done
  exit 1
fi

exit 0

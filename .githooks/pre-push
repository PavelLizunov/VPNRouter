#!/bin/bash

set -e

pushes_main=false
while read local_ref local_sha remote_ref remote_sha; do
    if [[ "$local_ref" == refs/tags/* ]]; then
        echo "[pre-push] Tag push detected ($local_ref) — skipping CI check."
        exit 0
    fi
    if [[ "$remote_ref" == "refs/heads/main" ]]; then
        pushes_main=true
    fi
done

if [[ "$pushes_main" != true ]]; then
    echo "[pre-push] Non-main branch push detected — CI will run on the branch/PR."
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
    echo "[pre-push] WARN: cannot resolve repo root; allowing push."
    exit 0
fi

SCRIPT="$REPO_ROOT/tools/verify-last-commit-ci.ps1"
if [ ! -f "$SCRIPT" ]; then
    echo "[pre-push] WARN: $SCRIPT missing — allowing push (script not yet pulled)."
    exit 0
fi

echo "[pre-push] Verifying previous commit CI via tools/verify-last-commit-ci.ps1..."
if powershell -ExecutionPolicy Bypass -File "$SCRIPT" -Commit "HEAD^1" 2>&1 | tee /tmp/vpnrouter-ci-check.log | tail -3 | grep -qE "^OK[: -]"; then
    echo "[pre-push] CI green — push allowed."
    WATCHER="$REPO_ROOT/tools/watch-after-push.ps1"
    if [ -f "$WATCHER" ]; then
        ( powershell -ExecutionPolicy Bypass -File "$WATCHER" >/dev/null 2>&1 & ) || true
    fi
    exit 0
fi

echo ""
echo "[pre-push] ABORT: previous commit CI is not green."
echo ""
echo "Last 10 lines of verification output:"
tail -10 /tmp/vpnrouter-ci-check.log
echo ""
echo "Fix the failing checks (or wait for in-progress) before pushing the next commit."
echo "Emergency bypass: git push --no-verify   (document reason in commit message)"
exit 1

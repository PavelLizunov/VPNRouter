#!/bin/bash

set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
    exit 0
fi

SHA="$(git rev-parse HEAD 2>/dev/null)"
if [ -z "$SHA" ]; then
    exit 0
fi

SCRIPT="$REPO_ROOT/tools/watch-after-push.ps1"
if [ ! -f "$SCRIPT" ]; then
    exit 0
fi

LOG="$REPO_ROOT/.git-watch.log"
nohup powershell -ExecutionPolicy Bypass -File "$SCRIPT" -Sha "$SHA" \
    > "$LOG" 2>&1 &

echo "[post-push] CI watcher launched for $SHA (background, PID $!)."
echo "[post-push] Tail $LOG for status; check .git-suggested-hash-bump.txt for fix."
exit 0
